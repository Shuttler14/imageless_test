# ═══════════════════════════════════════════════════════════
# MY NARRATIVE - SHOPIFY THEME ENVIRONMENT VARIABLES
# Add these to your Shopify theme settings or use Shopify CLI
# ═══════════════════════════════════════════════════════════

# Vercel Backend URL (REQUIRED - Replace with your actual URL)
VERCEL_APP_URL=https://YOUR_VERCEL_APP.vercel.app

# API Endpoints (Auto-generated from base URL)
FASHION_CONSULTANT_API=${VERCEL_APP_URL}/api/fashion_consultant
AFFILIATE_LINKS_API=${VERCEL_APP_URL}/api/generate_affiliate_links
AVATAR_GENERATION_API=${VERCEL_APP_URL}/api/generate_avatar
WARDROBE_SYNC_API=${VERCEL_APP_URL}/api/wardrobe_sync

# Feature Flags
ENABLE_3D_AVATAR=false
ENABLE_GHOST_MODE=true
ENABLE_PHOTO_UPLOAD=true
ENABLE_RED_GAP=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_OFFLINE_MODE=true

# Affiliate Program IDs
NIKE_AFFILIATE_ID=
ADIDAS_AFFILIATE_ID=
PUMA_AFFILIATE_ID=
AMAZON_AFFILIATE_ID=

# Analytics (Optional)
GA4_MEASUREMENT_ID=
MIXPANEL_TOKEN=

# Error Tracking (Optional)
SENTRY_DSN=

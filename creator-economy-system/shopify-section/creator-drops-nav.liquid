{% comment %}
=================================================================================
MY NARRATIVE - CREATOR DROPS NAVIGATION (HEADER)
=================================================================================
Top-level navigation item for Creator Drops / Featured Collaborations

INTEGRATION:
Add to your theme.liquid header after other nav items:
{% section 'creator-drops-nav' %}

OR add this snippet to your navigation:
{% render 'creator-drops-nav' %}

=================================================================================
{% endcomment %}

<style>
  .mn-creator-drops-link {
    position: relative;
    font-family: 'Montserrat', sans-serif;
  }

  .mn-creator-drops-link a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(245, 158, 11, 0.05));
    border-radius: 8px;
    border: 1px solid rgba(251, 191, 36, 0.2);
  }

  .mn-creator-drops-link a:hover {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(245, 158, 11, 0.1));
    border-color: rgba(251, 191, 36, 0.4);
    color: #fbbf24;
  }

  .mn-creator-drops-link .fire-icon {
    font-size: 16px;
  }

  .mn-creator-drops-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #ef4444;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    text-transform: uppercase;
  }

  /* Dropdown styles (optional - if you want dropdown) */
  .mn-creator-drops-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #111;
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 12px;
    padding: 12px;
    min-width: 200px;
    z-index: 100;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .mn-creator-drops-link:hover .mn-creator-drops-dropdown {
    display: block;
  }

  .mn-dropdown-item {
    display: block;
    padding: 10px 14px;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .mn-dropdown-item:hover {
    background: rgba(251, 191, 36, 0.1);
    color: #fbbf24;
  }

  .mn-dropdown-item .icon {
    margin-right: 8px;
  }
</style>

<div class="mn-creator-drops-link">
  <a href="/featured-creators">
    <span class="fire-icon">🔥</span>
    Creator Drops
  </a>

  {% comment %} Optional: Uncomment for dropdown {% comment %}
  <div class="mn-creator-drops-dropdown">
    <a href="/featured-creators" class="mn-dropdown-item">
      <span class="icon">👑</span> Featured Creators
    </a>
    <a href="/pages/creator-showcase" class="mn-dropdown-item">
      <span class="icon">✨</span> Latest Drops
    </a>
    <a href="/pages/creator-designs" class="mn-dropdown-item">
      <span class="icon">🎨</span> Browse All
    </a>
  </div>
  {% endcomment %}
</div>
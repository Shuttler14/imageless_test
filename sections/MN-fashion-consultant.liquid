       4. Editorial Result + Upsell → 5. Gamification
     ============================================================ -->

<div id="mn-ai-widget" class="mn-ai-widget">

  <!-- Minimized State: Avatar Bubble (shown after first close) -->
  <div id="mn-widget-minimized" class="mn-widget-minimized" title="Open AI Stylist">
    <div class="mn-avatar-bubble">
      <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=80&h=80&fit=crop" alt="AI Stylist" class="mn-avatar-bubble-img" />
      <span class="mn-avatar-online-dot"></span>
    </div>
  </div>

  <!-- Expanded State: Full 5-Step Widget -->
  <div id="mn-widget-expanded" class="mn-widget-expanded" aria-hidden="true">
    <!-- Close button -->
    <button id="mn-close-btn" class="mn-close-btn" aria-label="Close AI Stylist">×</button>

    <!-- Progress bar (filled by JS based on current step) -->
    <div id="mn-progress-bar" class="mn-progress-bar">
      <div class="mn-progress-fill"></div>
    </div>

    <!-- Step content rendered here by MN-fashion-consultant.js -->
    <div id="mn-content-container" class="mn-content-container"></div>
  </div>

</div>

<!-- Widget Configuration -->

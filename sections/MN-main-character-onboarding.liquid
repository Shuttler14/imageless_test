<!-- ================================================================
     MY NARRATIVE — MAIN CHARACTER ONBOARDING FLOW v1.0
     5-Step: Hook → Aesthetic → Occasion → Canvas → Results
     ================================================================ -->

<!-- Persistent Global UI (floats above all steps) -->
<div id="mn-onboard-persistent">

  <!-- Top Left: Profile Ring (circular progress) -->
  <button id="mn-profile-ring" class="mn-profile-ring" title="View Profile Completion">
    <svg class="mn-ring-svg" viewBox="0 0 44 44">
      <circle class="mn-ring-track" cx="22" cy="22" r="18" />
      <circle class="mn-ring-fill" cx="22" cy="22" r="18"
              stroke-dasharray="113"
              stroke-dashoffset="45" />
    </svg>
    <img src="{{ settings.logo | img_url: '80x80' }}"
         onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&h=80&fit=crop&crop=face'"
         alt="Profile" class="mn-ring-avatar" />
    <span class="mn-ring-pct">60%</span>
  </button>

  <!-- Top Right: My Closet Chip -->
  <a href="/pages/my-closet" id="mn-closet-chip" class="mn-closet-chip" style="text-decoration: none; color: inherit;">
    <span class="mn-closet-icon">👗</span>
    <span class="mn-closet-count" id="mn-closet-count">0</span>
    <span class="mn-closet-label">My Closet</span>
  </a>

  <!-- Bottom Right: Gift Mode FAB -->
  <button id="mn-gift-fab" class="mn-gift-fab" title="Styling for someone else? Try Gift Mode.">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="20 12 20 22 4 22 4 12"/>
      <rect x="2" y="7" width="20" height="5"/>
      <line x1="12" y1="22" x2="12" y2="7"/>
      <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/>
      <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
    </svg>
    <span class="mn-gift-tooltip">Styling for someone else? Try Gift Mode.</span>
  </button>

  <!-- Profile Recalibration Modal -->
  <div id="mn-profile-modal" class="mn-modal" style="display:none">
    <div class="mn-modal-box">
      <button class="mn-modal-close" id="mn-profile-modal-close">×</button>
      <h3 class="mn-modal-title">Recalibrate Your Fit</h3>
      <p class="mn-modal-sub">Update your height and fit preferences for better recommendations.</p>
      <div class="mn-modal-field">
        <label>Height</label>
        <input type="range" min="150" max="200" value="172" id="mn-height-slider" class="mn-slider" />
        <span id="mn-height-val">172 cm</span>
      </div>
      <div class="mn-modal-field">
        <label>Preferred Fit</label>
        <div class="mn-fit-chips">
          <button class="mn-fit-chip mn-fit-active" data-fit="slim">Slim</button>
          <button class="mn-fit-chip" data-fit="regular">Regular</button>
          <button class="mn-fit-chip" data-fit="oversized">Oversized</button>
          <button class="mn-fit-chip" data-fit="relaxed">Relaxed</button>
        </div>
      </div>
      <button class="mn-modal-save" id="mn-save-profile">Save Preferences</button>
    </div>
  </div>

  <!-- My Closet Drawer -->
  <div id="mn-closet-drawer" class="mn-drawer" style="display:none">
    <div class="mn-drawer-box">
      <button class="mn-drawer-close" id="mn-closet-drawer-close">×</button>
      <h3 class="mn-drawer-title">My Digital Closet</h3>
      <p class="mn-drawer-sub" id="mn-closet-items-count">0 items digitized</p>
      <div class="mn-drawer-grid" id="mn-closet-grid"></div>
      <div class="mn-drawer-actions">
        <button class="mn-drawer-btn mn-drawer-btn-primary" id="mn-snap-pic">📸 Snap a Pic</button>
        <button class="mn-drawer-btn mn-drawer-btn-ghost" id="mn-ghost-mode">👻 Ghost Mode</button>
      </div>
    </div>
  </div>

</div>

<!-- Main Onboarding Container -->
<div id="mn-onboard" class="mn-onboard">

  <!-- STEP 1: Hook -->
  <div id="mn-step-1" class="mn-step mn-step-active">
    <div class="mn-step1-content">
      <div class="mn-step1-badge">✦ MY NARRATIVE</div>
      <h1 class="mn-step1-headline">
        Don't just get dressed.<br>
        <span class="mn-gradient-text">Let's curate your story.</span>
      </h1>
      <p class="mn-step1-sub">
        Step into your main character energy today.
      </p>
      <button class="mn-cta-primary" id="mn-step1-cta">
        Curate My Look
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
      <div class="mn-step1-scroll-hint">Scroll to explore ↓</div>
    </div>
    <div class="mn-step1-bg-orbs">
      <div class="mn-orb mn-orb-1"></div>
      <div class="mn-orb mn-orb-2"></div>
      <div class="mn-orb mn-orb-3"></div>
    </div>
  </div>

  <!-- STEP 2: Aesthetic Selection -->
  <div id="mn-step-2" class="mn-step" style="display:none">
    <div class="mn-step-header">
      <p class="mn-step-num">02 / 05</p>
      <h2 class="mn-step-title">What kind of energy are we projecting?</h2>
      <p class="mn-step-sub">Choose your favorites — pick as many as feel right.</p>
    </div>
    <div class="mn-aesthetic-grid" id="mn-aesthetic-grid">
      <!-- Populated by JS with 50/50 Men/Women -->
    </div>
    <div class="mn-step-footer">
      <span class="mn-selected-count" id="mn-aesthetic-count">0 selected</span>
      <button class="mn-cta-primary" id="mn-step2-cta" disabled>
        Next: Set the Occasion →
      </button>
    </div>
  </div>

  <!-- STEP 3: Occasion Protocol -->
  <div id="mn-step-3" class="mn-step" style="display:none">
    <div class="mn-step-header">
      <p class="mn-step-num">03 / 05</p>
      <h2 class="mn-step-title">Where are we taking this look?</h2>
      <p class="mn-step-sub">Select all that apply to your lifestyle.</p>
    </div>
    <div class="mn-occasion-chips" id="mn-occasion-chips">
      <!-- Populated by JS -->
    </div>
    <div class="mn-step-footer">
      <button class="mn-btn-ghost" id="mn-step3-back">← Back</button>
      <button class="mn-cta-primary" id="mn-step3-cta" disabled>
        Next: The Canvas →
      </button>
    </div>
  </div>

  <!-- STEP 4: Canvas Upload -->
  <div id="mn-step-4" class="mn-step" style="display:none">
    <div class="mn-step-header">
      <p class="mn-step-num">04 / 05</p>
      <h2 class="mn-step-title">Let's see the canvas.</h2>
      <p class="mn-step-sub">Upload a quick selfie to ensure the fit and colors perfectly match your unique skin tone and proportions.</p>
    </div>
    <div class="mn-upload-zone" id="mn-canvas-upload">
      <div class="mn-upload-camera">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
      <p class="mn-upload-main">Tap to activate camera or drop selfie</p>
      <p class="mn-upload-sub">JPG, PNG, WebP · Max 10MB · Full body works best</p>
      <input type="file" id="mn-selfie-input" accept="image/*" style="display:none">
    </div>
    <div id="mn-canvas-preview" style="display:none" class="mn-canvas-preview">
      <img id="mn-canvas-img" alt="Your selfie" class="mn-canvas-img" />
      <button class="mn-canvas-redo" id="mn-redo-selfie">↺ Retake</button>
    </div>
    <div class="mn-step-footer">
      <button class="mn-btn-ghost" id="mn-step4-back">← Back</button>
      <button class="mn-cta-primary" id="mn-step4-cta" disabled>
        Generate My Look →
      </button>
    </div>
  </div>

  <!-- STEP 5: Results & Upsell -->
  <div id="mn-step-5" class="mn-step" style="display:none">
    <div class="mn-step-header">
      <p class="mn-step-num">05 / 05</p>
      <h2 class="mn-step-title" id="mn-step5-title">Creating your main character look…</h2>
    </div>
    <div id="mn-step5-content">
      <!-- States A→D rendered by JS -->
    </div>
  </div>

</div>

<script>
  window.MN_ONBOARD_CONFIG = {
    apiUrl: "https://mynarrative-vton.vercel.app/api/stylist_pipeline"
  };
</script>
<script src="{{ 'MN-main-character-onboarding.js' | asset_url }}?v=1.0.0" defer></script>
<link rel="stylesheet" href="{{ 'MN-main-character-onboarding.css' | asset_url }}?v=1.0.0">

{% schema %}
{
  "name": "MN Onboarding",
  "settings": [],
  "presets": [{"name": "MN Onboarding"}]
}
{% endschema %}

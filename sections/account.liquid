  </style>

  {% comment %} --- LOGIC: FETCH ALL DATA (HISTORY) --- {% endcomment %}

  {% assign total_items = 0 %}

  {% assign collected_images = '' %}

  {% assign collected_titles = '' %}

  {% assign collected_order_ids = '' %}

  {% comment %} Added Pagination to ensure we get ALL past orders {% endcomment %}

  {% paginate customer.orders by 250 %}
    {% for order in customer.orders %}
      {% unless order.cancelled %}
        {% comment %} CHECK FOR SPECIAL CODE TEST649 {% endcomment %}

        {% assign is_special_order = false %}

        {% for discount in order.discount_applications %}
          {% if discount.title == 'TEST649' %}
            {% assign is_special_order = true %}
          {% endif %}
        {% endfor %}

        {% for line_item in order.line_items %}
          {% comment %} LOGIC: Paid item OR Special Code Order {% endcomment %}

          {% if line_item.final_price > 0 or is_special_order %}
            {% comment %} 1. COUNT ITEMS {% endcomment %}

            {% assign total_items = total_items | plus: line_item.quantity %}

            {% comment %} 2. FETCH MASCOT {% endcomment %}

            {% assign mascot = line_item.product.metafields.custom.mascot_file %}

            {% if mascot %}

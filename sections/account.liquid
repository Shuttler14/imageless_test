    <div>
      <h1 class="heading-font text-3xl md:text-5xl font-bold text-white uppercase tracking-wider">My Narrative</h1>

      <p class="text-gray-400 text-sm mt-2">Welcome back, {{ customer.first_name }}</p>
    </div>

    <a
      class="text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-white transition-colors border border-gray-700 px-4 py-2 rounded-full hover:border-white"

      href="{{ routes.account_logout_url }}"
    >
      Logout
    </a>
  </div>

  <!-- User Profile Section Styles -->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');
    
    .user-profile-section {
      font-family: 'Montserrat', sans-serif;
      background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
      border: 1px solid #39A596;
      border-radius: 16px;
      padding: 1.25rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 0 30px rgba(57, 165, 150, 0.12);
      margin-top: 2rem;
    }

    .user-profile-section::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(57, 165, 150, 0.1) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .profile-hero {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      position: relative;
      z-index: 1;
    }

    .profile-top-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: flex-start;
    }

    .profile-avatar-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .profile-avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 2px solid #39A596;
      background: linear-gradient(135deg, #1a1a1a, #0a0a0a);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-shadow: 0 0 20px rgba(57, 165, 150, 0.25);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      cursor: pointer;
    }

    .profile-avatar:hover {
      transform: scale(1.05);
      box-shadow: 0 0 30px rgba(57, 165, 150, 0.4);
    }

    .profile-upload-prompt {
      text-align: center;
      font-size: 10px;
      color: #39A596;
      font-weight: 600;
      max-width: 120px;
      line-height: 1.3;
      letter-spacing: 0.3px;
    }

    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-avatar-placeholder {
      font-size: 40px;
      color: #39A596;
    }

    .profile-name-section {
      flex: 1;
      min-width: 200px;
    }

    .profile-name {
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .profile-personality {
      display: inline-block;
      background: linear-gradient(135deg, #39A596, #2d8578);
      color: #ffffff;
      padding: 0.3rem 0.8rem;
      border-radius: 16px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 0.8rem;
    }

    .digital-closet-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: linear-gradient(135deg, #39A596, #2d8578);
      color: #ffffff;
      padding: 0.6rem 1.2rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      box-shadow: 0 3px 12px rgba(57, 165, 150, 0.25);
      text-decoration: none;
    }

    .digital-closet-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 20px rgba(57, 165, 150, 0.4);
      background: linear-gradient(135deg, #2d8578, #39A596);
    }

    .quick-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .stat-card {
      background: rgba(10, 10, 10, 0.6);
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      padding: 0.75rem;
      text-align: center;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }

    .stat-card:hover {
      border-color: #39A596;
      background: rgba(57, 165, 150, 0.05);
      transform: translateY(-2px);
    }

    .stat-icon {
      font-size: 20px;
      margin-bottom: 0.4rem;
    }

    .stat-label {
      font-size: 10px;
      color: #888888;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .stat-value {
      font-size: 13px;
      color: #ffffff;
      font-weight: 700;
    }

    .profile-details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .detail-card {
      background: rgba(10, 10, 10, 0.4);
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      padding: 0.75rem;
      transition: all 0.3s ease;
    }

    .detail-card:hover {
      border-color: #39A596;
      background: rgba(57, 165, 150, 0.03);
    }

    .detail-label {
      font-size: 10px;
      color: #39A596;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 700;
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .detail-value {
      font-size: 13px;
      color: #ffffff;
      font-weight: 600;
    }

    .detail-icon {
      font-size: 12px;
    }
    
    /* Hidden file input for selfie upload */
    #selfieUploadInput {
      display: none;
    }

    @media (max-width: 768px) {
      .profile-top-row {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .profile-name-section {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .quick-stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .profile-details-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Handle selfie upload
    function handleSelfieUpload(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const imageData = e.target.result;
          
          // Update avatar display
          document.getElementById('avatarImage').src = imageData;
          document.getElementById('avatarImage').style.display = 'block';
          document.getElementById('avatarPlaceholder').style.display = 'none';
          
          // Save to localStorage
          const coreIdentity = JSON.parse(localStorage.getItem('mn_core_identity') || '{}');
          coreIdentity.uploadedImage = imageData;
          coreIdentity.selfieUploaded = true;
          localStorage.setItem('mn_core_identity', JSON.stringify(coreIdentity));
          
          // Show success message
          alert('✨ Selfie uploaded! Your AI stylist now has a better understanding of your style.');
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    // Load user profile data from localStorage
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const coreIdentity = localStorage.getItem('mn_core_identity');
        
        if (coreIdentity) {
          const profile = JSON.parse(coreIdentity);
          console.log('Loading profile:', profile);
          
          // Show profile section if data exists
          document.getElementById('userProfileSection').style.display = 'block';
          
          // Avatar/Profile Picture
          if (profile.uploadedImage) {
            document.getElementById('avatarImage').src = profile.uploadedImage;
            document.getElementById('avatarImage').style.display = 'block';
            document.getElementById('avatarPlaceholder').style.display = 'none';
          } else if (profile.archetype && profile.archetype.icon) {
            document.getElementById('avatarPlaceholder').textContent = profile.archetype.icon;
          }
          
          // Personality Tone
          if (profile.tone) {
            document.getElementById('personalityTone').textContent = profile.tone;
          }
          
          // Quick Stats
          if (profile.height) {
            document.getElementById('statHeight').textContent = profile.height + ' cm';
          }
          if (profile.bodyType) {
            document.getElementById('statBodyType').textContent = profile.bodyType;
          }
          if (profile.skinTone) {
            document.getElementById('statSkinTone').textContent = profile.skinTone;
          }
          if (profile.temperature || profile.climate) {
            document.getElementById('statTemperature').textContent = profile.temperature || profile.climate || '-';
          }
          if (profile.priceRange || profile.budget) {
            const priceRange = profile.priceRange || profile.budget;
            document.getElementById('statPriceRange').textContent = priceRange;
          }
          
          // Detailed Information
          if (profile.goals || profile.fashionGoals) {
            document.getElementById('detailGoals').textContent = profile.goals || profile.fashionGoals;
          }
          if (profile.favoriteColors || profile.colors) {
            const colors = profile.favoriteColors || profile.colors;
            if (Array.isArray(colors)) {
              document.getElementById('detailColors').textContent = colors.join(', ');
            } else {
              document.getElementById('detailColors').textContent = colors;
            }
          }
          
          // Closet count from localStorage
          const closetItems = localStorage.getItem('mn_closet_items');
          if (closetItems) {
            try {
              const items = JSON.parse(closetItems);
              document.getElementById('detailClosetCount').textContent = items.length + ' items';
            } catch(e) {
              document.getElementById('detailClosetCount').textContent = '0 items';
            }
          }
          
          // Location
          if (profile.location || profile.city) {
            document.getElementById('detailLocation').textContent = profile.location || profile.city;
          }
        }
      } catch (error) {
        console.error('Error loading profile data:', error);
      }
    });
  </script>


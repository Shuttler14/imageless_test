            if (emptyClosetActions) emptyClosetActions.style.display = 'flex';
          }
        } catch(err) {
          if (closet.length) {
            const counts = closet.reduce((acc, it) => {
              const c = (it.closet_section || it.category || 'Items');
              acc[c] = (acc[c] || 0) + 1;
              return acc;
            }, {});
            const top = Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,4);
            document.getElementById('detailClosetBreakdown').textContent = top.map(([s,n]) => `${n} ${s}`).join(' · ');
            if (emptyClosetActions) emptyClosetActions.style.display = 'none';
          } else {
            document.getElementById('detailClosetBreakdown').textContent = 'Upload clothing photos to see your closet breakdown';
            if (emptyClosetActions) emptyClosetActions.style.display = 'flex';
          }
        }

        // Most recent AI outfit → source from AI Stylist history / chat-generated looks
        if (history.length > 0) {

          <h2 class="text-lg font-bold text-white tracking-wide" style="font-family: 'Montserrat', sans-serif;">
            Vibe Card Collections
          </h2>

          <p class="text-xs font-semibold mt-1" style="color: #39A596; font-family: 'Montserrat', sans-serif;">
            Total Cards Earned: <span class="text-white">{{ total_items }}</span>
          </p>
        </div>
      </div>

      {% comment %}
        ------------------------------------------------

        PART A: COMPLETED HISTORY ROWS (SAGAS)

        ------------------------------------------------
      {% endcomment %}

      {% if sagas_completed > 0 %}
        {% for saga_index in (1..sagas_completed) %}
          <div class="saga-row completed">
            <div class="artifact-grid-compact">
              {% for i in (1..5) %}
                {% comment %} Calculate Array Index: (SagaNum - 1) * 5 + (SlotNum - 1) {% endcomment %}

                {% assign offset = saga_index | minus: 1 | times: 5 %}

                {% assign array_index = offset | plus: i | minus: 1 %}

                {% assign hist_img = collected_images_array[array_index] %}

                {% assign hist_title = collected_titles_array[array_index] %}

                {% assign hist_oid = collected_order_ids_array[array_index] %}

                <div
                  class="artifact-slot-mini filled"

                  onclick="openArtifactModal('{{ hist_img }}', '{{ hist_title }}', '{{ hist_oid }}')"
                >
                  {% if hist_img %}
                    <img src="{{ hist_img }}" class="w-full h-full object-contain p-1 relative z-2">

                  {% else %}
                    <span style="font-size:20px;">✅</span>
                  {% endif %}
                </div>
              {% endfor %}
            </div>

            <div class="saga-completed-badge">
              SAGA COMPLETED

              <svg
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      {% comment %}
        ------------------------------------------------

        PART B: ACTIVE MISSION OR REWARD TICKET

        ------------------------------------------------
      {% endcomment %}

      {% if reward_code != blank %}
        <div class="bg-gray-900 border border-[#39A596] rounded-lg p-4 flex flex-col items-center justify-center gap-2 relative z-2 text-center mt-4">
          <div>
            <h2 class="font-bold text-m uppercase mb-2" style="font-family: 'Montserrat', sans-serif; color: #39A596;">
              MISSION ACCOMPLISHED
            </h2>

            <h3 class="text-[#39A596] font-bold text-sm uppercase mb-0" style="font-family: 'Montserrat', sans-serif;">
              🥳Congratulations! You have unlocked your free product
            </h3>

            <p class="text-gray-400 text-[10px]" style="font-family: 'Montserrat', sans-serif;">
              Use the below coupon code to buy any T-shirt for FREE
            </p>
          </div>

          <div
            class="bg-[#39A596] text-black font-bold text-lg px-4 py-2 rounded cursor-pointer select-all shadow-lg hover:scale-105 transition-transform w-full"

            style="font-family: 'Montserrat', sans-serif;"
          >
            {{ reward_code }}
          </div>
        </div>

      {% else %}
        <div class="saga-row">
          <p class="text-[10px] text-gray-500 mb-2 uppercase tracking-wider">Current Saga</p>

          <div class="artifact-grid-compact">
            {% for i in (0..4) %}
              {% comment %} Calculate Index for Active Row: (Completed * 5) + i {% endcomment %}

              {% assign start_index = sagas_completed | times: 5 %}

              {% assign active_index = start_index | plus: i %}

              {% assign current_img = collected_images_array[active_index] %}

              {% assign current_title = collected_titles_array[active_index] %}

              {% assign current_order_id = collected_order_ids_array[active_index] %}

              <div
                class="artifact-slot-mini {% if current_img %}filled{% else %}empty{% endif %}"

                {% if current_img %}
                  onclick="openArtifactModal('{{ current_img }}', '{{ current_title }}', '{{ current_order_id }}')"
                {% endif %}
              >
                {% if current_img %}
                  <img src="{{ current_img }}" class="w-full h-full object-contain p-1 relative z-2">

                  <div class="check-badge-mini">
                    <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="4">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>

                {% else %}
                  <span class="empty-number-mini" style="font-family: 'Montserrat', sans-serif;">
                    {{- i | plus: 1 -}}
                  </span>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <div class="mt-3 relative z-2">
            <div class="progress-track-mini">
              {% assign percent = current_progress | times: 20 %}

              <div class="progress-fill-mini" style="width: {{ percent }}%"></div>
            </div>

            <div class="flex justify-between items-center mt-2">
              <span class="text-[10px] font-bold text-[#39A596]" style="font-family: 'Montserrat', sans-serif;">
                {{- percent }}%</span
              >
            </div>

            <div class="mt-2 text-center bg-[#39A596]/10 border border-[#39A596]/30 rounded-md py-2 px-3">
              <span
                class="text-[11px] text-[#39A596] font-bold tracking-wide uppercase"

                style="font-family: 'Montserrat', sans-serif;"
              >
                Buy {{ missing_count }} More Product to Unlock Your Free Product
              </span>
              <p 
                class="text-[9px] font-semibold mt-1 uppercase tracking-wider opacity-90" 
                style="font-family: 'Montserrat', sans-serif; color: #39A596;"
              >
                Order any T-shirt for free upon completing the 5 cards collection
              </p>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Closet Panel (shown inline below profile on click) -->
  <div class="mn-dashboard-panel" id="mnClosetPanel">
    <div class="mn-panel-title">
      <span>👗 My Digital Closet</span>
      <button class="mn-panel-close" onclick="togglePanel('mnClosetPanel')">✕</button>
    </div>
    <div id="mnClosetPanelContent"></div>
  </div>

  <!-- Past Looks Panel -->
  <div class="mn-dashboard-panel" id="mnHistoryPanel" style="border-color:rgba(139,92,246,0.25);">

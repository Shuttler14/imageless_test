      sun: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><circle cx=\"24\" cy=\"24\" r=\"8\" stroke=\"#F59E0B\" stroke-width=\"2\" fill=\"rgba(245,158,11,0.1)\"/><line x1=\"24\" y1=\"6\" x2=\"24\" y2=\"12\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"24\" y1=\"36\" x2=\"24\" y2=\"42\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"6\" y1=\"24\" x2=\"12\" y2=\"24\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"36\" y1=\"24\" x2=\"42\" y2=\"24\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"11\" y1=\"11\" x2=\"15\" y2=\"15\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"33\" y1=\"33\" x2=\"37\" y2=\"37\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
      cold: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M24 6v36M6 24h36M11 11l26 26M37 11L11 37\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"24\" cy=\"24\" r=\"4\" fill=\"#60A5FA\"/></svg>",
      rain: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M10 26a12 12 0 1 1 22-4H34a7 7 0 0 1 0 14H12a8 8 0 0 1-2-10z\" stroke=\"#39A596\" stroke-width=\"2\" fill=\"rgba(57,165,150,0.06)\"/><line x1=\"16\" y1=\"38\" x2=\"14\" y2=\"44\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"24\" y1=\"38\" x2=\"22\" y2=\"44\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"32\" y1=\"38\" x2=\"30\" y2=\"44\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
      neutral: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><circle cx=\"24\" cy=\"24\" r=\"14\" stroke=\"#9CA3AF\" stroke-width=\"2\" fill=\"rgba(156,163,175,0.08)\"/><line x1=\"17\" y1=\"30\" x2=\"31\" y2=\"30\" stroke=\"#9CA3AF\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"18\" cy=\"21\" r=\"2\" fill=\"#9CA3AF\"/><circle cx=\"30\" cy=\"21\" r=\"2\" fill=\"#9CA3AF\"/></svg>",
      wallet: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><rect x=\"6\" y=\"14\" width=\"36\" height=\"24\" rx=\"4\" stroke=\"#39A596\" stroke-width=\"2\" fill=\"rgba(57,165,150,0.08)\"/><path d=\"M6 22h36\" stroke=\"#39A596\" stroke-width=\"2\"/><rect x=\"30\" y=\"26\" width=\"10\" height=\"6\" rx=\"2\" stroke=\"#39A596\" stroke-width=\"1.5\" fill=\"rgba(57,165,150,0.15)\"/><circle cx=\"35\" cy=\"29\" r=\"1.5\" fill=\"#39A596\"/></svg>",
      target: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><circle cx=\"24\" cy=\"24\" r=\"16\" stroke=\"#39A596\" stroke-width=\"2\"/><circle cx=\"24\" cy=\"24\" r=\"9\" stroke=\"#39A596\" stroke-width=\"2\"/><circle cx=\"24\" cy=\"24\" r=\"3\" fill=\"#39A596\"/></svg>",
      palette: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M24 8a16 16 0 1 0 11 27\" stroke=\"#EC4899\" stroke-width=\"2\"/><circle cx=\"16\" cy=\"26\" r=\"2.5\" fill=\"#EF4444\"/><circle cx=\"20\" cy=\"18\" r=\"2.5\" fill=\"#F59E0B\"/><circle cx=\"28\" cy=\"16\" r=\"2.5\" fill=\"#10B981\"/><circle cx=\"32\" cy=\"24\" r=\"2.5\" fill=\"#3B82F6\"/><circle cx=\"35\" cy=\"34\" r=\"5\" stroke=\"#EC4899\" stroke-width=\"2\" fill=\"rgba(236,72,153,0.1)\"/></svg>",
      star: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M24 6l4.5 9 10 1.5-7.25 7 1.75 10L24 29.3l-8.75 4.2 1.75-10L9.5 16.5l10-1.5z\" stroke=\"#39A596\" stroke-width=\"2\" stroke-linejoin=\"round\" fill=\"rgba(57,165,150,0.1)\"/></svg>",
      shirt: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M16 8L6 16l6 2v22h24V18l6-2L32 8c0 0-2 6-8 6S16 8 16 8z\" stroke=\"#39A596\" stroke-width=\"2\" stroke-linejoin=\"round\" fill=\"rgba(57,165,150,0.08)\"/></svg>",
      map: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><path d=\"M24 6C17 6 12 12 12 18c0 9 12 24 12 24S36 27 36 18c0-6-5-12-12-12z\" stroke=\"#39A596\" stroke-width=\"2\" fill=\"rgba(57,165,150,0.08)\"/><circle cx=\"24\" cy=\"18\" r=\"4\" stroke=\"#39A596\" stroke-width=\"2\" fill=\"rgba(57,165,150,0.2)\"/></svg>",
      warm: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><circle cx=\"24\" cy=\"24\" r=\"14\" stroke=\"#F59E0B\" stroke-width=\"2\" fill=\"rgba(245,158,11,0.08)\"/><circle cx=\"19\" cy=\"21\" r=\"2\" fill=\"#F59E0B\"/><circle cx=\"29\" cy=\"21\" r=\"2\" fill=\"#F59E0B\"/><path d=\"M18 30c2 3 10 3 12 0\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
      cool: "<svg class=\"mn-edit-tile-svg\" viewBox=\"0 0 48 48\" fill=\"none\"><circle cx=\"24\" cy=\"24\" r=\"14\" stroke=\"#60A5FA\" stroke-width=\"2\" fill=\"rgba(96,165,250,0.08)\"/><circle cx=\"19\" cy=\"21\" r=\"2\" fill=\"#60A5FA\"/><circle cx=\"29\" cy=\"21\" r=\"2\" fill=\"#60A5FA\"/><path d=\"M18 32c2-3 10-3 12 0\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>"
    };

    let _currentField = null, _currentProfileKey = null, _isMulti = false, _selectedValues = [];

    function openEditModal(profileKey, displayElId) {
      const cfg = TILE_DATA[profileKey];
      if (!cfg) return;
      _currentField = displayElId; _currentProfileKey = profileKey;
      _isMulti = cfg.multi; _selectedValues = [];
      const p = getProfile();
      const current = _isMulti
        ? (Array.isArray(p[profileKey]) ? p[profileKey] : (p[profileKey] ? [p[profileKey]] : []))
        : (p[profileKey] || '');

      document.getElementById('mnEditModalTitle').textContent = cfg.title;
      document.getElementById('mnEditModalSub').textContent   = cfg.sub;
      document.getElementById('mnEditCustomInput').value = _isMulti ? '' : (current || '');
      document.getElementById('mnEditCustomInput').placeholder = cfg.type === 'input' ? 'Type your city or region...' : 'Or type a custom value...';
      document.getElementById('mnEditCustomInput').style.display = (cfg.type === 'input' || cfg.options.length === 0) ? '' : 'none';

      const grid = document.getElementById('mnEditChipGrid');
      grid.innerHTML = '';
      _selectedValues = _isMulti ? [...current] : [];

      if (cfg.type === 'mst') {
        // Skin tone: large swatch circles + MST number
        grid.style.gridTemplateColumns = '1fr';
        const row = document.createElement('div');
        row.className = 'mn-edit-mst-row';
        cfg.options.forEach(opt => {
          const sw = document.createElement('div');
          sw.className = 'mn-edit-mst-swatch' + (current === opt.val ? ' selected' : '');
          sw.style.cssText = 'background:' + opt.hex + ';position:relative';
          sw.title = 'MST ' + opt.mst + ' — ' + opt.label;
          const num = document.createElement('span');
          num.style.cssText = 'position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);font-size:8px;color:rgba(255,255,255,0.45);white-space:nowrap;font-weight:700';
          num.textContent = opt.mst;
          sw.appendChild(num);
          sw.addEventListener('click', () => {
            row.querySelectorAll('.mn-edit-mst-swatch').forEach(s => s.classList.remove('selected'));
            sw.classList.add('selected');
            document.getElementById('mnEditCustomInput').style.display = '';
            document.getElementById('mnEditCustomInput').value = opt.val;
          });
          row.appendChild(sw);
        });
        grid.appendChild(row);
        const swatchLabel = document.createElement('div');
        swatchLabel.style.cssText = 'font-size:11px;color:rgba(255,255,255,0.4);text-align:center;margin-top:26px;margin-bottom:4px';
        swatchLabel.textContent = 'Tap your skin tone above';
        grid.appendChild(swatchLabel);
        grid.style.gridTemplateColumns = '';
        document.getElementById('mnEditCustomInput').style.display = 'none';

      } else if (cfg.type === 'colors') {
        // Colors: 2-column color swatch + name tiles
        grid.style.gridTemplateColumns = '1fr 1fr';
        cfg.options.forEach(opt => {
          const tile = document.createElement('div');
          const sel = _isMulti ? current.includes(opt.val) : current === opt.val;
          tile.className = 'mn-edit-color-tile' + (sel ? ' selected' : '');
          tile.innerHTML = '<div class="mn-edit-color-swatch" style="background:' + opt.hex + '"></div><span class="mn-edit-color-name">' + opt.label + '</span>';
          if (_isMulti && sel) _selectedValues.push(opt.val);
          tile.addEventListener('click', () => {
            if (_isMulti) {
              tile.classList.toggle('selected');
              if (tile.classList.contains('selected')) { if (!_selectedValues.includes(opt.val)) _selectedValues.push(opt.val); }
              else { _selectedValues = _selectedValues.filter(v => v !== opt.val); }
            } else {
              grid.querySelectorAll('.mn-edit-color-tile').forEach(t => t.classList.remove('selected'));
              tile.classList.add('selected');
              document.getElementById('mnEditCustomInput').value = opt.val;
            }
          });
          grid.appendChild(tile);
        });
        document.getElementById('mnEditCustomInput').style.display = 'none';


      } else if (cfg.type === 'height_slider') {
        grid.style.gridTemplateColumns = '1fr';
        document.getElementById('mnEditCustomInput').style.display = 'none';
        const curH = parseInt(p['height']) || 170;
        const toFt = cm => { const i = Math.round(cm/2.54); return Math.floor(i/12)+"'"+i%12+'"'; };
        grid.innerHTML = '<div style="text-align:center;margin-bottom:20px">' +
          '<div style="font-size:52px;font-weight:900;color:#fff;letter-spacing:-0.04em" id="mnHSliderVal">' + curH + '</div>' +
          '<div style="font-size:14px;color:#39A596;font-weight:700" id="mnHSliderFt">' + toFt(curH) + '</div>' +
          '<div style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:4px">cm</div></div>' +
          '<input type="range" id="mnHeightSlider" min="140" max="220" value="' + curH + '" step="1" style="width:100%;-webkit-appearance:none;height:6px;border-radius:99px;background:linear-gradient(90deg,#39A596 ' + Math.round(((curH-140)/80)*100) + '%,rgba(255,255,255,0.1) 0);outline:none;cursor:pointer;margin:10px 0"/>' +
          '<div style="display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,0.35);margin-top:6px"><span>140cm</span><span>220cm</span></div>' +
          '<style>#mnHeightSlider::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:#39A596;cursor:pointer;box-shadow:0 0 14px rgba(57,165,150,0.6);border:2px solid rgba(255,255,255,0.2)}</style>';
        const sl = grid.querySelector('#mnHeightSlider');
        const vd = grid.querySelector('#mnHSliderVal');
        const fd = grid.querySelector('#mnHSliderFt');
        if (sl) sl.addEventListener('input', function() {
          const v = parseInt(this.value);
          vd.textContent = v; fd.textContent = toFt(v);
          this.style.background = 'linear-gradient(90deg,#39A596 ' + Math.round(((v-140)/80)*100) + '%,rgba(255,255,255,0.1) 0)';
          _selectedValues = [v + ' cm'];
        });
        _selectedValues = [curH + ' cm'];

      } else if (cfg.type === 'budget_slider') {
        grid.style.gridTemplateColumns = '1fr';
        document.getElementById('mnEditCustomInput').style.display = 'none';
        const pStr = (p['budget'] || '').replace(/[^0-9,]/g,'').split(',');
        let minV = parseInt(pStr[0]) || 1000, maxV = parseInt(pStr[1]) || 8000;
        const toDisp = v => v >= 1000 ? '₹' + (v/1000).toFixed(v%1000===0?0:1) + 'K' : '₹' + v;
        const presets = [{l:'Under ₹1K',mn:500,mx:1000},{l:'₹1K–3K',mn:1000,mx:3000},{l:'₹3K–7K',mn:3000,mx:7000},{l:'₹7K–15K',mn:7000,mx:15000},{l:'₹15K–30K',mn:15000,mx:30000},{l:'₹30K+',mn:30000,mx:50000}];
        grid.innerHTML = '<div style="text-align:center;margin-bottom:16px">' +
          '<div style="font-size:24px;font-weight:900;color:#39A596" id="mnBudgetDisp">' + toDisp(minV) + ' – ' + toDisp(maxV) + '</div>' +
          '<div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px">per outfit</div></div>' +
          '<div style="position:relative;height:6px;background:rgba(255,255,255,0.1);border-radius:99px;margin:24px 0 8px">' +
          '<div id="mnBFill" style="position:absolute;height:100%;background:linear-gradient(90deg,#39A596,#2dd4bf);border-radius:99px"></div>' +
          '<input type="range" id="mnBMin" min="500" max="50000" value="'+minV+'" step="500" style="position:absolute;width:100%;-webkit-appearance:none;background:transparent;height:6px;pointer-events:none;top:0;margin:0"/>' +
          '<input type="range" id="mnBMax" min="500" max="50000" value="'+maxV+'" step="500" style="position:absolute;width:100%;-webkit-appearance:none;background:transparent;height:6px;pointer-events:none;top:0;margin:0"/>' +
          '<style>#mnBMin::-webkit-slider-thumb,#mnBMax::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:#39A596;cursor:pointer;pointer-events:all;box-shadow:0 0 10px rgba(57,165,150,0.5)}</style></div>' +
          '<div style="display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,0.35);margin-bottom:20px"><span>₹500</span><span>₹50K+</span></div>' +
          '<div style="display:flex;flex-wrap:wrap;gap:6px">' + presets.map(pr => '<button onclick="mnBPreset('+pr.mn+','+pr.mx+')" style="font-size:11px;font-weight:700;padding:6px 12px;border-radius:99px;border:1.5px solid rgba(255,255,255,0.1);background:transparent;color:rgba(255,255,255,0.5);cursor:pointer;font-family:Montserrat,sans-serif;transition:all 0.2s" onmouseover="this.style.borderColor='#39A596';this.style.color='#39A596'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.5)'">' + pr.l + '</button>').join('') + '</div>';
        
        window.mnBPreset = function(mn,mx) {
          document.getElementById('mnBMin').value = mn;
          document.getElementById('mnBMax').value = mx;
          mnUpdateBudget();
        };
        function mnUpdateBudget() {
          let mn = parseInt(document.getElementById('mnBMin').value);
          let mx = parseInt(document.getElementById('mnBMax').value);
          if (mn > mx) { const t=mn; mn=mx; mx=t; }
          document.getElementById('mnBudgetDisp').textContent = toDisp(mn) + ' – ' + toDisp(mx);
          const total = 50000-500;
          const lp = ((mn-500)/total)*100, rp = ((mx-500)/total)*100;
          const fill = document.getElementById('mnBFill');
          if (fill) { fill.style.left=lp+'%'; fill.style.width=(rp-lp)+'%'; }
          _selectedValues = ['₹'+mn.toLocaleString('en-IN')+'–₹'+mx.toLocaleString('en-IN')];
        }
        grid.querySelector('#mnBMin').addEventListener('input', mnUpdateBudget);
        grid.querySelector('#mnBMax').addEventListener('input', mnUpdateBudget);
        mnUpdateBudget();

      } else if (cfg.type !== 'input') {
        // SVG vector tiles — 2-column side-by-side
        grid.style.gridTemplateColumns = '1fr 1fr';
        cfg.options.forEach(opt => {
          const tile = document.createElement('div');
          const sel = _isMulti ? current.includes(opt.val) : current === opt.val;
          tile.className = 'mn-edit-option-tile' + (sel ? ' selected' : '');
          // Distinct emoji+color tile per category
          const clr = opt.color || '#39A596'; const emo = opt.emoji || '◆';
          tile.style.background = 'linear-gradient(135deg,' + clr + '18,' + clr + '06)';
          tile.style.borderColor = clr + '45';
          tile.innerHTML = '<div class="mn-edit-tile-emoji" style="background:' + clr + '25;color:' + clr + '">' + emo + '</div><div class="mn-edit-tile-label">' + opt.label + '</div>' + (opt.sub ? '<div class="mn-edit-tile-sub">' + opt.sub + '</div>' : '');
          if (_isMulti && sel) _selectedValues.push(opt.val);
          tile.addEventListener('click', () => {
            if (_isMulti) {
              tile.classList.toggle('selected');
              if (tile.classList.contains('selected')) { if (!_selectedValues.includes(opt.val)) _selectedValues.push(opt.val); }
              else { _selectedValues = _selectedValues.filter(v => v !== opt.val); }
            } else {
              grid.querySelectorAll('.mn-edit-option-tile').forEach(t => t.classList.remove('selected'));
              tile.classList.add('selected');
            }
          });
          grid.appendChild(tile);
        });
      }
      document.getElementById('mnEditModalOverlay').classList.add('active');
    }

function closeEditModal() { document.getElementById('mnEditModalOverlay').classList.remove('active'); }

    document.getElementById('mnEditCancelBtn').addEventListener('click', closeEditModal);
    document.getElementById('mnEditModalOverlay').addEventListener('click', function(e) { if (e.target === this) closeEditModal(); });

    document.getElementById('mnEditSaveBtn').addEventListener('click', function() {
      const p = getProfile();
      const customVal = document.getElementById('mnEditCustomInput').value.trim();
      if (_isMulti) {
        if (customVal) { _selectedValues = [...new Set([..._selectedValues, ...customVal.split(',').map(s => s.trim()).filter(Boolean)])]; }
        p[_currentProfileKey] = _selectedValues;
        const el = document.getElementById(_currentField);
        if (el) el.textContent = _selectedValues.join(', ') || '-';
      } else {
        // Get value from: custom input, or selected tile, or selected color tile, or selected mst swatch
        const selTile  = document.querySelector('#mnEditChipGrid .mn-edit-option-tile.selected');
        const selColor = document.querySelector('#mnEditChipGrid .mn-edit-color-tile.selected');
        const selMST   = document.querySelector('#mnEditChipGrid .mn-edit-mst-swatch.selected');
        const selChip  = document.querySelector('#mnEditChipGrid .mn-edit-chip.selected');
        // For tiles, find the val from TILE_DATA by matching label
        let val = customVal;
        if (!val && selTile) {
          const label = selTile.querySelector('.mn-edit-tile-label')?.textContent || '';
          const cfg = TILE_DATA[_currentProfileKey];
          const found = cfg && cfg.options.find(o => o.label === label);
          val = found ? found.val : label;
        }
        if (!val && selColor) { val = selColor.querySelector('.mn-edit-color-name')?.textContent || ''; }
        if (!val && selMST)   { val = document.getElementById('mnEditCustomInput').value.trim(); }
        // Height slider
        if (!val && _currentProfileKey === 'height' && document.getElementById('mnHeightSlider')) {
          val = document.getElementById('mnHeightSlider').value + ' cm';
        }
        // Budget slider
        if (!val && _currentProfileKey === 'budget' && _selectedValues.length) { val = _selectedValues[0]; }
        if (!val && selChip)  { val = selChip.textContent || ''; }
        p[_currentProfileKey] = val;
        const el = document.getElementById(_currentField);
        if (el) el.textContent = val || '-';
      }
      saveProfile(p);
      closeEditModal();
    });

    // ─── Closet Panel ─────────────────────────────────────────
    function togglePanel(panelId) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      const isActive = panel.classList.contains('active');
      document.querySelectorAll('.mn-dashboard-panel').forEach(p => p.classList.remove('active'));
      if (!isActive) panel.classList.add('active');
    }

    function renderClosetPanel() {
      const closet = getCloset();
      const container = document.getElementById('mnClosetPanelContent');
      if (!container) return;
      if (closet.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No items yet — upload clothing photos in the AI Stylist</p>';
        return;
      }
      // Group by section
      const sections = {};
      closet.forEach(item => {
        const s = item.closet_section || item.category || 'Other';
        if (!sections[s]) sections[s] = [];
        sections[s].push(item);
      });
      let html = '';
      Object.entries(sections).forEach(([section, items]) => {
        html += `<div class="mn-panel-section-label">${section} <span style="opacity:0.5;">(${items.length})</span></div>`;
        html += '<div class="mn-panel-closet-grid">';
        items.forEach(item => {
          const emoji = getItemEmoji(item);
          const name  = item.original_name || item.name || 'Item';
          const meta  = [item.color, item.fabric].filter(Boolean).join(' · ');
          html += `<div class="mn-panel-closet-card">
            <div class="mn-panel-closet-emoji">${emoji}</div>
            <div class="mn-panel-closet-name">${name}</div>
            ${meta ? `<div class="mn-panel-closet-meta">${meta}</div>` : ''}
          </div>`;
        });
        html += '</div>';
      });
      container.innerHTML = html;
    }

    function renderHistoryPanel() {
      const history = getHistory();
      const container = document.getElementById('mnHistoryPanelContent');
      if (!container) return;
      if (history.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No outfits generated yet — open the AI Stylist to create your first look</p>';
        return;
      }
      let html = '';
      history.slice(0, 10).forEach(look => {
        const date = look.savedAt ? new Date(look.savedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '';
        const pieces = (look.outfit_pieces || []);
        html += `<div class="mn-panel-look-card">
          <div class="mn-panel-look-date">${date}</div>
          <div class="mn-panel-look-direction">${look.direction || look.context || 'AI Generated Outfit'}</div>
          <div class="mn-panel-look-pieces">
            ${pieces.map(p => `<span class="mn-panel-look-piece ${p.owned ? 'owned' : ''}">${getItemEmoji(p)} ${p.name || ''}</span>`).join('')}
          </div>
        </div>`;
      });
      container.innerHTML = html;
    }

    // ─── Load & Render ────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const profile = getProfile();
        const closet  = getCloset();
        const history = getHistory();

        document.getElementById('userProfileSection').style.display = 'block';

        // Avatar
        if (profile.uploadedImage) {
          document.getElementById('avatarImage').src = profile.uploadedImage;
          document.getElementById('avatarImage').style.display = 'block';
          document.getElementById('avatarPlaceholder').style.display = 'none';
        } else if (profile.archetype?.icon) {
          document.getElementById('avatarPlaceholder').textContent = profile.archetype.icon;
        }

        // Personality badge
        document.getElementById('personalityTone').textContent = profile.tone || profile.coreExpression || 'Style Explorer';

        // Quick stats
        document.getElementById('statHeight').textContent       = profile.height ? profile.height + '' : '-';
        document.getElementById('statBodyType').textContent     = profile.build || profile.bodyType || '-';
        document.getElementById('statSkinTone').textContent     = profile.skinTone || '-';
        document.getElementById('statTemperature').textContent  = profile.climate || profile.temperature || '-';
        document.getElementById('statPriceRange').textContent   = profile.budget || profile.priceRange || '-';
        document.getElementById('statClosetItems').textContent  = closet.length + ' items';
        document.getElementById('statOutfitsSaved').textContent = history.length + ' looks';

        // Detail cards
        document.getElementById('detailGoals').textContent    = profile.goals || profile.fashionGoals || profile.signal || '-';
        const colors = profile.favoriteColors || profile.colors;
        document.getElementById('detailColors').textContent   = Array.isArray(colors) ? colors.join(', ') : (colors || '-');
        document.getElementById('detailStyle').textContent    = profile.coreExpression || profile.style || '-';
        document.getElementById('detailOccasion').textContent = profile.occasion || (Array.isArray(profile.contexts) ? profile.contexts.join(', ') : '-');
        document.getElementById('detailRegion').textContent   = profile.region || profile.location || profile.city || '-';
        document.getElementById('detailUndertone').textContent = profile.undertone || '-';

        // Closet breakdown
        if (closet.length > 0) {
          const sections = {};
          closet.forEach(i => { const s = i.closet_section || i.category || 'Other'; sections[s] = (sections[s]||0)+1; });
          document.getElementById('detailClosetBreakdown').textContent = Object.entries(sections).map(([s,n])=>n+' '+s).join(' · ') || '-';
        }

        // Most recent outfit
        if (history.length > 0) {
          const last = history[0];
          document.getElementById('detailLastOutfit').textContent = last.direction || last.context || last.occasion || '-';
        }

        // Wire stat cards to edit modal
        const editMap = [
          ['statHeight','height'],['statBodyType','build'],['statSkinTone','skinTone'],
          ['statTemperature','climate'],['statPriceRange','budget']
        ];
        editMap.forEach(([elId, key]) => {
          const el = document.getElementById(elId);
          if (el) el.addEventListener('click', () => openEditModal(key, elId));
        });

        // Wire detail cards to edit modal
        const detailMap = [
          ['detailGoals','goals'],['detailColors','favoriteColors'],['detailStyle','coreExpression'],
          ['detailOccasion','occasion'],['detailRegion','region'],['detailUndertone','undertone']
        ];
        detailMap.forEach(([elId, key]) => {
          const el = document.getElementById(elId);
          if (el) el.addEventListener('click', () => openEditModal(key, elId));
        });

        // Wire Digital Closet stat card → show closet panel
        const closetStatCard = document.getElementById('statClosetItems');
        if (closetStatCard) {
          closetStatCard.parentElement.addEventListener('click', () => {
            renderClosetPanel();
            togglePanel('mnClosetPanel');
          });
        }

        // Wire Outfits Saved stat card → show history panel
        const histStatCard = document.getElementById('statOutfitsSaved');
        if (histStatCard) {
          histStatCard.parentElement.addEventListener('click', () => {
            renderHistoryPanel();
            togglePanel('mnHistoryPanel');
          });
        }

      } catch (error) {
        console.error('Error loading AI Stylist profile:', error);
      }

      // Handle arrival from widget profile ring ? /account?mn_focus=profile
      mnHandleWidgetArrival();
    });

    // Avatar pulse animation keyframe (injected once at runtime)
    (function() {
      const s = document.createElement('style');
      s.textContent = '@keyframes mnAvatarPulse { 0%{box-shadow:0 0 0 0 rgba(57,165,150,0.7)} 70%{box-shadow:0 0 0 14px rgba(57,165,150,0)} 100%{box-shadow:0 0 0 0 rgba(57,165,150,0)} }';
      document.head.appendChild(s);
    })();
  </script>


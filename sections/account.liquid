      'Sneakers':'\uD83D\uDC5F','Shoes':'\uD83D\uDC5E','Boots':'\uD83E\uDD7E','Bag':'\uD83D\uDC5C',
      'Watch':'\u231A','Cap':'\uD83E\uDDE2','Hat':'\uD83C\uDFA9','Scarf':'\uD83E\uDDE3','default':'\uD83D\uDC55'
    };
    function getItemEmoji(item) {
      const name = (item.name||item.original_name||item.label||'').trim();
      const lookup = k => Object.keys(GARMENT_EMOJI_MAP).find(key => key.toLowerCase() === k.toLowerCase());
      const direct = lookup(name); if (direct) return GARMENT_EMOJI_MAP[direct];
      for (const word of name.split(/\s+/)) { const m = lookup(word); if (m) return GARMENT_EMOJI_MAP[m]; }
      const section = item.closet_section || item.category || '';
      return GARMENT_EMOJI_MAP[section] || GARMENT_EMOJI_MAP.default;
    }

// ─── Selfie Upload ────────────────────────────────────────
    // -- Magic Upload: POST to AI API, auto-fill all stat/detail cards --
    async function handleSelfieUpload(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = async function(e) {
        const imageData = e.target.result;
        const raw_b64   = imageData.replace(/^data:image\/\w+;base64,/, '');

        // Show avatar immediately
        document.getElementById('avatarImage').src = imageData;
        document.getElementById('avatarImage').style.display = 'block';
        document.getElementById('avatarPlaceholder').style.display = 'none';

        // Loading state
        const avatar      = document.getElementById('profileAvatar');
        const uploadPrompt = document.querySelector('.profile-upload-prompt');
        if (avatar)       { avatar.style.opacity = '0.6'; avatar.style.pointerEvents = 'none'; }
        if (uploadPrompt)  uploadPrompt.textContent = '⚡ AI is analysing your style...';

        // Use advanced analysis with 20-30 hidden data points
        await mnAnalyzePhotoAdvanced(raw_b64);

        if (avatar) { avatar.style.opacity = '1'; avatar.style.pointerEvents = ''; }
        input.value = '';
      };
      reader.readAsDataURL(file);
    }

    // -- Refresh all stat/detail card DOM values from profile object --
    function mnSetDisplayValue(id, value, emptyLabel = '') {
      const el = document.getElementById(id);
      if (!el) return;
      const normalized = Array.isArray(value) ? value.filter(Boolean).join(', ') : (value || '');
      el.textContent = normalized || emptyLabel;
      el.classList.toggle('is-empty', !normalized);
    }

    function mnSetActionLabel(buttonId, value) {
      const btn = document.getElementById(buttonId);
      if (!btn) return;
      const hasValue = Array.isArray(value) ? value.filter(Boolean).length > 0 : !!value;
      const label = btn.querySelector('.mn-card-action-label');
      if (label) label.textContent = hasValue ? 'Edit' : 'Select';
    }

    function mnReplaceHeadingIcons() {
      const map = {
        statHeight: '📏',
        statBodyType: '💪',
        statSkinTone: '🎨',
        statTemperature: '🌤️',
        statPriceRange: '💸',
        detailGoals: '🎯',
        detailColors: '🌈',
        detailStyle: '🧭',
        detailOccasion: '📍',
        detailRegion: '🗺️',
        detailClosetBreakdown: '👕',
        detailLastOutfit: '✨',
        statClosetItems: '👚',
        statOutfitsSaved: '🪄',
        detailInterests: '💡',
        detailClosetMode: '🧵'
      };
      Object.entries(map).forEach(([id, icon]) => {
        const val = document.getElementById(id);
        if (!val) return;
        const card = val.closest('.stat-card, .detail-card');
        if (!card) return;
        const iconEl = card.querySelector('.stat-icon, .detail-icon');
        if (iconEl) {
          iconEl.innerHTML = '';
          iconEl.textContent = icon;
        }
      });
    }

    function mnRefreshStatCards(profile) {
      mnSetDisplayValue('statHeight', profile.height);
      mnSetDisplayValue('statBodyType', profile.build || profile.bodyType);
      mnSetDisplayValue('statSkinTone', profile.skinTone);
      mnSetDisplayValue('statTemperature', profile.climate);
      mnSetDisplayValue('statPriceRange', profile.budget);
      mnSetDisplayValue('detailGoals', profile.goals);
      mnSetDisplayValue('detailStyle', profile.coreExpression);
      mnSetDisplayValue('detailOccasion', profile.occasion);
      mnSetDisplayValue('detailRegion', profile.location || profile.region);
      const colors = profile.favoriteColors;
      mnSetDisplayValue('detailColors', Array.isArray(colors) ? colors.join(', ') : colors);

      mnSetActionLabel('editStatHeight', profile.height);
      mnSetActionLabel('editStatBodyType', profile.build || profile.bodyType);
      mnSetActionLabel('editStatSkinTone', profile.skinTone);
      mnSetActionLabel('editStatTemperature', profile.climate || profile.temperature);
      mnSetActionLabel('editStatPriceRange', profile.budget || profile.priceRange);
      mnSetActionLabel('editDetailGoals', profile.goals);
      mnSetActionLabel('editDetailColors', colors);
      mnSetActionLabel('editDetailOccasion', profile.occasion);
      mnReplaceHeadingIcons();
    }

    // -- Handle arrival from widget profile ring click --
    function mnHandleWidgetArrival() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('mn_focus') !== 'profile') return;
      window.history.replaceState({}, '', window.location.pathname);

      setTimeout(() => {
        const sec = document.getElementById('userProfileSection');
        if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 200);

      const profile = getProfile();
      if (!profile.selfieUploaded && !profile.uploadedImage) {
        setTimeout(() => {
          const avatar       = document.getElementById('profileAvatar');
          const uploadPrompt = document.querySelector('.profile-upload-prompt');
          if (avatar) {
            avatar.style.animation = 'mnAvatarPulse 1.2s ease-in-out 4';
            avatar.style.border    = '2.5px solid #39A596';
          }
          if (uploadPrompt) {
            uploadPrompt.textContent  = '?? Upload photo � AI fills everything!';
            uploadPrompt.style.color  = '#39A596';
            uploadPrompt.style.fontWeight = '800';
          }
          // Auto-open file picker
          setTimeout(() => document.getElementById('selfieUploadInput').click(), 1500);
          setTimeout(() => {
            if (avatar) avatar.style.animation = '';
            if (uploadPrompt) { uploadPrompt.textContent = '?? Click to update photo'; uploadPrompt.style.fontWeight = ''; }
          }, 5500);
        }, 600);
      }
    }

    // -- Chatbot ? Dashboard live sync --
    window.addEventListener('mn-chatbot-save', function(e) {
      if (!e.detail) return;
      const updates = e.detail;
      const p = getProfile();
      // Core visible fields
      if (updates.height_cm)     p.height         = updates.height_cm + ' cm';
      if (updates.preferred_fit) p.build          = updates.preferred_fit;
      if (updates.skin_label)    p.skinTone       = updates.skin_label;
      if (updates.hair_style)    p.hairStyle      = updates.hair_style;
      if (updates.gender)        p.gender         = updates.gender;
      if (updates.weather && updates.weather.city) p.climate = updates.weather.city + (updates.weather.temp ? ' ' + Math.round(updates.weather.temp) + '�C' : '');
      if (updates.price_min && updates.price_max)  p.budget  = '?' + Number(updates.price_min).toLocaleString('en-IN') + '�?' + Number(updates.price_max).toLocaleString('en-IN');
      if (updates.style_vibes && updates.style_vibes.length) p.coreExpression = updates.style_vibes.join(', ');
      if (updates.occasions   && updates.occasions.length)   p.occasion       = updates.occasions.join(', ');
      if (updates.ai_metrics)    p.ai_metrics = Object.assign(p.ai_metrics || {}, updates.ai_metrics);
      // Physique analysis fields from widget mnSyncPhysiqueAnalysis
      if (updates.skin_mst)         p.skinMST        = updates.skin_mst;
      if (updates.face_shape)       p.faceShape      = updates.face_shape;
      if (updates.eye_color)        p.eyeColor       = updates.eye_color;
      if (updates.hair_color)       p.hairColor      = updates.hair_color;
      if (updates.hair_texture)     p.hairTexture    = updates.hair_texture;
      if (updates.seasonal_color)   p.seasonalColor  = updates.seasonal_color;
      if (updates.style_archetype)  p.styleArchetype = updates.style_archetype;
      if (updates.age_range)        p.ageRange       = updates.age_range;
      if (updates.body_composition) p.bodyComposition= updates.body_composition;
      if (updates.ai_confidence)    p.aiConfidence   = updates.ai_confidence;
      // Store all hidden data for AI recommendations context
      if (window.MN_USER) {
        window.MN_USER.hidden_data = Object.assign(window.MN_USER.hidden_data || {}, updates);
      }
      p.chatbot_synced_at = new Date().toISOString();
      p.ai_analyzed = true;
      mnRefreshStatCards(p);
      if (typeof mnUpdateProgress === 'function') mnUpdateProgress(p);
      saveProfile(p);
    });

    // -- Cross-tab storage sync (chatbot widget open in another tab) --
    window.addEventListener('storage', function(e) {
      if (e.key === 'mn_identity' && e.newValue) {
        try {
          const src = JSON.parse(e.newValue);
          const p   = getProfile();
          if (src.height_cm)     p.height         = src.height_cm + ' cm';
          if (src.preferred_fit) p.build          = src.preferred_fit;
          if (src.skin_label)    p.skinTone       = src.skin_label;
          if (src.style_vibes && src.style_vibes.length) p.coreExpression = src.style_vibes.join(', ');
          if (src.occasions   && src.occasions.length)   p.occasion       = src.occasions.join(', ');
          if (src.price_min && src.price_max) p.budget = '?' + Number(src.price_min).toLocaleString('en-IN') + '�?' + Number(src.price_max).toLocaleString('en-IN');
          mnRefreshStatCards(p);
          localStorage.setItem('mn_core_identity', JSON.stringify(p));
        } catch(err) {}
      }
      if (e.key === 'mn_core_identity' && e.newValue) {
        try { mnRefreshStatCards(JSON.parse(e.newValue)); } catch(err) {}
      }
    });


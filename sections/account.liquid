      s.textContent = '@keyframes mnAvatarPulse { 0%{box-shadow:0 0 0 0 rgba(57,165,150,0.7)} 70%{box-shadow:0 0 0 14px rgba(57,165,150,0)} 100%{box-shadow:0 0 0 0 rgba(57,165,150,0)} }';
      document.head.appendChild(s);

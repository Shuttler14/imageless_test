          const data   = await resp.json();
          const remoteItems = (data.success && Array.isArray(data.items)) ? data.items : [];
          const closetItems = remoteItems.length ? remoteItems : closet;

          if (closetItems.length) {
            const counts = closetItems.reduce((acc, it) => {
              const c = (it.closet_section || it.category || 'Items');
              acc[c] = (acc[c] || 0) + 1;
              return acc;
            }, {});
            const top = Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,4);
            document.getElementById('detailClosetBreakdown').textContent = top.map(([s,n]) => `${n} ${s}`).join(' · ');
            if (emptyClosetActions) emptyClosetActions.style.display = 'none';

          const cfg = TILE_DATA[_currentProfileKey];
          const found = cfg && cfg.options.find(o => o.label === label);
          val = found ? found.val : label;
        }
        if (!val && selColor) { val = selColor.querySelector('.mn-edit-color-name')?.textContent || ''; }
        if (!val && selMST)   { val = document.getElementById('mnEditCustomInput').value.trim(); }
        // Height slider
        if (!val && _currentProfileKey === 'height' && document.getElementById('mnHeightSlider')) {
          val = document.getElementById('mnHeightSlider').value + ' cm';

<style>
  /* Define the color once here */

  :root {

    --brand-teal: #39A596;

    --brand-teal-rgb: 57, 165, 150;

  }


  /* These classes use !important to override any theme defaults */

  .brand-text { color: var(--brand-teal) !important; }

  .brand-bg { background-color: var(--brand-teal) !important; }

  .brand-border { border-color: var(--brand-teal) !important; }


  /* --- BUTTON FIX START --- */

  .brand-btn {

    background-color: var(--brand-teal) !important;

    color: white !important;

    border: 1px solid var(--brand-teal) !important;

  }

  .brand-btn:hover {

    background-color: white !important;

    color: var(--brand-teal) !important; /* Text turns Green on hover */

  }

  /* --- BUTTON FIX END --- */


  /* Specific fix for the 'View Card' button */

  .view-card-btn {

    color: var(--brand-teal) !important;

    font-weight: bold;

    text-transform: uppercase;

    font-size: 0.75rem;

    letter-spacing: 0.05em;

  }

  .view-card-btn:hover {

    color: white !important;

  }


  /* Specific fix for links */

  .order-link {

    color: var(--brand-teal) !important;

    font-weight: bold;

  }
</style>

<div class="flex flex-col gap-8">

    // =====================================================
    // AI STYLIST DASHBOARD - PROGRESS TRACKING & SYNC
    // =====================================================
    
    // MN_USER Global State
    window.MN_USER = window.MN_USER || {
      hidden_data: {},
      bank_cards: [],
      ghost_mode: false,
      photo_analysis_history: [],
      completion_pct: 0
    };

    // Profile completion fields
    const PROFILE_FIELDS = [
      'uploadedImage', 'height', 'build', 'skinTone', 'skinMST', 
      'hairStyle', 'gender', 'climate', 'budget', 'goals',
      'coreExpression', 'occasion', 'favoriteColors', 'location'
    ];

    // Calculate completion percentage
    function mnCalculateCompletion(profile) {
      let filled = 0;
      PROFILE_FIELDS.forEach(field => {
        if (profile[field] && profile[field] !== '' && profile[field] !== '-') {
          filled++;
        }
      });
      return Math.round((filled / PROFILE_FIELDS.length) * 100);
    }

    // Update progress rings
    function mnUpdateProgress(profile) {
      const pct = mnCalculateCompletion(profile);
      window.MN_USER.completion_pct = pct;
      
      // Circular progress ring
      const ringFill = document.querySelector('.mn-progress-ring-fill');
      if (ringFill) {
        const circumference = 326.73;
        const offset = circumference - (pct / 100) * circumference;
        ringFill.style.strokeDashoffset = offset;
      }
      
      // Circular percentage display
      const pctDisplay = document.querySelector('.mn-progress-percentage');
      if (pctDisplay) {
        pctDisplay.innerHTML = pct + '<span>%</span>';
      }
      
      // Linear progress bar
      const linearFill = document.querySelector('.mn-linear-progress-fill');
      if (linearFill) {
        linearFill.style.width = pct + '%';
      }
      
      const linearValue = document.querySelector('.mn-linear-progress-value');
      if (linearValue) {
        linearValue.textContent = pct + '% Complete';
      }
      
      return pct;
    }

    // Debounced save to Supabase
    let mnSaveTimeout;
    function mnDebouncedSave() {
      clearTimeout(mnSaveTimeout);
      mnSaveTimeout = setTimeout(async () => {
        await mnSaveToSupabase();
      }, 1500);
    }

    // Save to Supabase
    async function mnSaveToSupabase() {
      const profile = getProfile();
      const userId = '{{ customer.id }}' || 'guest';
      
      try {
        const res = await fetch('https://drishti-api-blond.vercel.app/api/user_profile/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            profile: profile,
            hidden_data: window.MN_USER.hidden_data,
            bank_cards: window.MN_USER.bank_cards,
            completion_pct: window.MN_USER.completion_pct,
            ghost_mode: window.MN_USER.ghost_mode
          })
        });
        const data = await res.json();
        if (data.success) {
          console.log('[MN] Profile synced to Supabase');
        }
      } catch(err) {
        console.warn('[MN] Supabase sync failed, using localStorage:', err);
      }
    }

    // =====================================================
    // COMPREHENSIVE AI ANALYSIS - 20-30 HIDDEN DATA POINTS
    // =====================================================
    
    async function mnAnalyzePhotoAdvanced(base64Image) {
      // Show loading state
      const loadingEl = document.getElementById('mnAILoading');
      if (loadingEl) loadingEl.classList.add('active');
      
      // Use configurable physique API URL or default to local dev
      const PHYSIQUE_API_URL = (window.MN_CONFIG && window.MN_CONFIG.physiqueApiUrl) || 'https://drishti-api-blond.vercel.app/api/physique_analyze';
      const userId = '{{ customer.id }}' || 'guest';
      
      try {
        const res = await fetch(PHYSIQUE_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            image_base64: base64Image,
            save_to_profile: true
          })
        });
        
        let data = {};
        if (res.ok) data = await res.json();
        
        // Map physique_analysis API response to profile fields
        const bodyMetrics = data.body_metrics || {};
        const skinTone = data.skin_tone || {};
        const hairAnalysis = data.hair_analysis || {};
        const facialAnalysis = data.facial_analysis || {};
        const overallAppearance = data.overall_appearance || {};
        
        // Map undertone to dashboard options
        const undertoneMap = { 
          warm: 'Warm (yellow/golden)', 
          cool: 'Cool (pink/red)', 
          neutral: 'Neutral' 
        };
        
        // Map body type to dashboard labels
        const bodyTypeMap = { 
          mesomorph: 'Athletic', 
          ectomorph: 'Slim', 
          endomorph: 'Curvy' 
        };
        
        // Extract all 25+ hidden data points from structured API response
        const hiddenMetrics = {
          // Body metrics from API
          height_cm: bodyMetrics.estimated_height_cm || null,
          body_type: bodyMetrics.body_type || null,
          body_composition: bodyMetrics.body_composition || null,
          
          // Body proportions (hidden)
          shoulder_width: bodyMetrics.proportions?.shoulder_width || null,
          chest_circumference: bodyMetrics.proportions?.chest_circumference || null,
          waist_hip_ratio: bodyMetrics.proportions?.waist_hip_ratio || null,
          leg_proportion: bodyMetrics.proportions?.leg_proportion || null,
          arm_length: bodyMetrics.proportions?.arm_length || null,
          torso_length: bodyMetrics.proportions?.torso_length || null,
          
          // Skin analysis
          undertone: skinTone.undertone || null,
          undertone_label: undertoneMap[skinTone.undertone] || null,
          skin_mst: skinTone.mst_scale || null,
          skin_label: skinTone.mst_label || null,
          undertone_precision_score: data.confidence_scores?.skin_tone || Math.random() * 0.3 + 0.7,
          melanin_level: skinTone.melanin_level || null,
          skin_texture: skinTone.texture || 'smooth',
          
          // Face analysis
          face_shape: facialAnalysis.face_shape || null,
          face_card: facialAnalysis.face_card || null,
          jawline_type: facialAnalysis.jawline_type || null,
          cheekbone_presence: facialAnalysis.cheekbone_presence || null,
          eye_color: facialAnalysis.eye_color || null,
          
          // Hair analysis
          hair_style: hairAnalysis.hair_style || null,
          hair_color: hairAnalysis.hair_color || null,
          hair_texture: hairAnalysis.hair_texture || null,
          hair_density: hairAnalysis.hair_density || null,
          hair_volume: hairAnalysis.hair_volume || null,
          
          // Color analysis
          contrast_level: overallAppearance.contrast_level || null,
          seasonal_color: overallAppearance.seasonal_color || null,
          recommended_colors: data.recommended_colors || [],
          avoid_colors: data.avoid_colors || [],
          
          // Style metrics
          silhouette_preference: bodyMetrics.silhouette_preference || null,
          pattern_affinity: data.pattern_affinity || null,
          fabric_preference: data.fabric_preference || null,
          
          // Overall appearance
          gender: overallAppearance.gender || null,
          age_range: overallAppearance.age_range || null,
          style_archetype: overallAppearance.style_archetype || null,
          
          // Personality proxies
          confidence_level: data.confidence_level || null,
          formality_preference: data.formality_preference || null,
          boldness_score: data.boldness_score || null,
          
          // AI learning data
          analysis_timestamp: new Date().toISOString(),
          confidence_score: data.confidence_scores?.overall || 0.85,
          model_version: 'v2.1-physique-api'
        };
        
        window.MN_USER.hidden_data = hiddenMetrics;
        
        // Add to photo history for AI learning
        const photoEntry = {
          id: Date.now(),
          image: base64Image.substring(0, 100) + '...',
          metrics: hiddenMetrics,
          timestamp: new Date().toISOString()
        };
        window.MN_USER.photo_analysis_history.push(photoEntry);
        
        // Keep only last 10 entries
        if (window.MN_USER.photo_analysis_history.length > 10) {
          window.MN_USER.photo_analysis_history = window.MN_USER.photo_analysis_history.slice(-10);
        }
        
        // Update visible profile data from mapped response
        const p = getProfile();
        p.uploadedImage = 'data:image/jpeg;base64,' + base64Image;
        p.selfieUploaded = true;
        p.ai_analyzed = true;
        p.last_ai_analysis = new Date().toISOString();
        
        // Map from physique_analysis API response structure
        if (bodyMetrics.estimated_height_cm) p.height = bodyMetrics.estimated_height_cm + ' cm';
        if (bodyMetrics.body_type) {
          p.build = bodyTypeMap[bodyMetrics.body_type] || bodyMetrics.body_type;
        }
        if (skinTone.mst_label) p.skinTone = skinTone.mst_label;
        if (skinTone.mst_scale) p.skinMST = skinTone.mst_scale;
        if (hairAnalysis.hair_style) p.hairStyle = hairAnalysis.hair_style;
        if (overallAppearance.gender) p.gender = overallAppearance.gender;
        if (overallAppearance.seasonal_color) p.seasonalColor = overallAppearance.seasonal_color;
        if (overallAppearance.style_archetype) p.styleArchetype = overallAppearance.style_archetype;
        
        // Map hidden data for AI recommendations
        if (facialAnalysis.face_shape) window.MN_USER.hidden_data.face_shape = facialAnalysis.face_shape;
        if (facialAnalysis.eye_color) window.MN_USER.hidden_data.eye_color = facialAnalysis.eye_color;
        if (hairAnalysis.hair_texture) window.MN_USER.hidden_data.hair_texture = hairAnalysis.hair_texture;
        
        saveProfile(p);
        mnUpdateProgress(p);
        mnRefreshStatCards(p);
        
        // Trigger hidden data sync
        mnDebouncedSave();
        
        if (loadingEl) {
          loadingEl.classList.remove('active');
          const prompt = document.querySelector('.profile-upload-prompt');
          if (prompt) prompt.textContent = '✨ AI Analysis Complete!';
          setTimeout(() => {
            if (prompt) prompt.textContent = '📸 Click to update photo';
          }, 3000);
        }
        
        return hiddenMetrics;
        
      } catch(err) {
        console.warn('[MN] AI Analysis failed:', err);
        if (loadingEl) loadingEl.classList.remove('active');
        return null;
      }
    }

    // =====================================================
    // HEIGHT VECTOR SVG UPDATE
    // =====================================================
    
    function mnUpdateHeightVector(cmValue) {
      const vectorContainer = document.querySelector('.mn-height-vector');
      if (!vectorContainer) return;
      
      // Scale: 140cm = 0.7, 220cm = 1.3
      const scale = 0.7 + ((cmValue - 140) / 80) * 0.6;
      vectorContainer.style.transform = `scaleY(${scale})`;
      
      // Update slider fill
      const slider = document.getElementById('mnHeightSlider');
      if (slider) {
        const fillPct = ((cmValue - 140) / 80) * 100;
        slider.style.setProperty('--slider-fill', fillPct + '%');
      }
    }

    // =====================================================
    // WEATHER WIDGET
    // =====================================================
    
    async function mnInitWeatherWidget() {
      const widget = document.getElementById('mnWeatherWidget');
      if (!widget) return;
      
      try {
        // Use Open-Meteo API (free, no key required)
        // First get location from IP
        const geoRes = await fetch('https://ipapi.co/json/');
        const geoData = await geoRes.json();
        
        if (geoData.latitude && geoData.longitude) {
          const weatherRes = await fetch(
            `https://api.open-meteo.com/v1/forecast?latitude=${geoData.latitude}&longitude=${geoData.longitude}&current_weather=true`
          );
          const weatherData = await weatherRes.json();
          
          if (weatherData.current_weather) {
            const temp = Math.round(weatherData.current_weather.temperature);
            const code = weatherData.current_weather.weathercode;
            
            // Map weather code to icon
            const weatherIcons = {
              0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️',
              45: '🌫️', 48: '🌫️',
              51: '🌧️', 53: '🌧️', 55: '🌧️',
              61: '🌧️', 63: '🌧️', 65: '🌧️',
              71: '🌨️', 73: '🌨️', 75: '🌨️',
              80: '🌦️', 81: '🌦️', 82: '🌦️',
              95: '⛈️', 96: '⛈️', 99: '⛈️'
            };
            
            const icon = weatherIcons[code] || '🌤️';
            const condition = code <= 3 ? 'Clear' : code <= 48 ? 'Cloudy' : code <= 65 ? 'Rainy' : code <= 75 ? 'Snowy' : 'Stormy';
            
            widget.querySelector('.mn-weather-icon').textContent = icon;
            widget.querySelector('.mn-weather-temp').textContent = temp + '°C';
            widget.querySelector('.mn-weather-condition').textContent = geoData.city || condition;
            
            // Update profile climate if not set
            const profile = getProfile();
            if (!profile.climate) {
              if (temp > 30) p.climate = 'Hot & Humid';
              else if (temp > 20) p.climate = 'Mild';
              else if (temp > 10) p.climate = 'Cool';
              else p.climate = 'Cold';
              saveProfile(p);
            }
          }
        }
      } catch(err) {
        console.warn('[MN] Weather fetch failed:', err);
        widget.querySelector('.mn-weather-temp').textContent = '--°C';
        widget.querySelector('.mn-weather-condition').textContent = 'Unavailable';
      }
    }


        opacity: 0.6;

        filter: blur(8px);

      }

      50% {

        opacity: 0.8;

        filter: blur(12px);

      }

    }


    @keyframes modalZoom {

      from {

        transform: scale(0.8);

        opacity: 0;

      }

      to {

        transform: scale(1);

        opacity: 1;

      }

    }


    .modal-close {


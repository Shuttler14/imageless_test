<div id="vault-overlay">
  <button class="close-vault" onclick="closeVault()">×</button>

  <div id="loading-state" style="text-align: center;">
    <h2 style="letter-spacing: 3px; color: white; margin-bottom: 10px;">NEURAL LINK ESTABLISHED</h2>

    <div class="scanner-bar"><div class="scanner-light"></div></div>

    <p id="status-text" class="glitch-text">ANALYZING PERSONALITY DATA...</p>
  </div>

  <div
    id="result-state"

    style="display: none; text-align: center; width: 100%; flex-direction: column; align-items: center;"
  >
    <h3 style="color: white; letter-spacing: 2px; margin-bottom: 20px;">IDENTITY CONFIRMED</h3>

    <img id="final-card-img" src="" alt="Identity Card">

    <button class="cyber-btn insta-btn" onclick="shareToInstagram()">SHARE TO STORY 📸</button>

    <a id="download-link" href="#" download class="cyber-btn" style="background:transparent; color:#888; border:none;"
      >⬇ Download Image</a
    >
  </div>
</div>

<script>
  // --- CONFIGURATION ---

  const API_URL = 'https://mynarrative-card-gen.vercel.app/api/index';

  let activeOrderId = '';

  let finalImageUrl = '';

  function openVault(orderId) {
    activeOrderId = orderId;

    document.getElementById('vault-overlay').style.display = 'flex';

    document.getElementById('loading-state').style.display = 'block';

    document.getElementById('result-state').style.display = 'none';

    document.body.style.overflow = 'hidden';

    startPolling();
  }

  function closeVault() {
    document.getElementById('vault-overlay').style.display = 'none';

    document.body.style.overflow = 'auto';
  }

  function startPolling() {
    const statusText = document.getElementById('status-text');

    let attempts = 0;

    const poller = setInterval(() => {
      attempts++;

      if (attempts % 2 === 0) statusText.innerText = 'ANALYZING VIBE...';
      else statusText.innerText = 'GENERATING ASSET...';

      fetch(`${API_URL}?order_id=${activeOrderId}`)
        .then((res) => res.json())

        .then((data) => {
          if (data.status === 'ready' && data.url.includes('http')) {
            clearInterval(poller);

            finalImageUrl = data.url;

            setTimeout(() => {
              revealCard(finalImageUrl);
            }, 1000);
          }
        })

        .catch((err) => console.error(err));

      if (attempts > 40) {
        clearInterval(poller);

        statusText.innerText = 'Processing... Check back in 1 minute.';
      }
    }, 3000);
  }

  function revealCard(url) {
    document.getElementById('loading-state').style.display = 'none';

    document.getElementById('result-state').style.display = 'flex';

    document.getElementById('final-card-img').src = url;

    document.getElementById('download-link').href = url;
  }

  async function shareToInstagram() {
    if (!finalImageUrl) return;

    if (navigator.share) {
      try {
        const response = await fetch(finalImageUrl);

        const blob = await response.blob();

        const file = new File([blob], 'identity_card.jpg', { type: 'image/jpeg' });

        await navigator.share({
          files: [file],

          title: 'My Narrative Identity',

          text: 'Verified 1%. #MyNarrative',
        });
      } catch (e) {
        alert('Please save the image and upload manually.');
      }
    } else {
      alert('Image saved! Open Instagram to post.');

      document.getElementById('download-link').click();
    }
  }
</script>

<script>
// Digital Twin Upload Functionality
async function uploadTwin(input) {
  const file = input.files[0];
  if (!file) return;

  // Show loading state
  document.getElementById('mn-twin-loading').style.display = 'flex';
  document.getElementById('mn-twin-placeholder').style.display = 'none';

  try {
    // Convert to Base64
    const base64 = await toBase64(file);
    
    // Send to Vercel Backend
    const res = await fetch('https://mynarrative-ai.vercel.app/api/profile_manager', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'save_twin',
        user_id: '{{ customer.id }}',
        image: base64
      })
    });
    
    const data = await res.json();
    
    if (data.success) {
      // Update the UI immediately
      const imgEl = document.getElementById('mn-twin-img');
      imgEl.src = data.url;
      imgEl.style.display = 'block';
      document.getElementById('mn-twin-loading').style.display = 'none';
      alert('✅ Digital Twin Updated! Now you can try on products in 1 click.');
    } else {
      throw new Error(data.error || 'Upload failed');
    }
  } catch (error) {
    console.error('Upload error:', error);
    alert('❌ Upload failed: ' + error.message);
    document.getElementById('mn-twin-loading').style.display = 'none';
    document.getElementById('mn-twin-placeholder').style.display = 'flex';
  }
}

// Helper: Convert file to Base64
function toBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => resolve(reader.result);
    reader.onerror = error => reject(error);
  });
}

// Load existing Digital Twin on page load
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('https://mynarrative-ai.vercel.app/api/profile_manager', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'get_twin',
        user_id: '{{ customer.id }}'
      })
    });
    
    const data = await res.json();
    
    if (data.success && data.url) {
      const imgEl = document.getElementById('mn-twin-img');
      imgEl.src = data.url;
      imgEl.style.display = 'block';
      document.getElementById('mn-twin-placeholder').style.display = 'none';
    }
  } catch (error) {
    console.error('Failed to load Digital Twin:', error);
  }
});
</script>


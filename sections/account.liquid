  <script>
    // â”€â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function getProfile()  { try { return JSON.parse(localStorage.getItem('mn_core_identity') || '{}'); } catch(e) { return {}; } }
    function saveProfile(p){ localStorage.setItem('mn_core_identity', JSON.stringify(p)); window.dispatchEvent(new CustomEvent('mn-identity-updated')); }
    function getCloset()   { try { return JSON.parse(localStorage.getItem('mn_digital_closet') || '[]'); } catch(e) { return []; } }
    function getHistory()  { try { return JSON.parse(localStorage.getItem('mn_outfit_history') || '[]'); } catch(e) { return []; } }

    // â”€â”€â”€ Emoji Map (same as AI stylist) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    const GARMENT_EMOJI_MAP = {
      'T-Shirt':'ðŸ‘•','Tshirt':'ðŸ‘•','Tee':'ðŸ‘•','Shirt':'ðŸ‘”','Formal Shirt':'ðŸ‘”','Kurta':'ðŸ‘˜','Kurti':'ðŸ‘˜',
      'Dress':'ðŸ‘—','Saree':'ðŸ¥»','Lehenga':'ðŸ‘—','Salwar':'ðŸ‘˜','Dupatta':'ðŸ§£','Top':'ðŸ‘š','Blouse':'ðŸ‘š',
      'Jeans':'ðŸ‘–','Trousers':'ðŸ‘–','Chinos':'ðŸ‘–','Pants':'ðŸ‘–','Shorts':'ðŸ©³','Skirt':'ðŸ‘—','Leggings':'ðŸ©±',
      'Jacket':'ðŸ§¥','Blazer':'ðŸ§¥','Coat':'ðŸ§¥','Hoodie':'ðŸ§¥','Sweater':'ðŸ§¥','Sherwani':'ðŸ¤µ','Suit':'ðŸ¤µ',
      'Sneakers':'ðŸ‘Ÿ','Shoes':'ðŸ‘Ÿ','Loafers':'ðŸ‘ž','Boots':'ðŸ‘¢','Heels':'ðŸ‘ ','Sandals':'ðŸ©´','Juttis':'ðŸ‘¡','Flats':'ðŸ‘¡',
      'Watch':'âŒš','Belt':'ðŸª¡','Sunglasses':'ðŸ•¶ï¸','Cap':'ðŸ§¢','Hat':'ðŸŽ©','Scarf':'ðŸ§£',
      'Bag':'ðŸ‘œ','Backpack':'ðŸŽ’','Wallet':'ðŸ‘›','Earrings':'ðŸ’Ž','Necklace':'ðŸ“¿','Ring':'ðŸ’',
      'Topwear':'ðŸ‘•','Bottomwear':'ðŸ‘–','Footwear':'ðŸ‘Ÿ','Outerwear':'ðŸ§¥',
      'Ethnic Wear':'ðŸ‘˜','Accessories':'âŒš','Innerwear':'ðŸ©²','Sportswear':'ðŸƒ','Bags':'ðŸ‘œ'
    };
    function getItemEmoji(item) {
      const name = (item.original_name || item.name || item.type || '').trim();
      const lookup = (k) => { const kl = k.toLowerCase(); return Object.keys(GARMENT_EMOJI_MAP).find(g => g.toLowerCase() === kl); };
      const direct = lookup(name); if (direct) return GARMENT_EMOJI_MAP[direct];
      for (const word of name.split(/\s+/)) { const m = lookup(word); if (m) return GARMENT_EMOJI_MAP[m]; }
      const section = item.closet_section || item.category || '';
      return GARMENT_EMOJI_MAP[section] || 'ðŸ‘”';
    }

    // â”€â”€â”€ Selfie Upload â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ── Magic Upload: POST to AI API, auto-fill all stat/detail cards ──
    async function handleSelfieUpload(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = async function(e) {
        const imageData = e.target.result;
        const raw_b64   = imageData.replace(/^data:image\/\w+;base64,/, '');

        // Show avatar immediately
        document.getElementById('avatarImage').src = imageData;
        document.getElementById('avatarImage').style.display = 'block';
        document.getElementById('avatarPlaceholder').style.display = 'none';

        // Loading state
        const avatar      = document.getElementById('profileAvatar');
        const uploadPrompt = document.querySelector('.profile-upload-prompt');
        if (avatar)       { avatar.style.opacity = '0.6'; avatar.style.pointerEvents = 'none'; }
        if (uploadPrompt)  uploadPrompt.textContent = '✨ AI is analysing your style...';

        try {
          const res = await fetch('https://api.mynarrative.store/v1/analyze-user', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              user_id:   '{{ customer.id | default: "guest" }}',
              image_b64: raw_b64,
              context:   'style_profile'
            })
          });
          let data = {};
          if (res.ok) data = await res.json();

          // Map API response → mn_core_identity fields
          const p = getProfile();
          p.uploadedImage  = imageData;
          p.selfieUploaded = true;
          if (data.height_cm)     p.height         = data.height_cm + ' cm';
          if (data.preferred_fit) p.build          = data.preferred_fit;
          if (data.skin_label)    p.skinTone       = data.skin_label;
          if (data.skin_mst)      p.skinMST        = data.skin_mst;
          if (data.hair_style)    p.hairStyle      = data.hair_style;
          if (data.gender)        p.gender         = data.gender;
          if (data.weather)       p.climate        = data.weather;
          if (data.price_range)   p.budget         = data.price_range;
          if (data.fashion_goals) p.goals          = data.fashion_goals;
          if (data.undertone)     p.undertone      = data.undertone;
          if (data.favorite_colors) p.favoriteColors = Array.isArray(data.favorite_colors) ? data.favorite_colors : [data.favorite_colors];
          if (data.style_vibes && data.style_vibes.length)  p.coreExpression = data.style_vibes.join(', ');
          if (data.occasions   && data.occasions.length)    p.occasion       = data.occasions.join(', ');
          if (data.ai_metrics) p.ai_metrics = data.ai_metrics;

          // Refresh all cards in the DOM
          mnRefreshStatCards(p);
          saveProfile(p);

          if (uploadPrompt) uploadPrompt.textContent = '✓ Profile auto-filled by AI!';
          setTimeout(() => { if (uploadPrompt) uploadPrompt.textContent = '📸 Click to update photo'; }, 3500);

        } catch(err) {
          console.warn('MN AI API unavailable — photo stored locally:', err);
          const p = getProfile();
          p.uploadedImage  = imageData;
          p.selfieUploaded = true;
          saveProfile(p);
          if (uploadPrompt) uploadPrompt.textContent = 'Photo saved — fill details manually';
        } finally {
          if (avatar) { avatar.style.opacity = '1'; avatar.style.pointerEvents = ''; }
          input.value = '';
        }
      };
      reader.readAsDataURL(file);
    }

    // ── Refresh all stat/detail card DOM values from profile object ──
    function mnRefreshStatCards(profile) {
      const set = (id, val) => { const el = document.getElementById(id); if (el && val) el.textContent = val; };
      set('statHeight',      profile.height    || '-');
      set('statBodyType',    profile.build     || '-');
      set('statSkinTone',    profile.skinTone  || '-');
      set('statTemperature', profile.climate   || '-');
      set('statPriceRange',  profile.budget    || '-');
      set('detailGoals',     profile.goals     || '-');
      set('detailStyle',     profile.coreExpression || '-');
      set('detailOccasion',  profile.occasion  || '-');
      set('detailUndertone', profile.undertone || '-');
      set('detailRegion',    profile.region || profile.location || '-');
      const colors = profile.favoriteColors;
      set('detailColors', Array.isArray(colors) ? colors.join(', ') : (colors || '-'));
    }

    // ── Handle arrival from widget profile ring click ──
    function mnHandleWidgetArrival() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('mn_focus') !== 'profile') return;
      window.history.replaceState({}, '', window.location.pathname);

      setTimeout(() => {
        const sec = document.getElementById('userProfileSection');
        if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 200);

      const profile = getProfile();
      if (!profile.selfieUploaded && !profile.uploadedImage) {
        setTimeout(() => {
          const avatar       = document.getElementById('profileAvatar');
          const uploadPrompt = document.querySelector('.profile-upload-prompt');
          if (avatar) {
            avatar.style.animation = 'mnAvatarPulse 1.2s ease-in-out 4';
            avatar.style.border    = '2.5px solid #39A596';
          }
          if (uploadPrompt) {
            uploadPrompt.textContent  = '📸 Upload photo — AI fills everything!';
            uploadPrompt.style.color  = '#39A596';
            uploadPrompt.style.fontWeight = '800';
          }
          // Auto-open file picker
          setTimeout(() => document.getElementById('selfieUploadInput').click(), 1500);
          setTimeout(() => {
            if (avatar) avatar.style.animation = '';
            if (uploadPrompt) { uploadPrompt.textContent = '📸 Click to update photo'; uploadPrompt.style.fontWeight = ''; }
          }, 5500);
        }, 600);
      }
    }

    // ── Chatbot → Dashboard live sync ──
    window.addEventListener('mn-chatbot-save', function(e) {
      if (!e.detail) return;
      const updates = e.detail;
      const p = getProfile();
      if (updates.height_cm)     p.height         = updates.height_cm + ' cm';
      if (updates.preferred_fit) p.build          = updates.preferred_fit;
      if (updates.skin_label)    p.skinTone       = updates.skin_label;
      if (updates.hair_style)    p.hairStyle      = updates.hair_style;
      if (updates.gender)        p.gender         = updates.gender;
      if (updates.weather && updates.weather.city) p.climate = updates.weather.city + (updates.weather.temp ? ' ' + Math.round(updates.weather.temp) + '°C' : '');
      if (updates.price_min && updates.price_max)  p.budget  = '₹' + Number(updates.price_min).toLocaleString('en-IN') + '–₹' + Number(updates.price_max).toLocaleString('en-IN');
      if (updates.style_vibes && updates.style_vibes.length) p.coreExpression = updates.style_vibes.join(', ');
      if (updates.occasions   && updates.occasions.length)   p.occasion       = updates.occasions.join(', ');
      if (updates.ai_metrics)    p.ai_metrics = Object.assign(p.ai_metrics || {}, updates.ai_metrics);
      p.chatbot_synced_at = new Date().toISOString();
      mnRefreshStatCards(p);
      saveProfile(p);
    });

    // ── Cross-tab storage sync (chatbot widget open in another tab) ──
    window.addEventListener('storage', function(e) {
      if (e.key === 'mn_identity' && e.newValue) {
        try {
          const src = JSON.parse(e.newValue);
          const p   = getProfile();
          if (src.height_cm)     p.height         = src.height_cm + ' cm';
          if (src.preferred_fit) p.build          = src.preferred_fit;
          if (src.skin_label)    p.skinTone       = src.skin_label;
          if (src.style_vibes && src.style_vibes.length) p.coreExpression = src.style_vibes.join(', ');
          if (src.occasions   && src.occasions.length)   p.occasion       = src.occasions.join(', ');
          if (src.price_min && src.price_max) p.budget = '₹' + Number(src.price_min).toLocaleString('en-IN') + '–₹' + Number(src.price_max).toLocaleString('en-IN');
          mnRefreshStatCards(p);
          localStorage.setItem('mn_core_identity', JSON.stringify(p));
        } catch(err) {}
      }
      if (e.key === 'mn_core_identity' && e.newValue) {
        try { mnRefreshStatCards(JSON.parse(e.newValue)); } catch(err) {}
      }
    });

    // â”€â”€â”€ Glass Edit Modal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    const FIELD_OPTIONS = {
      height:       { title: 'Your Height', sub: 'Choose or type your height in cm', multi: false,
        options: ['150 cm','155 cm','160 cm','165 cm','170 cm','175 cm','180 cm','185 cm','190 cm'] },
      build:        { title: 'Body Type', sub: 'How would you describe your build?', multi: false,
        options: ['Slim','Athletic','Average','Muscular','Broad','Plus Size','Petite','Tall & Lean'] },
      skinTone:     { title: 'Skin Tone', sub: 'Select your skin tone', multi: false,
        options: ['Fair','Light','Wheatish','Medium','Olive','Tan','Brown','Dark Brown','Deep'] },
      climate:      { title: 'Your Climate', sub: 'What climate do you mostly dress for?', multi: false,
        options: ['Hot & Humid','Tropical','Dry Heat','Mild','Cool','Cold','Monsoon','Mixed Seasons'] },
      budget:       { title: 'Budget Range', sub: 'Your typical outfit spend', multi: false,
        options: ['Under â‚¹1,000','â‚¹1,000â€“â‚¹3,000','â‚¹3,000â€“â‚¹7,000','â‚¹7,000â€“â‚¹15,000','â‚¹15,000+','No budget limit'] },
      goals:        { title: 'Fashion Goals', sub: 'What are you trying to achieve?', multi: false,
        options: ['Look more confident','Dress for my body','Build a capsule wardrobe','Stand out in a crowd',
                  'Look professional','Dress more traditionally','Be more sustainable','Express my personality'] },
      favoriteColors:{ title: 'Favourite Colors', sub: 'Pick all that apply', multi: true,
        options: ['Black','White','Navy','Beige','Olive','Grey','Brown','Maroon','Teal','Mustard',
                  'Rust','Coral','Blush Pink','Lavender','Royal Blue','Emerald Green'] },
      coreExpression:{ title: 'Style Expression', sub: 'How do you like to dress?', multi: false,
        options: ['Minimalist & Clean','Bold & Expressive','Traditional & Ethnic','Smart Casual',
                  'Streetwear','Business Formal','Boho & Free','Dark & Edgy','Preppy','Sporty'] },
      occasion:     { title: 'Go-to Occasion', sub: 'Where do you dress up most?', multi: false,
        options: ['Daily Casual','College / Campus','Office / Workwear','Festive & Weddings',
                  'Date Night','Party / Nightout','Outdoor / Travel','Sports / Gym'] },
      region:       { title: 'Region / City', sub: 'Type your city or region', multi: false, options: [] },
      undertone:    { title: 'Skin Undertone', sub: 'Your natural undertone', multi: false,
        options: ['Warm (yellow/golden)','Cool (pink/bluish)','Neutral (balanced)','Olive (green-ish)','Not sure'] }
    };

    let _currentField = null, _currentProfileKey = null, _isMulti = false, _selectedValues = [];

    function openEditModal(profileKey, displayElId) {
      const cfg = FIELD_OPTIONS[profileKey];
      if (!cfg) return;
      _currentField = displayElId; _currentProfileKey = profileKey;
      _isMulti = cfg.multi; _selectedValues = [];
      const p = getProfile();
      const current = _isMulti
        ? (Array.isArray(p[profileKey]) ? p[profileKey] : (p[profileKey] ? [p[profileKey]] : []))
        : (p[profileKey] || '');

      document.getElementById('mnEditModalTitle').textContent = cfg.title;
      document.getElementById('mnEditModalSub').textContent   = cfg.sub;
      document.getElementById('mnEditCustomInput').value = _isMulti ? '' : (current || '');
      document.getElementById('mnEditCustomInput').placeholder = _isMulti ? 'Or type a custom colourâ€¦' : 'Or type a custom valueâ€¦';

      // Build chip grid
      const grid = document.getElementById('mnEditChipGrid');
      grid.innerHTML = '';
      _selectedValues = _isMulti ? [...current] : [];
      cfg.options.forEach(opt => {
        const chip = document.createElement('button');
        chip.className = 'mn-edit-chip' + (cfg.options.length === 1 ? ' mn-edit-chip-single' : '');
        chip.textContent = opt;
        const isSelected = _isMulti ? current.includes(opt) : (current === opt);
        if (isSelected) { chip.classList.add('selected'); if (_isMulti && !_selectedValues.includes(opt)) _selectedValues.push(opt); }
        chip.addEventListener('click', () => {
          if (_isMulti) {
            chip.classList.toggle('selected');
            if (chip.classList.contains('selected')) { if (!_selectedValues.includes(opt)) _selectedValues.push(opt); }
            else { _selectedValues = _selectedValues.filter(v => v !== opt); }
          } else {
            grid.querySelectorAll('.mn-edit-chip').forEach(c => c.classList.remove('selected'));
            chip.classList.add('selected');
            document.getElementById('mnEditCustomInput').value = opt;
          }
        });
        grid.appendChild(chip);
      });

      // Hide custom input for fields with no options OR keep for all
      document.getElementById('mnEditCustomInput').style.display = cfg.options.length > 0 ? '' : '';
      document.getElementById('mnEditModalOverlay').classList.add('active');
    }

    function closeEditModal() { document.getElementById('mnEditModalOverlay').classList.remove('active'); }

    document.getElementById('mnEditCancelBtn').addEventListener('click', closeEditModal);
    document.getElementById('mnEditModalOverlay').addEventListener('click', function(e) { if (e.target === this) closeEditModal(); });

    document.getElementById('mnEditSaveBtn').addEventListener('click', function() {
      const p = getProfile();
      const customVal = document.getElementById('mnEditCustomInput').value.trim();
      if (_isMulti) {
        if (customVal) { _selectedValues = [...new Set([..._selectedValues, ...customVal.split(',').map(s => s.trim()).filter(Boolean)])]; }
        p[_currentProfileKey] = _selectedValues;
        const el = document.getElementById(_currentField);
        if (el) el.textContent = _selectedValues.join(', ') || '-';
      } else {
        const val = customVal || document.querySelector('#mnEditChipGrid .mn-edit-chip.selected')?.textContent || '';
        p[_currentProfileKey] = val;
        const el = document.getElementById(_currentField);
        if (el) el.textContent = val || '-';
      }
      saveProfile(p);
      closeEditModal();
    });

    // â”€â”€â”€ Closet Panel â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function togglePanel(panelId) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      const isActive = panel.classList.contains('active');
      document.querySelectorAll('.mn-dashboard-panel').forEach(p => p.classList.remove('active'));
      if (!isActive) panel.classList.add('active');
    }

    function renderClosetPanel() {
      const closet = getCloset();
      const container = document.getElementById('mnClosetPanelContent');
      if (!container) return;
      if (closet.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No items yet â€” upload clothing photos in the AI Stylist</p>';
        return;
      }
      // Group by section
      const sections = {};
      closet.forEach(item => {
        const s = item.closet_section || item.category || 'Other';
        if (!sections[s]) sections[s] = [];
        sections[s].push(item);
      });
      let html = '';
      Object.entries(sections).forEach(([section, items]) => {
        html += `<div class="mn-panel-section-label">${section} <span style="opacity:0.5;">(${items.length})</span></div>`;
        html += '<div class="mn-panel-closet-grid">';
        items.forEach(item => {
          const emoji = getItemEmoji(item);
          const name  = item.original_name || item.name || 'Item';
          const meta  = [item.color, item.fabric].filter(Boolean).join(' Â· ');
          html += `<div class="mn-panel-closet-card">
            <div class="mn-panel-closet-emoji">${emoji}</div>
            <div class="mn-panel-closet-name">${name}</div>
            ${meta ? `<div class="mn-panel-closet-meta">${meta}</div>` : ''}
          </div>`;
        });
        html += '</div>';
      });
      container.innerHTML = html;
    }

    function renderHistoryPanel() {
      const history = getHistory();
      const container = document.getElementById('mnHistoryPanelContent');
      if (!container) return;
      if (history.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No outfits generated yet â€” open the AI Stylist to create your first look</p>';
        return;
      }
      let html = '';
      history.slice(0, 10).forEach(look => {
        const date = look.savedAt ? new Date(look.savedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '';
        const pieces = (look.outfit_pieces || []);
        html += `<div class="mn-panel-look-card">
          <div class="mn-panel-look-date">${date}</div>
          <div class="mn-panel-look-direction">${look.direction || look.context || 'AI Generated Outfit'}</div>
          <div class="mn-panel-look-pieces">
            ${pieces.map(p => `<span class="mn-panel-look-piece ${p.owned ? 'owned' : ''}">${getItemEmoji(p)} ${p.name || ''}</span>`).join('')}
          </div>
        </div>`;
      });
      container.innerHTML = html;
    }

    // â”€â”€â”€ Load & Render â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const profile = getProfile();
        const closet  = getCloset();
        const history = getHistory();

        document.getElementById('userProfileSection').style.display = 'block';

        // Avatar
        if (profile.uploadedImage) {
          document.getElementById('avatarImage').src = profile.uploadedImage;
          document.getElementById('avatarImage').style.display = 'block';
          document.getElementById('avatarPlaceholder').style.display = 'none';
        } else if (profile.archetype?.icon) {
          document.getElementById('avatarPlaceholder').textContent = profile.archetype.icon;
        }

        // Personality badge
        document.getElementById('personalityTone').textContent = profile.tone || profile.coreExpression || 'Style Explorer';

        // Quick stats
        document.getElementById('statHeight').textContent       = profile.height ? profile.height + '' : '-';
        document.getElementById('statBodyType').textContent     = profile.build || profile.bodyType || '-';
        document.getElementById('statSkinTone').textContent     = profile.skinTone || '-';
        document.getElementById('statTemperature').textContent  = profile.climate || profile.temperature || '-';
        document.getElementById('statPriceRange').textContent   = profile.budget || profile.priceRange || '-';
        document.getElementById('statClosetItems').textContent  = closet.length + ' items';
        document.getElementById('statOutfitsSaved').textContent = history.length + ' looks';

        // Detail cards
        document.getElementById('detailGoals').textContent    = profile.goals || profile.fashionGoals || profile.signal || '-';
        const colors = profile.favoriteColors || profile.colors;
        document.getElementById('detailColors').textContent   = Array.isArray(colors) ? colors.join(', ') : (colors || '-');
        document.getElementById('detailStyle').textContent    = profile.coreExpression || profile.style || '-';
        document.getElementById('detailOccasion').textContent = profile.occasion || (Array.isArray(profile.contexts) ? profile.contexts.join(', ') : '-');
        document.getElementById('detailRegion').textContent   = profile.region || profile.location || profile.city || '-';
        document.getElementById('detailUndertone').textContent = profile.undertone || '-';

        // Closet breakdown
        if (closet.length > 0) {
          const sections = {};
          closet.forEach(i => { const s = i.closet_section || i.category || 'Other'; sections[s] = (sections[s]||0)+1; });
          document.getElementById('detailClosetBreakdown').textContent = Object.entries(sections).map(([s,n])=>n+' '+s).join(' Â· ') || '-';
        }

        // Most recent outfit
        if (history.length > 0) {
          const last = history[0];
          document.getElementById('detailLastOutfit').textContent = last.direction || last.context || last.occasion || '-';
        }

        // Wire stat cards to edit modal
        const editMap = [
          ['statHeight','height'],['statBodyType','build'],['statSkinTone','skinTone'],
          ['statTemperature','climate'],['statPriceRange','budget']
        ];
        editMap.forEach(([elId, key]) => {
          const el = document.getElementById(elId);
          if (el) el.addEventListener('click', () => openEditModal(key, elId));
        });

        // Wire detail cards to edit modal
        const detailMap = [
          ['detailGoals','goals'],['detailColors','favoriteColors'],['detailStyle','coreExpression'],
          ['detailOccasion','occasion'],['detailRegion','region'],['detailUndertone','undertone']
        ];
        detailMap.forEach(([elId, key]) => {
          const el = document.getElementById(elId);
          if (el) el.addEventListener('click', () => openEditModal(key, elId));
        });

        // Wire Digital Closet stat card â†’ show closet panel
        const closetStatCard = document.getElementById('statClosetItems');
        if (closetStatCard) {
          closetStatCard.parentElement.addEventListener('click', () => {
            renderClosetPanel();
            togglePanel('mnClosetPanel');
          });
        }

        // Wire Outfits Saved stat card â†’ show history panel
        const histStatCard = document.getElementById('statOutfitsSaved');
        if (histStatCard) {
          histStatCard.parentElement.addEventListener('click', () => {
            renderHistoryPanel();
            togglePanel('mnHistoryPanel');
          });
        }

      } catch (error) {
        console.error('Error loading AI Stylist profile:', error);
      }

      // Handle arrival from widget profile ring → /account?mn_focus=profile
      mnHandleWidgetArrival();
    });

    // Avatar pulse animation keyframe (injected once at runtime)
    (function() {
      const s = document.createElement('style');
      s.textContent = '@keyframes mnAvatarPulse { 0%{box-shadow:0 0 0 0 rgba(57,165,150,0.7)} 70%{box-shadow:0 0 0 14px rgba(57,165,150,0)} 100%{box-shadow:0 0 0 0 rgba(57,165,150,0)} }';
      document.head.appendChild(s);
    })();
  </script>

  {% if customer.orders.size > 0 %}

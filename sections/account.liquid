    function mnPopulateCardVariants() {
      const bankSelect = document.getElementById('mnBankSelect');
      const variantSelect = document.getElementById('mnCardVariant');
      
      if (!bankSelect || !variantSelect) return;
      
      bankSelect.addEventListener('change', function() {
        const selectedBank = this.value;
        variantSelect.innerHTML = '<option value="">Select Card Variant</option>';
        
        if (BANK_DATA[selectedBank]) {
          BANK_DATA[selectedBank].cards.forEach(card => {
            const option = document.createElement('option');
            option.value = card;
            option.textContent = card;
            variantSelect.appendChild(option);
          });
        }
      });
    }

    function mnAddBankCard() {
      const bankSelect = document.getElementById('mnBankSelect');
      const variantSelect = document.getElementById('mnCardVariant');
      const cardTypeBtns = document.querySelectorAll('.mn-card-type-btn');
      
      const selectedBank = bankSelect?.value;
      const selectedVariant = variantSelect?.value;
      const selectedType = Array.from(cardTypeBtns).find(b => b.classList.contains('selected'))?.textContent || 'Credit';
      
      if (!selectedBank || !selectedVariant) {
        alert('Please select a bank and card variant');
        return;
      }
      
      const newCard = {
        id: Date.now(),
        bank: selectedBank,
        variant: selectedVariant,
        type: selectedType,
        addedAt: new Date().toISOString()
      };
      
      window.MN_USER.bank_cards.push(newCard);
      mnRenderSavedCards();
      mnDebouncedSave();
      
      // Reset form
      bankSelect.value = '';
      variantSelect.innerHTML = '<option value="">Select Card Variant</option>';
      cardTypeBtns.forEach(b => b.classList.remove('selected'));
    }

    function mnRenderSavedCards() {
      const container = document.getElementById('mnSavedCardsList');
      if (!container) return;
      
      if (window.MN_USER.bank_cards.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:12px;text-align:center;padding:16px;">No cards saved yet</p>';
        return;
      }
      
      container.innerHTML = window.MN_USER.bank_cards.map(card => `
        <div class="mn-saved-card" data-id="${card.id}">
          <div class="mn-saved-card-info">
            <div class="mn-saved-card-icon">${BANK_DATA[card.bank]?.icon || '💳'}</div>
            <div class="mn-saved-card-details">
              <div class="mn-saved-card-bank">${card.bank} - ${card.variant}</div>
              <div class="mn-saved-card-variant">${card.type}</div>
            </div>
          </div>
          <button onclick="mnRemoveCard(${card.id})" style="background:none;border:none;color:rgba(255,255,255,0.4);cursor:pointer;font-size:16px;">✕</button>
        </div>
      `).join('');
    }

    function mnRemoveCard(cardId) {
      window.MN_USER.bank_cards = window.MN_USER.bank_cards.filter(c => c.id !== cardId);
      mnRenderSavedCards();
      mnDebouncedSave();
    }


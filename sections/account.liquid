          document.getElementById('detailLastOutfit').textContent = lastSummary || 'AI outfit ready in Stylist history';
        } else {
          document.getElementById('detailLastOutfit').textContent = 'No outfits generated yet — open the AI Stylist to create your first look';
        }

        // Wire stat cards to edit modal

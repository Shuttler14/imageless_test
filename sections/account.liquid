        class="absolute top-0 right-0 w-64 h-64 brand-bg opacity-5 blur-[100px] rounded-full pointer-events-none"
      ></div>

      <div class="relative z-2 p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">

    function openGhostModeModal() {
      const name = prompt("Ghost Mode \nEnter what you own (e.g. 'Vintage Leather Jacket'):");
      if (name && name.trim()) {
        const closet = getCloset();
        closet.push({
          name: name.trim(),
          category: "Wardrobe",
          closet_section: "Wardrobe",
          emoji: "👻",
          ghost: true,
          added_at: new Date().toISOString()
        });
        localStorage.setItem(MN_CLOSET_KEY, JSON.stringify(closet));
        renderClosetPanel();
      }
    }

    window.handleClosetPhotoUpload = handleClosetPhotoUpload;

      transition: width 0.5s ease;

    }


    /* GRID - TIGHTER SPACING */

    .artifact-grid-compact {

      display: grid;

      grid-template-columns: repeat(5, 1fr);

      gap: 8px;

      position: relative;

      z-index: 10;

    }


    /* MODAL STYLES */

    .artifact-modal {

      display: none;

      position: fixed;

      top: 0;

      left: 0;

      width: 100%;

      height: 100%;

      background: rgba(0, 0, 0, 0.95);

      z-index: 40;

      align-items: center;

      justify-content: center;

      padding: 20px;

    }


    .artifact-modal.active {

      display: flex;

    }


    .modal-content {

      background: linear-gradient(145deg, #1a1a1a 0%, #0a0a0a 50%, #1a1a1a 100%);

      border: 2px solid var(--brand-teal);

      border-radius: 16px;

      padding: 30px;

      max-width: 400px;

      width: 100%;

      position: relative;

      box-shadow:

        0 0 60px rgba(57, 165, 150, 0.4),

        0 8px 32px rgba(0, 0, 0, 0.8),

        inset 0 1px 0 rgba(255, 255, 255, 0.1),

        inset 0 -1px 0 rgba(0, 0, 0, 0.5);

      animation: modalZoom 0.3s ease-out;

    }


    .modal-content::before {

      content: '';

      position: absolute;

      top: -2px;

      left: -2px;

      right: -2px;

      bottom: -2px;

      background: linear-gradient(45deg, var(--brand-teal), #2d8578, var(--brand-teal), #2d8578);

      border-radius: 16px;

      z-index: -1;

      opacity: 0.6;

      filter: blur(8px);

      animation: borderGlow 3s ease-in-out infinite;


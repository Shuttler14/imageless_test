      font-family: 'Montserrat', sans-serif;

      text-transform: uppercase;

      letter-spacing: 0.5px;

      border: 1px solid #000;

    }


    /* SLOTS - REDUCED SIZE */

    .artifact-slot-mini {

      aspect-ratio: 1/1;

      border-radius: 6px;

      position: relative;

      overflow: hidden;

      transition: all 0.3s ease;

      width: 100%;

      cursor: pointer;

    }


    .artifact-slot-mini:hover {

      transform: scale(1.05);

    }


    /* FILLED */

    .artifact-slot-mini.filled {

      border: 1px solid var(--brand-teal);

      background: #000;

      box-shadow: inset 0 0 10px rgba(57, 165, 150, 0.2);

    }


    .artifact-slot-mini.filled:hover {

      border-color: var(--brand-teal);

      box-shadow: 0 0 20px rgba(57, 165, 150, 0.4);

    }


    /* EMPTY (Blueprint Grid) */

    .artifact-slot-mini.empty {

      background-color: #0f0f0f;

      border: 1px solid #222;

      background-image:

        linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),

        linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);

      background-size: 6px 6px;

      display: flex;

      align-items: center;

      justify-content: center;

      cursor: default;

    }


    .empty-number-mini {

      font-size: 0.9rem;

      font-weight: 700;

      color: #444;

    }


    /* BADGE - SMALLER */

    .check-badge-mini {

      position: absolute; top: 2px; right: 2px;

      width: 12px; height: 12px;

      background: var(--brand-teal);

      border-radius: 50%;

      display: flex; align-items: center; justify-content: center;

      z-index: 10;

      box-shadow: 0 0 5px var(--brand-teal);

    }


    /* PROGRESS BAR */

    .progress-track-mini {

      background: #1a1a1a;

      border-radius: 10px;

      height: 5px;

      overflow: hidden;

      margin-top: 16px;

    }

    .progress-fill-mini {

      height: 100%;

      background: var(--brand-teal);

      box-shadow: 0 0 10px var(--brand-teal);

      border-radius: 10px;

      transition: width 0.5s ease;

    }


    /* GRID - TIGHTER SPACING */

    .artifact-grid-compact {

      display: grid;

      grid-template-columns: repeat(5, 1fr);

      gap: 8px;

      position: relative;

      z-index: 10;

    }


    /* MODAL STYLES */

    .artifact-modal {

      display: none;

      position: fixed;

      top: 0;

      left: 0;

      width: 100%;

      height: 100%;

      background: rgba(0, 0, 0, 0.95);

      z-index: 40;

      align-items: center;

      justify-content: center;

      padding: 20px;

    }


    .artifact-modal.active {

      display: flex;

    }


    .modal-content {

      background: linear-gradient(145deg, #1a1a1a 0%, #0a0a0a 50%, #1a1a1a 100%);

      border: 2px solid var(--brand-teal);

      border-radius: 16px;

      padding: 30px;

      max-width: 400px;

      width: 100%;

      position: relative;

      box-shadow:

        0 0 60px rgba(57, 165, 150, 0.4),

        0 8px 32px rgba(0, 0, 0, 0.8),

        inset 0 1px 0 rgba(255, 255, 255, 0.1),

        inset 0 -1px 0 rgba(0, 0, 0, 0.5);

      animation: modalZoom 0.3s ease-out;

    }


    .modal-content::before {

      content: '';

      position: absolute;

      top: -2px;

      left: -2px;

      right: -2px;

      bottom: -2px;

      background: linear-gradient(45deg, var(--brand-teal), #2d8578, var(--brand-teal), #2d8578);

      border-radius: 16px;

      z-index: -1;

      opacity: 0.6;

      filter: blur(8px);

      animation: borderGlow 3s ease-in-out infinite;

    }


    @keyframes borderGlow {

      0%, 100% {

        opacity: 0.6;

        filter: blur(8px);

      }

      50% {

        opacity: 0.8;

        filter: blur(12px);

      }

    }


    @keyframes modalZoom {

      from {

        transform: scale(0.8);

        opacity: 0;

      }

      to {

        transform: scale(1);

        opacity: 1;

      }

    }


    .modal-close {

      position: absolute;

      top: 15px;

      right: 15px;

      background: none;

      border: none;

      color: #fff;

      font-size: 28px;

      cursor: pointer;

      line-height: 1;

      padding: 0;

      width: 30px;

      height: 30px;

      display: flex;

      align-items: center;

      justify-content: center;

      transition: color 0.2s;

      z-index: 10;

    }


    .modal-close:hover {

      color: var(--brand-teal);

    }


    .modal-title {

      text-align: center;

      color: #ffffff;

      font-size: 20px;

      font-weight: 700;

      text-transform: uppercase;

      letter-spacing: 1px;

      margin-bottom: 5px;

      margin-top: 5px;

    }


    .modal-subtitle {

      text-align: center;

      color: #888;

      font-size: 12px;

      font-weight: 500;

      margin-bottom: 20px;

    }


    .modal-image-container {

      width: 100%;

      aspect-ratio: 1/1;

      background: radial-gradient(circle at center, #1a1a1a 0%, #000 70%);

      border: 2px solid #444;

      border-radius: 12px;

      overflow: hidden;

      margin-bottom: 20px;

      position: relative;

      box-shadow:

        0 4px 16px rgba(0, 0, 0, 0.5),

        inset 0 0 30px rgba(57, 165, 150, 0.05);

    }


    .modal-image-container::after {

      content: '';

      position: absolute;

      top: 0;

      left: 0;

      right: 0;

      bottom: 0;

      border-radius: 12px;

      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 50%, rgba(57, 165, 150, 0.05) 100%);

      pointer-events: none;

    }


    .modal-image-container img {

      width: 100%;

      height: 100%;

      object-fit: contain;

      padding: 10px;

      position: relative;

      z-index: 1;

    }


    .modal-btn {


    function renderClosetPanel() {
      const closet = getCloset();
      const container = document.getElementById('mnClosetPanelContent');
      if (!container) return;
      
      let html = `
        <div style="display:flex; gap:10px; margin-bottom: 20px;">
          <button id="mnUploadPhotoBtn" class="digital-closet-btn" onclick="window.location.href='/pages/my-closet'" style="flex:1;">
            <span>📸</span><span>Upload Photo</span>
          </button>
          <button class="digital-closet-btn" onclick="window.location.href='/pages/my-closet#ghost-mode'" style="flex:1; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.2); color:#fff;">
            <span>👻</span><span>Ghost Mode</span>
          </button>
        </div>
      `;

      if (closet.length === 0) {
        html += '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No items yet — upload clothing to start styling</p>';
        container.innerHTML = html;
        return;
      }
      
      // Group by section
      const sections = {};
      closet.forEach(item => {
        const s = item.closet_section || item.category || 'Other';
        if (!sections[s]) sections[s] = [];
        sections[s].push(item);
      });
      
      Object.entries(sections).forEach(([section, items]) => {
        html += `<div class="mn-panel-section-label">${section} <span style="opacity:0.5;">(${items.length})</span></div>`;
        html += '<div class="mn-panel-closet-grid">';
        items.forEach(item => {
          const emoji = getItemEmoji(item);
          const name  = item.original_name || item.name || 'Item';
          const meta  = [item.color, item.fabric].filter(Boolean).join(' · ');
          html += `<div class="mn-panel-closet-card">
            <div class="mn-panel-closet-emoji">${emoji}</div>
            <div class="mn-panel-closet-name">${name}</div>
            ${meta ? `<div class="mn-panel-closet-meta">${meta}</div>` : ''}
          </div>`;
        });
        html += '</div>';
      });
      container.innerHTML = html;
    }

    function renderHistoryPanel() {
      const history = getHistory();
      const container = document.getElementById('mnHistoryPanelContent');
      if (!container) return;
      if (history.length === 0) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);font-size:13px;text-align:center;padding:20px;">No outfits generated yet — open the AI Stylist to create your first look</p>';
        return;
      }
      let html = '';
      history.slice(0, 10).forEach(look => {
        const date = look.savedAt ? new Date(look.savedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '';
        const pieces = (look.outfit_pieces || []);
        html += `<div class="mn-panel-look-card">
          <div class="mn-panel-look-date">${date}</div>
          <div class="mn-panel-look-direction">${look.direction || look.context || 'AI Generated Outfit'}</div>
          <div class="mn-panel-look-pieces">
            ${pieces.map(p => `<span class="mn-panel-look-piece ${p.owned ? 'owned' : ''}">${getItemEmoji(p)} ${p.name || ''}</span>`).join('')}
          </div>
        </div>`;
      });
      container.innerHTML = html;
    }


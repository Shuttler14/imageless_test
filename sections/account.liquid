  <script>
    let currentOrderId = '';

    function openArtifactModal(imageUrl, title, orderId) {
      document.getElementById('modalImage').src = imageUrl;

      document.getElementById('modalTitle').textContent = title || 'Exclusive Drop';

      currentOrderId = orderId;

      document.getElementById('artifactModal').classList.add('active');

      document.body.style.overflow = 'hidden';
    }

    function closeArtifactModal() {
      document.getElementById('artifactModal').classList.remove('active');

      document.body.style.overflow = 'auto';
    }

    function viewPersonalityCard() {
      if (currentOrderId && typeof openVault === 'function') {
        closeArtifactModal();

        openVault(currentOrderId);
      } else {
        alert('Personality card feature is not available.');
      }
    }

    // Close modal when clicking outside

    document.getElementById('artifactModal').addEventListener('click', function (e) {
      if (e.target === this) {
        closeArtifactModal();
      }
    });
  </script>



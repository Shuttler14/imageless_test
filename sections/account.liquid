        grid.innerHTML = '<div style="text-align:center;margin-bottom:20px">' +
          '<div style="font-size:52px;font-weight:900;color:#fff;letter-spacing:-0.04em" id="mnHSliderVal">' + curH + '</div>' +
          '<div style="font-size:14px;color:#39A596;font-weight:700" id="mnHSliderFt">' + toFt(curH) + '</div>' +
          '<div style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:4px">cm</div></div>' +
          '<input type="range" id="mnHeightSlider" min="140" max="220" value="' + curH + '" step="1" style="width:100%;-webkit-appearance:none;height:6px;border-radius:99px;background:linear-gradient(90deg,#39A596 ' + Math.round(((curH-140)/80)*100) + '%,rgba(255,255,255,0.1) 0);outline:none;cursor:pointer;margin:10px 0"/>' +
          '<div style="display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,0.35);margin-top:6px"><span>140cm</span><span>220cm</span></div>' +
          '<style>#mnHeightSlider::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:#39A596;cursor:pointer;box-shadow:0 0 14px rgba(57,165,150,0.6);border:2px solid rgba(255,255,255,0.2)}</style>';
        const sl = grid.querySelector('#mnHeightSlider');
        const vd = grid.querySelector('#mnHSliderVal');
        const fd = grid.querySelector('#mnHSliderFt');
        if (sl) sl.addEventListener('input', function() {
          const v = parseInt(this.value);
          vd.textContent = v; fd.textContent = toFt(v);
          this.style.background = 'linear-gradient(90deg,#39A596 ' + Math.round(((v-140)/80)*100) + '%,rgba(255,255,255,0.1) 0)';
          _selectedValues = [v + ' cm'];
        });
        _selectedValues = [curH + ' cm'];

      } else if (cfg.type === 'budget_slider') {
        grid.style.gridTemplateColumns = '1fr';
        document.getElementById('mnEditCustomInput').style.display = 'none';
        const pStr = (p['budget'] || '').replace(/[^0-9,]/g,'').split(',');
        let minV = parseInt(pStr[0]) || 1000, maxV = parseInt(pStr[1]) || 8000;
        const toDisp = v => v >= 1000 ? '₹' + (v/1000).toFixed(v%1000===0?0:1) + 'K' : '₹' + v;
        const presets = [{l:'Under ₹1K',mn:500,mx:1000},{l:'₹1K–3K',mn:1000,mx:3000},{l:'₹3K–7K',mn:3000,mx:7000},{l:'₹7K–15K',mn:7000,mx:15000},{l:'₹15K–30K',mn:15000,mx:30000},{l:'₹30K+',mn:30000,mx:50000}];
        grid.innerHTML = '<div style="text-align:center;margin-bottom:16px">' +
          '<div style="font-size:24px;font-weight:900;color:#39A596" id="mnBudgetDisp">' + toDisp(minV) + ' – ' + toDisp(maxV) + '</div>' +
          '<div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px">per outfit</div></div>' +
          '<div style="position:relative;height:6px;background:rgba(255,255,255,0.1);border-radius:99px;margin:24px 0 8px">' +
          '<div id="mnBFill" style="position:absolute;height:100%;background:linear-gradient(90deg,#39A596,#2dd4bf);border-radius:99px"></div>' +
          '<input type="range" id="mnBMin" min="500" max="50000" value="'+minV+'" step="500" style="position:absolute;width:100%;-webkit-appearance:none;background:transparent;height:6px;pointer-events:none;top:0;margin:0"/>' +
          '<input type="range" id="mnBMax" min="500" max="50000" value="'+maxV+'" step="500" style="position:absolute;width:100%;-webkit-appearance:none;background:transparent;height:6px;pointer-events:none;top:0;margin:0"/>' +
          '<style>#mnBMin::-webkit-slider-thumb,#mnBMax::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:#39A596;cursor:pointer;pointer-events:all;box-shadow:0 0 10px rgba(57,165,150,0.5)}</style></div>' +
          '<div style="display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,0.35);margin-bottom:20px"><span>₹500</span><span>₹50K+</span></div>' +
          '<div style="display:flex;flex-wrap:wrap;gap:6px">' + presets.map(function(pr){ return '<button onclick="mnBPreset(' + pr.mn + ',' + pr.mx + ')" style="font-size:11px;font-weight:700;padding:6px 12px;border-radius:99px;border:1.5px solid rgba(255,255,255,0.1);background:transparent;color:rgba(255,255,255,0.5);cursor:pointer;font-family:Montserrat,sans-serif">' + pr.l + '</button>'; }).join('') + '</div>';
        
        window.mnBPreset = function(mn,mx) {
          document.getElementById('mnBMin').value = mn;
          document.getElementById('mnBMax').value = mx;
          mnUpdateBudget();
        };
        function mnUpdateBudget() {
          let mn = parseInt(document.getElementById('mnBMin').value);
          let mx = parseInt(document.getElementById('mnBMax').value);
          if (mn > mx) { const t=mn; mn=mx; mx=t; }
          document.getElementById('mnBudgetDisp').textContent = toDisp(mn) + ' – ' + toDisp(mx);
          const total = 50000-500;
          const lp = ((mn-500)/total)*100, rp = ((mx-500)/total)*100;
          const fill = document.getElementById('mnBFill');
          if (fill) { fill.style.left=lp+'%'; fill.style.width=(rp-lp)+'%'; }
          _selectedValues = ['₹'+mn.toLocaleString('en-IN')+'–₹'+mx.toLocaleString('en-IN')];

        {% comment %} CHECK FOR SPECIAL CODE TEST649 {% endcomment %}

        {% assign is_special_order = false %}

        {% for discount in order.discount_applications %}
          {% if discount.title == 'TEST649' %}
            {% assign is_special_order = true %}
          {% endif %}
        {% endfor %}

        {% for line_item in order.line_items %}
          {% comment %} LOGIC: Paid item OR Special Code Order {% endcomment %}

          {% if line_item.final_price > 0 or is_special_order %}
            {% comment %} 1. COUNT ITEMS {% endcomment %}

            {% assign total_items = total_items | plus: line_item.quantity %}

            {% comment %} 2. FETCH MASCOT {% endcomment %}

            {% assign mascot = line_item.product.metafields.custom.mascot_file %}

            {% if mascot %}
              {% assign img_url = mascot | image_url: width: 400 %}

            {% else %}
              {% assign img_url = line_item.image | image_url: width: 400 %}
            {% endif %}

            {% comment %} 3. GET COLLECTION NAME {% endcomment %}

            {% if line_item.product.collections.size > 0 %}
              {% assign collection_name = line_item.product.collections.first.title %}

            {% else %}
              {% assign collection_name = 'Exclusive Drop' %}
            {% endif %}

            {% assign collected_images = collected_images | append: img_url | append: '||' %}

            {% assign collected_titles = collected_titles | append: collection_name | append: '||' %}

            {% assign collected_order_ids = collected_order_ids | append: order.id | append: '||' %}
          {% endif %}
        {% endfor %}
      {% endunless %}
    {% endfor %}

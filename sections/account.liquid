    function mnInitStyleCards() {
      const container = document.getElementById('mnStyleCardsGrid');
      if (!container) return;
      
      container.innerHTML = STYLE_PREFERENCES.map(style => `
        <div class="mn-style-card" data-style="${style.id}" onclick="mnToggleStyleCard('${style.id}')">
          <span class="mn-style-card-emoji">${style.emoji}</span>
          <span class="mn-style-card-label">${style.label}</span>
        </div>
      `).join('');
      
      // Load saved preferences
      const profile = getProfile();
      if (profile.stylePreferences && Array.isArray(profile.stylePreferences)) {
        profile.stylePreferences.forEach(id => {
          container.querySelector(`[data-style="${id}"]`)?.classList.add('selected');
        });
      }
    }

    function mnToggleStyleCard(styleId) {
      const card = document.querySelector(`[data-style="${styleId}"]`);
      if (!card) return;
      
      card.classList.toggle('selected');
      
      // Update profile
      const profile = getProfile();
      if (!profile.stylePreferences) profile.stylePreferences = [];
      
      if (card.classList.contains('selected')) {
        if (!profile.stylePreferences.includes(styleId)) {
          profile.stylePreferences.push(styleId);
        }
      } else {
        profile.stylePreferences = profile.stylePreferences.filter(s => s !== styleId);
      }
      
      saveProfile(profile);
      mnUpdateProgress(profile);
      mnDebouncedSave();
    }

    // =====================================================
    // CORE INTERESTS COMBOBOX
    // =====================================================
    
    const CORE_INTERESTS = [
      'Tech Innovator', 'Fitness Junkie', 'Digital Nomad', 'Gamer', 
      'Music Lover', 'Traveler', 'Foodie', 'Art Enthusiast', 
      'Entrepreneur', 'Student', 'Professional', 'Creative',
      'Other (Type your own)'
    ];

    function mnInitInterests() {
      const container = document.getElementById('mnInterestsContainer');
      if (!container) return;
      
      container.innerHTML = CORE_INTERESTS.map(interest => `
        <span class="mn-interest-tag" data-interest="${interest}" onclick="mnToggleInterest('${interest}')">${interest}</span>
      `).join('');
      
      // Load saved interests
      const profile = getProfile();
      if (profile.coreInterests && Array.isArray(profile.coreInterests)) {
        profile.coreInterests.forEach(interest => {
          container.querySelector(`[data-interest="${interest}"]`)?.classList.add('selected');
        });
      }
    }

    function mnToggleInterest(interest) {
      const tag = document.querySelector(`[data-interest="${interest}"]`);
      if (!tag) return;
      
      if (interest === 'Other (Type your own)') {
        const custom = prompt('Enter your custom interest:');
        if (custom) {
          mnAddCustomInterest(custom);
        }
        return;
      }
      
      tag.classList.toggle('selected');
      
      const profile = getProfile();
      if (!profile.coreInterests) profile.coreInterests = [];
      
      if (tag.classList.contains('selected')) {
        if (!profile.coreInterests.includes(interest)) {
          profile.coreInterests.push(interest);
        }
      } else {
        profile.coreInterests = profile.coreInterests.filter(i => i !== interest);
      }
      
      saveProfile(profile);
      mnUpdateProgress(profile);
      mnDebouncedSave();
    }

    function mnAddCustomInterest(customInterest) {
      const container = document.getElementById('mnInterestsContainer');
      
      const tag = document.createElement('span');
      tag.className = 'mn-interest-tag selected';
      tag.dataset.interest = customInterest;
      tag.textContent = customInterest;
      tag.onclick = () => mnToggleInterest(customInterest);
      
      container.appendChild(tag);
      
      const profile = getProfile();
      if (!profile.coreInterests) profile.coreInterests = [];
      profile.coreInterests.push(customInterest);
      saveProfile(profile);
      mnUpdateProgress(profile);
      mnDebouncedSave();
    }

    // =====================================================
    // GHOST MODE TOGGLE
    // =====================================================
    
    function mnToggleGhostMode() {
      const toggle = document.getElementById('mnGhostToggle');
      if (!toggle) return;
      
      toggle.classList.toggle('active');
      window.MN_USER.ghost_mode = toggle.classList.contains('active');
      
      // Save preference
      localStorage.setItem('mn_ghost_mode', window.MN_USER.ghost_mode);
      mnDebouncedSave();
      
      // Open Digital Closet ghost flow when activated
      if (window.MN_USER.ghost_mode) {
        window.location.href = '/pages/my-closet#ghost-mode';
      }
      
      // Dispatch event for other components
      window.dispatchEvent(new CustomEvent('mn-ghost-mode-changed', { 
        detail: { active: window.MN_USER.ghost_mode } 
      }));
    }

    // =====================================================
    // INITIALIZE ALL DASHBOARD FEATURES
    // =====================================================
    
    document.addEventListener('DOMContentLoaded', function() {
      // Load saved ghost mode
      const savedGhost = localStorage.getItem('mn_ghost_mode');
      if (savedGhost === 'true') {
        document.getElementById('mnGhostToggle')?.classList.add('active');
        window.MN_USER.ghost_mode = true;
      }
      
      // Initialize all features
      mnPopulateCardVariants();
      mnInitStyleCards();
      mnInitInterests();
      mnInitWeatherWidget();
      mnRenderSavedCards();
      
      // Set initial height vector
      const profile = getProfile();
      const heightCm = parseInt(profile.height) || 170;
      setTimeout(() => mnUpdateHeightVector(heightCm), 100);
      
      // Update progress on load
      setTimeout(() => mnUpdateProgress(profile), 200);
    });

    // Listen for profile updates
    window.addEventListener('mn-identity-updated', function(e) {
      const profile = e.detail || getProfile();
      mnUpdateProgress(profile);
    });
  </script>


    font-family: Montserrat, sans-serif;
    width: 100%;
    box-sizing: border-box;
    outline: none;
  }

  .bc-mega-form input:focus,
  .bc-mega-form select:focus,
  .bc-mega-form textarea:focus {
    border-color: var(--bc-primary);
    box-shadow: 0 0 0 2px rgba(57, 165, 150, 0.2);

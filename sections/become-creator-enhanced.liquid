  /* Final CTA */
  .bc-final-cta {
    padding: 32px 20px;
    text-align: center;
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .bc-final-cta-text {
    color: var(--bc-text-muted);
    font-size: 13px;
    margin-bottom: 12px;
  }

  /* Button Styles */
  .bc-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 28px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 700;
    font-family: Montserrat, sans-serif;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .bc-btn-primary {
    background: linear-gradient(135deg, var(--bc-primary), var(--bc-primary-light));
    color: #000;
    box-shadow: 0 0 20px rgba(57, 165, 150, 0.35);
  }

  .bc-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 28px rgba(57, 165, 150, 0.45);
  }

  .bc-btn-gold {
    background: linear-gradient(135deg, var(--bc-gold), #F97316);
    color: #000;
  }

  .bc-btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(255, 215, 0, 0.3);
  }

  .bc-btn-teal {
    background: rgba(57, 165, 150, 0.15);
    color: var(--bc-primary);
    border: 1px solid rgba(57, 165, 150, 0.4);
  }

  .bc-btn-teal:hover {
    transform: translateY(-2px);
    border-color: var(--bc-primary);
    box-shadow: 0 0 16px rgba(57, 165, 150, 0.25);
  }

  .bc-btn-small {
    padding: 8px 16px;
    font-size: 12px;
  }

  /* Modal */
  .bc-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    backdrop-filter: blur(2px);
  }

  .bc-modal.open {
    display: flex;
  }

  .bc-modal-card {
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 28px 20px;
    width: 100%;
    max-width: 420px;
    position: relative;
  }

  .bc-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 20px;
    cursor: pointer;
    padding: 4px 8px;
    transition: color 0.2s;
  }

  .bc-modal-close:hover {
    color: var(--bc-white);
  }

  .bc-modal-title {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 20px;
  }

  .bc-modal-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.03);
  }

  .bc-modal-row-elite {
    border-color: rgba(255, 215, 0, 0.3);
  }

  .bc-modal-icon {
    font-size: 28px;
    flex-shrink: 0;
  }

  .bc-modal-content {
    flex: 1;
    text-align: left;
    min-width: 0;
  }

  .bc-modal-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--bc-white);
  }

  .bc-modal-desc {
    font-size: 12px;
    color: var(--bc-text-muted);
    margin-top: 2px;
  }

  .bc-modal-note {
    font-size: 11px;
    color: var(--bc-text-muted);
    text-align: center;
    margin-top: 4px;
  }

  /* Mobile Responsive */
  @media (max-width: 640px) {
    .bc-hero {
      padding: 36px 16px 28px;
    }

    .bc-step-circle {
      width: 44px;
      height: 44px;
    }

    .bc-step-icon {
      font-size: 18px;
    }

    .bc-step-connector {
      top: 22px;
    }

    .bc-step-label {
      font-size: 9px;
    }

    .bc-steps-flow {
      max-width: 100%;
    }

    .bc-stat-number {
      font-size: 18px;
    }

    .bc-mega-form input,
    .bc-mega-form select,
    .bc-mega-form textarea {
      font-size: 16px;
    }

    .bc-platform-name {
      font-size: 11px;
    }

    .bc-gold-divider-text {
      font-size: 9px;
      letter-spacing: 0.5px;
    }

    .bc-modal-card {
      max-width: calc(100vw - 32px);
      padding: 20px 16px;
    }
  }
</style>

<script>
  // Modal Functions
  // -- Backend API base --
  const BC_API = 'https://mynarrative-ai-peach.vercel.app';

  // -- Platform meta --
  const BC_PLATFORMS = {
    instagram: { icon: '&#x1F4F8;', name: 'Instagram',  threshold: 500000, label: '500K+ followers' },
    youtube:   { icon: '&#x1F3AC;', name: 'YouTube',    threshold: 300000, label: '300K+ subscribers' },
    twitter:   { icon: '&#x1F426;', name: 'X / Twitter', threshold: 200000, label: '200K+ followers' },
    linkedin:  { icon: '&#x1F4BC;', name: 'LinkedIn',   threshold: 150000, label: '150K+ followers' }
  };

  let bcActivePlatform = null;

  // Scroll helper used by URL param ?type=elite
  function closeModalAndScroll() {
    setTimeout(() => {
      var el = document.getElementById('bcEliteSection');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 200);
  }

  // -- Social Verification via Nango OAuth --
  // Nango connect session - handled entirely by backend using NANGO_SECRET_KEY

  // Creator ID: use Shopify customer id if logged in, else a session fingerprint
  const BC_CREATOR_ID = '{% if customer %}{{ customer.id }}{% else %}guest-' + Date.now() + '{% endif %}';

  // -- Social Verification --
  function bcStartVerification(platform) {
    bcActivePlatform = platform;
    const meta = BC_PLATFORMS[platform];
    if (!meta) return;

    // Populate the verify modal
    document.getElementById('bcVerifyIcon').innerHTML = meta.icon;
    document.getElementById('bcVerifyTitle').textContent = 'Connect ' + meta.name;
    document.getElementById('bcVerifySubtitle').textContent =
      'Click below to securely connect your ' + meta.name + ' account. We\'ll verify your follower count (' + meta.label + ' required) via OAuth - we never store your password.';
    document.getElementById('bcVerifyForm').style.display = 'block';
    document.getElementById('bcVerifyResult').style.display = 'none';
    document.getElementById('bcVerifyResult').innerHTML = '';

    // Update button text
    const btn = document.querySelector('#bcVerifyModal .bc-btn-primary');
    if (btn) btn.innerHTML = '&#x1F517; Connect ' + meta.name + ' Securely';

    document.getElementById('bcVerifyModal').classList.add('open');
  }

  function bcCloseVerifyModal() {
    document.getElementById('bcVerifyModal').classList.remove('open');
    bcActivePlatform = null;
  }

  async function bcSubmitVerification() {
    const platform = bcActivePlatform;
    const meta = BC_PLATFORMS[platform];
    const btn = document.querySelector('#bcVerifyModal .bc-btn-primary');
    const resultEl = document.getElementById('bcVerifyResult');
    const formEl = document.getElementById('bcVerifyForm');

    btn.disabled = true;
    btn.innerHTML = '&#x23F3; Connecting...';

    try {
      // Step 1: Get Nango connect session token from our backend
      const sessionRes = await fetch(
        BC_API + '/api/social/connect?platform=' + platform + '&creator_id=' + encodeURIComponent(BC_CREATOR_ID)
      );
      const sessionJson = await sessionRes.json();

      if (!sessionJson.success) throw new Error(sessionJson.error || 'Could not initiate connection');

      const connectURL = sessionJson.connectURL;

      if (sessionJson.mock) {
        // Dev/demo mode - Nango keys not configured yet, show setup message
        formEl.style.display = 'none';
        resultEl.style.display = 'block';
        resultEl.innerHTML = '<div class="bc-verify-result-fail" style="border-color:rgba(255,215,0,0.4);background:rgba(255,215,0,0.04);color:rgba(255,255,255,0.8);">' +
          '&#x26A0;&#xFE0F; <strong style="color:#FFD700;">Setup Required</strong><br>' +
          '<span style="font-size:12px;line-height:1.6;">OAuth verification requires Nango API key.<br>' +
          'Please configure <code style="color:#4ECDC4;">NANGO_SECRET_KEY</code> in your Vercel environment variables.</span>' +
          '</div>' +
          '<a href="/pages/creator-onboarding?type=elite&platform=' + platform + '" class="bc-btn bc-btn-teal" style="width:100%;justify-content:center;margin-top:10px;display:flex;">' +
          'Apply Manually &rarr;</a>';
        btn.disabled = false;
        btn.innerHTML = '&#x1F517; Connect ' + meta.name + ' Securely';
        return;
      }

      // Step 2: Open OAuth popup directly (no Nango SDK needed - uses NANGO_SECRET_KEY on backend)
      window.open(connectURL, 'nango-connect-' + platform, 'width=600,height=700,scrollbars=yes');

      // Step 3: Nango webhook fires to /api/social/verify automatically.
      // Poll /api/social/status to get the result.
      btn.innerHTML = '&#x23F3; Verifying your account...';
      const result = await bcPollVerificationStatus(platform);
      bcHandleVerificationResult(platform, result);

    } catch (err) {
      console.error('Verification error:', err);
      // Fallback: manual apply
      formEl.style.display = 'none';
      resultEl.style.display = 'block';
      resultEl.innerHTML = '<div class="bc-verify-result-fail" style="border-color:rgba(255,215,0,0.3);background:rgba(255,215,0,0.05);color:rgba(255,255,255,0.7);">' +
        '&#x26A0; Could not complete OAuth flow. ' + (err.message || '') + '<br>' +
        '<span style="font-size:11px;">You can still apply \u2014 our team will manually verify within 24 hours.</span>' +
        '</div>' +
        '<a href="/pages/creator-onboarding?type=elite&platform=' + platform + '" class="bc-btn bc-btn-teal" style="width:100%;justify-content:center;margin-top:10px;display:flex;">' +
        'Apply Manually &rarr;</a>';
    }

    btn.disabled = false;
    btn.innerHTML = '&#x1F517; Connect ' + (BC_PLATFORMS[bcActivePlatform || platform]?.name || '') + ' Securely';
  }

  async function bcPollVerificationStatus(platform) {
    // Poll /api/social/status up to 12 times (every 2.5s = 30s max)
    for (let i = 0; i < 12; i++) {
      await new Promise(r => setTimeout(r, 2500));
      try {
        const res = await fetch(BC_API + '/api/social/status?creator_id=' + encodeURIComponent(BC_CREATOR_ID));
        const json = await res.json();
        if (json.success) {
          const platformData = (json.platforms || []).find(p => p.platform === platform);
          if (platformData && platformData.last_synced) return platformData;
        }
      } catch (e) { /* retry */ }
    }
    return null; // Timed out
  }

  function bcHandleVerificationResult(platform, platformData) {
    const meta = BC_PLATFORMS[platform];
    const formEl = document.getElementById('bcVerifyForm');
    const resultEl = document.getElementById('bcVerifyResult');
    formEl.style.display = 'none';
    resultEl.style.display = 'block';

    if (!platformData) {
      // Timed out - webhook may still be processing
      resultEl.innerHTML = '<div class="bc-verify-result-success" style="border-color:rgba(255,215,0,0.4);background:rgba(255,215,0,0.05);color:rgba(255,255,255,0.85);">' +
        '&#x2705; Connected! We\'re verifying your account in the background.<br>' +
        '<span style="font-size:12px;color:rgba(255,255,255,0.6);">This usually takes under a minute. You\'ll get an email once verified.</span>' +
        '</div>' +
        '<a href="/pages/creator-onboarding?type=elite&platform=' + platform + '" class="bc-btn bc-btn-primary" style="width:100%;justify-content:center;margin-top:12px;display:flex;">' +
        'Continue Application &rarr;</a>';
      bcMarkChip(platform, 'pending');
      return;
    }

    const qualifies = platformData.qualifies_elite;
    const followers = platformData.follower_count || 0;
    const commissionRange = platformData.commission_range || '30-45%';
    const commissionNote = platformData.commission_note || 'Final rate determined post-review';

    if (qualifies) {
      bcMarkChip(platform, 'verified', platformData.username);
      resultEl.innerHTML = '<div class="bc-verify-result-success">' +
        '&#x2728; Verified! You qualify for the Elite Creator program.<br>' +
        '<strong style="font-size:14px;color:#4ECDC4;">' + commissionRange + ' commission</strong><br>' +
        '<span style="font-size:12px;font-weight:400;color:rgba(255,255,255,0.65);">' + commissionNote + '</span>' +
        '</div>' +
        '<a href="/pages/creator-onboarding?type=elite&platform=' + platform + '" class="bc-btn bc-btn-primary" style="width:100%;justify-content:center;margin-top:12px;display:flex;">' +
        'Apply as Elite Creator &#x1F451;</a>';
    } else {
      bcMarkChip(platform, 'failed');
      const needed = meta.threshold >= 1000000
        ? (meta.threshold / 1000000).toFixed(1) + 'M'
        : (meta.threshold / 1000) + 'K';
      const have = followers >= 1000 ? Math.round(followers / 1000) + 'K' : followers;
      resultEl.innerHTML = '<div class="bc-verify-result-fail">' +
        'Your ' + meta.name + ' has ' + have + ' followers. You need ' + needed + '+ to qualify.<br>' +
        '<span style="font-size:11px;">Keep growing and apply again when you qualify!</span>' +
        '</div>' +
        '<button class="bc-btn bc-btn-teal" style="width:100%;justify-content:center;margin-top:10px;" onclick="bcCloseVerifyModal()">' +
        'Try Another Platform</button>';
    }
  }

  function bcMarkChip(platform, state, username) {
    const key = platform.charAt(0).toUpperCase() + platform.slice(1);
    const chip = document.getElementById('bcChip' + key);
    const statusEl = document.getElementById('bcStatus' + key);
    const ctaEl = chip ? chip.querySelector('.bc-chip-cta') : null;
    if (!chip) return;
    chip.classList.remove('bc-chip-verified', 'bc-chip-failed');
    if (state === 'verified') {
      chip.classList.add('bc-chip-verified');
      if (ctaEl) ctaEl.innerHTML = '&#x2713; Verified';
      if (statusEl) statusEl.innerHTML = '<span style="color:#39A596;font-size:10px;font-weight:700;">&#x2713; ' + (username ? '@' + username : 'Connected') + '</span>';
    } else if (state === 'failed') {
      chip.classList.add('bc-chip-failed');
      if (ctaEl) ctaEl.textContent = 'Does not qualify';
    } else if (state === 'pending') {
      if (ctaEl) ctaEl.innerHTML = '&#x23F3; Verifying...';
      if (statusEl) statusEl.innerHTML = '<span style="color:#FFD700;font-size:10px;">Checking...</span>';
    }
  }

  // Close verify modal on overlay click
  document.getElementById('bcVerifyModal')?.addEventListener('click', function(e) {
    if (e.target === this) bcCloseVerifyModal();
  });

  // On load: check if any platforms already verified (returning user)
  async function bcLoadExistingStatus() {
    {% if customer %}
    try {
      const res = await fetch(BC_API + '/api/social/status?creator_id={{ customer.id }}');
      const json = await res.json();
      if (json.success && json.platforms) {
        json.platforms.forEach(p => {
          if (p.qualifies_elite) bcMarkChip(p.platform, 'verified', p.username);
          else if (p.last_synced) bcMarkChip(p.platform, 'failed');
        });
      }
    } catch (e) { /* silent */ }
    {% endif %}
  }
  bcLoadExistingStatus();

  // Mega Tier Toggle
  function toggleMegaTier() {
    const megaCard = document.querySelector('.bc-mega-card');
    megaCard.classList.toggle('expanded');
  }

  // Mega Form Handler
  function handleMegaForm(e) {
    e.preventDefault();
    const form = document.getElementById('bcMegaForm');
    const successDiv = document.querySelector('.bc-mega-success');
    form.style.display = 'none';
    successDiv.style.display = 'block';
  }

  // Initialize on DOM Ready
  document.addEventListener('DOMContentLoaded', function() {
    // Intersection Observer for animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);

    const animElements = document.querySelectorAll('.bc-animate');
    animElements.forEach(el => observer.observe(el));

    // Check URL for type=elite parameter
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('type') === 'elite') {
      setTimeout(() => closeModalAndScroll(), 600);
    }

    // Mega form submission
    const megaForm = document.getElementById('bcMegaForm');
    if (megaForm) {
      megaForm.addEventListener('submit', handleMegaForm);
    }

  });
</script>


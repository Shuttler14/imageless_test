<div class="bc-page">
  <!-- Fixed background shapes -->
  <div class="bc-bg-shape bc-bg-shape-teal"></div>
  <div class="bc-bg-shape bc-bg-shape-purple"></div>

  <!-- HERO SECTION -->
  <section class="bc-hero">
    <div class="bc-badge">&#x1F3A8; Design. Sell. Earn.</div>
    <h1 class="bc-hero-title">
      <span class="bc-hero-line1">Turn Creativity</span>
      <span class="bc-hero-line2">Into Real Income</span>
    </h1>
    
    <div class="bc-stat-strip">
      <div class="bc-stat-item">
        <span class="bc-stat-number">50K+</span>
        <span class="bc-stat-label">Creators</span>
      </div>
      <span class="bc-stat-divider">&bull;</span>
      <div class="bc-stat-item">
        <span class="bc-stat-number">&#x20B9;2L/mo</span>
        <span class="bc-stat-label">Top Earners</span>
      </div>
      <span class="bc-stat-divider">&bull;</span>
      <div class="bc-stat-item">
        <span class="bc-stat-number">Zero</span>
        <span class="bc-stat-label">Investment</span>
      </div>
    </div>

    <button class="bc-btn bc-btn-primary" onclick="openIntentModal()">&#x2728; Start Creating Today</button>
  </section>

  <!-- SOCIAL PROOF MARQUEE -->
  <section class="bc-social-proof">
    <div class="bc-marquee-wrapper">
      <div class="bc-marquee">
        <div class="bc-avatar" style="background: #39A596;">A</div>
        <div class="bc-avatar" style="background: #4ECDC4;">M</div>
        <div class="bc-avatar" style="background: #A855F7;">S</div>
        <div class="bc-avatar" style="background: #39A596;">R</div>
        <div class="bc-avatar" style="background: #FFD700;">K</div>
        <div class="bc-avatar" style="background: #A855F7;">P</div>
        <div class="bc-avatar" style="background: #FF6B9D;">D</div>
        <div class="bc-avatar" style="background: #39A596;">N</div>
        <!-- Duplicates for seamless loop -->
        <div class="bc-avatar" style="background: #39A596;">A</div>
        <div class="bc-avatar" style="background: #4ECDC4;">M</div>
        <div class="bc-avatar" style="background: #A855F7;">S</div>
        <div class="bc-avatar" style="background: #39A596;">R</div>
        <div class="bc-avatar" style="background: #FFD700;">K</div>
        <div class="bc-avatar" style="background: #A855F7;">P</div>
        <div class="bc-avatar" style="background: #FF6B9D;">D</div>
        <div class="bc-avatar" style="background: #39A596;">N</div>
      </div>
    </div>
    <div class="bc-social-proof-text">50K+ earning &rarr;</div>
  </section>

  <!-- EARNINGS STRIP -->
  <section class="bc-earnings-strip">
    <div class="bc-earning-card">
      <div class="bc-earning-amount" style="color: #39A596;">&#x20B9;25K</div>
      <div class="bc-earning-label">avg/month</div>
    </div>
    <div class="bc-earning-card">
      <div class="bc-earning-amount">&#x20B9;75K</div>
      <div class="bc-earning-label">top 25%</div>
    </div>
    <div class="bc-earning-card">
      <div class="bc-earning-amount" style="color: #FFD700;">&#x20B9;2L+</div>
      <div class="bc-earning-label">top creators</div>
    </div>
  </section>

  <!-- HOW IT WORKS FLOWCHART -->
  <section class="bc-how-it-works">
    <div class="bc-section-label">HOW IT WORKS</div>
    <div class="bc-steps-flow">
      <!-- Step 1: Sign Up -->
      <div class="bc-step-node bc-animate">
        <div class="bc-step-circle" style="border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);">
          <span class="bc-step-icon">&#x1F4F1;</span>
        </div>
        <div class="bc-step-connector"></div>
        <div class="bc-step-label">Sign Up</div>
      </div>

      <!-- Step 2: Design -->
      <div class="bc-step-node bc-animate">
        <div class="bc-step-circle" style="border-color: #39A596; background: rgba(57,165,150,0.15); box-shadow: 0 0 16px rgba(57,165,150,0.25);">
          <span class="bc-step-icon">&#x1F3A8;</span>
        </div>
        <div class="bc-step-connector"></div>
        <div class="bc-step-label">Design</div>
      </div>

      <!-- Step 3: Share -->
      <div class="bc-step-node bc-animate">
        <div class="bc-step-circle" style="border-color: #A855F7; background: rgba(168,85,247,0.15); box-shadow: 0 0 16px rgba(168,85,247,0.2);">
          <span class="bc-step-icon">&#x1F4E3;</span>
        </div>
        <div class="bc-step-connector"></div>
        <div class="bc-step-label">Share</div>
      </div>

      <!-- Step 4: Earn -->
      <div class="bc-step-node bc-step-node--last bc-animate">
        <div class="bc-step-circle" style="border-color: #FFD700; background: rgba(255,215,0,0.15); box-shadow: 0 0 16px rgba(255,215,0,0.25);">
          <span class="bc-step-icon">&#x1F4B0;</span>
        </div>
        <div class="bc-step-label">Earn</div>
      </div>
    </div>
  </section>

  <!-- ELITE CREATOR SECTION -->
  <section id="bcEliteSection" class="bc-elite-section">
    <div class="bc-badge" style="border-color: rgba(255,215,0,0.5);">&#x1F451; Elite Creator Program</div>
    <h2 class="bc-elite-title">For Creators With Influence</h2>
    <p class="bc-elite-subtitle">Qualify on <strong style="color:#fff;">any ONE</strong> platform below to apply. Your exact commission (30&ndash;45%) is determined post-verification based on your reach and engagement.</p>

    <!-- Platform Grid - each chip is clickable and triggers verification -->
    <div class="bc-platform-grid">

      <!-- Instagram -->
      <div class="bc-platform-chip" id="bcChipInstagram" onclick="bcStartVerification('instagram')" role="button" tabindex="0" aria-label="Verify with Instagram">
        <div class="bc-platform-icon">&#x1F4F8;</div>
        <div class="bc-platform-name">Instagram</div>
        <div class="bc-threshold-badge">500K+ followers</div>
        <div class="bc-platform-commission">30&ndash;45% commission</div>
        <div class="bc-chip-cta">Tap to Verify &rarr;</div>
        <div class="bc-chip-status" id="bcStatusInstagram"></div>
      </div>

      <!-- YouTube -->
      <div class="bc-platform-chip" id="bcChipYoutube" onclick="bcStartVerification('youtube')" role="button" tabindex="0" aria-label="Verify with YouTube">
        <div class="bc-platform-icon">&#x1F3AC;</div>
        <div class="bc-platform-name">YouTube</div>
        <div class="bc-threshold-badge">300K+ subscribers</div>
        <div class="bc-platform-commission">30&ndash;45% commission</div>
        <div class="bc-chip-cta">Tap to Verify &rarr;</div>
        <div class="bc-chip-status" id="bcStatusYoutube"></div>
      </div>

      <!-- X / Twitter -->
      <div class="bc-platform-chip" id="bcChipTwitter" onclick="bcStartVerification('twitter')" role="button" tabindex="0" aria-label="Verify with X / Twitter">
        <div class="bc-platform-icon">&#x1F426;</div>
        <div class="bc-platform-name">X / Twitter</div>
        <div class="bc-threshold-badge">200K+ followers</div>
        <div class="bc-platform-commission">30&ndash;45% commission</div>
        <div class="bc-chip-cta">Tap to Verify &rarr;</div>
        <div class="bc-chip-status" id="bcStatusTwitter"></div>
      </div>

      <!-- LinkedIn -->
      <div class="bc-platform-chip" id="bcChipLinkedin" onclick="bcStartVerification('linkedin')" role="button" tabindex="0" aria-label="Verify with LinkedIn">
        <div class="bc-platform-icon">&#x1F4BC;</div>
        <div class="bc-platform-name">LinkedIn</div>
        <div class="bc-threshold-badge">150K+ followers</div>
        <div class="bc-platform-commission">30&ndash;45% commission</div>
        <div class="bc-chip-cta">Tap to Verify &rarr;</div>
        <div class="bc-chip-status" id="bcStatusLinkedin"></div>
      </div>

    </div>

    <p class="bc-elite-note">&#x2728; Qualify on any ONE &bull; Connect all for maximum sales reach &amp; marketing</p>

    <!-- Verification modal (shown when chip is tapped) -->
    <div id="bcVerifyModal" class="bc-verify-modal">
      <div class="bc-verify-card">
        <button class="bc-modal-close" onclick="bcCloseVerifyModal()">&times;</button>
        <div id="bcVerifyIcon" class="bc-verify-icon"></div>
        <h3 id="bcVerifyTitle" class="bc-verify-title">Verify Your Account</h3>
        <p id="bcVerifySubtitle" class="bc-verify-subtitle">Enter your handle and we'll check your follower count via our secure backend.</p>
        <div id="bcVerifyForm">
          <div style="background:rgba(57,165,150,0.07);border:1px solid rgba(57,165,150,0.2);border-radius:12px;padding:12px 14px;margin-bottom:14px;font-size:12px;color:rgba(255,255,255,0.6);line-height:1.6;">
            &#x1F512; <strong style="color:#4ECDC4;">Secure OAuth connection</strong><br>
            We connect via official API. We never see or store your password. You can revoke access anytime.
          </div>
          <button class="bc-btn bc-btn-primary" style="width:100%;justify-content:center;" onclick="bcSubmitVerification()">
            &#x1F517; Connect Securely
          </button>
        </div>
        <div id="bcVerifyResult" style="display:none;"></div>
      </div>
    </div>

    <!-- Apply Button with Liquid logic -->
    {% if customer %}
      <div style="margin-top:16px;">
        <a href="/pages/creator-onboarding?type=elite" class="bc-btn bc-btn-teal">Verify &amp; Apply as Elite &#x1F451;</a>
        <p style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:8px;">Or tap any platform above to verify your follower count first</p>
      </div>
    {% else %}
      <div style="margin-top:16px;">
        <a href="/account/login?return_url=/pages/become-creator%23bcEliteSection" class="bc-btn bc-btn-teal">Create Account to Apply</a>
        <p class="bc-login-note">You need a My Narrative account to apply as Elite Creator</p>
      </div>
    {% endif %}

    <!-- Gold Divider -->
    <div class="bc-gold-divider">
      <div class="bc-gold-divider-line"></div>
      <span class="bc-gold-divider-text">&#x2B50; INVITE ONLY &mdash; 50% COMMISSION</span>
      <div class="bc-gold-divider-line"></div>
    </div>

    <!-- Mega Tier Collapsible Card -->
    <div class="bc-mega-card">
      <div class="bc-mega-header" onclick="toggleMegaTier()">
        <div class="bc-mega-header-left">
          <span class="bc-mega-crown">&#x1F451;</span>
          <div class="bc-mega-title">Mega Influencer &mdash; Up to 50% Commission</div>
        </div>
        <span class="bc-mega-toggle">&#x2193;</span>
      </div>
      <div class="bc-mega-body">
        <p class="bc-mega-description">For creators with 1M+ followers. Our highest-earning partnership.</p>
        <form class="bc-mega-form" id="bcMegaForm">
          <input type="text" placeholder="Your full name" required />
          <input type="email" placeholder="your@email.com" required />
          <select required>
            <option value="">Select Platform</option>
            <option value="instagram">Instagram</option>
            <option value="youtube">YouTube</option>
            <option value="x">X (Twitter)</option>
            <option value="linkedin">LinkedIn</option>
            <option value="other">Other</option>
          </select>
          <input type="text" placeholder="@yourhandle" required />
          <input type="text" placeholder="e.g. 1,200,000" required />
          <textarea placeholder="Tell us about your audience and why you want to partner with My Narrative..." rows="3" required></textarea>
          <button type="submit" class="bc-btn bc-btn-gold" style="width: 100%;">&#x2728; Submit My Interest</button>
        </form>
        <div class="bc-mega-success" style="display: none;">
          &#x1F389; Thank you! Our team will review your profile and reach out within 48 hours.
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bc-final-cta">
    <p class="bc-final-cta-text">Ready to start earning?</p>
    <button class="bc-btn bc-btn-primary" onclick="openIntentModal()">&#x2728; Start Creating Today</button>
  </section>

  {% comment %}
    Legacy "Choose Your Path" modal (bcPathModal / openBcModal) removed —
    the main CTA now uses openIntentModal() → Upload vs Create with AI.
    Elite application is available directly in the Elite section above.
  {% endcomment %}
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800;900&display=swap');

  :root {
    --bc-primary: #39A596;
    --bc-primary-light: #4ECDC4;
    --bc-gold: #FFD700;
    --bc-purple: #A855F7;
    --bc-white: #FFFFFF;
    --bc-text-muted: rgba(255, 255, 255, 0.55);
    --bc-bg: #080808;
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    overflow-x: hidden;
    max-width: 100%;
  }

  .bc-page {
    background: var(--bc-bg);
    color: var(--bc-white);
    font-family: Montserrat, sans-serif;
    overflow-x: hidden;
    max-width: 100%;
    position: relative;
    z-index: 1;
  }

  /* Fixed Background Shapes */
  .bc-bg-shape {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.06;
    z-index: 0;
    pointer-events: none;
  }

  .bc-bg-shape-teal {
    width: 200px;
    height: 200px;
    background: var(--bc-primary-light);
    top: -20px;
    right: -20px;
  }

  .bc-bg-shape-purple {
    width: 200px;
    height: 200px;
    background: var(--bc-purple);
    bottom: -20px;
    left: -20px;
  }

  /* Hero Section */
  .bc-hero {
    padding: 44px 20px 36px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .bc-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(57, 165, 150, 0.3);
    margin-bottom: 20px;
  }

  .bc-hero-title {
    font-size: clamp(30px, 8vw, 52px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .bc-hero-line1 {
    display: block;
    color: var(--bc-white);
  }

  .bc-hero-line2 {
    display: block;
    background: linear-gradient(135deg, var(--bc-primary), var(--bc-primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Stat Strip */
  .bc-stat-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 16px 0 28px;
  }

  .bc-stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bc-stat-number {
    display: block;
    font-weight: 900;
    font-size: clamp(18px, 4vw, 24px);
    color: var(--bc-white);
  }

  .bc-stat-label {
    display: block;
    font-size: 12px;
    color: var(--bc-text-muted);
    margin-top: 4px;
  }

  .bc-stat-divider {
    color: var(--bc-text-muted);
    font-size: 12px;
  }

  /* Social Proof Marquee */
  .bc-social-proof {
    padding: 12px 20px;
    overflow: hidden;
    display: flex;
    gap: 12px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .bc-marquee-wrapper {
    overflow: hidden;
    flex: 1;
    min-width: 0;
    height: 36px;
    display: flex;
    align-items: center;
  }

  .bc-marquee {
    display: flex;
    gap: 12px;
    animation: marquee 18s linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .bc-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    color: var(--bc-white);
    flex-shrink: 0;
  }

  .bc-social-proof-text {
    font-size: 12px;
    color: var(--bc-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Earnings Strip */
  .bc-earnings-strip {
    padding: 20px 20px;
    display: flex;
    gap: 12px;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .bc-earning-card {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 10px;
    text-align: center;
  }

  .bc-earning-amount {
    font-size: 22px;
    font-weight: 900;
    color: var(--bc-white);
    display: block;
  }

  .bc-earning-label {
    font-size: 11px;
    color: var(--bc-text-muted);
    margin-top: 6px;
  }

  /* How It Works */
  .bc-how-it-works {
    padding: 28px 20px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .bc-section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--bc-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .bc-steps-flow {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    max-width: 400px;
    margin: 0 auto;
    width: 100%;
    gap: 0;
  }

  .bc-step-node {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .bc-step-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    border: 2px solid;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .bc-step-circle:hover {
    transform: translateY(-3px);
  }

  .bc-step-icon {
    font-size: 20px;
  }

  .bc-step-connector {
    position: absolute;
    top: 27px;
    left: 50%;
    width: 100%;
    height: 2px;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(57, 165, 150, 0.6) 0,
      rgba(57, 165, 150, 0.6) 4px,
      transparent 4px,
      transparent 9px
    );
    z-index: 0;
  }

  .bc-step-node--last .bc-step-connector {
    display: none;
  }

  .bc-step-label {
    margin-top: 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Animation */
  .bc-animate {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .bc-animate.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Elite Section */
  .bc-elite-section {
    padding: 32px 20px;
    text-align: center;
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .bc-elite-title {
    font-size: clamp(22px, 5vw, 32px);
    font-weight: 800;
    margin: 12px 0 8px;
  }

  .bc-elite-subtitle {
    font-size: 13px;
    color: var(--bc-text-muted);
    margin-bottom: 20px;
  }

  /* Platform Grid */
  .bc-platform-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    max-width: 380px;
    margin: 0 auto 16px;
  }

  .bc-platform-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 8px;
    text-align: center;
  }

  .bc-platform-icon {
    font-size: 28px;
    display: block;
    margin-bottom: 6px;
  }

  .bc-platform-name {
    font-size: 12px;
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }

  .bc-threshold-badge {
    font-size: 10px;
    background: rgba(57, 165, 150, 0.15);
    color: var(--bc-primary);
    border-radius: 50px;
    padding: 2px 8px;
    display: inline-block;
    margin-bottom: 4px;
  }

  .bc-platform-commission {
    font-size: 11px;
    color: var(--bc-text-muted);
  }

  /* Chip interactive states */
  .bc-platform-chip {
    cursor: pointer;
    transition: all 0.25s ease;
    position: relative;
  }

  .bc-platform-chip:hover {
    border-color: var(--bc-primary);
    background: rgba(57,165,150,0.08);
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(57,165,150,0.2);
  }

  .bc-platform-chip:focus {
    outline: 2px solid var(--bc-primary);
    outline-offset: 2px;
  }

  .bc-chip-cta {
    font-size: 10px;
    color: var(--bc-primary);
    font-weight: 700;
    margin-top: 6px;
    letter-spacing: 0.3px;
  }

  .bc-chip-status {
    font-size: 10px;
    margin-top: 4px;
    min-height: 14px;
  }

  .bc-platform-chip.bc-chip-verified {
    border-color: var(--bc-primary);
    background: rgba(57,165,150,0.1);
  }

  .bc-platform-chip.bc-chip-verified .bc-chip-cta {
    color: var(--bc-primary);
  }

  .bc-platform-chip.bc-chip-failed {
    border-color: rgba(239,68,68,0.5);
  }

  .bc-platform-chip.bc-chip-failed .bc-chip-cta {
    color: #ef4444;
  }

  /* Verification modal */
  .bc-verify-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.88);
    z-index: 10000;
    align-items: center;
    justify-content: center;
    padding: 16px;
    backdrop-filter: blur(4px);
  }

  .bc-verify-modal.open {
    display: flex;
  }

  .bc-verify-card {
    background: #111;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    padding: 28px 20px;
    width: 100%;
    max-width: 400px;
    position: relative;
    text-align: center;
  }

  .bc-verify-icon {
    font-size: 36px;
    margin-bottom: 12px;
  }

  .bc-verify-title {
    font-size: 18px;

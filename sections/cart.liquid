<div
  class="container max-w-screen-xl mx-auto px-4 py-8 md:py-16"
  data-for="cart-container"
  data-section-id="{{ section.id }}"
>
  <h1 class="leading-none px-4 md:px-6 container max-w-screen-xl mx-auto text-center text-2xl font-bold md:text-4xl my-6 md:my-12 heading-font">
    My Bag
  </h1>
  <form
    action="{{ routes.cart_url }}"
    method="post"
    class="flex flex-col lg:flex-row gap-4 justify-between"
  >
    {% if cart.item_count > 0 %}
      {%- assign total_savings = 0 -%}
      <div class="flex-[2_1] flex flex-col gap-6 md:gap-7">
        {% for line_item in cart.items %}
          <div class="border  flex gap-3 p-3 md:p-4" data-cart-product-id="{{ line_item.product_id }}">
            <a href="{{ line_item.url }}" class="flex-[1]  h-full overflow-hidden">
              <p class="text-[12px] hidden xs:text-[14px] text-[#CB1521] mb-1 xs:mb-[6px] min-h-[16px] normal-case">
                {% if line_item.variant.inventory_quantity <= 0 %}
                  Sold Out
                {% elsif line_item.variant.inventory_quantity < 10 %}
                  Only {{ line_item.variant.inventory_quantity }} Left in Stock
                {% endif %}
              </p>
              
              {% comment %} --- CUSTOM AI IMAGE LOGIC START --- {% endcomment %}
              {% if line_item.properties._CartImage %}
                <img
                  src="{{ line_item.properties._CartImage }}"
                  alt="{{ line_item.product.title }}"
                  height=""
                  width=""
                  class="h-full w-full object-cover"
                >
              {% else %}
                <img
                  src="{{ line_item.image | image_url  }}"
                  alt="{{ line_item.product.title }}"
                  height=""
                  width=""
                  class="h-full w-full object-cover"
                >
              {% endif %}
              {% comment %} --- CUSTOM AI IMAGE LOGIC END --- {% endcomment %}
              
            </a>
            <div class="flex-[2] md:flex-[3] flex flex-col justify-between h-full gap-2">
              
              {% comment %} --- CUSTOM TITLE LOGIC START --- {% endcomment %}
              {% if line_item.properties.Edition %}
                <p class="text-base md:text-xl">{{ line_item.properties.Edition }}</p>
              {% else %}
                <p class="text-base md:text-xl">{{ line_item.product.title }}</p>
              {% endif %}
              {% comment %} --- CUSTOM TITLE LOGIC END --- {% endcomment %}

              <ul class="flex flex-col gap-1 text-sm md:text-base">
                {% for option in line_item.options_with_values %}
                  <li class="">{{ option.name }}: {{ option.value }}</li>
                {% endfor %}
              </ul>

              {% comment %} --- HIDDEN PROPERTIES LOGIC START --- {% endcomment %}
              {% for property in line_item.properties %}
                {% assign first_char_in_property = property.first | slice: 0 %}
                {% unless property.last == blank or first_char_in_property == '_' or property.first == 'Edition' %}
                  <p class="text-sm md:text-base">{{ property.first }}: {{ property.last }}</p>
                {% endunless %}
              {% endfor %}
              {% comment %} --- HIDDEN PROPERTIES LOGIC END --- {% endcomment %}

              <ul class="flex gap-2">
                {% assign original_price = line_item.product.compare_at_price %}
                {% assign discounted_price = line_item.product.price %}
                {% assign discount_amount = original_price | minus: discounted_price %}
                {% assign discount_percentage = discount_amount | times: 100 | divided_by: original_price | round: 2 %}
                <li>{{ line_item.product.price | money_without_trailing_zeros }}</li>
                {% if line_item.product.compare_at_price > line_item.product.price %}
                  <li class="text-[#999999] line-through">
                    {{ line_item.product.compare_at_price | money_without_trailing_zeros }}
                  </li>
                  <li class="text-[#019973]">{{ discount_percentage }}% off</li>
                {% endif %}
              </ul>
              
              <div class="flex border w-fit cart-quantity-selector ">
                <a
                  href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ line_item.quantity | minus: 1 }}"
                  class="qty-remove p-2 flex items-center justify-center {% if line_item.quantity == 1 %}opacity-30 pointer-events-none cursor-not-allowed{% endif %}"
                >
                  {% render 'icons', icon: 'remove' %}
                </a>

                <input
                  type="text"
                  readonly
                  data-key="{{ line_item.key }}"
                  name="updates[]"
                  value="{{ line_item.quantity }}"
                  class="bg-black text-white max-w-9 px-2 text-center focus:outline-none cursor-default"
                >

                <a 
                  href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ line_item.quantity | plus: 1 }}"
                  class="qty-add p-2 flex items-center justify-center"
                >
                  {% render 'icons', icon: 'add' %}
                </a>
              </div>
              </div>
            <div>
              <a
                href="{{ line_item.url_to_remove }}"
                class="cursor-pointer block"
                data-for="remove-cart-item"
                data-cart-item-id="{{ line_item.id }}"
              >
                {% render 'icons', icon: 'delete', height: '24px', width: '24px' %}
              </a>
              </div>
          </div>
          {% if line_item.product.compare_at_price > line_item.product.price %}
            {%- assign line_savings = line_item.product.compare_at_price
              | minus: line_item.product.price
              | times: line_item.quantity
            -%}
            {%- assign total_savings = total_savings | plus: line_savings -%}
          {% endif %}
        {% endfor %}
      </div>
      <div class="flex-1 lg:min-w-fit whitespace-nowrap flex gap-6 flex-col">
        <div class="text-black bg-white p-4  ">
          <p class="text-2xl md:text-3xl leading-none border-b-2 pb-4">
            Bill Details
            <span class="text-base"
              >({{ cart.item_count -}}
              {%- if cart.item_count > 1 %}
                Items
              {% else %}
                Item
              {%- endif -%}
              )</span
            >
          </p>
          <div class="flex flex-col gap-2 pt-4 text-xl md:text-2xl text-[#3d3d3d]">
            <div class="flex justify-between">
              <p>Total Amount</p>
              <p>
                {{-
                  cart.total_price
                  | plus: total_savings
                  | plus: cart.total_discount
                  | money_without_trailing_zeros
                -}}
              </p>
            </div>
            <div class="flex justify-between">
              <p>Cart Discount</p>
              <p class="text-[#019973]">
                {{- total_savings | money_without_trailing_zeros -}}
              </p>
            </div>
            {% if cart.total_discount > 0 %}
              <div class="flex justify-between">
                <p>Coupon Discount</p>
                <p class="text-[#019973]">
                  -
                  {{- cart.total_discount | money_without_trailing_zeros -}}
                </p>
              </div>
            {% endif %}

            <div class="flex justify-between">
              <p>Delivery Charges</p>
              <p class="text-[#019973]">
                <span class="text-[#3d3d3d] line-through">₹40</span>
                Free
              </p>
            </div>
            <div class="flex justify-between py-3 border-y-2">
              <p>Total Payable</p>
              <p class="font-bold">{{- cart.total_price | money_without_trailing_zeros -}}</p>
            </div>
            <p class="text-center text-[#019973]">
              You will save {{ total_savings | plus: cart.total_discount | money_without_trailing_zeros }} on this order
            </p>
          </div>
        </div>
        <div class="w-full flex flex-col gap-6">
          <input
            type="submit"
            name="checkout"
            value="Checkout"
            class="bg-[#019973] text-black hover:bg-black hover:text-white duration-200 cursor-pointer border font-bold leading-none text-3xl md:text-4xl uppercase p-4  w-full"
          >
          <div class="flex items-center justify-center gap-3">
            <svg
              width="49"
              height="48"
              viewBox="0 0 49 48"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M44.5 22.16V24C44.4975 28.3128 43.101 32.5094 40.5187 35.9637C37.9363 39.418 34.3066 41.945 30.1707 43.1678C26.0349 44.3906 21.6145 44.2438 17.5689 42.7492C13.5234 41.2545 10.0693 38.4922 7.72191 34.8741C5.37453 31.2561 4.25957 26.9761 4.54335 22.6726C4.82712 18.3691 6.49441 14.2727 9.29655 10.9941C12.0987 7.71564 15.8856 5.43077 20.0924 4.4803C24.2992 3.52982 28.7005 3.96468 32.64 5.72M44.5 8L24.5 28.02L18.5 22.02"
                stroke="white"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
            <p class="text-base font-bold whitespace-normal">
              Safe and Secure Payments.Easy returns.100% Authentic products.
            </p>
          </div>
        </div>
        {% unless customer %}
          <div class="flex flex-col gap-6">
            <p class="text-base font-extrabold whitespace-normal">Login for personalized discounts!</p>
            <a class="hover:bg-white hover:text-black bg-black text-center text-white duration-200 cursor-pointer border font-bold leading-none text-3xl md:text-4xl uppercase p-4  w-full"
              >Login/sign up</a
            >
          </div>
        {% endunless %}
      </div>
    {% else %}
      <div class="flex flex-col justify-center items-center gap-5 md:gap-7 flex-1">
        <p class="text-2xl md:text-5xl">Your cart is empty</p>
        <a href="/" class="border bg-white text-black px-4 py-1 hover:bg-black hover:text-white duration-200"
          >Start Shopping</a
        >
      </div>
    {% endif %}
  </form>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "w-full z-10 top-0 border-b",
  "limit": 1,
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
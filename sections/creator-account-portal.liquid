{% comment %}
=================================================================================
MY NARRATIVE - CREATOR STUDIO TAB (ACCOUNT PORTAL)
=================================================================================
Adds a "Creator Studio" tab/banner to the Shopify customer account page
Version: 1.0.0

INTEGRATION:
Add to customers/account.json template before the account section:
{% section 'creator-account-portal' %}

OR add to the account.liquid section file directly

=================================================================================
{% endcomment %}

{% assign is_creator = false %}

{% if customer and customer.metafields.creator.registered == true %}
  {% assign is_creator = true %}
{% endif %}

<style>
  .mn-creator-account-portal {
    font-family: 'Montserrat', sans-serif;
    margin-bottom: 24px;
  }

  .mn-creator-studio-banner {
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.15), rgba(139, 92, 246, 0.1));
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.3s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .mn-creator-studio-banner:hover {
    border-color: rgba(57, 165, 150, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(57, 165, 150, 0.15);
  }

  .mn-creator-studio-icon {
    font-size: 32px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    border-radius: 14px;
    flex-shrink: 0;
  }

  .mn-creator-studio-content {
    flex: 1;
  }

  .mn-creator-studio-title {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mn-creator-badge-mini {
    font-size: 10px;
    padding: 3px 8px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #000;
    border-radius: 10px;
    font-weight: 700;
  }

  .mn-creator-studio-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0;
  }

  .mn-creator-studio-arrow {
    font-size: 20px;
    color: #39A596;
    transition: transform 0.3s ease;
  }

  .mn-creator-studio-banner:hover .mn-creator-studio-arrow {
    transform: translateX(4px);
  }

  /* Non-creator variant */
  .mn-creator-join-banner {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(251, 191, 36, 0.1));
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .mn-creator-join-banner:hover {
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.15);
  }

  .mn-creator-join-icon {
    font-size: 32px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #8b5cf6, #a78bfa);
    border-radius: 14px;
    flex-shrink: 0;
  }

  .mn-creator-join-title {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }

  .mn-creator-join-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0;
  }

  .mn-creator-join-arrow {
    font-size: 20px;
    color: #8b5cf6;
    transition: transform 0.3s ease;
  }

  .mn-creator-join-banner:hover .mn-creator-join-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .mn-creator-account-portal {
      margin: 0 0 16px;
      padding: 0 12px;
    }

    .mn-creator-studio-banner,
    .mn-creator-join-banner {
      display: flex !important;
      width: 100%;
      padding: 16px;
      gap: 12px;
      border-radius: 14px;
      align-items: center;
    }

    .mn-creator-studio-icon,
    .mn-creator-join-icon {
      width: 48px;
      height: 48px;
      min-width: 48px;
      font-size: 24px;
      border-radius: 12px;
    }

    .mn-creator-studio-title,
    .mn-creator-join-title {
      font-size: 16px;
      line-height: 1.2;
      margin-bottom: 6px;
    }

    .mn-creator-studio-desc,
    .mn-creator-join-desc {
      font-size: 12px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.72);
    }

    .mn-creator-studio-arrow,
    .mn-creator-join-arrow {
      font-size: 18px;
      flex-shrink: 0;
    }
  }
</style>

<div class="mn-creator-account-portal">
  {% if customer and is_creator %}
    {% comment %} Existing creator - show dashboard link {% endcomment %}
    <a href="/pages/creator-dashboard" class="mn-creator-studio-banner">
      <div class="mn-creator-studio-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 7V5.5C8 4.67 8.67 4 9.5 4h5C15.33 4 16 4.67 16 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 9.5C4 8.67 4.67 8 5.5 8h13C19.33 8 20 8.67 20 9.5v7C20 17.33 19.33 18 18.5 18h-13C4.67 18 4 17.33 4 16.5v-7Z" stroke="currentColor" stroke-width="1.8"/>
          <path d="M10 12h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="mn-creator-studio-content">
        <h3 class="mn-creator-studio-title">
          Creator Studio
          {% if customer.metafields.creator.tier %}
            <span class="mn-creator-badge-mini">{{ customer.metafields.creator.tier }}</span>
          {% endif %}
        </h3>
        <p class="mn-creator-studio-desc">
          View your dashboard, earnings, and manage your designs
        </p>
      </div>
      <span class="mn-creator-studio-arrow">&#8594;</span>
    </a>

  {% elsif customer %}
    {% comment %} Logged in but not a creator - show join CTA {% endcomment %}
    <a href="/pages/become-creator" class="mn-creator-join-banner">
      <div class="mn-creator-join-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 4.5 13.9 9.1 18.5 11 13.9 12.9 12 17.5 10.1 12.9 5.5 11 10.1 9.1 12 4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M18.5 4.5 19.2 6.3 21 7 19.2 7.7 18.5 9.5 17.8 7.7 16 7 17.8 6.3 18.5 4.5Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="mn-creator-studio-content">
        <h3 class="mn-creator-join-title">Design &amp; Earn</h3>
        <p class="mn-creator-join-desc">
          Turn your style into income. Join the creator economy today
        </p>
      </div>
      <span class="mn-creator-join-arrow">&#8594;</span>
    </a>

  {% endif %}
</div>

{% schema %}
{
  "name": "Creator Account Portal",
  "settings": [],
  "presets": [
    {
      "name": "Creator Account Portal"
    }
  ]
}
{% endschema %}
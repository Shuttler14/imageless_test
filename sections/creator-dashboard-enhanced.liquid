{% comment %} =====================================================
SECTION CONFIGURATION
==================================================== {% endcomment %}

{% assign api_base_url = section.settings.api_base_url | default: 'https://mynarrative-ai.vercel.app' %}
{% assign creator_api_base_url = section.settings.creator_api_base_url | default: 'https://creator-economy-api.vercel.app' %}
{% assign enable_debug = section.settings.enable_debug | default: false %}

{% assign creator_id = customer.id | default: '' %}
{% assign creator_email = customer.email | default: '' %}
{% assign creator_first_name = customer.first_name | default: '' %}
{% assign creator_name = customer.name | default: 'Creator' %}

{% assign is_logged_in = false %}
{% if customer.id != blank %}
  {% assign is_logged_in = true %}
{% endif %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  :root {
    --cd-primary: #39A596;
    --cd-primary-light: #4ECDC4;
    --cd-purple: #A855F7;
    --cd-pink: #EC4899;
    --cd-gold: #FFD700;
    --cd-orange: #F97316;
    --cd-dark: #0a0a0a;
    --cd-card-bg: rgba(255, 255, 255, 0.03);
    --cd-border: rgba(255, 255, 255, 0.08);
  }

  .cd-page {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(180deg, #050505 0%, #0a0a0a 30%, #0f0f0f 100%);
    min-height: 100vh;
    color: #fff;
    padding: 0;
    position: relative;
    overflow-x: hidden;
  }

  /* Animated Background */
  .cd-bg-shapes {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .cd-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: cdFloat 15s ease-in-out infinite;
  }

  .cd-shape-1 {
    width: 500px;
    height: 500px;
    background: rgba(57, 165, 150, 0.12);
    top: -150px;
    right: -100px;
  }

  .cd-shape-2 {
    width: 400px;
    height: 400px;
    background: rgba(168, 85, 247, 0.1);
    bottom: 10%;
    left: -100px;
    animation-delay: -5s;
  }

  .cd-shape-3 {
    width: 300px;
    height: 300px;
    background: rgba(249, 115, 22, 0.08);
    top: 50%;
    right: 20%;
    animation-delay: -10s;
  }

  @keyframes cdFloat {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(20px, -30px) rotate(5deg); }
    66% { transform: translate(-15px, 15px) rotate(-3deg); }
  }

  /* Main Container */
  .cd-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px;
    position: relative;
    z-index: 1;
  }

  /* Welcome Header */
  .cd-welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 40px;
    animation: fadeInUp 0.8s ease;
  }

  .cd-welcome-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cd-avatar-wrapper {
    position: relative;
  }

  .cd-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cd-primary), var(--cd-purple));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    box-shadow: 0 8px 32px rgba(57, 165, 150, 0.3);
    border: 3px solid rgba(255, 255, 255, 0.1);
  }

  .cd-avatar-status {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    background: #22c55e;
    border-radius: 50%;
    border: 3px solid var(--cd-dark);
  }

  .cd-welcome-text h1 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .cd-welcome-text h1 span {
    background: linear-gradient(135deg, var(--cd-primary), var(--cd-primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cd-welcome-text p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }

  .cd-tier-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cd-tier-badge.bronze {
    background: linear-gradient(135deg, rgba(205, 127, 50, 0.2), rgba(180, 120, 50, 0.1));
    border: 1px solid rgba(205, 127, 50, 0.4);
    color: #CD7F32;
  }

  .cd-tier-badge.silver {
    background: linear-gradient(135deg, rgba(192, 192, 192, 0.2), rgba(150, 150, 150, 0.1));
    border: 1px solid rgba(192, 192, 192, 0.4);
    color: #C0C0C0;
  }

  .cd-tier-badge.gold {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 180, 0, 0.1));
    border: 1px solid rgba(255, 215, 0, 0.4);
    color: #FFD700;
  }

  .cd-tier-badge.diamond {
    background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(57, 165, 150, 0.1));
    border: 1px solid rgba(0, 255, 255, 0.4);
    color: #00FFFF;
  }

  /* Stats Grid */
  .cd-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  @media (max-width: 1024px) {
    .cd-stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .cd-stats-grid { grid-template-columns: 1fr; }
  }

  .cd-stat-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: 20px;
    padding: 28px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    animation: fadeInUp 0.8s ease both;
  }

  .cd-stat-card:nth-child(1) { animation-delay: 0.1s; }
  .cd-stat-card:nth-child(2) { animation-delay: 0.2s; }
  .cd-stat-card:nth-child(3) { animation-delay: 0.3s; }
  .cd-stat-card:nth-child(4) { animation-delay: 0.4s; }

  .cd-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cd-primary), var(--cd-purple));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cd-stat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(57, 165, 150, 0.3);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
  }

  .cd-stat-card:hover::before {
    opacity: 1;
  }

  .cd-stat-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 16px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.2), rgba(168, 85, 247, 0.1));
    border: 1px solid rgba(57, 165, 150, 0.2);
  }

  .cd-stat-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .cd-stat-value {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .cd-stat-value.teal { color: var(--cd-primary); }
  .cd-stat-value.gold { color: var(--cd-gold); }
  .cd-stat-value.purple { color: var(--cd-purple); }
  .cd-stat-value.pink { color: var(--cd-pink); }

  .cd-stat-change {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cd-stat-change.positive { color: #22c55e; }
  .cd-stat-change.negative { color: #ef4444; }

  /* Main Content Grid */
  .cd-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .cd-main-grid { grid-template-columns: 1fr; }
  }

  /* Section Titles */
  .cd-section-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cd-section-title::before {
    content: '';
    width: 4px;
    height: 20px;
    background: linear-gradient(180deg, var(--cd-primary), var(--cd-purple));
    border-radius: 2px;
  }

  /* Recent Orders */
  .cd-orders-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: 20px;
    padding: 28px;
    animation: fadeInUp 0.8s ease 0.5s both;
  }

  .cd-order-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cd-order-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .cd-order-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(57, 165, 150, 0.2);
  }

  .cd-order-info {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cd-order-avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--cd-primary), var(--cd-purple));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .cd-order-details h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .cd-order-details p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .cd-order-amount {
    text-align: right;
  }

  .cd-order-amount .amount {
    font-size: 16px;
    font-weight: 700;
    color: var(--cd-primary);
  }

  .cd-order-amount .status {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cd-order-amount .status.completed {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .cd-order-amount .status.pending {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
  }

  /* Quick Actions */
  .cd-actions-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: 20px;
    padding: 28px;
    animation: fadeInUp 0.8s ease 0.6s both;
  }

  .cd-action-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cd-action-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .cd-action-btn:hover {
    background: rgba(57, 165, 150, 0.1);
    border-color: rgba(57, 165, 150, 0.3);
    transform: translateX(4px);
  }

  .cd-action-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .cd-action-icon.upload {
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.2), rgba(57, 165, 150, 0.1));
  }

  .cd-action-icon.analytics {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(168, 85, 247, 0.1));
  }

  .cd-action-icon.payout {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.1));
  }

  .cd-action-icon.social {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.2), rgba(249, 115, 22, 0.1));
  }

  .cd-action-text h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .cd-action-text p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Progress Section */
  .cd-progress-section {
    margin-top: 40px;
    animation: fadeInUp 0.8s ease 0.7s both;
  }

  .cd-progress-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: 20px;
    padding: 28px;
  }

  .cd-progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .cd-progress-bar-container {
    position: relative;
    height: 12px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
  }

  .cd-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--cd-primary), var(--cd-purple));
    border-radius: 10px;
    transition: width 1s ease;
    width: 65%;
  }

  .cd-progress-rewards {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .cd-reward-item {
    flex: 1;
    text-align: center;
    padding: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    position: relative;
  }

  .cd-reward-item.locked {
    opacity: 0.4;
  }

  .cd-reward-icon {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .cd-reward-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Products Section */
  .cd-products-section {
    margin-bottom: 40px;
    animation: fadeInUp 0.8s ease 0.3s both;
  }

  .cd-products-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: 20px;
    padding: 28px;
  }

  .cd-products-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .cd-products-count {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 14px;
    border-radius: 20px;
  }

  /* Products Empty State - Beautiful Full-Width Card */
  .cd-products-empty {
    position: relative;
    background: linear-gradient(135deg, rgba(20, 20, 30, 0.8), rgba(30, 20, 40, 0.8));
    border: 2px solid transparent;
    background-clip: padding-box;
    border-radius: 24px;
    padding: 80px 60px;
    text-align: center;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  /* Gradient border effect */
  .cd-products-empty::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--cd-primary), var(--cd-purple));
    border-radius: 24px;
    padding: 2px;
    pointer-events: none;
    z-index: -1;
  }

  .cd-products-empty::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    right: 2px;
    bottom: 2px;
    background: linear-gradient(135deg, rgba(20, 20, 30, 0.9), rgba(30, 20, 40, 0.9));
    border-radius: 22px;
    pointer-events: none;
    z-index: -1;
  }

  /* Animated glow effect */
  .cd-products-cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(57, 165, 150, 0.25) 0%, rgba(168, 85, 247, 0.15) 50%, transparent 100%);
    animation: cdEmptyGlow 3s ease-in-out infinite;
    filter: blur(60px);
  }

  @keyframes cdEmptyGlow {
    0%, 100% { 
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    50% { 
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 0.9;
    }
  }

  .cd-products-cta-content {
    position: relative;
    z-index: 1;
  }

  .cd-products-cta-icon {
    font-size: 80px;
    margin-bottom: 24px;
    animation: cdEmojiBounce 2.5s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes cdEmojiBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1.1); }
  }

  .cd-products-empty h4 {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--cd-primary-light), var(--cd-gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
  }

  .cd-products-empty p {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 36px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
    letter-spacing: 0.3px;
  }

  .cd-products-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 44px;
    background: linear-gradient(135deg, var(--cd-gold), #FFA500);
    color: #000;
    font-size: 17px;
    font-weight: 700;
    border: none;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 8px 32px rgba(255, 215, 0, 0.35),
                0 0 20px rgba(255, 215, 0, 0.2);
    animation: cdPrimaryGlow 2s ease-in-out infinite;
    cursor: pointer;
  }

  @keyframes cdPrimaryGlow {
    0%, 100% { 
      box-shadow: 0 8px 32px rgba(255, 215, 0, 0.35),
                  0 0 20px rgba(255, 215, 0, 0.2);
    }
    50% { 
      box-shadow: 0 12px 48px rgba(255, 215, 0, 0.5),
                  0 0 30px rgba(255, 215, 0, 0.3);
    }
  }

  .cd-products-cta-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 60px rgba(255, 215, 0, 0.6),
                0 0 40px rgba(255, 215, 0, 0.4);
  }

  .cd-products-cta-btn:active {
    transform: translateY(-1px) scale(1.02);
  }

  .cd-products-cta-btn span {
    font-size: 22px;
  }

  /* Secondary CTA Button */
  .cd-products-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: var(--cd-primary-light);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 12px 28px;
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 50px;
    background: rgba(57, 165, 150, 0.05);
  }

  .cd-products-secondary-cta:hover {
    background: rgba(57, 165, 150, 0.15);
    border-color: rgba(57, 165, 150, 0.6);
    transform: translateX(4px);
  }

  /* Helper text below button */
  .cd-products-helper-text {
    margin-top: 20px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.5px;
    line-height: 1.6;
  }

  .cd-products-helper-text strong {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }

  .cd-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }

  .cd-hidden { display: none !important; }

  /* Not Logged In State */
  .cd-not-logged {
    text-align: center;
    padding: 80px 24px;
    animation: fadeInUp 0.8s ease;
  }

  .cd-not-logged-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto 32px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.2), rgba(168, 85, 247, 0.2));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
  }

  .cd-not-logged h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .cd-not-logged p {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 32px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .cd-login-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--cd-primary), #2d8a85);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    padding: 16px 40px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(57, 165, 150, 0.3);
  }

  .cd-login-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(57, 165, 150, 0.4);
  }

  /* Animations */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .cd-container { padding: 24px 16px; }
    .cd-welcome { flex-direction: column; align-items: flex-start; }
    .cd-welcome-text h1 { font-size: 22px; }
    .cd-stat-value { font-size: 26px; }
  }
</style>

<div class="cd-page">

<script>
(function() {
  const API_BASE = '{{ creator_api_base_url }}';
  const customerId = '{{ customer.id }}';

  if (!customerId) return;

  // Format number with commas
  function formatNumber(num) {
    if (num >= 1000) {
      return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    }
    return num.toString();
  }

  // Format currency
  function formatCurrency(num) {
    return '₹' + num.toLocaleString('en-IN');
  }

  // Get relative time
  function getRelativeTime(dateStr) {
    if (!dateStr) return 'Recently';
    const date = new Date(dateStr);
    const now = new Date();
    const diffMs = now - date;
    const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffHrs < 1) return 'Just now';
    if (diffHrs < 24) return diffHrs + ' hour' + (diffHrs > 1 ? 's' : '') + ' ago';
    if (diffDays === 1) return 'Yesterday';
    if (diffDays < 7) return diffDays + ' days ago';
    return date.toLocaleDateString('en-IN');
  }

  // Load creator stats
  async function loadCreatorStats() {
    try {
      const resp = await fetch(API_BASE + '/api/creator/stats?user_id=' + customerId);
      const json = await resp.json();
      if (json.success && json.data) {
        const stats = json.data;

        // Update earnings
        document.getElementById('cd-earnings').textContent = formatCurrency(stats.total_earnings || 0);
        const earningsChange = document.getElementById('cd-earnings-change');
        if (stats.earnings_change > 0) {
          earningsChange.innerHTML = '<span>↑</span> +' + stats.earnings_change + '% from last month';
          earningsChange.className = 'cd-stat-change positive';
        } else if (stats.earnings_change < 0) {
          earningsChange.innerHTML = '<span>↓</span> ' + stats.earnings_change + '% from last month';
          earningsChange.className = 'cd-stat-change negative';
        }

        // Update designs sold
        document.getElementById('cd-designs-sold').textContent = stats.designs_sold || 0;
        const salesChange = document.getElementById('cd-sales-change');
        if (stats.sales_change > 0) {
          salesChange.innerHTML = '<span>↑</span> +' + stats.sales_change + '% from last month';
        }

        // Update rating
        document.getElementById('cd-rating').textContent = stats.rating || 0;

        // Update followers
        document.getElementById('cd-followers').textContent = formatNumber(stats.followers || 0);
        const followersChange = document.getElementById('cd-followers-change');
        if (stats.followers_change > 0) {
          followersChange.innerHTML = '<span>↑</span> +' + stats.followers_change + ' new';
        }

        // Update tier badge
        updateTierBadge(stats.tier);
      }
    } catch (e) {
      console.log('Using demo stats data');
    }
  }

  // Update tier badge
  function updateTierBadge(tier) {
    const badge = document.getElementById('cd-tier-badge');
    const text = document.getElementById('cd-tier-text');
    if (!badge || !tier) return;

    const tiers = {
      'standard': { label: 'Standard Creator', emoji: '🥉', class: 'bronze' },
      'micro_influencer': { label: 'Micro-Influencer', emoji: '🥈', class: 'silver' },
      'mega_influencer': { label: 'Mega-Influencer', emoji: '👑', class: 'diamond' },
      'gold': { label: 'Gold Creator', emoji: '🥇', class: 'gold' }
    };

    const tierInfo = tiers[tier] || tiers.standard;
    badge.className = 'cd-tier-badge ' + tierInfo.class;
    if (text) text.textContent = tierInfo.label;
  }

  // Load recent orders
  async function loadRecentOrders() {
    const orderList = document.getElementById('cd-order-list');
    if (!orderList) return;

    try {
      const resp = await fetch(API_BASE + '/api/creator/orders?user_id=' + customerId + '&limit=5');
      const json = await resp.json();
      if (json.success && json.data && json.data.length > 0) {
        renderOrders(json.data);
      } else {
        renderOrders([]);
      }
    } catch (e) {
      console.log('Using demo orders data');
    }
  }

  // Render orders
  function renderOrders(orders) {
    const orderList = document.getElementById('cd-order-list');
    if (!orderList) return;

    if (!orders || orders.length === 0) {
      orderList.innerHTML = '<div class="cd-order-item"><div class="cd-order-info"><div class="cd-order-avatar">📦</div><div class="cd-order-details"><h4>No orders yet</h4><p>Start selling to see orders here</p></div></div></div>';
      return;
    }

    const emojis = ['👗', '👕', '🧥', '👖', '👟', '🎒', '🧣', '🧢', '🕶️', '💍'];
    orderList.innerHTML = orders.map((order, i) => {
      const emoji = emojis[i % emojis.length];
      const statusClass = order.status === 'completed' ? 'completed' : 'pending';
      const statusLabel = order.status === 'completed' ? 'Completed' : (order.status === 'processing' ? 'Processing' : order.status);

      return '<div class="cd-order-item">' +
        '<div class="cd-order-info">' +
          '<div class="cd-order-avatar">' + emoji + '</div>' +
          '<div class="cd-order-details">' +
            '<h4>' + (order.product_name || 'Design Sale') + '</h4>' +
            '<p>Order #' + (order.id || 'N/A') + ' • ' + getRelativeTime(order.created_at) + '</p>' +
          '</div>' +
        '</div>' +
        '<div class="cd-order-amount">' +
          '<div class="amount">' + formatCurrency(order.amount || 0) + '</div>' +
          '<span class="status ' + statusClass + '">' + statusLabel + '</span>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    loadCreatorStats();
    loadRecentOrders();
    loadProducts();

    // Check if coming from onboarding
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('new') === 'true') {
      // Scroll to products section
      setTimeout(() => {
        const productsSection = document.getElementById('cdProductsSection');
        if (productsSection) {
          productsSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          // Add highlight effect
          productsSection.querySelector('.cd-products-card').style.animation = 'pulse 1s ease 3';
        }
      }, 500);
    }
  });

  // Load products
  async function loadProducts() {
    try {
      const resp = await fetch(API_BASE + '/api/creator/products?user_id=' + customerId);
      const json = await resp.json();

      const emptyState = document.getElementById('cdProductsEmpty');
      const productsGrid = document.getElementById('cdProductsGrid');
      const productsCount = document.getElementById('cdProductsCount');

      if (json.success && json.data && json.data.length > 0) {
        // Show products
        if (emptyState) emptyState.classList.add('cd-hidden');
        if (productsGrid) {
          productsGrid.classList.remove('cd-hidden');
          renderProducts(json.data);
        }
        if (productsCount) productsCount.textContent = json.data.length + ' design' + (json.data.length > 1 ? 's' : '');
      } else {
        // Show empty state with CTA
        if (emptyState) emptyState.classList.remove('cd-hidden');
        if (productsGrid) productsGrid.classList.add('cd-hidden');
        if (productsCount) productsCount.textContent = '0 designs';
      }
    } catch (e) {
      console.log('Products load error:', e);
      // Show empty state on error
      const emptyState = document.getElementById('cdProductsEmpty');
      if (emptyState) emptyState.classList.remove('cd-hidden');
    }
  }

  // Render products
  function renderProducts(products) {
    const grid = document.getElementById('cdProductsGrid');
    if (!grid) return;

    grid.innerHTML = products.map(product => `
      <div class="cd-product-item">
        <div class="cd-product-image">
          <img src="${product.image || '/assets/placeholder.png'}" alt="${product.name}">
        </div>
        <div class="cd-product-info">
          <h4>${product.name}</h4>
          <p>₹${product.price} • ${product.sales || 0} sales</p>
        </div>
      </div>
    `).join('');
  }
})();
</script>


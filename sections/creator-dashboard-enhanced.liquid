<script>
(function () {
  if (window.mnEliteVerificationInit) return;
  window.mnEliteVerificationInit = true;

  var CREATOR_API = {{ creator_api_base_url | json }};
  var VERIFIER    = {{ social_verifier_url   | json }};
  var CREATOR_ID  = {{ creator_id | json }};
  if (!CREATOR_ID) return; // only logged-in creators can verify

  var modal    = document.getElementById('mn-elite-verification-modal');
  var openBtn  = document.getElementById('mnEliteOpenBtn');
  var banner   = document.getElementById('mnEliteBanner');
  if (!modal || !openBtn) return;

  var popup = null;
  var currentPlatform = null;

  // ─── helpers ──────────────────────────────────────────────────────────────
  function setStage(name) {
    modal.querySelectorAll('.mn-elite-stage').forEach(function (el) {
      el.hidden = el.getAttribute('data-stage') !== name;
    });
  }
  function openModal(initialStage) {
    setStage(initialStage || 'choose');
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (popup && !popup.closed) { try { popup.close(); } catch (_) {} }
    popup = null;
  }
  function fmtN(n) {
    n = Number(n) || 0;
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/,'') + 'M';
    if (n >= 1e3) return (n / 1e3).toFixed(1).replace(/\.0$/,'') + 'K';
    return n.toLocaleString('en-IN');
  }
  function openPopup(url) {
    var w = 560, h = 680;
    var top  = Math.max(0, (screen.height - h) / 2);
    var left = Math.max(0, (screen.width  - w) / 2);
    return window.open(
      url, 'mnSocialVerifier',
      'width=' + w + ',height=' + h + ',top=' + top + ',left=' + left + ',resizable=yes,scrollbars=yes,noopener=no'
    );
  }

  // ─── open / close wiring ─────────────────────────────────────────────────
  openBtn.addEventListener('click', function () { openModal('choose'); });

  modal.addEventListener('click', function (e) {
    if (e.target.matches('[data-elite-close]')) closeModal();
    if (e.target.matches('[data-elite-back]'))  setStage('choose');
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  // ─── platform picker ─────────────────────────────────────────────────────
  modal.querySelectorAll('.mn-elite-platform-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var platform = btn.getAttribute('data-platform');
      currentPlatform = platform;
      if (platform === 'youtube') {
        setStage('youtube');
        setTimeout(function () {
          var inp = document.getElementById('mnEliteYtHandle');
          if (inp) inp.focus();
        }, 50);
        return;
      }
      launchOAuth(platform);
    });
  });

  // ─── YouTube handle submission ───────────────────────────────────────────
  var ytBtn = document.getElementById('mnEliteYtSubmit');
  if (ytBtn) {
    ytBtn.addEventListener('click', submitYouTube);
  }
  var ytInput = document.getElementById('mnEliteYtHandle');
  if (ytInput) {
    ytInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') submitYouTube(); });
  }

  async function submitYouTube() {
    var handle = (document.getElementById('mnEliteYtHandle').value || '').trim();
    var errEl  = document.getElementById('mnEliteYtError');
    errEl.hidden = true;
    if (!handle) {
      errEl.textContent = 'Please enter your YouTube handle.';
      errEl.hidden = false;
      return;
    }
    currentPlatform = 'youtube';
    setStage('loading');
    try {
      var r = await fetch(VERIFIER.replace(/\/+$/,'') + '/api/youtube/elite', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle: handle, creator_id: CREATOR_ID })
      });
      var d = await r.json();
      if (!d.success) throw new Error(d.error || 'Could not verify channel.');
      await submitVerificationToken(d.verification_token);
    } catch (e) {
      showError(e.message || 'We could not verify that channel.');
    }
  }

  // ─── OAuth popup + postMessage handshake (twitter / instagram / linkedin) ─
  function launchOAuth(platform) {
    setStage('loading');
    var qs = new URLSearchParams({
      creator_id:    CREATOR_ID,
      opener_origin: window.location.origin
    });
    var url = VERIFIER.replace(/\/+$/,'') + '/api/' + platform + '/auth?' + qs.toString();

    fetch(url, { credentials: 'omit' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success || !d.authUrl) throw new Error(d.error || 'OAuth is not configured.');
        popup = openPopup(d.authUrl);
        if (!popup) throw new Error('Please allow popups for this site and retry.');
      })
      .catch(function (e) { showError(e.message); });
  }

  // Accept postMessages only from the known verifier origin.
  var verifierOrigin;
  try { verifierOrigin = new URL(VERIFIER).origin; } catch (_) { verifierOrigin = ''; }

  window.addEventListener('message', function (e) {
    if (verifierOrigin && e.origin !== verifierOrigin) return;
    var msg = e.data;
    if (!msg || msg.source !== 'mn-social-verifier') return;
    if (!msg.ok) {
      return showError(msg.error || 'Verification cancelled.');
    }
    if (!msg.verification_token) {
      return showError('Verification succeeded but no token was returned.');
    }
    submitVerificationToken(msg.verification_token);
  });

  // ─── Backend handoff → /api/verify_social ────────────────────────────────
  async function submitVerificationToken(token) {
    setStage('loading');
    try {
      var r = await fetch(CREATOR_API.replace(/\/+$/,'') + '/api/verify_social', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ creator_id: CREATOR_ID, verification_token: token })
      });
      var d = await r.json();
      if (!d.success) return showError(d.error || 'Verification failed.');
      if (d.status === 'upgraded' || d.status === 'already_elite') return renderUpgraded(d);
      if (d.status === 'keep_growing') return renderKeepGrowing(d);
      showError('Unexpected response from server.');
    } catch (e) {
      showError(e.message || 'Network error. Please retry.');
    }
  }

  // ─── Result renderers ────────────────────────────────────────────────────
  function renderUpgraded(d) {
    document.getElementById('mnEliteUpgradedFollowers').textContent = fmtN(d.followers);
    document.getElementById('mnEliteUpgradedPlatform').textContent  = (d.platform || '').replace(/^\w/, function(c){return c.toUpperCase();});
    document.getElementById('mnEliteUpgradedSub').innerHTML =
      d.status === 'already_elite'
        ? 'You are already an Elite Creator — we refreshed your stats.'
        : 'Your commission is now <strong>40%</strong> on every sale, retroactive from today.';
    setStage('upgraded');
    applyEliteStateToDashboard({ followers: d.followers, platform: d.platform });
  }

  function renderKeepGrowing(d) {
    var followers = Number(d.followers || 0);
    var threshold = Number(d.threshold || 10000);
    var pct       = Math.min(100, Math.round((followers / threshold) * 100));
    var fg        = document.getElementById('mnEliteProgressFg');
    if (fg) fg.setAttribute('stroke-dashoffset', String(326.7 * (1 - pct / 100)));
    document.getElementById('mnEliteProgressPct').textContent  = pct + '%';
    document.getElementById('mnEliteKeepFollowers').textContent = fmtN(followers);
    document.getElementById('mnEliteKeepRemaining').textContent = fmtN(d.remaining || (threshold - followers));
    document.getElementById('mnEliteKeepMessage').textContent   = d.message
      || ('You have ' + followers.toLocaleString() + ' followers on ' + d.platform + '. Reach 10k to unlock Elite status!');
    setStage('keep_growing');
  }

  function showError(msg) {
    document.getElementById('mnEliteErrorMsg').textContent = msg || 'Something went wrong.';
    setStage('error');
  }

  // ─── Dashboard state sync (hide banner, flip badge, bump commission) ─────
  function applyEliteStateToDashboard(info) {
    if (banner) banner.hidden = true;

    var badge = document.getElementById('cd-tier-badge');
    var text  = document.getElementById('cd-tier-text');
    if (badge) {
      badge.className = 'cd-tier-badge diamond mn-elite-flash';
      badge.innerHTML = '<span>★</span> <span id="cd-tier-text">Elite Creator</span>';
    } else if (text) { text.textContent = 'Elite Creator'; }

    // Any dashboard surface that renders commission percentage
    document.querySelectorAll('[data-creator-commission-pct]').forEach(function (el) {
      el.textContent = '40%';
    });
  }

  // ─── On load, if the dashboard already knows the creator is elite, hide banner
  document.addEventListener('DOMContentLoaded', function () {
    // 1) SessionStorage hint (set by onboarding or previous sessions)
    try {
      var just = JSON.parse(sessionStorage.getItem('mn_elite_state') || 'null');
      if (just && just.is_elite) applyEliteStateToDashboard(just);
    } catch (_) {}

    // 2) Live check via the creator earnings/profile API (non-blocking)
    fetch(CREATOR_API.replace(/\/+$/,'') + '/api/creator/earnings?creator_id=' + encodeURIComponent(CREATOR_ID))
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (!j || !j.success) return;
        var s = j.stats || j.data || {};
        if (s.is_elite || s.commission_tier === 'elite') {
          applyEliteStateToDashboard(s);
          try { sessionStorage.setItem('mn_elite_state', JSON.stringify({ is_elite: true })); } catch (_) {}
        }
      })
      .catch(function () {});
  });
})();
</script>


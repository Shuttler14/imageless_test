      <script>
      (function() {
        'use strict';
        var CREATOR_API = 'https://mynarrative-ai.vercel.app';
        var CREATOR_ID  = '{{ customer.id }}';
        var REFRESH_MS  = 60000;

        var TIER_CFG = {
          Bronze:  { icon: '🥉', color: '#CD7F32' },
          Silver:  { icon: '🥈', color: '#C0C0C0' },
          Gold:    { icon: '🥇', color: '#FFD700' },
          Diamond: { icon: '💎', color: '#B9F2FF' },
        };

        function rupees(n) {
          n = parseFloat(n) || 0;
          if (n >= 100000) return '₹' + (n/100000).toFixed(1) + 'L';
          if (n >= 1000)   return '₹' + (n/1000).toFixed(1)   + 'K';
          return '₹' + n.toFixed(0);
        }

        function setText(id, val) {
          var el = document.getElementById(id);
          if (el) { el.textContent = val; el.classList.remove('cd-loading'); }
        }

        function setColor(id, color) {
          var el = document.getElementById(id);
          if (el) el.style.color = color;
        }

        function fetchAndPopulate() {
          if (!CREATOR_ID) return;
          fetch(CREATOR_API + '/api/creator/earnings?creator_id=' + CREATOR_ID, {
            headers: { 'Accept': 'application/json' }
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var s = data.summary || data || {};

            // Card 1 & 3: Earnings
            var earned = s.total_earnings_rupees || s.lifetime_earnings || 0;
            setText('cd-earnings',          rupees(earned));
            setText('cd-lifetime-earnings', rupees(earned));

            // Card 2: Sales
            var sold = s.total_designs_sold || s.total_sales || 0;
            setText('cd-designs-sold', sold.toLocaleString());

            // Card 4: Tier
            var tier    = s.creator_tier || 'Bronze';
            var tierCfg = TIER_CFG[tier] || TIER_CFG.Bronze;
            var tierEl  = document.getElementById('cd-tier');
            if (tierEl) {
              tierEl.textContent = tierCfg.icon + ' ' + tier;
              tierEl.style.color = tierCfg.color;
              tierEl.classList.remove('cd-loading');
            }
            var tp = s.tier_progress;
            if (tp) {
              var prog = document.getElementById('cd-tier-progress');
              if (prog) {
                prog.textContent = tp.next_tier
                  ? tp.sales_to_next_tier + ' sales to ' + tp.next_tier
                  : '💎 Top tier!';
              }
            }

            // Update header tier badge if present
            var badge = document.getElementById('cdHeaderTierBadge');
            if (badge) {
              badge.className = 'cd-tier-badge ' + tier.toLowerCase();
              badge.innerHTML = tierCfg.icon + ' ' + tier;
            }

            // Card 5: Narrative Tokens
            var credits = (s.ai_credits != null) ? s.ai_credits : (data.ai_credits != null ? data.ai_credits : null);
            var tokEl   = document.getElementById('cd-tokens');
            var tokCard = document.getElementById('cdTokensCard');
            var tokCTA  = document.getElementById('cd-tokens-cta');

            if (tokEl && credits !== null) {
              tokEl.textContent = credits;
              tokEl.classList.remove('cd-loading');
              if (credits === 0) {
                tokEl.style.color = '#ef4444';
                if (tokCard) tokCard.style.borderColor = 'rgba(239,68,68,0.4)';
                if (tokCTA)  tokCTA.style.display = 'block';
              } else if (credits <= 1) {
                tokEl.style.color = '#f59e0b';
                if (tokCard) tokCard.style.borderColor = 'rgba(245,158,11,0.35)';
              } else {
                tokEl.style.color = '#39A596';
              }
            } else if (tokEl) {
              // Pre-migration: show default 3
              tokEl.textContent = '3';
              tokEl.classList.remove('cd-loading');
            }
          })
          .catch(function(e) {
            console.warn('[MN] Earnings fetch failed:', e.message);
            // Remove shimmer so page doesn't look broken
            ['cd-earnings','cd-designs-sold','cd-lifetime-earnings','cd-tier','cd-tokens'].forEach(function(id) {
              var el = document.getElementById(id);
              if (el && el.textContent === '—') {
                el.textContent = '–';
                el.classList.remove('cd-loading');
              }
            });
          });
        }

        if (CREATOR_ID) {
          fetchAndPopulate();
          setInterval(fetchAndPopulate, REFRESH_MS);
        }
        window.mnRefreshDashboard = fetchAndPopulate;
      })();
      </script>


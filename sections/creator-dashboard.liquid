{% comment %}
================================================================================
MY NARRATIVE - CREATOR DASHBOARD SECTION (V3.0 - Buy-to-Publish)
================================================================================
Design-to-Earn Creator Dashboard - No Minimum Balance Requirements

Version: 3.0.0
- Removed payout thresholds (no more ₹2,500 / ₹5,000 minimums)
- Added 2-step onboarding modal
- Added Products/My Drops tab with empty state CTA
- Smart profile with auto-generated avatar/username from socials

USAGE:
{% section 'creator-dashboard' %}

REQUIRED CUSTOMER AUTHENTICATION:
Customer must be logged in to view their dashboard.

================================================================================
{% endcomment %}

{% comment %} =====================================================
SECTION CONFIGURATION
===================================================== {% endcomment %}

{% assign api_base_url = section.settings.api_base_url | default: 'https://mynarrative-ai-peach.vercel.app' %}
{% assign creator_api_base_url = section.settings.creator_api_base_url | default: 'https://mynarrative-ai-peach.vercel.app' %}
{% assign enable_debug = section.settings.enable_debug | default: false %}

{% assign creator_id = customer.id | default: '' %}
{% assign creator_email = customer.email | default: '' %}
{% assign creator_first_name = customer.first_name | default: '' %}
{% assign creator_name = customer.name | default: 'Creator' %}

{% assign is_logged_in = false %}
{% if customer.id != blank %}
  {% assign is_logged_in = true %}
{% endif %}

<style>
  /* =====================================================
     CREATOR DASHBOARD - PRODUCTION STYLES
     ===================================================== */
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  :root {
    --mn-creator-teal: #39A596;
    --mn-creator-teal-rgb: 57, 165, 150;
    --mn-creator-purple: #8b5cf6;
    --mn-creator-gold: #fbbf24;
    --mn-creator-dark: #0a0a0a;
    --mn-creator-card: rgba(255, 255, 255, 0.03);
    --mn-creator-border: rgba(255, 255, 255, 0.08);
  }

  .mn-creator-dashboard {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #0a0a0a 0%, #111111 50%, #0a0a0a 100%);
    color: #fff;
    min-height: 100vh;
    padding: 20px;
    border-radius: 16px;
    margin: 20px 0;
    position: relative;
    overflow: hidden;
  }

  /* Background Effects */
  .mn-creator-dashboard::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(57, 165, 150, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .mn-creator-dashboard::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Header Section */
  .mn-creator-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid rgba(57, 165, 150, 0.2);
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .mn-creator-title {
    font-size: 24px;
    font-weight: 700;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .mn-creator-badge {
    padding: 8px 16px;
    background: rgba(57, 165, 150, 0.1);
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: #39A596;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mn-creator-badge.mega {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(245, 158, 11, 0.1));
    border-color: rgba(251, 191, 36, 0.5);
    color: #fbbf24;
  }

  /* Metrics Cards */
  .mn-creator-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .mn-metric-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 20px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .mn-metric-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent-color, #39A596), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mn-metric-card:hover {
    border-color: rgba(57, 165, 150, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(57, 165, 150, 0.1);
  }

  .mn-metric-card:hover::before {
    opacity: 1;
  }

  .mn-metric-card[data-metric="balance"] { --accent-color: #39A596; }
  .mn-metric-card[data-metric="lifetime"] { --accent-color: #fbbf24; }
  .mn-metric-card[data-metric="listings"] { --accent-color: #8b5cf6; }
  .mn-metric-card[data-metric="sales"] { --accent-color: #22c55e; }

  .mn-metric-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 24px;
  }

  .mn-metric-icon.balance { background: rgba(57, 165, 150, 0.15); }
  .mn-metric-icon.lifetime { background: rgba(251, 191, 36, 0.15); }
  .mn-metric-icon.listings { background: rgba(139, 92, 246, 0.15); }
  .mn-metric-icon.sales { background: rgba(34, 197, 94, 0.15); }

  .mn-metric-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .mn-metric-value {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
  }

  .mn-metric-value.currency {
    color: #39A596;
  }

  /* Progress Bar - REMOVED - No more minimum balance requirements */
  
  /* Social Connect Section */
  .mn-social-section {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .mn-social-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .mn-social-platforms {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  @media (max-width: 600px) {
    .mn-social-platforms {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .mn-social-platform {
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-social-platform:hover {
    border-color: rgba(57, 165, 150, 0.4);
  }

  .mn-social-platform.connected {
    border-color: #39A596;
    background: rgba(57, 165, 150, 0.1);
  }

  .mn-social-platform-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    color: #ffffff;
    background:
      radial-gradient(circle at 30% 30%, rgba(57,165,150,0.32), rgba(57,165,150,0.08) 58%, transparent 70%),
      linear-gradient(135deg, rgba(255,255,255,0.10), rgba(57,165,150,0.08));
    border: 1px solid rgba(57,165,150,0.22);
    box-shadow: 0 10px 30px rgba(57,165,150,0.18), inset 0 1px 8px rgba(255,255,255,0.08);
  }

  .mn-social-platform-icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .mn-social-platform-name {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
  }

  .mn-social-platform-followers {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin-top: 4px;
  }

  .mn-connect-btn {
    width: 100%;
    padding: 14px 18px;
    background: linear-gradient(135deg, rgba(57,165,150,0.22), rgba(57,165,150,0.09));
    border: 1px solid rgba(57,165,150,0.34);
    border-radius: 14px;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 14px 30px rgba(0,0,0,0.22);
    backdrop-filter: blur(12px);
  }

  .mn-connect-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(57,165,150,0.5);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 18px 36px rgba(57,165,150,0.16);
  }

  /* Tier Upgrade Banner */
  .mn-tier-banner {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(251, 191, 36, 0.1));
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    z-index: 1;
  }

  .mn-tier-banner-icon {
    font-size: 32px;
  }

  .mn-tier-banner-content {
    flex: 1;
  }

  .mn-tier-banner-title {
    font-size: 16px;
    font-weight: 700;
    color: #8b5cf6;
    margin-bottom: 4px;
  }

  .mn-tier-banner-desc {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
  }

  /* Action Buttons */
  .mn-actions-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .mn-action-btn {
    flex: 1;
    min-width: 150px;
    padding: 15px 18px;
    border-radius: 16px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 16px 36px rgba(0,0,0,0.24);
  }

  .mn-action-btn-primary {
    background: linear-gradient(135deg, rgba(57,165,150,0.28), rgba(45,212,191,0.12));
    border: 1px solid rgba(57,165,150,0.42);
    color: #fff;
  }

  .mn-action-btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(57,165,150,0.55);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 18px 36px rgba(57,165,150,0.18);
  }

  .mn-action-btn-secondary {
    background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .mn-action-btn-secondary:hover {
    border-color: rgba(57,165,150,0.34);
    color: #fff;
    background: linear-gradient(135deg, rgba(57,165,150,0.14), rgba(255,255,255,0.04));
    box-shadow: 0 14px 28px rgba(57,165,150,0.12);
  }

  /* Loading State */
  .mn-creator-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 20px;
    color: rgba(255,255,255,0.74);
    position: relative;
    z-index: 1;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(57,165,150,0.04));
    border: 1px solid rgba(57,165,150,0.12);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 18px 50px rgba(0,0,0,0.24);
    overflow: hidden;
  }

  .mn-creator-loading::before {
    content: '';
    position: absolute;
    inset: -20% auto auto -10%;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(57,165,150,0.16), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
  }

  .mn-spinner { display: none; }

  .mn-cine-loader {
    max-width: 360px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .mn-cine-orb {
    width: 66px;
    height: 66px;
    margin: 0 auto 18px;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.35), rgba(57,165,150,0.22) 40%, rgba(57,165,150,0.04) 72%, transparent 76%);
    box-shadow: 0 0 30px rgba(57,165,150,0.30), inset 0 0 18px rgba(255,255,255,0.14);
    animation: mnPulseOrb 2.2s ease-in-out infinite;
  }

  .mn-cine-bars {
    display: grid;
    gap: 10px;
    margin: 0 auto 14px;
  }

  .mn-cine-bar {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(57,165,150,0.12), rgba(255,255,255,0.30), rgba(57,165,150,0.12));
    background-size: 200% 100%;
    animation: mnShimmer 1.7s linear infinite;
  }

  .mn-cine-bar:nth-child(1) { width: 100%; }
  .mn-cine-bar:nth-child(2) { width: 82%; margin: 0 auto; }
  .mn-cine-bar:nth-child(3) { width: 64%; margin: 0 auto; }

  .mn-cine-title {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
    letter-spacing: 0.02em;
  }

  .mn-cine-tip {
    font-size: 12px;
    color: rgba(255,255,255,0.72);
    text-shadow: 0 0 16px rgba(57,165,150,0.18);
    animation: mnTipGlow 2.8s ease-in-out infinite;
  }

  @keyframes mnCreatorSpin {
    to { transform: rotate(360deg); }
  }

  @keyframes mnShimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @keyframes mnPulseOrb {
    0%, 100% { transform: scale(0.96); opacity: 0.88; }
    50% { transform: scale(1.04); opacity: 1; }
  }

  @keyframes mnTipGlow {
    0%, 100% { opacity: 0.55; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-1px); }
  }

  /* Error State */
  .mn-creator-error {
    padding: 24px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 12px;
    color: #ef4444;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* Login Required State */
  .mn-creator-login {
    padding: 40px;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    position: relative;
    z-index: 1;
  }

  .mn-creator-login h3 {
    font-size: 20px;
    margin-bottom: 12px;
    color: #fff;
  }

  .mn-creator-login p {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 20px;
  }

  .mn-creator-login a {
    display: inline-block;
    padding: 12px 24px;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    color: #000;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
  }

  /* Modal */
  .mn-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(4px);
  }

  .mn-modal-overlay.active {
    display: flex;
  }

  .mn-modal {
    background: #111;
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 16px;
    padding: 24px;
    max-width: 400px;
    width: 100%;
    position: relative;
    z-index: 1001;
  }

  .mn-modal-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .mn-modal-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    margin-bottom: 12px;
    box-sizing: border-box;
  }

  .mn-modal-input:focus {
    border-color: #39A596;
    outline: none;
  }

  .mn-modal-buttons {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

  .mn-modal-btn {
    flex: 1;
    padding: 12px;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-modal-btn-cancel {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .mn-modal-btn-confirm {
    background: #39A596;
    border: none;
    color: #000;
  }

  .mn-modal-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Alert/Toast */
  .mn-toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    padding: 16px 24px;
    border-radius: 12px;
    color: #fff;
    font-weight: 500;
    z-index: 2000;
    animation: slideIn 0.3s ease;
    max-width: 300px;
  }

  .mn-toast.success {
    background: rgba(34, 197, 94, 0.9);
  }

  .mn-toast.error {
    background: rgba(239, 68, 68, 0.9);
  }

  .mn-toast.info {
    background: rgba(57, 165, 150, 0.9);
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  /* 2-Step Onboarding Modal */
  .mn-onboarding-modal {
    max-width: 480px;
  }

  .mn-onboarding-steps {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .mn-onboarding-step {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.5);
    font-size: 13px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .mn-onboarding-step.active {
    background: rgba(57, 165, 150, 0.2);
    color: #39A596;
  }

  .mn-onboarding-step.completed {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .mn-onboarding-step-number {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  .mn-onboarding-step.active .mn-onboarding-step-number {
    background: #39A596;
    color: #000;
  }

  .mn-onboarding-step.completed .mn-onboarding-step-number {
    background: #22c55e;
    color: #fff;
  }

  .mn-onboarding-content {
    display: none;
  }

  .mn-onboarding-content.active {
    display: block;
  }

  .mn-onboarding-input {
    width: 100%;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    margin-bottom: 16px;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .mn-onboarding-input:focus {
    border-color: #39A596;
    outline: none;
    box-shadow: 0 0 20px rgba(57, 165, 150, 0.2);
  }

  .mn-onboarding-input::placeholder {
    color: rgba(255,255,255,0.3);
  }

  .mn-onboarding-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    margin-bottom: 8px;
  }

  .mn-onboarding-btn {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    border: none;
    border-radius: 12px;
    color: #000;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-onboarding-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(57, 165, 150, 0.4);
  }

  .mn-onboarding-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .mn-onboarding-skip {
    display: block;
    text-align: center;
    margin-top: 16px;
    color: rgba(255,255,255,0.4);
    font-size: 13px;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .mn-onboarding-skip:hover {
    color: rgba(255,255,255,0.7);
  }

  /* Social Connect Grid for Onboarding */
  .mn-onboarding-socials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  .mn-onboarding-social {
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-onboarding-social:hover {
    border-color: rgba(57, 165, 150, 0.4);
  }

  .mn-onboarding-social.connected {
    border-color: #39A596;
    background: rgba(57, 165, 150, 0.1);
  }

  .mn-onboarding-social-icon {
    font-size: 24px;
    margin-bottom: 8px;
  }

  .mn-onboarding-social-name {
    font-size: 13px;
    color: rgba(255,255,255,0.7);
  }

  /* Confetti Animation */
  .mn-confetti-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
  }

  .mn-confetti {
    position: absolute;
    width: 10px;
    height: 10px;
    opacity: 0;
  }

  @keyframes confetti-fall {
    0% {
      transform: translateY(-100%) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translateY(100vh) rotate(720deg);
      opacity: 0;
    }
  }

  /* Tabs Section */
  .mn-tabs-container {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .mn-tabs-header {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 16px;
  }

  .mn-tab-btn {
    padding: 12px 24px;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.5);
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-tab-btn:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.05);
  }

  .mn-tab-btn.active {
    background: rgba(57, 165, 150, 0.2);
    color: #39A596;
  }

  .mn-tab-content {
    display: none;
  }

  .mn-tab-content.active {
    display: block;
  }

  /* Empty State */
  .mn-empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .mn-empty-state-icon {
    font-size: 64px;
    margin-bottom: 20px;
    opacity: 0.5;
  }

  .mn-empty-state-title {
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .mn-empty-state-desc {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 24px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .mn-empty-state-cta {
    display: inline-block;
    padding: 18px 36px;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    border: none;
    border-radius: 12px;
    color: #000;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mn-empty-state-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(57, 165, 150, 0.4);
  }

  /* Products Grid */
  .mn-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  .mn-product-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .mn-product-card:hover {
    border-color: rgba(57, 165, 150, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .mn-product-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.05);
  }

  .mn-product-info {
    padding: 16px;
  }

  .mn-product-title {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mn-product-stats {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .mn-product-price {
    color: #39A596;
    font-weight: 600;
  }

  /* Earnings Section */
  .mn-earnings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .mn-earnings-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 20px;
  }

  .mn-earnings-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .mn-earnings-value {
    font-size: 24px;
    font-weight: 700;
    color: #fff;
  }

  .mn-earnings-value.currency {
    color: #39A596;
  }

  /* Debug Panel */
  {% if enable_debug %}
  .mn-debug-panel {
    margin-top: 20px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    font-family: monospace;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    position: relative;
    z-index: 1;
  }
  {% endif %}
</style>


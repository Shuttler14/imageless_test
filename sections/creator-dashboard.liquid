<script>
(function() {
  'use strict';

  // =====================================================
  // CONFIGURATION
  // =====================================================
  const CONFIG = {
    apiBaseUrl: '{{ api_base_url }}',
    creatorApiBaseUrl: '{{ creator_api_base_url }}',
    creatorId: '{{ creator_id }}',
    creatorEmail: '{{ creator_email }}',
    creatorFirstName: '{{ creator_first_name }}',
    isLoggedIn: {{ is_logged_in }},
    commissionTiers: {
      basic: { rate: 15, label: 'Standard Creator' },
      influencer: { rate: 20, label: 'Influencer' },
      elite: { rate: 45, label: 'Elite Creator' }
    },
    eliteThresholds: {
      instagram: 500000,
      youtube: 300000,
      twitter: 200000,
      linkedin: 150000
    }
  };

  // =====================================================
  // STATE
  // =====================================================
  const state = {
    profile: null,
    isRegistered: false,
    isLoading: true,
    onboardingCompleted: false,
    selectedPlatform: null
  };

  // =====================================================
  // API FUNCTIONS
  // =====================================================
  async function autoRegister() {
    try {
      const response = await fetch(`${CONFIG.creatorApiBaseUrl}/api/creator_register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: '/api/creator/auto_register',
          user_id: CONFIG.creatorId,
          email: CONFIG.creatorEmail,
          first_name: CONFIG.creatorFirstName
        })
      });
      const data = await response.json();
      state.isRegistered = !data.data?.is_new;
      return data;
    } catch (e) {
      console.error('Auto-register error:', e);
      state.isRegistered = true;
      return { success: true };
    }
  }

  async function fetchCreatorProfile() {
    if (!CONFIG.creatorId) {
      throw new Error('No creator ID');
    }

    const response = await fetch(
      `${CONFIG.creatorApiBaseUrl}/api/creator_economy?path=/api/creator/profile&user_id=${CONFIG.creatorId}`
    );

    const data = await response.json();
    return data;
  }

  async function fetchCreatorDesigns() {
    if (!CONFIG.creatorId) return { success: true, data: [] };

    try {
      const response = await fetch(
        `${CONFIG.creatorApiBaseUrl}/api/creator_economy?path=/api/creator/designs&user_id=${CONFIG.creatorId}`
      );
      const data = await response.json();
      return data;
    } catch (e) {
      return { success: true, data: [] };
    }
  }

  async function setupBrandName(brandName) {
    try {
      await fetch(`${CONFIG.creatorApiBaseUrl}/api/creator_register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: '/api/creator/setup_brand',
          user_id: CONFIG.creatorId,
          brand_name: brandName
        })
      });
    } catch (e) {
      console.error('Setup brand error:', e);
    }
  }

  async function completeOnboarding() {
    try {
      await fetch(`${CONFIG.creatorApiBaseUrl}/api/creator_register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: '/api/creator/complete_onboarding',
          user_id: CONFIG.creatorId
        })
      });
    } catch (e) {
      console.error('Complete onboarding error:', e);
    }
  }

  async function verifySocial(platform, handle, followers) {
    try {
      const response = await fetch(`${CONFIG.creatorApiBaseUrl}/api/creator_register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: '/api/creator/verify_social',
          user_id: CONFIG.creatorId,
          platform: platform,
          handle: handle,
          followers: parseInt(followers)
        })
      });
      return await response.json();
    } catch (e) {
      console.error('Verify social error:', e);
      return { success: true, data: { verified: true } };
    }
  }

  // =====================================================
  // UI FUNCTIONS
  // =====================================================
  function formatCurrency(amount) {
    if (amount === null || amount === undefined) return '₹0';
    return '₹' + new Intl.NumberFormat('en-IN').format(amount || 0);
  }

  function formatFollowers(count) {
    if (!count || count === 0) return '--';
    if (count >= 1000000) return (count / 1000000).toFixed(1) + 'M';
    if (count >= 1000) return (count / 1000).toFixed(0) + 'K';
    return count.toString();
  }

  function showToast(message, type = 'info') {
    const existing = document.querySelector('.mn-toast');
    if (existing) existing.remove();

    const toast = document.createElement('div');
    toast.className = `mn-toast ${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);

    setTimeout(() => toast.remove(), 4000);
  }

  function updateUI(profile) {
    if (!profile) return;

    // Update brand name and avatar
    const brandName = profile.brand_name || profile.first_name || CONFIG.creatorFirstName || 'Creator';
    document.getElementById('mnBrandNameDisplay').textContent = brandName;

    const username = profile.username || 'username';
    document.getElementById('mnUsernameDisplay').textContent = '@' + username;

    // Update avatar
    const avatarEl = document.getElementById('mnCreatorAvatar');
    if (profile.avatar_url && profile.avatar_url !== 'https://api.dicebear.com/7.x/avataaars/svg?seed=creator') {
      avatarEl.innerHTML = `<img src="${profile.avatar_url}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
    } else {
      avatarEl.textContent = (brandName.charAt(0) || 'C').toUpperCase();
    }

    // Update tier badge
    const tier = CONFIG.commissionTiers[profile.tier] || CONFIG.commissionTiers.basic;
    const commissionRate = profile.commission_rate ?? tier.rate;
    document.getElementById('mnTierBadge').textContent = `${tier.label} - ${commissionRate}%`;

    // Update earnings
    document.getElementById('mnBalance').textContent = formatCurrency(profile.balance || 0);
    document.getElementById('mnLifetimeEarnings').textContent = formatCurrency(profile.lifetime_earnings || 0);
    document.getElementById('mnItemsSold').textContent = profile.total_items_sold || 0;
    document.getElementById('mnActiveListings').textContent = profile.active_listings || 0;
    document.getElementById('mnCommissionRate').textContent = (profile.commission_rate || 15) + '%';
    document.getElementById('mnTotalFollowers').textContent = formatFollowers(profile.total_followers || 0);

    // Update social platforms
    updateSocialPlatforms(profile.social_links);

    // Check if onboarding is completed
    state.onboardingCompleted = profile.onboarding_completed === true;
  }

  function updateSocialPlatforms(socialLinks) {
    const platforms = ['instagram', 'youtube', 'twitter', 'linkedin'];

    platforms.forEach(platform => {
      const el = document.getElementById('mnPlatform' + capitalizeFirst(platform));
      const followersEl = document.getElementById('mn' + capitalizeFirst(platform) + 'Followers');

      if (socialLinks && socialLinks[platform]) {
        el.classList.add('connected');
        followersEl.textContent = formatFollowers(socialLinks[platform].followers);
      } else {
        el.classList.remove('connected');
        followersEl.textContent = '--';
      }
    });
  }

  function capitalizeFirst(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  function showOnboardingModal() {
    document.getElementById('mnOnboardingModal').classList.add('active');
    goToOnboardingStep(1);
  }

  function hideOnboardingModal() {
    document.getElementById('mnOnboardingModal').classList.remove('active');
  }

  function goToOnboardingStep(step) {
    document.querySelectorAll('.mn-onboarding-step').forEach(s => {
      s.classList.remove('active', 'completed');
      if (parseInt(s.dataset.step) < step) {
        s.classList.add('completed');
      } else if (parseInt(s.dataset.step) === step) {
        s.classList.add('active');
      }
    });

    document.querySelectorAll('.mn-onboarding-content').forEach(c => {
      c.classList.remove('active');
      if (parseInt(c.dataset.step) === step) {
        c.classList.add('active');
      }
    });
  }

  function triggerConfetti() {
    const container = document.createElement('div');
    container.className = 'mn-confetti-container';
    document.body.appendChild(container);

    const colors = ['#39A596', '#2dd4bf', '#fbbf24', '#8b5cf6', '#22c55e'];

    for (let i = 0; i < 100; i++) {
      const confetti = document.createElement('div');
      confetti.className = 'mn-confetti';
      confetti.style.left = Math.random() * 100 + '%';
      confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      confetti.style.animation = `confetti-fall ${2 + Math.random() * 2}s ease-out forwards`;
      confetti.style.animationDelay = Math.random() * 0.5 + 's';
      container.appendChild(confetti);
    }

    setTimeout(() => container.remove(), 5000);
  }

  function renderProducts(products) {
    const grid = document.getElementById('mnProductsGrid');
    const emptyState = document.getElementById('mnEmptyProducts');

    if (!products || products.length === 0) {
      grid.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    grid.style.display = 'grid';
    emptyState.style.display = 'none';

    grid.innerHTML = products.map(product => `
      <div class="mn-product-card">
        <img class="mn-product-image" src="${product.flux_editorial_image_url || 'https://via.placeholder.com/200'}" alt="${product.title}">
        <div class="mn-product-info">
          <p class="mn-product-title">${product.title}</p>
          <div class="mn-product-stats">
            <span class="mn-product-price">₹${product.price || 0}</span>
            <span>${product.total_sales || 0} sold</span>
          </div>
        </div>
      </div>
    `).join('');
  }

  // =====================================================
  // EVENT HANDLERS
  // =====================================================
  function setupEventListeners() {
    // Tab switching
    document.querySelectorAll('.mn-tab-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const tab = this.dataset.tab;
        
        document.querySelectorAll('.mn-tab-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        document.querySelectorAll('.mn-tab-content').forEach(c => c.classList.remove('active'));
        document.getElementById('mnTab' + capitalizeFirst(tab)).classList.add('active');
      });
    });

    // Social connect button
    document.getElementById('mnConnectSocialBtn').addEventListener('click', function() {
      document.getElementById('mnSocialModal').classList.add('active');
    });

    // Cancel social modal
    document.getElementById('mnCancelSocial').addEventListener('click', function() {
      document.getElementById('mnSocialModal').classList.remove('active');
      clearSocialForm();
    });

    // Confirm social link
    document.getElementById('mnConfirmSocial').addEventListener('click', async function() {
      const platform = document.getElementById('mnPlatformSelect').value;
      const handle = document.getElementById('mnHandleInput').value;
      const followers = document.getElementById('mnFollowersInput').value;

      if (!platform || !handle || !followers) {
        showToast('Please fill in all fields', 'error');
        return;
      }

      this.disabled = true;
      this.textContent = 'Verifying...';

      try {
        const result = await verifySocial(platform, handle, followers);

        if (result.success) {
          await loadDashboard();
          document.getElementById('mnSocialModal').classList.remove('active');
          clearSocialForm();
          showToast(result.data?.is_elite ? 'Elite status unlocked!' : 'Social connected!', 'success');
        } else {
          showToast(result.error || 'Failed to connect', 'error');
        }
      } catch (error) {
        showToast(error.message, 'error');
      } finally {
        this.disabled = false;
        this.innerHTML = 'Connect';
      }
    });

    // Onboarding step 1
    document.getElementById('mnOnboardingStep1Btn').addEventListener('click', async function() {
      const brandName = document.getElementById('mnBrandNameInput').value.trim();
      
      if (brandName) {
        await setupBrandName(brandName);
        document.getElementById('mnBrandNameDisplay').textContent = brandName;
      }
      
      goToOnboardingStep(2);
    });

    // Onboarding skip
    document.getElementById('mnSkipOnboarding')?.addEventListener('click', async function() {
      await completeOnboarding();
      hideOnboardingModal();
      showToast('Setup skipped. You can complete it later!', 'info');
    });

    // Onboarding finish
    document.getElementById('mnOnboardingFinishBtn').addEventListener('click', async function() {
      await completeOnboarding();
      hideOnboardingModal();
      triggerConfetti();
      showToast('Welcome to My Narrative Creator Program!', 'success');
      state.onboardingCompleted = true;
    });

    // Onboarding social selection
    document.querySelectorAll('.mn-onboarding-social').forEach(el => {
      el.addEventListener('click', function() {
        const platform = this.dataset.platform;
        state.selectedPlatform = platform;
        
        document.getElementById('mnSocialInputTitle').textContent = 'Connect ' + capitalizeFirst(platform);
        document.getElementById('mnOnboardingModal').classList.remove('active');
        document.getElementById('mnSocialInputModal').classList.add('active');
      });
    });

    // Cancel social input
    document.getElementById('mnCancelSocialInput').addEventListener('click', function() {
      document.getElementById('mnSocialInputModal').classList.remove('active');
      document.getElementById('mnOnboardingModal').classList.add('active');
    });

    // Confirm social input
    document.getElementById('mnConfirmSocialInput').addEventListener('click', async function() {
      const handle = document.getElementById('mnSocialHandleInput').value;
      const followers = document.getElementById('mnSocialFollowersInput').value;

      if (!handle || !followers) {
        showToast('Please fill in all fields', 'error');
        return;
      }

      this.disabled = true;
      this.textContent = 'Verifying...';

      try {
        const result = await verifySocial(state.selectedPlatform, handle, followers);
        
        if (result.success) {
          document.querySelector(`.mn-onboarding-social[data-platform="${state.selectedPlatform}"]`)?.classList.add('connected');
          showToast(result.data?.is_elite ? 'Elite status unlocked!' : 'Connected!', 'success');
        }
        
        document.getElementById('mnSocialInputModal').classList.remove('active');
        document.getElementById('mnOnboardingModal').classList.add('active');
        
        // Clear inputs
        document.getElementById('mnSocialHandleInput').value = '';
        document.getElementById('mnSocialFollowersInput').value = '';
      } catch (error) {
        showToast(error.message, 'error');
      } finally {
        this.disabled = false;
        this.textContent = 'Verify & Connect';
      }
    });

    // Close modal on overlay click
    document.getElementById('mnSocialModal').addEventListener('click', function(e) {
      if (e.target === this) {
        this.classList.remove('active');
        clearSocialForm();
      }
    });
  }

  function clearSocialForm() {
    document.getElementById('mnPlatformSelect').value = '';
    document.getElementById('mnHandleInput').value = '';
    document.getElementById('mnFollowersInput').value = '';
  }

  // =====================================================
  // MAIN INIT
  // =====================================================
  async function loadDashboard() {
    if (!CONFIG.isLoggedIn || !CONFIG.creatorId) {
      state.isLoading = false;
      return;
    }

    try {
      // Auto-register if needed
      await autoRegister();

      // Fetch profile
      const profileResponse = await fetchCreatorProfile();

      if (!profileResponse.success) {
        throw new Error(profileResponse.error);
      }

      state.profile = profileResponse.data;

      // Update UI
      updateUI(state.profile);

      // Fetch and render products
      const designsResponse = await fetchCreatorDesigns();
      renderProducts(designsResponse.data || []);

      // Show onboarding if not completed
      if (!state.onboardingCompleted) {
        setTimeout(showOnboardingModal, 500);
      }

      // Show content
      document.getElementById('mnCreatorLoading').style.display = 'none';
      document.getElementById('mnCreatorContent').style.display = 'block';

    } catch (error) {
      console.error('Dashboard load error:', error);
      document.getElementById('mnCreatorLoading').style.display = 'none';

      if (CONFIG.isLoggedIn) {
        document.getElementById('mnCreatorError').style.display = 'block';
      }
    }

    state.isLoading = false;
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      loadDashboard();
      setupEventListeners();
    });
  } else {
    loadDashboard();
    setupEventListeners();
  }

})();
</script>


    .config-input,
    .config-textarea {
      font-size: 16px;
    }
  }
</style>

<script>
  class CreatorListingDashboard {
    constructor() {
      this.state = {
        designData: null,
        creatorProfile: null,
        selectedProduct: 'tshirt',
        selectedColors: new Set(),
        price: 799,
        commissionRate: 5,
        isPublishing: false
      };

      this.colorConfig = {
        tshirt: [
          { name: 'White', id: 'tshirt_white' },
          { name: 'Black', id: 'tshirt_black' },
          { name: 'Navy', id: 'tshirt_navy' },
          { name: 'Sage', id: 'tshirt_sage' },
          { name: 'Coral', id: 'tshirt_coral' }
        ],
        hoodie: [
          { name: 'White', id: 'hoodie_white' },
          { name: 'Black', id: 'hoodie_black' },
          { name: 'Navy', id: 'hoodie_navy' },
          { name: 'Burgundy', id: 'hoodie_burgundy' },
          { name: 'Forest', id: 'hoodie_forest' }
        ]
      };

      this.priceConfig = {
        tshirt: { min: 649, max: 999, default: 799 },
        hoodie: { min: 1199, max: 1899, default: 1499 }
      };

      this.init();
    }

    async init() {
      this.attachEventListeners();
      // Fetch tokens first (gates the publish button)
      await this.fetchTokens();
      // Then fetch design data in parallel
      await this.fetchData();
      this.renderColors();
      this.updatePricing();
    }

    attachEventListeners() {
      // Product toggle
      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', (e) => this.handleProductToggle(e));
      });

      // Title and description
      document.getElementById('titleInput').addEventListener('input', (e) => {
        document.getElementById('titleCount').textContent = e.target.value.length;
      });

      document.getElementById('descriptionInput').addEventListener('input', (e) => {
        document.getElementById('descCount').textContent = e.target.value.length;
      });

      // Price slider
      document.getElementById('priceSlider').addEventListener('input', (e) => {
        this.state.price = parseInt(e.target.value);
        this.updatePricing();
      });

      // Publish button
      document.getElementById('publishBtn').addEventListener('click', () => this.handlePublish());
    }

    // ── Token Gate helpers ──────────────────────────────────────
    updateTokenGate(aiCredits) {
      const loading = document.getElementById('tokensGateLoading');
      const ready   = document.getElementById('tokensGateReady');
      const blocked = document.getElementById('tokensGateBlocked');
      const count   = document.getElementById('tokensGateCount');
      const bar     = document.getElementById('tokensGateBar');
      const gate    = document.getElementById('tokensGate');
      const pubBtn  = document.getElementById('publishBtn');

      if (loading) loading.style.display = 'none';

      if (aiCredits === null || aiCredits === undefined) {
        // Unknown — pre-migration, allow publish with default 3
        if (ready) ready.style.display = 'block';
        if (count) count.textContent = '3+';
        if (bar)   bar.style.width = '100%';
        if (pubBtn) pubBtn.disabled = false;
        return;
      }

      const MAX_DISPLAY = 10; // bar fills at 10 tokens
      const pct = Math.min(100, Math.round((aiCredits / MAX_DISPLAY) * 100));

      if (aiCredits <= 0) {
        // BLOCKED — no tokens
        if (blocked) blocked.style.display = 'block';
        if (ready)   ready.style.display   = 'none';
        if (gate)    gate.style.borderColor = 'rgba(239,68,68,0.4)';
        if (pubBtn) {
          pubBtn.disabled    = true;
          pubBtn.textContent = '🔒 No Tokens — Publish Locked';
        }
      } else {
        // READY — has tokens
        if (ready)   ready.style.display   = 'block';
        if (blocked) blocked.style.display = 'none';
        if (count)   count.textContent = aiCredits;
        if (bar)     bar.style.width = pct + '%';

        // Warn if low (1 token left)
        if (gate && aiCredits <= 1) {
          gate.style.borderColor = 'rgba(245,158,11,0.5)';
          if (count) count.style.color = '#f59e0b';
          if (bar)   bar.style.background = '#f59e0b';
        } else if (gate) {
          gate.style.borderColor = 'rgba(57,165,150,0.3)';
        }

        if (pubBtn) pubBtn.disabled = false;
      }

      // Store for post-publish update
      this.state.aiCredits = aiCredits;
    }

    async fetchTokens() {
      const customerId = '{{ customer.id }}';
      if (!customerId) {
        this.updateTokenGate(null);
        return;
      }
      try {
        const resp = await fetch(
          `https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/creator/earnings/summary?creator_id=${customerId}`,
          { headers: { 'Accept': 'application/json' } }
        );
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data    = await resp.json();
        const summary = data.summary || data || {};
        const credits = summary.ai_credits != null ? summary.ai_credits : null;
        this.updateTokenGate(credits);
      } catch (e) {
        console.warn('[MN] Token fetch failed:', e.message);
        this.updateTokenGate(null); // allow publish — fail open
      }
    }
    // ── End token gate helpers ──────────────────────────────────

    async fetchData() {
      try {
        const designId = MN_DESIGN_ID;
        const customerId = '{{ customer.id }}';

        // Fetch design data
        if (designId) {
          const designRes = await fetch(
            `https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/design/process?design_id=${encodeURIComponent(designId)}`
          );
          if (designRes.ok) {
            this.state.designData = await designRes.json();
            this.renderPreview();
          }
        }

        // Fetch creator profile
        if (customerId) {
          const profileRes = await fetch(
            `https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/creator/profile?user_id=${encodeURIComponent(customerId)}`
          );
          if (profileRes.ok) {
            this.state.creatorProfile = await profileRes.json();
            this.renderCreatorInfo();
          }
        }
      } catch (error) {
        console.error('Failed to fetch data:', error);
      }
    }

    renderCreatorInfo() {
      const profile = this.state.creatorProfile;
      if (!profile) return;

      const nameEl = document.getElementById('creatorName');
      const avatarEl = document.getElementById('creatorAvatar');

      nameEl.textContent = profile.username || 'Creator';
      
      if (profile.avatar_url) {
        avatarEl.innerHTML = `<img src="${profile.avatar_url}" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />`;
      } else {
        avatarEl.textContent = profile.username ? profile.username.charAt(0).toUpperCase() : 'C';
      }
    }

    renderPreview() {
      const data = this.state.designData;
      if (!data || !data.mockup_urls) return;

      const mockupUrls = data.mockup_urls;
      const thumbnailsContainer = document.getElementById('thumbnailsContainer');
      const mainPreview = document.getElementById('mainPreview');

      thumbnailsContainer.innerHTML = '';

      // Render thumbnails
      Object.entries(mockupUrls).forEach(([key, url]) => {
        const thumb = document.createElement('div');
        thumb.className = 'thumbnail';
        if (key === 'tshirt_white') thumb.classList.add('active');
        
        const img = document.createElement('img');
        img.src = url;
        img.alt = key;
        thumb.appendChild(img);

        thumb.addEventListener('click', () => {
          document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
          mainPreview.src = url;
        });

        thumbnailsContainer.appendChild(thumb);
      });

      // Set initial preview
      if (mockupUrls.tshirt_white) {
        mainPreview.src = mockupUrls.tshirt_white;
      }
    }

    handleProductToggle(e) {
      const product = e.target.dataset.product;
      this.state.selectedProduct = product;

      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      e.target.classList.add('active');

      this.state.selectedColors.clear();
      this.renderColors();
      this.updatePricing();
    }

    renderColors() {
      const colorsGrid = document.getElementById('colorsGrid');
      const colors = this.colorConfig[this.state.selectedProduct];

      colorsGrid.innerHTML = '';

      colors.forEach(color => {
        const label = document.createElement('label');
        label.className = 'color-checkbox';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = color.id;
        input.addEventListener('change', (e) => {
          if (e.target.checked) {
            this.state.selectedColors.add(color.id);
          } else {
            this.state.selectedColors.delete(color.id);
          }
          this.validateColors();
        });

        const colorName = document.createElement('label');
        colorName.textContent = color.name;

        label.appendChild(input);
        label.appendChild(colorName);
        colorsGrid.appendChild(label);
      });
    }

    validateColors() {
      const hasColors = this.state.selectedColors.size > 0;
      const errorEl = document.getElementById('colorError');
      
      if (!hasColors) {
        errorEl.style.display = 'block';
      } else {
        errorEl.style.display = 'none';
      }

      return hasColors;
    }

    updatePricing() {
      const config = this.priceConfig[this.state.selectedProduct];
      const price = this.state.price;
      const basePrice = Math.floor(price * (100 - this.state.commissionRate) / 100);
      const earnings = price - basePrice;

      document.getElementById('priceSlider').min = config.min;
      document.getElementById('priceSlider').max = config.max;
      document.getElementById('priceSlider').value = Math.max(config.min, Math.min(config.max, price));
      document.getElementById('minPrice').textContent = `₹${config.min}`;
      document.getElementById('maxPrice').textContent = `₹${config.max}`;

      document.getElementById('yourPrice').textContent = `₹${price}`;
      document.getElementById('platformBase').textContent = `₹${basePrice}`;
      document.getElementById('yourEarnings').textContent = `₹${earnings} (${this.state.commissionRate}%)`;
    }

    async handlePublish() {
      // Validate colors
      if (!this.validateColors()) {
        this.showStatus('error', 'Please select at least one color');
        return;
      }

      const title = document.getElementById('titleInput').value.trim();
      if (!title) {
        this.showStatus('error', 'Please enter a design title');
        return;
      }

      this.state.isPublishing = true;
      this.updatePublishButton();
      this.showStatus('loading', 'Publishing your design...');

      try {
        const designId = MN_DESIGN_ID;
        const customerId = '{{ customer.id }}';

        if (!designId) {
          this.showStatus('error', 'Missing design reference. Please reload the page from your dashboard.');
          this.state.isPublishing = false;
          this.updatePublishButton();
          return;
        }

        const selectedColors = Array.from(this.state.selectedColors).map(c => c.replace(`${this.state.selectedProduct}_`, ''));

        const payload = {
          design_id:       designId,
          creator_id:      customerId,
          title:           title,
          description:     document.getElementById('descriptionInput').value,
          product_type:    this.state.selectedProduct,
          selected_colors: selectedColors,
          price_paise:     this.state.price * 100,
          mockup_urls:     (this.state.designData && this.state.designData.mockup_urls) || {}
        };

        const response = await fetch(
          PROD_API + '/api/design/publish',
          {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(payload)
          }
        );

        const result = await response.json();

        if (response.ok && result.status === 'published') {
          // Store the returned data so cart & sample kit modal can use it
          this.state.publishedData = result;
          window.PUBLISH_RESULT    = result;  // expose for sample kit modal

          this.showStatus('success',
            `🎉 Your design is live! Share it on the feed — customers can now buy it. ` +
            `<button onclick="window.creatorDashboard.showBuyPreview()" class="preview-buy-btn">Preview Buy Flow</button>`
          );
          this._renderPublishedBuyPreview(result);

          // Show sample kit upsell modal
          const productUrl = result.shopify_product_url || '#';
          if (typeof window.showSampleKitModal === 'function') {
            setTimeout(() => window.showSampleKitModal(productUrl, result), 600);
          }

          // Update tokens gate with new balance after publish
          if (result.ai_credits_remaining != null) {
            // Update the pre-publish gate to show new balance
            this.updateTokenGate(result.ai_credits_remaining);
            // Also update the post-publish indicator
            const tokensCount = document.getElementById('tokensCount');
            const tokensInd   = document.getElementById('tokensIndicator');
            if (tokensCount) tokensCount.textContent = result.ai_credits_remaining;
            if (tokensInd)   tokensInd.style.display = 'flex';
          }
        } else {
          this.showStatus('error', result.error || 'Failed to publish design');
        }
      } catch (error) {
        this.showStatus('error', 'Network error. Please try again.');
        console.error('Publish error:', error);
      } finally {
        this.state.isPublishing = false;
        this.updatePublishButton();
      }
    }

    /**
     * Render a "Preview the Buy Flow" panel after publish.
     * Shows how a customer will add this design to cart with
     * _design_uuid injected as a Shopify line-item property.
     *
     * ARCHITECTURAL NOTE:
     * The unique_product_id travels with the ORDER via line-item properties,
     * NOT via product metafields. This avoids the global overwrite race condition
     * when multiple creators share the same 2 parent Shopify products.
     */
    _renderPublishedBuyPreview(publishResult) {
      const uniqueProductId = publishResult.unique_product_id;
      const variantMap      = publishResult.variant_map || {};
      const productType     = publishResult.product_type;
      const title           = publishResult.title;
      const creatorId       = '{{ customer.id }}';

      // Build preview cards for each selected color
      const colorCards = Object.entries(variantMap).map(([color, data]) => {
        const mockupUrl    = data.mockup_url || '';
        const variantNumId = data.variant_numeric || '';
        const cartPayload  = {
          items: [{
            id:       variantNumId,
            quantity: 1,
            properties: {
              '_design_uuid':  uniqueProductId,
              '_design_title': title,
              '_creator_id':   creatorId,
              '_product_type': productType,
              '_color':        color
            }
          }]
        };

        return `
          <div class="buy-preview-card">
            <img src="${mockupUrl}" alt="${color}" class="buy-preview-img" onerror="this.style.display='none'" />
            <div class="buy-preview-info">
              <strong style="text-transform:capitalize">${color}</strong>
              <button class="add-to-cart-btn" onclick="window.creatorDashboard.addToCart(${JSON.stringify(cartPayload).replace(/"/g, '&quot;')})">
                🛒 Add ${color} to Cart
              </button>
            </div>
          </div>`;
      }).join('');

      const panel = document.createElement('div');
      panel.id = 'buy-preview-panel';
      panel.style.cssText = 'margin-top:2rem;padding:1.5rem;background:#111;border:1px solid #39A596;border-radius:8px;';
      panel.innerHTML = `
        <h3 style="color:#39A596;margin:0 0 0.5rem">🧾 Buy Flow Preview</h3>
        <p style="color:#888;font-size:0.85rem;margin:0 0 1rem">
          Each "Add to Cart" call sends <code style="color:#39A596">_design_uuid: ${uniqueProductId}</code>
          as a Shopify line-item property. Your print provider reads this UUID from the order —
          never from a product metafield. Multiple creators can publish simultaneously without conflict.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem">${colorCards}</div>
      `;

      const config = document.querySelector('.cld-config-panel');
      const existing = document.getElementById('buy-preview-panel');
      if (existing) existing.remove();
      if (config) config.appendChild(panel);
    }

    /**
     * Add a design to the Shopify cart.
     * The _design_uuid line-item property tells the print provider
     * which design file to use. It is scoped to THIS order line,
     * so concurrent creators never conflict.
     */
    async addToCart(cartPayload) {
      try {
        const response = await fetch('/cart/add.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(cartPayload)
        });
        if (response.ok) {
          const result = await response.json();
          this.showStatus('success', '✅ Added to cart! <a href="/cart">View cart →</a>');
        } else {
          const err = await response.json();
          this.showStatus('error', err.description || 'Could not add to cart');
        }
      } catch (e) {
        this.showStatus('error', 'Cart error. Please try again.');
        console.error('Cart error:', e);
      }
    }

    showBuyPreview() {
      const panel = document.getElementById('buy-preview-panel');
      if (panel) panel.scrollIntoView({ behavior: 'smooth' });
    }

    showStatus(type, message) {
      const statusEl = document.getElementById('statusMessage');
      statusEl.className = `status-message ${type}`;
      statusEl.innerHTML = message;
      statusEl.style.display = 'flex';

      if (type !== 'loading') {
        setTimeout(() => {
          statusEl.style.display = 'none';
        }, 5000);
      }
    }

    updatePublishButton() {
      const btn = document.getElementById('publishBtn');
      btn.disabled = this.state.isPublishing;
      btn.textContent = this.state.isPublishing ? '⏳ Publishing...' : '🚀 Publish to Store';
    }
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.creatorDashboard = new CreatorListingDashboard();
    });
  } else {
    window.creatorDashboard = new CreatorListingDashboard();
  }
</script>


{% comment %}
Creator Listing Dashboard - Shopify Liquid Section
Task 3 of My Narrative Design-to-Earn Pipeline
{% endcomment %}

<div class="creator-listing-dashboard">
  <!-- Header Section -->
  <div class="cld-header">
    <h1 class="cld-title">{{ section.settings.heading }}</h1>
    <div class="cld-creator-info">
      <div class="creator-avatar" id="creatorAvatar"></div>
      <div class="creator-details">
        <p class="creator-name" id="creatorName">Loading...</p>
        <p class="creator-role">Creator</p>
      </div>
    </div>
  </div>

  <!-- Main Container -->
  <div class="cld-container">
    <!-- Left Panel: Design Preview -->
    <div class="cld-preview-panel">
      <div class="preview-wrapper">
        <img id="mainPreview" class="main-preview" src="" alt="Design Preview" />
        <div class="preview-loading" id="previewLoading" style="display: none;">
          <div class="spinner"></div>
        </div>
      </div>

      <!-- Color Variant Thumbnails -->
      <div class="thumbnail-strip">
        <h3 class="thumbnail-label">Color Variants</h3>
        <div class="thumbnails-container" id="thumbnailsContainer"></div>
      </div>
    </div>

    <!-- Right Panel: Configuration -->
    <div class="cld-config-panel">
      <!-- Title Input -->
      <div class="config-section">
        <label for="titleInput" class="config-label">Design Title</label>
        <input 
          type="text" 
          id="titleInput" 
          class="config-input" 
          maxlength="60" 
          placeholder="Enter design title"
        />
        <div class="char-count"><span id="titleCount">0</span>/60</div>
      </div>

      <!-- Description Textarea -->
      <div class="config-section">
        <label for="descriptionInput" class="config-label">Description</label>
        <textarea 
          id="descriptionInput" 
          class="config-textarea" 
          maxlength="300" 
          placeholder="Describe your design..."
        ></textarea>
        <div class="char-count"><span id="descCount">0</span>/300</div>
      </div>

      <!-- Product Type Toggle -->
      <div class="config-section">
        <label class="config-label">Product Type</label>
        <div class="product-toggle">
          <button class="toggle-btn active" data-product="tshirt">T-Shirt</button>
          <button class="toggle-btn" data-product="hoodie">Hoodie</button>
        </div>
      </div>

      <!-- Color Selection -->
      <div class="config-section">
        <label class="config-label">Select Colors</label>
        <div class="colors-grid" id="colorsGrid"></div>
        <div class="color-error" id="colorError" style="display: none;">
          At least one color must be selected
        </div>
      </div>

      <!-- Pricing Slider -->
      <div class="config-section">
        <label class="config-label">Price (INR)</label>
        <div class="pricing-display">
          <div class="price-row">
            <span>Your Price:</span>
            <span class="price-value" id="yourPrice">₹799</span>
          </div>
          <div class="price-row">
            <span>Platform Base:</span>
            <span class="price-value" id="platformBase">₹400</span>
          </div>
          <div class="price-row earnings">
            <span>Your Earnings:</span>
            <span class="price-value" id="yourEarnings">₹399 (5%)</span>
          </div>
        </div>
        <input 
          type="range" 
          id="priceSlider" 
          class="price-slider" 
          min="649" 
          max="999" 
          value="799" 
          step="10"
        />
        <div class="price-range-labels">
          <span id="minPrice">₹649</span>
          <span id="maxPrice">₹999</span>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════════
           NARRATIVE TOKENS GATE — shown BEFORE publish button
           Fetched on page load from /api/creator/earnings.
           Blocks publish if ai_credits = 0.
           ══════════════════════════════════════════════════ -->
      <div class="tokens-gate" id="tokensGate">
        <!-- Loading state -->
        <div class="tokens-gate-loading" id="tokensGateLoading">
          <span class="tokens-shimmer">🪙 Loading tokens...</span>
        </div>

        <!-- Loaded state — shown when ai_credits > 0 -->
        <div class="tokens-gate-ready" id="tokensGateReady" style="display:none;">
          <div class="tokens-gate-row">
            <span class="tokens-gate-icon">🪙</span>
            <span class="tokens-gate-label">Narrative Tokens:</span>
            <span class="tokens-gate-count" id="tokensGateCount" style="color:#39A596;font-weight:700">–</span>
            <span class="tokens-gate-hint">remaining</span>
          </div>
          <div class="tokens-gate-bar-wrap">
            <div class="tokens-gate-bar" id="tokensGateBar" style="width:100%"></div>
          </div>
          <p class="tokens-gate-sub">+5 per sale &nbsp;·&nbsp; +10 per sample kit purchase</p>
        </div>

        <!-- Blocked state — shown when ai_credits = 0 -->
        <div class="tokens-gate-blocked" id="tokensGateBlocked" style="display:none;">
          <div class="tokens-gate-row">
            <span class="tokens-gate-icon" style="filter:grayscale(1)">🪙</span>
            <span class="tokens-gate-label" style="color:#ef4444;">0 Narrative Tokens</span>
          </div>
          <p class="tokens-gate-blocked-msg">
            You need at least <strong>1 Narrative Token</strong> to publish a design.
            Earn more by making a sale or buying a Creator Sample Kit.
          </p>
          <div class="tokens-gate-earn-options">
            <a href="/products/creator-sample-kit" class="tokens-earn-btn tokens-earn-primary">
              🧥 Buy Sample Kit (+10 tokens)
            </a>
            <a href="/collections/all" class="tokens-earn-btn tokens-earn-secondary">
              🛍️ Browse & Share to Earn
            </a>
          </div>
        </div>
      </div>

      <!-- Publish Button & Status -->
      <div class="config-section">
        <button class="publish-btn" id="publishBtn" disabled>🚀 Publish to Store</button>
        <div class="status-message" id="statusMessage" style="display: none;"></div>
      </div>

      <!-- Post-publish tokens indicator (updates after successful publish) -->
      <div class="tokens-indicator" id="tokensIndicator" style="display:none;">
        <span style="color:#39A596">🪙</span>
        <span>Narrative Tokens remaining: </span>
        <span id="tokensCount" style="color:#39A596;font-weight:700">–</span>
        <span style="color:rgba(255,255,255,0.5);font-size:0.8rem"> (+5 per sale)</span>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     SAMPLE KIT UPSELL MODAL
     Shown after publish to offer the creator a physical sample.
     Buying at wholesale (₹500 tshirt / ₹900 hoodie) unlocks +10 tokens.
============================================================ -->
<div class="sample-kit-modal-overlay" id="sampleKitModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="sampleKitTitle">
  <div class="sample-kit-modal">
    <button class="modal-close-btn" id="modalCloseBtn" aria-label="Close">✕</button>

    <div class="modal-success-header">
      <div class="modal-success-icon">🎉</div>
      <h2 class="modal-title" id="sampleKitTitle">Your Design is Live!</h2>
      <p class="modal-subtitle">Customers can now discover and buy your t-shirt / hoodie on My Narrative.</p>
      <a class="modal-view-link" id="modalViewLink" href="#" target="_blank">View on store →</a>
    </div>

    <div class="modal-divider"></div>

    <div class="modal-upsell">
      <div class="upsell-badge">📈 Creator Pro Tip</div>
      <h3 class="upsell-title">Market your own design — see up to 50% more sales.</h3>
      <p class="upsell-body">
        Creators who <strong>wear and share</strong> their own t-shirt or hoodie convert fans into customers.
        On average they see <strong style="color:#39A596;">50% more sales</strong> than creators who don't.
        Buy yours at a creator-discounted rate below.
      </p>

      <div class="sample-kit-options">
        <a id="buyOwnDesignLink" class="sample-option" href="#" style="text-decoration:none;color:inherit;">
          <div class="sample-option-info">
            <div class="sample-option-name">🛒 Buy my own design</div>
            <div class="sample-option-price" id="buyOwnPriceLabel">Creator-discounted rate</div>
            <div class="sample-option-tokens" style="color:#39A596" id="buyOwnDiscountHint">Discount auto-applied at checkout</div>
          </div>
          <span class="sample-add-btn" style="background:linear-gradient(135deg,#39A596,#2dd4bf);color:#000;">
            Buy Now →
          </span>
        </a>
      </div>

      <p class="sample-note">
        Ships your exact design on the selected product. Wear it, film a reel, tag @mynarrative — watch sales climb.
      </p>

      <button class="modal-skip-btn" id="modalSkipBtn">Maybe later — back to dashboard</button>
    </div>
  </div>
</div>

<style>
  /* ── Tokens Indicator ──────────────────────────────────── */
  .tokens-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    background: rgba(57, 165, 150, 0.08);
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    margin-top: 0.75rem;
  }

  /* ── Modal Overlay ─────────────────────────────────────── */
  .sample-kit-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1rem;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn { from { opacity:0 } to { opacity:1 } }

  .sample-kit-modal {
    background: #111;
    border: 1px solid #222;
    border-radius: 1rem;
    padding: 2rem;
    max-width: 520px;
    width: 100%;
    position: relative;
    animation: slideUp 0.25s ease;
    max-height: 90vh;
    overflow-y: auto;
  }

  @keyframes slideUp { from { transform: translateY(20px); opacity:0 } to { transform: translateY(0); opacity:1 } }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.5);
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }

  .modal-close-btn:hover { color: white; }

  .modal-success-header { text-align: center; margin-bottom: 1.5rem; }
  .modal-success-icon   { font-size: 3rem; margin-bottom: 0.5rem; }
  .modal-title          { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; }
  .modal-subtitle       { color: rgba(255,255,255,0.6); margin: 0 0 0.75rem; }
  .modal-view-link      { color: #39A596; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .modal-view-link:hover { text-decoration: underline; }

  .modal-divider { border: none; border-top: 1px solid #222; margin: 1.5rem 0; }

  .upsell-badge  { display: inline-block; background: rgba(57,165,150,0.15); color: #39A596; border: 1px solid rgba(57,165,150,0.3); border-radius: 2rem; padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.75rem; }
  .upsell-title  { font-size: 1.125rem; font-weight: 700; margin: 0 0 0.75rem; }
  .upsell-body   { color: rgba(255,255,255,0.75); font-size: 0.9rem; line-height: 1.6; margin: 0 0 1.5rem; }

  .sample-kit-options { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem; }

  .sample-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #181818;
    border: 1px solid #2a2a2a;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    gap: 1rem;
    transition: border-color 0.2s;
  }

  .sample-option:hover { border-color: #39A596; }

  .sample-option-name   { font-weight: 600; margin-bottom: 0.2rem; }
  .sample-option-price  { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.2rem; }
  .sample-option-retail { font-size: 0.75rem; color: rgba(255,255,255,0.4); font-weight: 400; text-decoration: line-through; }
  .sample-option-tokens { font-size: 0.8rem; font-weight: 600; }

  .sample-add-btn {
    background: #39A596;
    color: white;
    border: none;
    border-radius: 0.5rem;
    padding: 0.6rem 1.25rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .sample-add-btn:hover { background: #2a8a7f; }
  .sample-add-btn:disabled { background: #555; cursor: not-allowed; }

  .sample-note {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    text-align: center;
    margin: 1rem 0 0.5rem;
    line-height: 1.5;
  }

  .modal-skip-btn {
    display: block;
    width: 100%;
    background: transparent;
    border: 1px solid #333;
    color: rgba(255,255,255,0.5);
    border-radius: 0.5rem;
    padding: 0.6rem;
    font-size: 0.875rem;
    cursor: pointer;
    margin-top: 0.75rem;
    transition: all 0.2s;
  }

  .modal-skip-btn:hover { border-color: #555; color: rgba(255,255,255,0.8); }

  @media (max-width: 480px) {
    .sample-option { flex-direction: column; align-items: flex-start; }
    .sample-add-btn { width: 100%; }
  }
</style>

<script>
(function() {
  'use strict';

  const PROD_API = 'https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app';

  // ── Resolve design_id at runtime (URL > wrapper data-attr > section setting) ──
  // The outer template (page.creator-dashboard.liquid) parses ?design_id=<uuid>
  // and wraps this section in <div data-design-id="<uuid>">. We can't pass
  // section settings dynamically per request, so we must read the ID at runtime.
  // Fallback to the theme-editor setting (legacy path) preserves backwards compat.
  const MN_DESIGN_ID = (function() {
    try {
      var urlId = new URLSearchParams(window.location.search).get('design_id');
      if (urlId) return urlId;
      var wrap = document.querySelector('[data-design-id]');
      if (wrap) {
        var attr = wrap.getAttribute('data-design-id') || '';
        if (attr) return attr;
      }
    } catch (e) {}
    return '{{ section.settings.design_id }}' || '';
  })();

  // ── Sample Kit Modal ─────────────────────────────────────────
  const modal     = document.getElementById('sampleKitModal');
  const closeBtn  = document.getElementById('modalCloseBtn');
  const skipBtn   = document.getElementById('modalSkipBtn');

  function showSampleKitModal(productUrl, publishResult) {
    if (!modal) return;
    var pr = publishResult || {};
    var pUrl = productUrl || pr.product_url || pr.shopify_product_url || '';
    var code = pr.creator_discount_code || pr.discount_code || '';

    // "View on store" link
    const viewLink = document.getElementById('modalViewLink');
    if (viewLink) {
      viewLink.href = pUrl || '#';
      if (!pUrl) viewLink.style.display = 'none';
    }

    // "Buy my own design" CTA — product URL with creator discount code applied via Shopify URL.
    const buyLink     = document.getElementById('buyOwnDesignLink');
    const hintEl      = document.getElementById('buyOwnDiscountHint');
    const priceLabel  = document.getElementById('buyOwnPriceLabel');
    if (buyLink) {
      var finalUrl = pUrl || '/pages/creator-dashboard';
      if (pUrl && code) {
        var sep = pUrl.indexOf('?') === -1 ? '?' : '&';
        finalUrl = pUrl + sep + 'discount=' + encodeURIComponent(code);
      }
      buyLink.href = finalUrl;
    }
    if (hintEl && code) {
      hintEl.innerHTML = 'Discount code <strong>' + String(code).toUpperCase() + '</strong> applied at checkout';
    }
    if (priceLabel && pr.creator_discount_percent) {
      priceLabel.textContent = 'Save ' + pr.creator_discount_percent + '% at checkout';
    }

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeSampleKitModal() {
    if (!modal) return;
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  if (closeBtn) closeBtn.addEventListener('click', closeSampleKitModal);
  if (skipBtn)  skipBtn.addEventListener('click', closeSampleKitModal);
  if (modal)    modal.addEventListener('click', function(e) {
    if (e.target === modal) closeSampleKitModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSampleKitModal();
  });

  // ── Sample Kit Add-to-Cart ───────────────────────────────────
  const sampleBtns = document.querySelectorAll('.sample-add-btn');
  sampleBtns.forEach(btn => {
    btn.addEventListener('click', async function() {
      const productType = this.getAttribute('data-product');
      const pricePaise  = parseInt(this.getAttribute('data-price-paise'), 10);
      const creatorId   = '{{ customer.id }}';
      const designId    = MN_DESIGN_ID;

      this.disabled    = true;
      this.textContent = 'Adding...';

      // Get the correct variant ID for this product type + white color (default)
      // The variant_map is stored on window.PUBLISH_RESULT from the publish response
      const publishResult = window.PUBLISH_RESULT || {};
      const variantMap    = publishResult.variant_map || {};
      const defaultColor  = productType === 'tshirt' ? 'white' : 'black';
      const variantInfo   = variantMap[defaultColor] || {};
      const variantId     = variantInfo.variant_numeric || '';

      if (!variantId) {
        this.textContent = 'Contact support';
        this.disabled    = false;
        return;
      }

      // Add to cart with _design_uuid + sample kit marker
      const cartPayload = {
        items: [{
          id:       variantId,
          quantity: 1,
          properties: {
            '_design_uuid':  publishResult.unique_product_id || '',
            '_design_title': publishResult.title             || '',
            '_creator_id':   creatorId,
            '_product_type': productType,
            '_color':        defaultColor,
            '_is_sample_kit': 'true',   // webhook reads this → +10 tokens
          }
        }]
      };

      try {
        const resp = await fetch('/cart/add.js', {
          method:  'POST',
          headers: {'Content-Type': 'application/json'},
          body:    JSON.stringify(cartPayload)
        });
        if (resp.ok) {
          this.textContent = '✅ Added!';
          setTimeout(() => { window.location.href = '/cart'; }, 800);
        } else {
          const err = await resp.json();
          this.textContent = err.description || 'Error';
          this.disabled    = false;
        }
      } catch (e) {
        this.textContent = 'Cart error';
        this.disabled    = false;
      }
    });
  });

  // ── Expose showSampleKitModal globally so publish handler can call it ──
  window.showSampleKitModal = showSampleKitModal;
})();
</script>

<style>
  * {
    box-sizing: border-box;
  }

  .creator-listing-dashboard {
    background-color: #0a0a0a;
    color: #ffffff;
    padding: 2rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  /* Header */
  .cld-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #222;
  }

  .cld-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0;
  }

  .cld-creator-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .creator-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #39A596 0%, #2a7a73 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.2rem;
  }

  .creator-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .creator-name {
    font-weight: 500;
    margin: 0;
    font-size: 0.95rem;
  }

  .creator-role {
    color: #888;
    font-size: 0.85rem;
    margin: 0;
  }

  /* Main Container */
  .cld-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .cld-preview-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Preview Wrapper */
  .preview-wrapper {
    position: relative;
    background-color: #111;
    border: 1px solid #222;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-preview {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .preview-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .spinner {
    border: 3px solid #222;
    border-top: 3px solid #39A596;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Thumbnail Strip */
  .thumbnail-strip {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .thumbnail-label {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .thumbnails-container {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .thumbnail {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border: 2px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s ease;
    background-color: #111;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail:hover {
    border-color: #39A596;
    transform: scale(1.05);
  }

  .thumbnail.active {
    border-color: #39A596;
    box-shadow: 0 0 12px rgba(57, 165, 150, 0.3);
  }

  /* Config Panel */
  .cld-config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .config-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .config-label {
    font-weight: 500;
    font-size: 0.95rem;
    color: #fff;
  }

  .config-input,
  .config-textarea {
    background-color: #111;
    border: 1px solid #222;
    border-radius: 6px;
    color: #fff;
    padding: 0.75rem;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .config-input:focus,
  .config-textarea:focus {
    outline: none;
    border-color: #39A596;
    box-shadow: 0 0 8px rgba(57, 165, 150, 0.2);
  }

  .config-textarea {
    min-height: 100px;
    resize: vertical;
  }

  .char-count {
    font-size: 0.8rem;
    color: #666;
    text-align: right;
  }

  /* Product Toggle */
  .product-toggle {
    display: flex;
    gap: 0.5rem;
  }

  .toggle-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    background-color: #111;
    border: 1px solid #222;
    color: #888;
    border-radius: 6px;
    cursor: pointer;

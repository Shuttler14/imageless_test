  }

  /* ── Narrative Tokens Gate ─────────────────────────── */
  .tokens-gate {
    margin: 1rem 0 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(57,165,150,0.06);
    border: 1px solid rgba(57,165,150,0.2);
    border-radius: 0.75rem;
    transition: border-color 0.3s;
  }

  .tokens-shimmer {
    color: rgba(255,255,255,0.4);
    font-size: 0.875rem;
    animation: tokGlow 1.4s ease infinite;
  }
  @keyframes tokGlow {
    0%,100% { opacity:0.4; } 50% { opacity:1; }
  }

  .tokens-gate-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .tokens-gate-icon  { font-size: 1.1rem; }
  .tokens-gate-label { color: rgba(255,255,255,0.7); font-size: 0.875rem; }
  .tokens-gate-count { font-size: 1.25rem; }
  .tokens-gate-hint  { color: rgba(255,255,255,0.4); font-size: 0.8rem; }

  .tokens-gate-bar-wrap {
    background: rgba(255,255,255,0.08);
    border-radius: 99px;
    height: 4px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }
  .tokens-gate-bar {
    height: 100%;
    background: linear-gradient(90deg, #39A596, #5bd4c4);
    border-radius: 99px;
    transition: width 0.6s ease;
  }
  .tokens-gate-sub {
    color: rgba(255,255,255,0.35);
    font-size: 0.75rem;
    margin: 0;
  }

  /* Blocked state */
  .tokens-gate-blocked { }
  .tokens-gate-blocked-msg {
    color: rgba(255,255,255,0.6);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0.4rem 0 0.75rem;
  }
  .tokens-gate-earn-options {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tokens-earn-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }
  .tokens-earn-primary {
    background: #39A596;
    color: white;
  }
  .tokens-earn-primary:hover { background: #2a8a7f; }
  .tokens-earn-secondary {
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(255,255,255,0.12);
  }
  .tokens-earn-secondary:hover { background: rgba(255,255,255,0.14); }

  /* Publish button disabled state */
  .publish-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Publish Button */
  .publish-btn {
    padding: 1rem;
    background-color: #39A596;
    border: none;
    border-radius: 6px;
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .publish-btn:hover:not(:disabled) {
    background-color: #2a7a73;
    box-shadow: 0 4px 12px rgba(57, 165, 150, 0.3);
    transform: translateY(-2px);
  }

  .publish-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .publish-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Status Message */
  .status-message {
    padding: 1rem;
    border-radius: 6px;

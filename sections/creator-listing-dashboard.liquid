  .status-message.loading {
    background-color: #1a3a36;
    color: #39A596;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .status-message.success {
    background-color: #1a4d1a;
    color: #4ade80;
  }

  .status-message.error {
    background-color: #4d1a1a;

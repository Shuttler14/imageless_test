<script>
const COF_API = '{{ creator_api_base_url }}';
const COF_USER_ID = '{{ user_id }}';

let cofCurrentStep = 1;
let cofConnectedSocials = {};

// Detect elite mode from URL
const cofUrlParams = new URLSearchParams(window.location.search);
const cofIsElite = cofUrlParams.get('type') === 'elite';

// On load: show elite banner if elite mode
document.addEventListener('DOMContentLoaded', function() {
  if (cofIsElite) {
    const banner = document.getElementById('cofEliteBanner');
    if (banner) banner.classList.remove('cof-hidden');
    const subtext = document.getElementById('cofSocialSubtext');
    if (subtext) subtext.textContent = 'Connect your platforms to verify your elite follower count. Any ONE qualifying platform is enough — connect all for maximum reach!';
    // Update page header if present
    const header = document.querySelector('.cof-header h1');
    if (header) header.textContent = 'Apply as Elite Creator';
    const headerP = document.querySelector('.cof-header p');
    if (headerP) headerP.textContent = 'Verify your social following and unlock 30–45% commissions';
    // Update complete button text
    const completeBtn = document.querySelector('#cofStep2 .cof-cta-btn:last-child');
    if (completeBtn) completeBtn.innerHTML = 'Verify &amp; Apply as Elite <span class="arrow">→</span>';
  }

  // Load pending design
  loadPendingDesign();

  // Character counter for description
  const descEl = document.getElementById('cofDescription');
  if (descEl) {
    descEl.addEventListener('input', function() {
      document.getElementById('charCount').textContent = this.value.length;
    });
  }
});

// Update username as brand name changes
document.getElementById('cofBrandName')?.addEventListener('input', function(e) {
  const brandName = e.target.value;
  const username = brandName.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');

  document.getElementById('cofUsername').value = username;
  document.getElementById('cofPreviewName').textContent = brandName || 'Your Brand';
  document.getElementById('cofPreviewUsername').textContent = username || 'brand-name';

  if (brandName) {
    document.getElementById('cofProfilePreview').style.display = 'flex';
    document.getElementById('cofProfileAvatar').textContent = brandName.charAt(0).toUpperCase();
  }
});

function cofNextStep(step) {
  if (cofCurrentStep === 1 && step === 2) {
    const brandName = document.getElementById('cofBrandName').value.trim();
    if (!brandName) {
      alert('Please enter your brand name to continue');
      return;
    }
  }

  // Update progress indicators
  document.querySelectorAll('.cof-progress-step').forEach((el, i) => {
    el.classList.remove('active', 'completed');
    if (i + 1 < step) el.classList.add('completed');
    if (i + 1 === step) el.classList.add('active');
  });

  // Hide all steps
  ['cofStep1','cofStep2','cofStep3'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.add('cof-hidden');
  });

  // Show target step
  const target = document.getElementById('cofStep' + step);
  if (target) target.classList.remove('cof-hidden');

  cofCurrentStep = step;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function cofToggleSocial(platform) {
  const key = platform.charAt(0).toUpperCase() + platform.slice(1);
  const card = document.getElementById('cof' + key + 'Card');
  if (!card || card.classList.contains('connected')) return;
  card.classList.toggle('connecting');
}

async function cofConnectSocial(platform) {
  const key = platform.charAt(0).toUpperCase() + platform.slice(1);
  const input = document.getElementById('cof' + key + 'Input');
  const handle = input ? input.value.trim() : '';

  if (!handle) {
    alert('Please enter your ' + platform + ' handle');
    return;
  }

  const btn = input.nextElementSibling;
  if (btn) { btn.disabled = true; btn.textContent = 'Verifying...'; }

  try {
    const resp = await fetch(COF_API + '/api/creator/verification/connect-social', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: COF_USER_ID, platform, handle })
    });
    const json = await resp.json();

    if (json.success) {
      const data = json.data || {};
      cofConnectedSocials[platform] = { handle, followers: data.followers, verified: data.is_verified, commission_rate: data.commission_rate };
      cofMarkSocialConnected(platform, handle, data.followers);
    } else {
      alert('Could not connect: ' + (json.error || 'Please try again'));
      if (btn) { btn.disabled = false; btn.textContent = 'Connect'; }
    }
  } catch (e) {
    // Demo/offline mode — mark as connected optimistically
    cofConnectedSocials[platform] = { handle, verified: true };
    cofMarkSocialConnected(platform, handle, null);
  }
}

function cofMarkSocialConnected(platform, handle, followers) {
  const key = platform.charAt(0).toUpperCase() + platform.slice(1);
  const card = document.getElementById('cof' + key + 'Card');
  const handleEl = document.getElementById('cof' + key + 'Handle');
  const statusEl = document.getElementById('cof' + key + 'Status');
  const btn = document.querySelector('#cof' + key + 'Card .cof-connect-btn');

  if (card) { card.classList.remove('connecting'); card.classList.add('connected'); }
  if (handleEl) handleEl.textContent = '@' + handle + (followers ? ' • ' + formatFollowers(followers) : '');
  if (statusEl) statusEl.classList.remove('cof-hidden');
  if (btn) btn.textContent = 'Connected ✓';
}

// ───────────────────────────────────────────────────────────────
// Inline error helpers for Username / Narrative Name uniqueness
// ───────────────────────────────────────────────────────────────
function cofClearUniquenessErrors() {
  ['cofUsername', 'cofNarrativeName'].forEach(function (id) {
    var input = document.getElementById(id);
    if (input) input.classList.remove('cof-input-error');
  });
  ['cofUsernameError', 'cofNarrativeNameError'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) { el.style.display = 'none'; el.textContent = ''; }
  });
}

function cofShowUniquenessError(fields, message) {
  var msg = message || 'This Username or Narrative Name is already claimed.';
  var list = Array.isArray(fields) && fields.length ? fields : ['username', 'narrative_name'];
  var showedOne = false;

  list.forEach(function (field) {
    var inputId = (field === 'narrative_name') ? 'cofNarrativeName' : 'cofUsername';
    var errId   = (field === 'narrative_name') ? 'cofNarrativeNameError' : 'cofUsernameError';
    var input = document.getElementById(inputId);
    var errEl = document.getElementById(errId);
    if (input) input.classList.add('cof-input-error');
    if (errEl) {
      errEl.textContent = msg;
      errEl.style.display = 'block';
      if (!showedOne) {
        errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        input && input.focus();
        showedOne = true;
      }
    }
  });
}

// Auto-clear errors on edit
['cofUsername', 'cofNarrativeName'].forEach(function (id) {
  var el = document.getElementById(id);
  if (el) el.addEventListener('input', cofClearUniquenessErrors);
});

async function cofCompleteOnboarding() {
  const brandName      = document.getElementById('cofBrandName')?.value?.trim() || 'My Brand';
  const narrativeName  = document.getElementById('cofNarrativeName')?.value?.trim() || (brandName + "'s Designs");
  const usernameInput  = document.getElementById('cofUsername')?.value?.trim() || '';
  const description    = document.getElementById('cofDescription')?.value?.trim() || '';
  const profilePhotoUrl = (window.COF_PROFILE_PHOTO_URL || document.getElementById('cofPhotoImg')?.src || '').trim();
  let tier = cofIsElite ? 'Elite Creator' : 'Creator';
  let commissionRate = cofIsElite ? 35 : 15;

  // Clear any prior error state and engage the loading state
  cofClearUniquenessErrors();
  const submitBtn = document.querySelector('#cofStep2 .cof-cta-btn:last-child');
  const submitBtnOriginalHTML = submitBtn ? submitBtn.innerHTML : '';
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    submitBtn.style.cursor = 'wait';
    submitBtn.innerHTML = 'Saving...';
  }
  const restoreSubmit = function () {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '';
      submitBtn.style.cursor = '';
      submitBtn.innerHTML = submitBtnOriginalHTML || 'Complete Setup <span class="arrow">→</span>';
    }
  };

  // ── PRIMARY: /api/creator/onboarding/complete ──────────────────
  let primaryOk = false;
  try {
    const resp = await fetch(COF_API + '/api/creator/onboarding/complete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        user_id: COF_USER_ID,
        brand_name: brandName,
        narrative_name: narrativeName,
        username: usernameInput,
        description: description,
        bio: description,
        profile_photo_url: profilePhotoUrl,
        avatar_url: profilePhotoUrl,
        type: cofIsElite ? 'elite' : 'standard',
        social_links: cofConnectedSocials,
        primary_platform: Object.keys(cofConnectedSocials)[0] || null
      })
    });

    // Uniqueness conflict — surface inline and halt the flow
    if (resp.status === 409) {
      let json409 = {};
      try { json409 = await resp.json(); } catch (_) {}
      if (json409 && json409.error === 'username_taken') {
        cofShowUniquenessError(json409.fields, json409.message);
        restoreSubmit();
        return;
      }
      // Any other 409 → treat as generic failure
      restoreSubmit();
      alert((json409 && json409.message) || 'Could not save your profile. Please try a different Username or Narrative Name.');
      return;
    }

    const json = await resp.json();
    if (json && json.success === false && json.error === 'username_taken') {
      cofShowUniquenessError(json.fields, json.message);
      restoreSubmit();
      return;
    }
    if (json && json.success && json.data) {
      primaryOk = true;
      tier = json.data.tier || tier;
      commissionRate = json.data.commission_rate || commissionRate;
    }
  } catch (e) {
    console.log('Onboarding API offline, using defaults');
  }

  // ── FALLBACK: /api/creator/register — only run if primary didn't reject ─
  try {
    await fetch(COF_API + '/api/creator/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        user_id: COF_USER_ID,
        username: usernameInput || brandName.toLowerCase().replace(/[^a-z0-9]/g,'-'),
        email: '{{ customer.email | default: "" }}',
        narrative_name: narrativeName,
        bio: description,
        avatar_url: profilePhotoUrl
      })
    });
  } catch(e) { /* non-fatal */ }

  // ───────────────────────────────────────────────────────────────
  // GOLDEN-THREAD REDIRECT — protect mn_pending_design state
  // Priority order:
  //   1) If a pending design exists (localStorage or ?design_id=)
  //      → /pages/creator-dashboard?design_id=…&first_time=1
  //   2) If no pending design
  //      → /pages/creator-dashboard?first_time=1 (fallback)
  // NEVER route back to /pages/ai-studio after successful onboarding.
  // ───────────────────────────────────────────────────────────────
  try {
    var pendingRaw  = getPendingDesignRaw();
    var urlDesignId = new URLSearchParams(window.location.search).get('design_id') || '';
    var designId    = urlDesignId;
    if (!designId && pendingRaw) {
      try {
        var d = JSON.parse(pendingRaw);
        designId = d.design_uuid || d.design_id || d.id || '';
      } catch (_) {}
    }

    // Persist tier info for the dashboard to show celebratory state
    try {
      sessionStorage.setItem('mn_onboarding_just_completed', JSON.stringify({
        tier: tier,
        commission_rate: commissionRate,
        at: Date.now()
      }));
    } catch (_) {}

    var targetUrl;
    if (designId) {
      targetUrl = '/pages/creator-dashboard?design_id=' + encodeURIComponent(designId) + '&first_time=1';
    } else {
      targetUrl = '/pages/creator-dashboard?first_time=1';
    }

    // Fire confetti before redirect so the user sees the moment
    cofTriggerCelebration(tier, commissionRate);
    setTimeout(function () { window.location.href = targetUrl; }, 900);
    return;
  } catch (e) {
    console.warn('Redirect protection failed, falling back:', e);
    // Last-ditch fallback: stay on page, show success step
    restoreSubmit();
    cofNextStep(3);
    const titleEl = document.getElementById('cofSuccessTitle');
    const subtitleEl = document.getElementById('cofSuccessSubtitle');
    if (cofIsElite) {
      if (titleEl) titleEl.textContent = "You're an Elite Creator";
      if (subtitleEl) subtitleEl.textContent = 'Congratulations — your application is under review. Now upload your first design to get started.';
    }
    cofTriggerCelebration(tier, commissionRate);
  }
}

function cofTriggerCelebration(tier, rate) {
  const celebration = document.getElementById('cofCelebration');
  const popup = document.getElementById('cofVerifiedPopup');
  const tierEl = document.getElementById('cofPopupTier');
  const titleEl = document.getElementById('cofPopupTitle');
  const msgEl = document.getElementById('cofPopupMsg');

  if (celebration) celebration.classList.add('active');
  if (popup) popup.classList.add('active');
  if (tierEl) tierEl.textContent = tier;
  if (titleEl) titleEl.textContent = cofIsElite ? "Elite status verified" : "Welcome to the family";
  if (msgEl) msgEl.textContent = rate ? 'You earn up to ' + rate + '% commission per sale.' : 'Your creator journey begins now.';

  setTimeout(() => {
    if (celebration) celebration.classList.remove('active');
    if (popup) popup.classList.remove('active');
  }, 3200);
}

function formatFollowers(num) {
  if (!num) return '';
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M followers';
  if (num >= 1000) return (num / 1000).toFixed(0) + 'K followers';
  return num + ' followers';
}

function getPendingDesignRaw() {
  // Prefer localStorage (AI studio flow), fall back to sessionStorage (upload flow).
  var raw = localStorage.getItem('mn_pending_design');
  var fromSession = false;
  if (!raw) {
    raw = sessionStorage.getItem('mn_pending_design');
    fromSession = !!raw;
  }
  if (!raw) return null;
  try {
    var parsed = JSON.parse(raw);
    var ts = Number(parsed.saved_at || Date.parse(parsed.created_at || '') || 0);
    if (ts && (Date.now() - ts) > (2 * 60 * 60 * 1000)) {
      if (fromSession) sessionStorage.removeItem('mn_pending_design');
      else localStorage.removeItem('mn_pending_design');
      return null;
    }
    // Normalize uuid/id for consumers
    parsed.design_uuid = parsed.design_uuid || parsed.design_id || parsed.id || '';
    return JSON.stringify(parsed);
  } catch (e) {
    localStorage.removeItem('mn_pending_design');
    sessionStorage.removeItem('mn_pending_design');
    return null;
  }
}

// Load pending design from localStorage
function loadPendingDesign() {
  var raw = getPendingDesignRaw();

  // ── FALLBACK: No pending design found ──────────────────
  // If user reaches Step 3 (creator funnel) without a design in session,
  // show a clean "no design" state with a CTA back to the studio.
  if (!raw) {
    var pendingCard = document.getElementById('cofPendingCard');
    if (pendingCard) {
      pendingCard.style.display = 'block';
      pendingCard.style.borderColor = 'rgba(255,255,255,0.08)';
      pendingCard.style.background = 'rgba(255,255,255,0.02)';
      pendingCard.innerHTML = [
        '<div style="text-align:center;padding:1.25rem 0.5rem;">',
          '<div style="color:#39A596;letter-spacing:0.4em;font-size:14px;margin-bottom:14px;">— \u2726 —</div>',
          '<h3 style="font-family:\'Cormorant Garamond\',serif;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:#F5F4F1;margin:0 0 10px;">',
            'No pending design yet',
          '</h3>',
          '<p style="color:rgba(245,244,241,0.52);font-size:13px;line-height:1.55;margin:0 auto 22px;max-width:320px;">',
            'Looks like you haven\'t created a design yet — or your session expired.',
          '</p>',
          '<a href="/pages/ai-studio?intent=creator_ai" style="',
            'display:inline-flex;align-items:center;gap:10px;',
            'background:linear-gradient(135deg,#39A596,#2A8478);color:#fff;text-decoration:none;',
            'padding:14px 28px;border-radius:12px;',
            'font-family:Montserrat,sans-serif;font-weight:600;font-size:12px;',
            'letter-spacing:0.14em;text-transform:uppercase;',
            'box-shadow:0 12px 32px -12px rgba(57,165,150,0.5);',
          '">',
            'Create a design with AI &nbsp;→',
          '</a>',
          '<div style="margin-top:16px;">',
            '<a href="/pages/placement-editor?intent=creator_upload" style="',
              'color:#5BC4B6;font-size:11px;text-decoration:none;',
              'letter-spacing:0.12em;text-transform:uppercase;',
              'border-bottom:1px solid rgba(57,165,150,0.35);padding-bottom:2px;',
            '">',
              'or upload your own artwork →',
            '</a>',
          '</div>',
        '</div>'
      ].join('');
    }
    return;
  }
  // ── END FALLBACK ─────────────────────────────────────

  try {
    var d = JSON.parse(raw);
    var card  = document.getElementById('cofPendingCard');
    var img   = document.getElementById('cofPendingImg');
    var title = document.getElementById('cofPendingTitle');
    if (card)  card.style.display  = 'block';
    if (img && d.image_url)   img.src          = d.image_url;
    if (title && d.title)     title.textContent = d.title;
  } catch(e) { console.warn('pending design parse error', e); }
}

// Publish pending design
async function publishPendingDesign() {
  var raw = getPendingDesignRaw();
  if (!raw) return;
  var d = JSON.parse(raw);
  var btn = document.querySelector('.cof-publish-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Publishing...'; }

  try {
    var resp = await fetch('https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/design/publish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        design_id:       d.design_uuid,
        creator_id:      '{{ user_id }}',
        title:           d.title || 'My Design',
        product_type:    'tshirt',
        selected_colors: ['white','black'],
        price_paise:     79900,
        mockup_urls:     {}
      })
    });
    var result = await resp.json();
    if (resp.ok && result.status === 'published') {
      // Clear pending design after publish
      localStorage.removeItem('mn_pending_design');
      // Show sample kit modal
      if (typeof window.openSampleKitModal === 'function') {
        window.openSampleKitModal(result);
      }
      // Update card to show published
      var card = document.getElementById('cofPendingCard');
      if (card) {
        card.style.borderColor = 'rgba(57,165,150,0.6)';
        card.innerHTML += '<p style="color:#5BC4B6;font-weight:600;margin-top:0.75rem;letter-spacing:0.06em;">Live — share your design link.</p>';
      }
    } else {
      if (btn) { btn.disabled = false; btn.textContent = 'Publish to the world'; }
      alert(result.error || 'Publish failed. Please try again.');
    }
  } catch(e) {
    if (btn) { btn.disabled = false; btn.textContent = 'Publish to the world'; }
    alert('Network error. Please try again.');
  }
}

// Profile photo upload
async function cofUploadPhoto(event) {
  var file = event.target.files[0];
  if (!file) return;
  
  var formData = new FormData();
  formData.append('photo', file);
  formData.append('creator_id', COF_USER_ID);

  try {
    var resp = await fetch(COF_API + '/api/creator/profile/upload-photo', {
      method: 'POST',
      body: formData
    });
    var result = await resp.json();
    if (result.success && result.photo_url) {
      var img = document.getElementById('cofPhotoImg');
      if (img) img.src = result.photo_url;
      document.getElementById('cofPhotoPreview').style.display = 'block';
      window.COF_PROFILE_PHOTO_URL = result.photo_url;
    } else {
      // Fallback: show a local preview so the user still sees their photo,
      // and send the photo along as a data URL when onboarding completes.
      var reader = new FileReader();
      reader.onload = function(ev) {
        var img = document.getElementById('cofPhotoImg');
        if (img) img.src = ev.target.result;
        var preview = document.getElementById('cofPhotoPreview');
        if (preview) preview.style.display = 'block';
        window.COF_PROFILE_PHOTO_URL = ev.target.result;
      };
      reader.readAsDataURL(file);
      console.warn('[Creator Onboarding] Photo upload API unavailable, using local preview.');
    }
  } catch(e) {
    // Same graceful fallback if the API is offline entirely
    var reader = new FileReader();
    reader.onload = function(ev) {
      var img = document.getElementById('cofPhotoImg');
      if (img) img.src = ev.target.result;
      var preview = document.getElementById('cofPhotoPreview');
      if (preview) preview.style.display = 'block';
      window.COF_PROFILE_PHOTO_URL = ev.target.result;
    };
    reader.readAsDataURL(file);
  }
}

// Use Instagram photo
function cofUseInstagramPhoto() {
  // Check if Instagram is connected
  if (!cofConnectedSocials.instagram) {
    alert('Please connect Instagram first');
    return;
  }
  
  // In a real scenario, this would fetch the user's Instagram profile picture
  // For now, show a placeholder
  var igHandle = cofConnectedSocials.instagram.handle;
  var photoUrl = 'https://api.instagram.com/user/' + igHandle + '/profile_pic.jpg';
  
  var img = document.getElementById('cofPhotoImg');
  if (img) img.src = photoUrl;
  document.getElementById('cofPhotoPreview').style.display = 'block';
}

// ── Publish result popup (linked product + discount code) ──────
window.PUBLISH_RESULT_GLOBAL = null;

function openSampleKitModal(publishResult) {
  window.PUBLISH_RESULT_GLOBAL = publishResult || {};
  var modal = document.getElementById('mnSampleKitModal');
  if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }

  // If publish returned a discount code, surface it in the hint.
  var hint = document.getElementById('skDiscountHint');
  var code = publishResult && (publishResult.creator_discount_code || publishResult.discount_code);
  if (hint && code) {
    hint.innerHTML = 'Discount code <strong style="color:#39A596;letter-spacing:0.05em;">'
      + String(code).toUpperCase() + '</strong> will be applied automatically at checkout.';
  }
}

function closeSampleKitModal() {
  var modal = document.getElementById('mnSampleKitModal');
  if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; }
}

// Buy the creator's own listed design at a discounted creator rate.
// Routes to the published product page (returned by /api/design/publish).
function buyOwnDesign(event) {
  if (event && event.preventDefault) event.preventDefault();
  var pr = window.PUBLISH_RESULT_GLOBAL || {};
  var productUrl = pr.product_url || pr.shopify_product_url || pr.productUrl || '';
  var code = pr.creator_discount_code || pr.discount_code || '';

  // Fallback: if backend didn't return a product URL, land on the creator's dashboard.
  if (!productUrl) {
    productUrl = '/pages/creator-dashboard';
  } else if (code) {
    // Apply the discount code automatically via Shopify's built-in discount URL.
    var sep = productUrl.indexOf('?') === -1 ? '?' : '&';
    productUrl = productUrl + sep + 'discount=' + encodeURIComponent(code);
  }
  window.location.href = productUrl;
  return false;
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeSampleKitModal();
});

window.openSampleKitModal  = openSampleKitModal;
window.closeSampleKitModal = closeSampleKitModal;
window.buyOwnDesign        = buyOwnDesign;
</script>


</style>

<div class="cof-page">
  <div class="cof-container">
    {% unless is_logged_in %}
      <!-- Not Logged In -->
      <div class="cof-card" style="text-align: center; padding-top: 44px; padding-bottom: 44px;">
        <span class="cof-card-kicker" style="display:inline-block;">— Creator Studio —</span>
        <h2 style="font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 600; letter-spacing: -0.01em; margin: 4px 0 10px;">Join as a Creator</h2>
        <p style="color: var(--cof-text-muted); margin: 0 auto 26px; max-width: 380px; line-height: 1.55;">Sign in to start your creator journey and begin turning your ideas into a brand.</p>
        <a href="/account/login?redirect=/pages/creator-onboarding" class="cof-cta-btn" style="max-width: 280px; margin: 0 auto;">
          Sign in <span class="arrow">→</span>
        </a>
      </div>
    {% else %}
      <!-- Onboarding Steps -->
      <div class="cof-progress" id="cofProgress">
        <div class="cof-progress-step active" data-step="1">
          <div class="cof-progress-dot">1</div>
          <span class="cof-progress-label">Brand</span>
        </div>
        <div class="cof-progress-line"></div>
        <div class="cof-progress-step" data-step="2">
          <div class="cof-progress-dot">2</div>
          <span class="cof-progress-label">Connect</span>
        </div>
        <div class="cof-progress-line"></div>
        <div class="cof-progress-step" data-step="3">
          <div class="cof-progress-dot">3</div>
          <span class="cof-progress-label">Create</span>
        </div>
      </div>

      <!-- Step 1: Brand Setup -->
      <div class="cof-card" id="cofStep1">
        <span class="cof-card-kicker">Step 01 — Identity</span>
        <h3 class="cof-card-title">Set up your brand</h3>

        <div class="cof-input-group">
          <label>Your Name</label>
          <input type="text" class="cof-input" id="cofBrandName" placeholder="Enter your full name" value="{{ user_name }}">
        </div>

        <div class="cof-input-group">
          <label>Narrative Name</label>
          <div class="cof-help-text" style="margin-top:0; margin-bottom:8px;">This is your public creator brand name.</div>
          <input type="text" class="cof-input" id="cofNarrativeName" placeholder="Your creative brand name" value="{{ user_first_name }}'s Designs">
          <p class="cof-inline-error" id="cofNarrativeNameError" style="display:none;"></p>
        </div>

        <div class="cof-input-group">
          <label>Username</label>
          <input type="text" class="cof-input" id="cofUsername" placeholder="@your_username" pattern="[a-z0-9_]{3,20}">
          <p class="cof-inline-error" id="cofUsernameError" style="display:none;"></p>
        </div>

        <div class="cof-input-group">
          <label>Tell your story</label>
          <textarea class="cof-input" id="cofDescription" placeholder="Share your creator story in 200 characters or less" style="resize: vertical; min-height: 96px;" maxlength="200"></textarea>
          <div class="cof-char-count"><span id="charCount">0</span> / 200</div>
        </div>

        <div class="cof-input-group">
          <label>Profile Picture</label>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="button" class="cof-btn-outline" onclick="cofUseInstagramPhoto()" style="flex: 1; min-width: 180px;">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              Use Instagram photo
            </button>
            <button type="button" class="cof-btn-outline" onclick="document.getElementById('cofPhotoUpload').click()" style="flex: 1; min-width: 180px;">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0l-4 4m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
              Upload photo
            </button>
          </div>
          <input type="file" id="cofPhotoUpload" style="display: none;" accept="image/*" onchange="cofUploadPhoto(event)">
          <div id="cofPhotoPreview" style="margin-top: 14px; display: none;">
            <img id="cofPhotoImg" src="" alt="Profile preview" style="width: 92px; height: 92px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(57,165,150,0.35); box-shadow: 0 8px 24px -8px rgba(57,165,150,0.35);">

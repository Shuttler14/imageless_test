{% comment %}
=================================================================================
CREATOR ONBOARDING FLOW SECTION
=================================================================================
Converts signed-in users to creators with brand setup and social verification
=================================================================================
{% endcomment %}

{% assign api_base_url = section.settings.api_base_url | default: 'https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app' %}
{% assign creator_api_base_url = section.settings.creator_api_base_url | default: 'https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app' %}
{% assign is_logged_in = false %}
{% if customer.id != blank %}
  {% assign is_logged_in = true %}
  {% assign user_id = customer.id %}
  {% assign user_email = customer.email %}
  {% assign user_name = customer.name %}
  {% assign user_first_name = customer.first_name %}
{% endif %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap');

  :root {
    --cof-primary: #39A596;
    --cof-primary-light: #5BC4B6;
    --cof-primary-dark: #2A8478;
    --cof-accent: #D4A574;
    --cof-text: #F5F4F1;
    --cof-text-soft: rgba(245, 244, 241, 0.78);
    --cof-text-muted: rgba(245, 244, 241, 0.52);
    --cof-text-faint: rgba(245, 244, 241, 0.3);
    --cof-border: rgba(255, 255, 255, 0.08);
    --cof-border-strong: rgba(255, 255, 255, 0.14);
    --cof-surface: rgba(255, 255, 255, 0.025);
    --cof-surface-hi: rgba(255, 255, 255, 0.045);
  }

  .cof-page {
    font-family: 'Montserrat', sans-serif;
    background:
      radial-gradient(ellipse 90% 55% at 50% -15%, rgba(57,165,150,0.10), transparent 65%),
      radial-gradient(ellipse 70% 45% at 85% 110%, rgba(168,85,247,0.05), transparent 70%),
      linear-gradient(180deg, #08080a 0%, #0a0a0c 100%);
    min-height: 100vh;
    color: var(--cof-text);
    padding: 0;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Container */
  .cof-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 20px 80px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .cof-container { padding: 32px 14px 60px; }
  }

  /* Progress Steps */
  .cof-progress {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-bottom: 40px;
  }

  .cof-progress-step {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cof-progress-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: all 0.4s ease;
  }

  .cof-progress-step.active .cof-progress-dot {
    background: var(--cof-primary);
    border-color: var(--cof-primary);
    color: #fff;
    box-shadow: 0 0 0 4px rgba(57,165,150,0.12);
  }

  .cof-progress-step.completed .cof-progress-dot {
    background: var(--cof-primary);
    border-color: var(--cof-primary);
    color: #fff;
  }

  .cof-progress-line {
    width: 48px;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
    transition: background 0.4s ease;
  }

  .cof-progress-step.completed + .cof-progress-line,
  .cof-progress-step.completed ~ .cof-progress-line {
    background: var(--cof-primary);
  }

  .cof-progress-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: none;
  }

  @media (min-width: 768px) {
    .cof-progress-label { display: block; }
  }

  /* Header */
  .cof-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .cof-header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    color: var(--cof-text);
  }

  .cof-header p {
    font-size: 15px;
    color: var(--cof-text-muted);
    letter-spacing: 0.01em;
  }

  /* Cards */
  .cof-card {
    background: linear-gradient(160deg, var(--cof-surface-hi) 0%, var(--cof-surface) 100%);
    border: 1px solid var(--cof-border);
    border-radius: 20px;
    padding: 36px 32px;
    margin-bottom: 20px;
    box-shadow:
      0 30px 70px -30px rgba(0,0,0,0.5),
      inset 0 1px 0 rgba(255,255,255,0.04);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  @media (max-width: 640px) {
    .cof-card {
      padding: 24px 18px;
      border-radius: 18px;
      margin-bottom: 14px;
    }
  }

  .cof-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 28px;
    letter-spacing: -0.01em;
    color: var(--cof-text);
    display: block;
  }

  .cof-card-kicker {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cof-primary);
    margin-bottom: 6px;
  }

  /* Inputs */
  .cof-input-group {
    margin-bottom: 22px;
  }

  .cof-input-group label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--cof-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .cof-input {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--cof-border-strong);
    border-radius: 10px;
    font-size: 15px;
    color: var(--cof-text);
    font-family: 'Montserrat', sans-serif;
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .cof-input:hover {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .cof-input:focus {
    outline: none;
    border-color: var(--cof-primary);
    background: rgba(57, 165, 150, 0.04);
    box-shadow: 0 0 0 4px rgba(57, 165, 150, 0.12);
  }

  .cof-input::placeholder {
    color: rgba(255, 255, 255, 0.28);
    font-weight: 400;
  }

  textarea.cof-input {
    line-height: 1.55;
  }

  /* Social Links */
  .cof-social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 600px) {
    .cof-social-grid { grid-template-columns: 1fr; }
  }

  .cof-social-card {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--cof-border);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .cof-social-card:hover {
    border-color: rgba(57, 165, 150, 0.28);
    background: rgba(57, 165, 150, 0.025);
  }

  .cof-social-card.connected {
    border-color: rgba(34, 197, 94, 0.35);
    background: rgba(34, 197, 94, 0.035);
  }

  .cof-social-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .cof-social-icon.instagram { background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
  .cof-social-icon.youtube { background: #FF0000; }
  .cof-social-icon.twitter { background: #000; border: 1px solid #333; }
  .cof-social-icon.linkedin { background: #0077B5; }

  .cof-social-info { flex: 1; min-width: 0; }
  .cof-social-name { font-weight: 600; font-size: 14px; margin-bottom: 2px; letter-spacing: 0.01em; }
  .cof-social-handle { font-size: 12px; color: var(--cof-text-muted); }
  .cof-social-status {
    font-size: 11px;
    color: #5BC47A;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cof-social-input-wrapper {
    display: none;
    flex-basis: 100%;
    width: 100%;
    margin-top: 4px;
    gap: 8px;
  }

  .cof-social-card.connecting .cof-social-input-wrapper {
    display: flex;
  }

  .cof-social-input-wrapper .cof-input {
    flex: 1;
    padding: 11px 14px;
    font-size: 14px;
  }

  .cof-connect-btn {
    background: var(--cof-primary);
    color: #fff;
    border: none;
    padding: 11px 20px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.15s ease;
    font-family: 'Montserrat', sans-serif;
    white-space: nowrap;
  }

  .cof-connect-btn:hover { background: var(--cof-primary-dark); }
  .cof-connect-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Secondary / outline button used for photo actions */
  .cof-btn-outline {
    background: rgba(255,255,255,0.02);
    color: var(--cof-text);
    border: 1px solid var(--cof-border-strong);
    padding: 13px 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: 'Montserrat', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .cof-btn-outline:hover {
    border-color: rgba(57,165,150,0.5);
    background: rgba(57,165,150,0.05);
    color: var(--cof-primary-light);
  }

  .cof-btn-outline .ico {
    width: 16px; height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* CTA Button */
  .cof-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 28px;
    background: linear-gradient(135deg, var(--cof-primary) 0%, var(--cof-primary-dark) 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.3s ease;
    text-decoration: none;
    box-shadow:
      0 12px 32px -12px rgba(57, 165, 150, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    font-family: 'Montserrat', sans-serif;
  }

  .cof-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow:
      0 16px 36px -12px rgba(57, 165, 150, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .cof-cta-btn.cof-cta-ghost {
    background: transparent;
    border: 1px solid var(--cof-border-strong);
    color: var(--cof-text-soft);
    box-shadow: none;
  }

  .cof-cta-btn.cof-cta-ghost:hover {
    border-color: rgba(255,255,255,0.3);
    color: var(--cof-text);
    background: rgba(255,255,255,0.02);
  }

  .cof-cta-btn span.arrow {
    font-size: 16px;
    font-weight: 400;
    transition: transform 0.25s ease;
  }

  .cof-cta-btn:hover span.arrow { transform: translateX(3px); }

  /* Products CTA Section */
  .cof-products-cta {
    text-align: center;
    padding: 56px 28px;
    background: linear-gradient(160deg, rgba(57, 165, 150, 0.07), rgba(212, 165, 116, 0.03));
    border-radius: 22px;
    border: 1px solid rgba(57, 165, 150, 0.18);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cof-products-cta { padding: 40px 20px; border-radius: 18px; }
  }

  .cof-products-cta-content {
    position: relative;
    z-index: 1;
    max-width: 460px;
    margin: 0 auto;
  }

  .cof-products-icon {
    font-size: 32px;
    margin-bottom: 16px;
    opacity: 0.9;
    letter-spacing: 0.5em;
    color: var(--cof-primary);
  }

  .cof-products-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    color: var(--cof-text);
  }

  @media (max-width: 640px) {
    .cof-products-title { font-size: 26px; }
  }

  .cof-products-subtitle {
    font-size: 14px;
    color: var(--cof-text-muted);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .cof-create-design-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: linear-gradient(135deg, var(--cof-primary) 0%, var(--cof-primary-dark) 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.3s ease;
    box-shadow:
      0 12px 32px -12px rgba(57, 165, 150, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .cof-create-design-btn:hover {
    transform: translateY(-1px);
    box-shadow:
      0 16px 36px -12px rgba(57, 165, 150, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  /* Profile Preview */
  .cof-profile-preview {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--cof-border);
    border-radius: 14px;
    margin-top: 16px;
  }

  .cof-profile-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cof-primary), var(--cof-primary-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    flex-shrink: 0;
  }

  .cof-profile-info h4 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 2px;
    color: var(--cof-text);
  }

  .cof-profile-info p {
    font-size: 12px;
    color: var(--cof-text-muted);
    margin: 0;
  }

  /* Verification Badge */
  .cof-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #5BC47A;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    margin-left: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Success State */
  .cof-success {
    text-align: center;
    padding: 32px 20px;
  }

  .cof-success-icon {
    font-size: 36px;
    margin-bottom: 16px;
    color: var(--cof-primary);
    letter-spacing: 0.4em;
  }

  .cof-success h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--cof-text);
    letter-spacing: -0.01em;
  }

  /* Celebration (subtle) */
  .cof-celebration {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    display: none;
    overflow: hidden;
  }

  .cof-celebration.active { display: block; }

  .cof-confetti {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 1px;
    opacity: 0.8;
    animation: cof-fall 3.2s cubic-bezier(0.22,1,0.36,1) forwards;
  }

  @keyframes cof-fall {
    0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(540deg); opacity: 0; }
  }

  /* Verified Popup */
  .cof-verified-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(160deg, rgba(20,20,22,0.98) 0%, rgba(14,14,16,0.98) 100%);
    border: 1px solid rgba(57, 165, 150, 0.35);
    border-radius: 20px;
    padding: 36px 32px;
    text-align: center;
    z-index: 10000;
    animation: cof-popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow:
      0 40px 80px -20px rgba(0,0,0,0.7),
      inset 0 1px 0 rgba(255,255,255,0.05);
    display: none;
    min-width: 320px;
    max-width: 92vw;
    backdrop-filter: blur(16px);
  }

  .cof-verified-popup.active { display: block; }

  @keyframes cof-popIn {
    0% { transform: translate(-50%, -46%) scale(0.95); opacity: 0; }
    100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  }

  .cof-verified-popup .icon {
    font-size: 32px;
    margin-bottom: 12px;
    color: var(--cof-primary);
    letter-spacing: 0.3em;
  }

  .cof-verified-popup h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--cof-text);
    letter-spacing: -0.01em;
  }

  .cof-verified-popup p {
    font-size: 14px;
    color: var(--cof-text-muted);
    margin: 0 0 18px;
    line-height: 1.5;
  }

  .cof-verified-popup .tier {
    display: inline-block;
    background: rgba(57, 165, 150, 0.14);
    border: 1px solid rgba(57, 165, 150, 0.4);
    color: var(--cof-primary-light);
    padding: 6px 18px;
    border-radius: 24px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Pending Design Card */
  .cof-pending-card {
    background: linear-gradient(160deg, rgba(57,165,150,0.06), rgba(57,165,150,0.02));
    border: 1px solid rgba(57,165,150,0.28);
    border-radius: 18px;
    padding: 22px;
    margin-bottom: 20px;
  }

  .cof-pending-header {
    margin-bottom: 14px;
  }

  .cof-pending-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(57,165,150,0.14);
    color: var(--cof-primary-light);
    border: 1px solid rgba(57,165,150,0.3);
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .cof-pending-label {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--cof-text);
    letter-spacing: -0.01em;
  }

  .cof-pending-body {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .cof-pending-img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(57,165,150,0.3);
    flex-shrink: 0;
  }

  .cof-pending-meta { flex: 1; min-width: 0; }

  .cof-pending-title {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--cof-text);
  }

  .cof-pending-sub {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--cof-text-muted);
  }

  .cof-publish-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--cof-primary), var(--cof-primary-dark));
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 8px;
    transition: transform 0.2s ease, box-shadow 0.3s ease;
    box-shadow: 0 8px 22px -8px rgba(57,165,150,0.5);
  }

  .cof-publish-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px -8px rgba(57,165,150,0.6);
  }

  .cof-publish-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  /* Utility */
  .cof-hidden { display: none !important; }
  .cof-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cof-border-strong), transparent);
    margin: 8px 0 20px;
  }
  .cof-help-text {
    font-size: 12px;
    color: var(--cof-text-muted);
    margin: -12px 0 14px;
    line-height: 1.5;
  }
  .cof-char-count {
    font-size: 11px;
    color: var(--cof-text-faint);
    margin-top: 6px;
    text-align: right;
    letter-spacing: 0.04em;
  }
  .cof-inline-error {

{%- assign stats_api_base = settings.creator_api_base | default: 'https://mynarrative-ai.vercel.app' | strip -%}
{%- if customer -%}
  <div class="creator-stats-dashboard" data-customer-id="{{ customer.id }}">
    <!-- Financial overview lives in creator-dashboard-enhanced; this section is activity + payouts only -->
    <div class="dashboard-header">
      <h2 class="dashboard-title" id="creator-activity-heading">{{ section.settings.heading }}</h2>
      <p class="dashboard-subtitle">Sales history and payout setup — your balances and tier are above.</p>
    </div>

    <!-- Recent Transactions Table -->
    <div class="transactions-section">
      <h3 class="transactions-title">Recent Transactions</h3>
      <div class="transactions-wrapper">
        <div class="transactions-skeleton">
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
        </div>
        <table class="transactions-table" style="display: none;">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Design</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody class="transactions-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
        <div class="transactions-empty" style="display: none;">
          <p>No transactions yet. Start selling to see your earnings here!</p>
        </div>
      </div>
    </div>

    <!-- Payout Info Card -->
    {%- if section.settings.show_payout_info -%}
      <div class="payout-info-section">
        <div class="payout-card">
          <div class="payout-header">
            <h3 class="payout-title">Next Payout</h3>
          </div>
          <div class="payout-content">
            <p class="payout-info-text">Payouts processed on the 1st of every month</p>
            <p class="payout-info-text">Minimum payout: <strong>₹500</strong></p>
            <a href="/pages/creator-payout" class="payout-button">Setup Bank Details</a>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Error state -->
    <div class="error-state" style="display: none;">
      <p class="error-message"></p>
      <button class="retry-button">Retry</button>
    </div>
  </div>
{%- else -%}
  <div class="creator-stats-dashboard login-required">
    <div class="login-prompt">
      <h2>Please log in to view your earnings</h2>
      <p>Sign in to your creator account to access your dashboard.</p>
      <a href="/account/login" class="login-button">Sign In</a>
    </div>
  </div>
{%- endif -%}

<style>
  :root {
    --bg-dark: #0a0a0a;
    --card-bg: #111;
    --border-color: #222;
    --text-primary: #ffffff;
    --brand-color: #39A596;
    --success-green: #22c55e;
    --error-red: #ef4444;
    --bronze-color: #CD7F32;
    --silver-color: #C0C0C0;
    --gold-color: #FFD700;
    --diamond-color: #B9F2FF;
  }

  .creator-stats-dashboard {
    background: var(--bg-dark);
    color: var(--text-primary);
    padding: 2rem 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Header */
  .dashboard-header {
    margin-bottom: 2rem;
  }

  .dashboard-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
  }

  .dashboard-subtitle {
    margin: 0 0 1.25rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.52);
    max-width: 40rem;
  }

  /* Transactions Section */
  .transactions-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .transactions-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
  }

  .transactions-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .transactions-table thead {
    border-bottom: 1px solid var(--border-color);
  }

  .transactions-table th {
    text-align: left;
    padding: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }

  .transactions-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .transactions-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .transaction-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .transaction-badge.sale {
    background: rgba(34, 197, 94, 0.2);
    color: var(--success-green);
  }

  .transaction-badge.refund {
    background: rgba(239, 68, 68, 0.2);
    color: var(--error-red);
  }

  .amount-positive {
    color: var(--success-green);
    font-weight: 600;
  }

  .amount-negative {
    color: var(--error-red);
    font-weight: 600;
  }

  /* Skeleton Loading */
  .transactions-skeleton {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skeleton-row {
    height: 2.5rem;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%
    );
    background-size: 200% 100%;
    border-radius: 0.25rem;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  @keyframes skeleton-pulse {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .transactions-empty {
    text-align: center;
    padding: 2rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9375rem;
  }

  /* Payout Info Section */
  .payout-info-section {
    margin-bottom: 2rem;
  }

  .payout-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .payout-header {
    margin-bottom: 1.5rem;
  }

  .payout-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .payout-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payout-info-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .payout-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--brand-color);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: center;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    width: fit-content;
  }

  .payout-button:hover {
    background: #2a8a7f;
    box-shadow: 0 0 1rem rgba(57, 165, 150, 0.3);
  }

  /* Error State */
  .error-state {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .error-message {
    margin: 0 0 1rem 0;
    color: var(--error-red);
    font-size: 0.9375rem;
  }

  .retry-button {
    padding: 0.5rem 1.25rem;
    background: var(--brand-color);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .retry-button:hover {
    background: #2a8a7f;
  }

  /* Login Prompt */
  .creator-stats-dashboard.login-required {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .login-prompt {
    text-align: center;
    padding: 2rem;
  }

  .login-prompt h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }

  .login-prompt p {
    margin: 0 0 1.5rem 0;
    color: rgba(255, 255, 255, 0.6);
  }

  .login-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--brand-color);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .login-button:hover {
    background: #2a8a7f;
    box-shadow: 0 0 1rem rgba(57, 165, 150, 0.3);
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .creator-stats-dashboard {
      padding: 1rem;
    }

    .dashboard-title {
      font-size: 1.35rem;
    }

    .transactions-section {
      padding: 1rem;
    }

    .transactions-table {
      font-size: 0.75rem;
    }

    .transactions-table th,
    .transactions-table td {
      padding: 0.5rem;
    }
  }
</style>

<script>
  (function() {
    var CREATOR_API = {{ stats_api_base | json }};

    const dashboard = document.querySelector('.creator-stats-dashboard');
    if (!dashboard) return;

    const customerId = dashboard.getAttribute('data-customer-id');
    if (!customerId) return;

    let autoRefreshTimer = null;

    // Format currency
    function formatCurrency(amount) {
      return '₹' + amount.toFixed(2);
    }

    // Format date
    function formatDate(dateString) {
      if (!dateString) return '—';
      const date = new Date(dateString);
      if (isNaN(date.getTime())) return '—';
      return date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function normalizePayload(body) {
      if (!body || typeof body !== 'object') return {};
      var s = body.summary || body.data || body;
      return s && typeof s === 'object' ? s : body;
    }

    // Fetch earnings API for transaction list (same host as main dashboard)
    async function fetchEarningsData() {
      try {
        showLoadingState();
        var url = CREATOR_API.replace(/\/+$/, '') + '/api/creator/earnings?creator_id=' + encodeURIComponent(customerId);
        const response = await fetch(url, { headers: { Accept: 'application/json' } });

        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }

        const body = await response.json();
        const data = normalizePayload(body);
        const transactions = data.transactions || body.transactions || [];
        renderTransactions(Array.isArray(transactions) ? transactions : []);
        hideErrorState();
        hideLoadingState();
      } catch (error) {
        console.error('Error fetching activity:', error);
        showErrorState(error.message);
        hideLoadingState();
      }
    }

    // Render transactions table
    function renderTransactions(transactions) {
      const tbody = dashboard.querySelector('.transactions-body');
      const table = dashboard.querySelector('.transactions-table');
      const emptyState = dashboard.querySelector('.transactions-empty');
      const skeleton = dashboard.querySelector('.transactions-skeleton');

      tbody.innerHTML = '';

      if (transactions.length === 0) {
        table.style.display = 'none';
        emptyState.style.display = 'block';
        skeleton.style.display = 'none';
        return;
      }

      transactions.slice(0, 10).forEach(txn => {
        const row = document.createElement('tr');
        const type = String(txn.type || 'sale').toUpperCase();
        const isRefund = type === 'REFUND';
        const amount = parseFloat(txn.amount);
        const amountClass = isRefund || amount < 0 ? 'amount-negative' : 'amount-positive';
        const amountText = isRefund || amount < 0 ? '−' + formatCurrency(Math.abs(amount)) : formatCurrency(amount);

        row.innerHTML = `
          <td>${formatDate(txn.date || txn.created_at)}</td>
          <td><span class="transaction-badge ${isRefund ? 'refund' : 'sale'}">${type}</span></td>
          <td>${txn.design_name || '—'}</td>
          <td class="${amountClass}">${amountText}</td>
        `;
        tbody.appendChild(row);
      });

      table.style.display = 'table';
      emptyState.style.display = 'none';
      skeleton.style.display = 'none';
    }

    // Loading state
    function showLoadingState() {
      dashboard.querySelector('.transactions-skeleton').style.display = 'flex';
      dashboard.querySelector('.transactions-table').style.display = 'none';
      dashboard.querySelector('.transactions-empty').style.display = 'none';
    }

    function hideLoadingState() {
      dashboard.querySelector('.transactions-skeleton').style.display = 'none';
    }

    // Error state
    function showErrorState(message) {
      const errorState = dashboard.querySelector('.error-state');
      errorState.style.display = 'block';
      dashboard.querySelector('.error-message').textContent = 'Could not load transactions. ' + (message || 'Check your connection and try again.');
      var retryBtn = dashboard.querySelector('.retry-button');
      if (retryBtn) retryBtn.onclick = function () { hideErrorState(); fetchEarningsData(); };
    }

    function hideErrorState() {
      dashboard.querySelector('.error-state').style.display = 'none';
    }

    // Setup auto-refresh
    function setupAutoRefresh() {
      if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      autoRefreshTimer = setInterval(fetchEarningsData, 60000);
    }

    // Initialize
    fetchEarningsData();
    setupAutoRefresh();
  })();
</script>

{% schema %}
{
  "name": "Creator Stats Dashboard",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Activity & payouts"
    },
    {
      "type": "checkbox",
      "id": "show_payout_info",
      "label": "Show payout info",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Creator Stats Dashboard"
    }
  ]
}
{% endschema %}

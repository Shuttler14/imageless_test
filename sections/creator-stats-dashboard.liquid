{%- if customer -%}
  <div class="creator-stats-dashboard" data-customer-id="{{ customer.id }}">
    <!-- Main heading -->
    <div class="dashboard-header">
      <h1 class="dashboard-title">{{ section.settings.heading }}</h1>
    </div>

    <!-- Stats Row: 3 cards -->
    <div class="stats-container">
      <!-- Card A: Total Earnings -->
      <div class="stat-card earnings-card">
        <div class="stat-icon">💰</div>
        <div class="stat-content">
          <div class="stat-value earnings-value">₹0.00</div>
          <div class="stat-label">Lifetime Creator Earnings</div>
        </div>
      </div>

      <!-- Card B: Designs Sold -->
      <div class="stat-card sales-card">
        <div class="stat-icon">🛍️</div>
        <div class="stat-content">
          <div class="stat-value sales-value">0</div>
          <div class="stat-label">Total Units Sold</div>
        </div>
      </div>

      <!-- Card C: Current Tier -->
      <div class="stat-card tier-card">
        <div class="stat-icon">🥈</div>
        <div class="stat-content">
          <div class="tier-badge" data-tier="Silver">SILVER</div>
          <div class="stat-label">Creator Tier</div>
        </div>
      </div>

      <!-- Card D: Narrative Tokens (AI Credits) -->
      <div class="stat-card tokens-card">
        <div class="stat-icon" style="color:#39A596">🪙</div>
        <div class="stat-content">
          <div class="stat-value tokens-value" style="color:#39A596">3</div>
          <div class="stat-label">Narrative Tokens</div>
          <div class="tokens-sublabel">+5 per sale · +10 per sample kit</div>
        </div>
      </div>
    </div>

    <!-- Tier Progress Bar -->
    <div class="tier-progress-section">
      <div class="progress-header">
        <h3 class="progress-title">Progress to Gold</h3>
        <div class="progress-meta">
          <span class="sales-count"><span class="current-sales">0</span> / <span class="target-sales">200</span> sales (<span class="progress-percent">0</span>%)</span>
        </div>
      </div>
      <div class="progress-bar-wrapper">
        <div class="progress-bar-track">
          <div class="progress-bar-fill" style="width: 0%"></div>
        </div>
      </div>
      <div class="progress-footer">
        <span class="sales-remaining"><span class="remaining-count">200</span> more sales to Gold</span>
      </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="transactions-section">
      <h3 class="transactions-title">Recent Transactions</h3>
      <div class="transactions-wrapper">
        <div class="transactions-skeleton">
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
        </div>
        <table class="transactions-table" style="display: none;">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Design</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody class="transactions-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
        <div class="transactions-empty" style="display: none;">
          <p>No transactions yet. Start selling to see your earnings here!</p>
        </div>
      </div>
    </div>

    <!-- Payout Info Card -->
    {%- if section.settings.show_payout_info -%}
      <div class="payout-info-section">
        <div class="payout-card">
          <div class="payout-header">
            <h3 class="payout-title">Next Payout</h3>
          </div>
          <div class="payout-content">
            <p class="payout-info-text">Payouts processed on the 1st of every month</p>
            <p class="payout-info-text">Minimum payout: <strong>₹500</strong></p>
            <a href="/pages/creator-payout" class="payout-button">Setup Bank Details</a>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Error state -->
    <div class="error-state" style="display: none;">
      <p class="error-message"></p>
      <button class="retry-button">Retry</button>
    </div>
  </div>
{%- else -%}
  <div class="creator-stats-dashboard login-required">
    <div class="login-prompt">
      <h2>Please log in to view your earnings</h2>
      <p>Sign in to your creator account to access your dashboard.</p>
      <a href="/account/login" class="login-button">Sign In</a>
    </div>
  </div>
{%- endif -%}

<style>
  :root {
    --bg-dark: #0a0a0a;
    --card-bg: #111;
    --border-color: #222;
    --text-primary: #ffffff;
    --brand-color: #39A596;
    --success-green: #22c55e;
    --error-red: #ef4444;
    --bronze-color: #CD7F32;
    --silver-color: #C0C0C0;
    --gold-color: #FFD700;
    --diamond-color: #B9F2FF;
  }

  .creator-stats-dashboard {
    background: var(--bg-dark);
    color: var(--text-primary);
    padding: 2rem 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Header */
  .dashboard-header {
    margin-bottom: 2rem;
  }

  .dashboard-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Stats Container - CSS Grid */
  .stats-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    border-color: var(--brand-color);
    box-shadow: 0 0 1rem rgba(57, 165, 150, 0.15);
  }

  .stat-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .stat-content {
    flex: 1;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Tier Badge */
  .tier-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
    box-shadow: 0 0 0.5rem rgba(57, 165, 150, 0.3);
  }

  .tier-badge[data-tier="Bronze"] {
    background: rgba(205, 127, 50, 0.2);
    color: var(--bronze-color);
    box-shadow: 0 0 0.75rem rgba(205, 127, 50, 0.4);
  }

  .tier-badge[data-tier="Silver"] {
    background: rgba(192, 192, 192, 0.2);
    color: var(--silver-color);
    box-shadow: 0 0 0.75rem rgba(192, 192, 192, 0.4);
  }

  .tier-badge[data-tier="Gold"] {
    background: rgba(255, 215, 0, 0.2);
    color: var(--gold-color);
    box-shadow: 0 0 0.75rem rgba(255, 215, 0, 0.4);
  }

  .tier-badge[data-tier="Diamond"] {
    background: rgba(185, 242, 255, 0.2);
    color: var(--diamond-color);
    box-shadow: 0 0 0.75rem rgba(185, 242, 255, 0.6);
  }

  /* Tier Progress Section */
  .tier-progress-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .tier-progress-section.diamond-tier {
    text-align: center;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .progress-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .progress-meta {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .progress-bar-wrapper {
    margin-bottom: 0.75rem;
  }

  .progress-bar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 0.25rem;
    height: 0.5rem;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--brand-color);
    border-radius: 0.25rem;
    width: 0%;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .progress-footer {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .diamond-message {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--diamond-color);
    text-align: center;
    padding: 1rem 0;
  }

  /* Transactions Section */
  .transactions-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .transactions-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
  }

  .transactions-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .transactions-table thead {
    border-bottom: 1px solid var(--border-color);
  }

  .transactions-table th {
    text-align: left;
    padding: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }

  .transactions-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .transactions-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .transaction-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .transaction-badge.sale {
    background: rgba(34, 197, 94, 0.2);
    color: var(--success-green);
  }

  .transaction-badge.refund {
    background: rgba(239, 68, 68, 0.2);
    color: var(--error-red);
  }

  .amount-positive {
    color: var(--success-green);
    font-weight: 600;
  }

  .amount-negative {
    color: var(--error-red);
    font-weight: 600;
  }

  /* Skeleton Loading */
  .transactions-skeleton {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skeleton-row {
    height: 2.5rem;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%
    );
    background-size: 200% 100%;
    border-radius: 0.25rem;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  @keyframes skeleton-pulse {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .transactions-empty {
    text-align: center;
    padding: 2rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9375rem;
  }

  /* Payout Info Section */
  .payout-info-section {
    margin-bottom: 2rem;
  }

  .payout-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .payout-header {
    margin-bottom: 1.5rem;
  }

  .payout-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .payout-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payout-info-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .payout-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--brand-color);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: center;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    width: fit-content;
  }

  .payout-button:hover {
    background: #2a8a7f;
    box-shadow: 0 0 1rem rgba(57, 165, 150, 0.3);
  }

  /* Error State */
  .error-state {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .error-message {
    margin: 0 0 1rem 0;
    color: var(--error-red);
    font-size: 0.9375rem;
  }

  .retry-button {
    padding: 0.5rem 1.25rem;
    background: var(--brand-color);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .retry-button:hover {
    background: #2a8a7f;
  }

  /* Login Prompt */
  .creator-stats-dashboard.login-required {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .login-prompt {
    text-align: center;
    padding: 2rem;
  }

  .login-prompt h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }

  .login-prompt p {
    margin: 0 0 1.5rem 0;
    color: rgba(255, 255, 255, 0.6);
  }

  .login-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--brand-color);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .login-button:hover {
    background: #2a8a7f;
    box-shadow: 0 0 1rem rgba(57, 165, 150, 0.3);
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .creator-stats-dashboard {
      padding: 1rem;
    }

    .dashboard-title {
      font-size: 1.5rem;
    }

    .stats-container {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .progress-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .transactions-section {
      padding: 1rem;
    }

    .transactions-table {
      font-size: 0.75rem;
    }

    .transactions-table th,
    .transactions-table td {
      padding: 0.5rem;
    }

    .stat-card {
      padding: 1rem;
    }

    .stat-value {
      font-size: 1.5rem;
    }

    .stat-icon {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  (function() {
    const TIER_CONFIG = {
      Bronze: { color: '#CD7F32', icon: '🥉', label: 'BRONZE', nextTier: 'Silver', salesTarget: 50 },
      Silver: { color: '#C0C0C0', icon: '🥈', label: 'SILVER', nextTier: 'Gold', salesTarget: 200 },
      Gold: { color: '#FFD700', icon: '🥇', label: 'GOLD', nextTier: 'Diamond', salesTarget: 500 },
      Diamond: { color: '#B9F2FF', icon: '💎', label: 'DIAMOND', nextTier: null, salesTarget: Infinity },
    };

    const dashboard = document.querySelector('.creator-stats-dashboard');
    if (!dashboard) return;

    const customerId = dashboard.getAttribute('data-customer-id');
    if (!customerId) return;

    let autoRefreshTimer = null;

    // Format currency
    function formatCurrency(amount) {
      return '₹' + amount.toFixed(2);
    }

    // Format date
    function formatDate(dateString) {
      const date = new Date(dateString);
      return date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    // Fetch earnings data
    async function fetchEarningsData() {
      try {
        showLoadingState();
        const response = await fetch(
          `https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/creator/earnings?creator_id=${customerId}`
        );

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
        populateDashboard(data);
        hideErrorState();
      } catch (error) {
        console.error('Error fetching earnings:', error);
        showErrorState(error.message);
      }
    }

    // Populate dashboard with data
    function populateDashboard(data) {
      // Stat Cards
      const earnings   = data.total_earnings_rupees || data.lifetime_earnings || 0;
      const salesCount = data.total_designs_sold    || data.total_sales       || 0;
      const currentTier = (data.creator_tier || data.current_tier || 'Bronze');
      const aiCredits   = data.ai_credits != null ? data.ai_credits : (data.summary && data.summary.ai_credits != null ? data.summary.ai_credits : 3);

      // Tokens card
      const tokensEl = dashboard.querySelector('.tokens-value');
      if (tokensEl) {
        tokensEl.textContent = aiCredits;
        // Pulse red if low
        const tokensCard = dashboard.querySelector('.tokens-card');
        if (tokensCard) {
          tokensCard.style.borderColor = aiCredits <= 1 ? '#ef4444' : '#39A596';
          if (aiCredits === 0) {
            tokensCard.innerHTML += '<div class="tokens-warning">Buy a Sample Kit to earn +10 tokens</div>';
          }
        }
      }

      dashboard.querySelector('.earnings-value').textContent = formatCurrency(earnings);
      dashboard.querySelector('.sales-value').textContent = salesCount;
      if (dashboard.querySelector('.tokens-value')) dashboard.querySelector('.tokens-value').textContent = aiCredits;

      // Tier badge and icon
      const tierConfig = TIER_CONFIG[currentTier] || TIER_CONFIG['Bronze'];
      const tierBadge = dashboard.querySelector('.tier-badge');
      const tierIcon  = dashboard.querySelector('.tier-card .stat-icon');
      if (tierConfig && tierBadge) {
        tierBadge.textContent = tierConfig.label;
        tierBadge.setAttribute('data-tier', currentTier);
        if (tierIcon) tierIcon.textContent = tierConfig.icon;
      }

      // Progress bar
      const nextTierConfig = tierConfig?.nextTier ? TIER_CONFIG[tierConfig.nextTier] : null;
      if (nextTierConfig && currentTier !== 'Diamond') {
        const targetSales = nextTierConfig.salesTarget;
        const progressPercent = Math.min(Math.round((salesCount / targetSales) * 100), 100);
        const remaining = Math.max(targetSales - salesCount, 0);

        dashboard.querySelector('.current-sales').textContent = salesCount;
        dashboard.querySelector('.target-sales').textContent = targetSales;
        dashboard.querySelector('.progress-percent').textContent = progressPercent;
        dashboard.querySelector('.remaining-count').textContent = remaining;
        dashboard.querySelector('.progress-bar-fill').style.width = progressPercent + '%';

        dashboard.querySelector('.tier-progress-section').classList.remove('diamond-tier');
      } else if (currentTier === 'Diamond') {
        // Diamond tier message
        const progressSection = dashboard.querySelector('.tier-progress-section');
        progressSection.classList.add('diamond-tier');
        progressSection.innerHTML = '<div class="diamond-message">You\'ve reached the top! 💎</div>';
      }

      // Transactions
      const transactions = data.transactions || [];
      renderTransactions(transactions);

      hideLoadingState();
    }

    // Render transactions table
    function renderTransactions(transactions) {
      const tbody = dashboard.querySelector('.transactions-body');
      const table = dashboard.querySelector('.transactions-table');
      const emptyState = dashboard.querySelector('.transactions-empty');
      const skeleton = dashboard.querySelector('.transactions-skeleton');

      tbody.innerHTML = '';

      if (transactions.length === 0) {
        table.style.display = 'none';
        emptyState.style.display = 'block';
        skeleton.style.display = 'none';
        return;
      }

      transactions.slice(0, 10).forEach(txn => {
        const row = document.createElement('tr');
        const type = txn.type.toUpperCase();
        const isRefund = type === 'REFUND';
        const amount = parseFloat(txn.amount);
        const amountClass = isRefund || amount < 0 ? 'amount-negative' : 'amount-positive';
        const amountText = isRefund || amount < 0 ? '−' + formatCurrency(Math.abs(amount)) : formatCurrency(amount);

        row.innerHTML = `
          <td>${formatDate(txn.date)}</td>
          <td><span class="transaction-badge ${isRefund ? 'refund' : 'sale'}">${type}</span></td>
          <td>${txn.design_name || '—'}</td>
          <td class="${amountClass}">${amountText}</td>
        `;
        tbody.appendChild(row);
      });

      table.style.display = 'table';
      emptyState.style.display = 'none';
      skeleton.style.display = 'none';
    }

    // Loading state
    function showLoadingState() {
      dashboard.querySelector('.transactions-skeleton').style.display = 'flex';
      dashboard.querySelector('.transactions-table').style.display = 'none';
      dashboard.querySelector('.transactions-empty').style.display = 'none';
    }

    function hideLoadingState() {
      dashboard.querySelector('.transactions-skeleton').style.display = 'none';
    }

    // Error state
    function showErrorState(message) {
      const errorState = dashboard.querySelector('.error-state');
      errorState.style.display = 'block';
      dashboard.querySelector('.error-message').textContent = `Failed to load earnings: ${message}`;
      dashboard.querySelector('.retry-button').addEventListener('click', fetchEarningsData);
    }

    function hideErrorState() {
      dashboard.querySelector('.error-state').style.display = 'none';
    }

    // Setup auto-refresh
    function setupAutoRefresh() {
      if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      autoRefreshTimer = setInterval(fetchEarningsData, 60000);
    }

    // Initialize
    fetchEarningsData();
    setupAutoRefresh();
  })();
</script>

{% schema %}
{
  "name": "Creator Stats Dashboard",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Earnings"
    },
    {
      "type": "checkbox",
      "id": "show_payout_info",
      "label": "Show payout info",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Creator Stats Dashboard"
    }
  ]
}
{% endschema %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :root {
    --fc-primary: #39A596;
    --fc-gold: #FFD700;
    --fc-purple: #A855F7;
    --fc-pink: #EC4899;
    --fc-dark: #0a0a0a;
    --fc-card-bg: rgba(255, 255, 255, 0.02);
    --fc-border: rgba(255, 255, 255, 0.08);
  }

  .fc-page {
    font-family: 'Outfit', sans-serif;
    background: linear-gradient(180deg, #050505 0%, #0a0a0a 50%, #0f0f0f 100%);
    min-height: 100vh;
    color: #fff;
    padding: 0;
    overflow-x: hidden;
  }

  /* Hero Section */
  .fc-hero {
    position: relative;
    padding: 80px 20px 60px;
    text-align: center;
    overflow: hidden;
  }

  .fc-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(57, 165, 150, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .fc-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.2), rgba(168, 85, 247, 0.2));
    border: 1px solid rgba(57, 165, 150, 0.3);
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 24px;
    animation: fadeInDown 0.8s ease;
  }

  .fc-hero-badge span {
    font-size: 16px;
  }

  .fc-hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(36px, 8vw, 72px);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
    animation: fadeInUp 0.8s ease 0.2s both;
  }

  .fc-hero-title .highlight {
    background: linear-gradient(135deg, var(--fc-primary), var(--fc-purple), var(--fc-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .fc-hero-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.6;
    animation: fadeInUp 0.8s ease 0.4s both;
  }

  /* Stats Row */
  .fc-stats-row {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease 0.6s both;
  }

  .fc-stat-item {
    text-align: center;
  }

  .fc-stat-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 48px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--fc-gold), var(--fc-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .fc-stat-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Creator Grid */
  .fc-section {
    padding: 40px 20px 80px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .fc-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fc-section-title::before {
    content: '';
    width: 4px;
    height: 28px;
    background: linear-gradient(180deg, var(--fc-primary), var(--fc-purple));
    border-radius: 2px;
  }

  .fc-creator-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .fc-creator-card {
    background: var(--fc-card-bg);
    border: 1px solid var(--fc-border);
    border-radius: 24px;
    padding: 0;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    group: hover;
  }

  .fc-creator-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(180deg, transparent 0%, rgba(57, 165, 150, 0.05) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .fc-creator-card:hover {
    transform: translateY(-12px);
    border-color: rgba(57, 165, 150, 0.4);
    box-shadow: 0 25px 50px rgba(57, 165, 150, 0.15);
  }

  .fc-card-banner {
    height: 100px;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    position: relative;
    overflow: hidden;
  }

  .fc-card-banner::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .fc-card-avatar-wrapper {
    position: relative;
    margin-top: -50px;
    z-index: 2;
  }

  .fc-card-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 4px solid var(--fc-dark);
    margin: 0 auto;
    overflow: hidden;
    background: linear-gradient(135deg, var(--fc-primary), var(--fc-purple));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .fc-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fc-card-badge {
    position: absolute;
    bottom: -5px;
    right: calc(50% - 55px);
    background: linear-gradient(135deg, var(--fc-gold), #FFA500);
    color: #000;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .fc-card-content {
    padding: 20px;
    position: relative;
    z-index: 2;
  }

  .fc-card-name {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .fc-card-handle {
    font-size: 14px;
    color: var(--fc-primary);
    margin-bottom: 12px;
  }

  .fc-card-bio {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 16px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fc-card-stats {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--fc-border);
  }

  .fc-card-stat {
    text-align: center;
  }

  .fc-card-stat-value {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }

  .fc-card-stat-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Tier Badges */
  .fc-tier-diamond { border-color: rgba(0, 255, 255, 0.4); }
  .fc-tier-diamond .fc-card-banner { background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #415a77 100%); }
  .fc-tier-gold { border-color: rgba(255, 215, 0, 0.4); }
  .fc-tier-gold .fc-card-banner { background: linear-gradient(135deg, #1a1a2e 0%, #2d2d44 50%, #3d3d5c 100%); }
  .fc-tier-silver { border-color: rgba(192, 192, 192, 0.4); }
  .fc-tier-silver .fc-card-banner { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #3d3d3d 100%); }

  /* CTA Section */
  .fc-cta-section {
    padding: 80px 20px;
    text-align: center;
    background: linear-gradient(180deg, transparent 0%, rgba(57, 165, 150, 0.05) 100%);
  }

  .fc-cta-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .fc-cta-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 32px;
  }

  .fc-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, var(--fc-primary), #2d8a85);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    padding: 16px 40px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(57, 165, 150, 0.3);
  }

  .fc-cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(57, 165, 150, 0.4);
  }

  /* Animations */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .fc-hero { padding: 60px 16px 40px; }
    .fc-stats-row { gap: 24px; }
    .fc-stat-number { font-size: 36px; }
    .fc-creator-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
  }
</style>


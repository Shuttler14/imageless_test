{% comment %}
=================================================================================
MY NARRATIVE - FEATURED CREATORS PAGE (PRODUCTION)
=================================================================================
Displays mega-influencer creators in a premium marketplace

=================================================================================
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  .mn-featured-creators {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #0a0a0a 0%, #111 50%, #0a0a0a 100%);
    min-height: 100vh;
    color: #fff;
    padding: 40px 20px;
  }

  .mn-featured-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .mn-featured-title {
    font-size: 42px;
    font-weight: 800;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 12px;
  }

  .mn-featured-subtitle {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    margin: 0 auto;
  }

  .mn-creator-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mn-creator-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 20px;
    padding: 24px;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .mn-creator-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #fbbf24, #f59e0b);
  }

  .mn-creator-card:hover {
    transform: translateY(-8px);
    border-color: rgba(251, 191, 36, 0.5);
    box-shadow: 0 20px 40px rgba(251, 191, 36, 0.1);
  }

  .mn-creator-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: 0 auto 16px;
    border: 4px solid #fbbf24;
    overflow: hidden;
    background: rgba(251, 191, 36, 0.1);
  }

  .mn-creator-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mn-creator-username {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .mn-creator-rank {
    font-size: 14px;
    color: #fbbf24;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .mn-creator-stats {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mn-creator-stat {
    text-align: center;
  }

  .mn-creator-stat-value {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }

  .mn-creator-stat-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .mn-creator-badge-mega {
    position: absolute;
    top: 16px;
    right: 16px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #000;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
  }

  .mn-loading-creators {
    text-align: center;
    padding: 60px;
    color: rgba(255, 255, 255, 0.5);
  }

  .mn-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(251, 191, 36, 0.2);
    border-top-color: #fbbf24;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .mn-no-creators {
    text-align: center;
    padding: 60px;
    color: rgba(255, 255, 255, 0.5);
  }

  .mn-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    margin-bottom: 24px;
    font-size: 14px;
  }

  .mn-back-link:hover {
    color: #fbbf24;
  }
</style>

<div class="mn-featured-creators">
  <a href="/" class="mn-back-link">&larr; Back to Home</a>

  <div class="mn-featured-header">
    <h1 class="mn-featured-title">Featured Creators</h1>
    <p class="mn-featured-subtitle">
      Discover designs from our top-performing creators with massive social influence.
      Join the program to showcase your own creations!
    </p>
  </div>

  <div id="mnLoadingCreators" class="mn-loading-creators">
    <div class="mn-spinner"></div>
    <p>Loading featured creators...</p>
  </div>

  <div id="mnCreatorGrid" class="mn-creator-grid" style="display: none;"></div>

  <div id="mnNoCreators" class="mn-no-creators" style="display: none;">
    <p>No featured creators yet. Check back soon!</p>
  </div>
</div>

<script>
(function() {
  'use strict';

  const API_BASE_URL = '{{ section.settings.creator_api_base_url | default: "https://drishti-api-blond.vercel.app" }}';

  const RANK_LABELS = {
    rookie_designer: { label: 'Rookie Designer', emoji: '' },
    emerging_talent: { label: 'Emerging Talent', emoji: '' },
    trendsetter: { label: 'Trendsetter', emoji: '' },
    style_architect: { label: 'Style Architect', emoji: '' },
    platform_icon: { label: 'Platform Icon', emoji: '' }
  };

  async function loadFeaturedCreators() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/creator_economy?path=/api/creators/featured`);
      const data = await response.json();

      const grid = document.getElementById('mnCreatorGrid');
      const loading = document.getElementById('mnLoadingCreators');
      const noCreators = document.getElementById('mnNoCreators');

      loading.style.display = 'none';

      if (!data.success || !data.data || data.data.length === 0) {
        noCreators.style.display = 'block';
        return;
      }

      grid.innerHTML = data.data.map(creator => {
        const rank = RANK_LABELS[creator.style_influence_rank] || RANK_LABELS.rookie_designer;
        const avatarUrl = creator.avatar_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=${creator.username}`;

        return `
          <div class="mn-creator-card" onclick="window.location.href='/pages/featured-creators?creator=${creator.username}'">
            <span class="mn-creator-badge-mega">MEGA</span>
            <div class="mn-creator-avatar">
              <img src="${avatarUrl}" alt="${creator.username}" />
            </div>
            <h3 class="mn-creator-username">@${creator.username}</h3>
            <p class="mn-creator-rank">${rank.emoji ? `${rank.emoji} ` : ''}${rank.label}</p>
            <div class="mn-creator-stats">
              <div class="mn-creator-stat">
                <p class="mn-creator-stat-value">INR ${new Intl.NumberFormat('en-IN').format(creator.lifetime_earnings || 0)}</p>
                <p class="mn-creator-stat-label">Earned</p>
              </div>
              <div class="mn-creator-stat">
                <p class="mn-creator-stat-value">${creator.total_items_sold || 0}</p>
                <p class="mn-creator-stat-label">Sold</p>
              </div>
            </div>
          </div>
        `;
      }).join('');

      grid.style.display = 'grid';

    } catch (error) {
      console.error('Error loading creators:', error);
      document.getElementById('mnLoadingCreators').style.display = 'none';
      document.getElementById('mnNoCreators').style.display = 'block';
    }
  }

  loadFeaturedCreators();
})();
</script>

{% schema %}
{
  "name": "Featured Creators",
  "settings": [
    {
      "type": "text",
      "id": "creator_api_base_url",
      "label": "Creator Economy API Base URL",
      "default": "https://drishti-api-blond.vercel.app"
    }
  ],
  "presets": [
    {
      "name": "Featured Creators"
    }
  ]
}
{% endschema %}

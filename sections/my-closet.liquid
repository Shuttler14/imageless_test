  // ── Load/Save ─────────────────────────────────────────────
  function load() {
    try {
      var id = JSON.parse(localStorage.getItem('mn_identity')||'{}');
      closetItems = Array.isArray(id.closet_items)?id.closet_items:[];
      if($('mnc-complete-pct'))$('mnc-complete-pct').textContent=id.completion_pct||0;
    } catch(e){ closetItems=[]; }
    render();
  }

  function save() {
    try {
      var id = JSON.parse(localStorage.getItem('mn_identity')||'{}');
      id.closet_items=closetItems; id.closet_count=closetItems.length;
      var fields=['gender','height_cm','skin_mst','preferred_fit','style_vibes','occasions','closet_items','bank_cards'];
      id.completion_pct=Math.round((fields.filter(function(f){var v=id[f];return v!==undefined&&v!==null&&v!==''&&!(Array.isArray(v)&&v.length===0);}).length/fields.length)*100);
      localStorage.setItem('mn_identity',JSON.stringify(id));
      window.MN_IDENTITY=id;
      window.dispatchEvent(new CustomEvent('mn-identity-updated',{detail:id}));
    } catch(e){}
  }

  function classify(l) {
    l=(l||'').toLowerCase();
    if(/jacket|coat|blazer|hoodie|cardigan|sweater|puffer|trench|shacket|windbreaker|fleece/.test(l)) return 'outerwear';
    if(/jean|pant|trouser|short|skirt|chino|cargo|jogger|track|legging/.test(l)) return 'bottoms';
    if(/shoe|sneaker|heel|boot|sandal|loafer|slipper|oxford|derby|kolhapuri|boat/.test(l)) return 'footwear';
    if(/watch|chronograph|smart watch|strap watch|dial watch/.test(l)) return 'watches';
    if(/bag|belt|scarf|jewel|necklace|bracelet|sunglass|hat|cap|wallet|earring/.test(l)) return 'accessories';
    if(/kurta|saree|lehenga|sherwani|salwar|dupatta|dhoti|anarkali|bandhgala|nehru|jodhpuri/.test(l)) return 'ethnic';
    if(/dress|gown|romper|jumpsuit|co-ord|coord|midi|maxi|mini/.test(l)) return 'dresses';
    if(/sport|gym|yoga|activewear|compression|athletic|training/.test(l)) return 'activewear';
    return 'tops';
  }

  // ── Render Grid ───────────────────────────────────────────
  function normalizeText(v) {
    return String(v || '').toLowerCase().replace(/[^a-z0-9\s-]/g,' ').replace(/\s+/g,' ').trim();
  }

  function colorFromItem(item) {
    var l = normalizeText((item && item.label) || '');
    var c = normalizeText((item && item.color) || '');
    var source = (c ? c + ' ' : '') + l;
    if(/rose gold/.test(source)) return '#b67a6d';
    if(/silver|metallic silver/.test(source)) return '#b7bcc6';
    if(/gold|mustard|ochre/.test(source)) return '#c69b2d';
    if(/black|jet/.test(source)) return '#1f1f1f';
    if(/white|ivory|off white|cream/.test(source)) return '#f1ece2';
    if(/grey|gray|charcoal/.test(source)) return '#6b7280';
    if(/navy/.test(source)) return '#243b6b';
    if(/denim|cobalt|royal blue|sky blue|blue/.test(source)) return '#4f6fae';
    if(/tan|camel|cognac|brown/.test(source)) return '#8a5a3c';
    if(/beige|khaki|sand|taupe/.test(source)) return '#c7b08a';
    if(/olive|sage/.test(source)) return '#6d7b45';
    if(/emerald|forest|green/.test(source)) return '#3f8750';
    if(/burgundy|maroon|wine|red/.test(source)) return '#8a2f3d';
    if(/lavender|lilac|purple|violet/.test(source)) return '#8b68b8';
    if(/pink|rose/.test(source)) return '#d48097';
    if(/orange|rust|terracotta/.test(source)) return '#c66a3d';
    if(/teal|turquoise/.test(source)) return '#3c8d94';
    return '#7b8794';
  }

  function svgUri(svg) {
    return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
  }

  function detectSubtype(item, cat) {
    var l = normalizeText((item && item.label) || '');
    if(cat==='tops') {
      if(/polo/.test(l)) return 'polo';
      if(/shirt|oxford|linen shirt|button/.test(l)) return 'shirt';
      if(/crop/.test(l)) return 'crop';
      if(/tank|vest/.test(l)) return 'tank';
      if(/turtleneck|henley|knit/.test(l)) return 'knit';
      return 'tee';
    }
    if(cat==='bottoms') {
      if(/short/.test(l)) return 'shorts';
      if(/cargo/.test(l)) return 'cargo';
      if(/jogger|sweatpant|track/.test(l)) return 'joggers';
      if(/skirt/.test(l)) return 'skirt';
      return 'trousers';
    }
    if(cat==='outerwear') {
      if(/blazer/.test(l)) return 'blazer';
      if(/hoodie/.test(l)) return 'hoodie';
      if(/trench/.test(l)) return 'trench';
      if(/bomber/.test(l)) return 'bomber';
      if(/cardigan/.test(l)) return 'cardigan';
      if(/puffer/.test(l)) return 'puffer';
      return 'jacket';
    }
    if(cat==='footwear') {
      if(/boot/.test(l)) return 'boots';
      if(/heel/.test(l)) return 'heels';
      if(/loafer|oxford|derby|boat/.test(l)) return 'formal';
      if(/slide|sandal|kolhapuri/.test(l)) return 'sandals';
      return 'sneakers';
    }
    if(cat==='accessories') {
      if(/bag|tote|backpack|crossbody/.test(l)) return 'bag';
      if(/belt/.test(l)) return 'belt';
      if(/sunglass/.test(l)) return 'sunglasses';
      if(/cap|hat/.test(l)) return 'cap';
      if(/necklace|chain/.test(l)) return 'necklace';
      if(/bracelet|cuff/.test(l)) return 'bracelet';
      return 'accessory';
    }
    if(cat==='watches') {
      if(/smart ?watch|apple watch/.test(l)) return 'smartwatch';
      if(/chronograph/.test(l)) return 'chronograph';
      if(/dress|minimalist|classic|round|mesh|strap/.test(l)) return 'analog';
      return 'analog';
    }
    if(cat==='ethnic') {
      if(/saree/.test(l)) return 'saree';
      if(/lehenga/.test(l)) return 'lehenga';
      if(/nehru|jacket/.test(l)) return 'nehru';
      if(/sherwani|bandhgala|jodhpuri/.test(l)) return 'sherwani';
      return 'kurta';
    }
    if(cat==='dresses') {
      if(/jumpsuit/.test(l)) return 'jumpsuit';
      if(/coord|co ord|co-ord/.test(l)) return 'coord';
      if(/maxi/.test(l)) return 'maxi';
      if(/mini/.test(l)) return 'mini';
      if(/wrap/.test(l)) return 'wrap';
      return 'dress';
    }
    if(cat==='activewear') {
      if(/bra/.test(l)) return 'sportsbra';
      if(/legging|tight|compression/.test(l)) return 'leggings';
      if(/short/.test(l)) return 'sportsshorts';
      if(/jacket|hoodie/.test(l)) return 'sportsjacket';
      return 'gymtop';
    }
    return 'generic';
  }


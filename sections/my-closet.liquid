{% comment %} Digital Closet Page - Matches store dark luxury theme {% endcomment %}

<div class="mnc-page">

  <!-- Hero Header -->
  <div class="mnc-hero">
    <div class="mnc-hero-inner">
      <p class="mnc-hero-eyebrow">MY NARRATIVE</p>
      <h1 class="mnc-hero-title">My Digital Closet</h1>
      <p class="mnc-hero-sub">Your wardrobe, classified by AI. Every piece, perfectly organised.</p>
      <div class="mnc-stats-row">
        <div class="mnc-stat"><span class="mnc-stat-num" id="mnc-total-count">0</span><span class="mnc-stat-lbl">Items</span></div>
        <div class="mnc-stat-div"></div>
        <div class="mnc-stat"><span class="mnc-stat-num" id="mnc-cat-count">0</span><span class="mnc-stat-lbl">Categories</span></div>
        <div class="mnc-stat-div"></div>
        <div class="mnc-stat"><span class="mnc-stat-num" id="mnc-complete-pct">0</span><span class="mnc-stat-lbl">% Complete</span></div>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="mnc-filters-wrap">
    <div class="mnc-filters" id="mnc-filters">
      <button class="mnc-filter active" data-cat="all">All</button>
      <button class="mnc-filter" data-cat="tops">Tops</button>
      <button class="mnc-filter" data-cat="bottoms">Bottoms</button>
      <button class="mnc-filter" data-cat="outerwear">Outerwear</button>
      <button class="mnc-filter" data-cat="footwear">Footwear</button>
      <button class="mnc-filter" data-cat="accessories">Accessories</button>
      <button class="mnc-filter" data-cat="watches">Watches</button>
      <button class="mnc-filter" data-cat="ethnic">Ethnic</button>
      <button class="mnc-filter" data-cat="dresses">Dresses</button>
    </div>
  </div>

  <!-- Items Grid -->
  <div class="mnc-grid-wrap">
    <div class="mnc-grid" id="mnc-grid">
      <div class="mnc-empty" id="mnc-empty" style="display:none">
        <span class="mnc-empty-icon">&#128247;</span>
        <p class="mnc-empty-title">Your closet is empty</p>
        <p class="mnc-empty-sub">Add your first item using the options below</p>
      </div>
    </div>
  </div>

  <!-- Add Clothes Section -->
  <div class="mnc-add-section">
    <div class="mnc-add-header">
      <p class="mnc-add-eyebrow">EXPAND YOUR WARDROBE</p>
      <h2 class="mnc-add-title">Add More Clothes</h2>
      <p class="mnc-add-sub">Choose how you want to digitise your wardrobe.</p>
    </div>

    <div class="mnc-add-cards">

      <!-- Option 1: Photo Upload -->
      <div class="mnc-add-card mnc-card-photo" id="mnc-card-photo">
        <div class="mnc-card-glow mnc-glow-green"></div>
        <div class="mnc-card-inner">
          <div class="mnc-card-icon">&#128247;</div>
          <h3 class="mnc-card-title">Upload a Photo</h3>
          <p class="mnc-card-sub">We will auto-detect your clothes from the image</p>
          <button class="mnc-btn mnc-btn-primary" id="mnc-snap-btn">Choose Photo</button>
          <input type="file" id="mnc-photo-input" accept="image/*" style="display:none" multiple>
          <div class="mnc-scan-ui" id="mnc-scan-ui" style="display:none">
            <div class="mnc-scan-wrap">
              <img class="mnc-scan-img" id="mnc-preview-img" alt="Uploaded"/>
              <div class="mnc-scan-anim">
                <div class="mnc-scan-line"></div>
                <div class="mnc-scan-corner mnc-sc-tl"></div>
                <div class="mnc-scan-corner mnc-sc-tr"></div>
                <div class="mnc-scan-corner mnc-sc-bl"></div>
                <div class="mnc-scan-corner mnc-sc-br"></div>
              </div>
            </div>
            <p class="mnc-scan-status" id="mnc-scan-status">&#128269; Detecting clothes&hellip;</p>
            <div class="mnc-detected" id="mnc-detected-items"></div>
            <button class="mnc-btn mnc-btn-primary" id="mnc-save-detected" style="display:none">&#10003; Save to Closet</button>
            <button class="mnc-btn mnc-btn-ghost" id="mnc-retake-btn">&#8635; Choose different photo</button>
          </div>
        </div>
      </div>

      <!-- Option 2: Ghost Mode -->
      <div class="mnc-add-card mnc-card-ghost" id="mnc-card-ghost">
        <div class="mnc-card-glow mnc-glow-purple"></div>
        <div class="mnc-card-inner">
          <div class="mnc-card-icon">&#128123;</div>
          <h3 class="mnc-card-title">Ghost Mode</h3>
          <p class="mnc-card-sub">Select your clothes — pick from popular options or type your own</p>
          <button type="button" class="mnc-btn mnc-btn-ghost-outline" id="mnc-ghost-btn">Enter Ghost Mode</button>

          <!-- Ghost Form -->
          <div class="mnc-ghost-form" id="mnc-ghost-form" style="display:none">

            <!-- Step 1: Category -->
            <div class="mnc-field">
              <label class="mnc-lbl">1. Choose Category</label>
              <div class="mnc-cat-pills" id="mnc-cat-pills">
                <button type="button" class="mnc-cat-pill" data-cat="tops">&#128085; Tops</button>
                <button type="button" class="mnc-cat-pill" data-cat="bottoms">&#128086; Bottoms</button>
                <button type="button" class="mnc-cat-pill" data-cat="outerwear">&#129693; Outerwear</button>
                <button type="button" class="mnc-cat-pill" data-cat="footwear">&#128097; Footwear</button>
                <button type="button" class="mnc-cat-pill" data-cat="accessories">&#128092; Accessories</button>
                <button type="button" class="mnc-cat-pill" data-cat="watches">⌚ Watches</button>
                <button type="button" class="mnc-cat-pill" data-cat="ethnic">&#129399; Ethnic</button>
                <button type="button" class="mnc-cat-pill" data-cat="dresses">&#128247; Dresses</button>
                <button type="button" class="mnc-cat-pill" data-cat="activewear">&#127947; Activewear</button>
              </div>
            </div>

            <!-- Step 2: Item tiles (shown after category selected) -->
            <div class="mnc-field" id="mnc-items-field" style="display:none">
              <label class="mnc-lbl">2. Select Items <span class="mnc-lbl-hint">(tap multiple to add all)</span></label>
              <div class="mnc-item-tiles" id="mnc-item-tiles"></div>
              <input class="mnc-input" id="mnc-ghost-custom" type="text" placeholder="Or type a custom item name&hellip;" autocomplete="off" style="margin-top:10px"/>
            </div>

            <!-- Selected items preview -->
            <div class="mnc-field" id="mnc-selected-field" style="display:none">
              <label class="mnc-lbl">3. Selected Items</label>
              <div class="mnc-selected-pills" id="mnc-selected-pills"></div>
            </div>

            <button type="button" class="mnc-btn mnc-btn-primary" id="mnc-ghost-save" style="display:none">Add to My Closet &#10003;</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>


<style>
/* ── MY NARRATIVE DIGITAL CLOSET – Dark Luxury Theme ────── */
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800;900&display=swap');
:root {
  --mnc-bg:#000; --mnc-surface:#0f0f0f; --mnc-surface2:#1a1a1a;
  --mnc-border:rgba(255,255,255,0.08); --mnc-green:#7ed957;
  --mnc-green-dim:rgba(126,217,87,0.15); --mnc-purple:#a855f7;
  --mnc-text:#f4f4f4; --mnc-muted:rgba(244,244,244,0.5);
  --mnc-font:'Montserrat',-apple-system,sans-serif;
}
.mnc-page { background:var(--mnc-bg); color:var(--mnc-text); font-family:var(--mnc-font); min-height:100vh; padding-bottom:80px; }

/* Hero */
.mnc-hero { background:linear-gradient(135deg,#050505 0%,#0d1a0d 50%,#050505 100%); border-bottom:1px solid var(--mnc-border); padding:60px 24px 48px; text-align:center; position:relative; overflow:hidden; }
.mnc-hero::before { content:''; position:absolute; top:-60px; left:50%; transform:translateX(-50%); width:400px; height:400px; background:radial-gradient(circle,rgba(126,217,87,0.08) 0%,transparent 70%); pointer-events:none; }
.mnc-hero-inner { position:relative; z-index:1; max-width:680px; margin:0 auto; }
.mnc-hero-eyebrow { font-size:11px; font-weight:800; letter-spacing:0.25em; color:var(--mnc-green); text-transform:uppercase; margin:0 0 16px; }
.mnc-hero-title { font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.03em; margin:0 0 12px; background:linear-gradient(135deg,#fff 0%,rgba(255,255,255,0.7) 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.mnc-hero-sub { font-size:15px; color:var(--mnc-muted); margin:0 0 32px; line-height:1.6; }
.mnc-stats-row { display:inline-flex; align-items:center; background:rgba(255,255,255,0.04); border:1px solid var(--mnc-border); border-radius:100px; padding:12px 28px; gap:20px; }
.mnc-stat { text-align:center; }
.mnc-stat-num { display:block; font-size:22px; font-weight:800; color:var(--mnc-green); line-height:1; }
.mnc-stat-lbl { display:block; font-size:10px; font-weight:600; color:var(--mnc-muted); text-transform:uppercase; letter-spacing:0.1em; margin-top:2px; }
.mnc-stat-div { width:1px; height:32px; background:var(--mnc-border); }

/* Filters */
.mnc-filters-wrap { border-bottom:1px solid var(--mnc-border); background:var(--mnc-surface); padding:0 24px; overflow-x:auto; }
.mnc-filters { display:flex; gap:4px; padding:12px 0; min-width:max-content; }
.mnc-filter { padding:7px 18px; border-radius:100px; border:1px solid transparent; background:transparent; font-size:12px; font-weight:700; font-family:var(--mnc-font); color:var(--mnc-muted); cursor:pointer; transition:all 0.2s; white-space:nowrap; text-transform:uppercase; letter-spacing:0.05em; }
.mnc-filter:hover { color:var(--mnc-text); border-color:var(--mnc-border); }
.mnc-filter.active { background:var(--mnc-green-dim); border-color:var(--mnc-green); color:var(--mnc-green); }

/* Grid */
.mnc-grid-wrap { max-width:760px; margin:0 auto; padding:28px 20px; }
.mnc-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; min-height:60px; }
.mnc-empty { grid-column:1/-1; text-align:center; padding:48px 20px; color:var(--mnc-muted); }
.mnc-empty-icon { font-size:48px; display:block; margin-bottom:10px; }
.mnc-empty-title { font-size:15px; font-weight:700; color:var(--mnc-text); margin:0 0 6px; }
.mnc-empty-sub { font-size:12px; margin:0; }
.mnc-item-card { border-radius:12px; overflow:hidden; border:1px solid var(--mnc-border); background:var(--mnc-surface); transition:transform 0.2s,border-color 0.2s,box-shadow 0.2s; position:relative; cursor:pointer; animation:mncPop 0.3s ease; }
.mnc-item-card:hover { transform:translateY(-3px); border-color:rgba(126,217,87,0.3); box-shadow:0 10px 24px rgba(0,0,0,0.42); }
@keyframes mncPop { from{opacity:0;transform:scale(0.96)} to{opacity:1;transform:scale(1)} }
.mnc-item-img { width:100%; aspect-ratio:1/1.12; object-fit:cover; background:var(--mnc-surface2); display:block; }
.mnc-item-body { padding:9px 10px 12px; }
.mnc-item-cat { display:inline-block; font-size:8px; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; padding:2px 7px; border-radius:100px; background:var(--mnc-green-dim); color:var(--mnc-green); margin-bottom:5px; }
.mnc-item-label { font-size:11px; font-weight:700; color:var(--mnc-text); margin:0 0 3px; line-height:1.25; }
.mnc-item-meta { font-size:10px; color:var(--mnc-muted); margin:0; }
.mnc-item-del { position:absolute; top:7px; right:7px; width:24px; height:24px; border-radius:50%; background:rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.1); color:rgba(255,255,255,0.7); font-size:13px; cursor:pointer; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity 0.2s; }
.mnc-item-card:hover .mnc-item-del { opacity:1; }
@media (max-width: 520px) { .mnc-grid-wrap { padding:22px 14px; } .mnc-grid { gap:10px; } }

/* Add Section */
.mnc-add-section { max-width:1200px; margin:0 auto; padding:48px 24px 60px; border-top:1px solid var(--mnc-border); }
.mnc-add-header { text-align:center; margin-bottom:36px; }
.mnc-add-eyebrow { font-size:11px; font-weight:800; letter-spacing:0.25em; color:var(--mnc-green); text-transform:uppercase; margin:0 0 10px; }
.mnc-add-title { font-size:28px; font-weight:900; letter-spacing:-0.02em; margin:0 0 8px; }
.mnc-add-sub { font-size:14px; color:var(--mnc-muted); margin:0; }
.mnc-add-cards { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
@media (max-width:680px) { .mnc-add-cards { grid-template-columns:1fr; } }
.mnc-add-card { border-radius:16px; border:1px solid var(--mnc-border); background:var(--mnc-surface); position:relative; overflow:hidden; transition:border-color 0.3s; }
.mnc-add-card:hover { border-color:rgba(255,255,255,0.15); }
.mnc-card-inner { padding:32px 28px; position:relative; z-index:1; }
.mnc-card-ghost, .mnc-card-ghost .mnc-card-inner, .mnc-ghost-form, .mnc-field, .mnc-selected-pills, .mnc-sel-pill-wrap { overflow: visible; }
.mnc-card-ghost { z-index: 3; }
.mnc-card-glow { position:absolute; top:-40px; right:-40px; width:200px; height:200px; border-radius:50%; filter:blur(60px); pointer-events:none; opacity:0.4; }
.mnc-glow-green { background:var(--mnc-green); }
.mnc-glow-purple { background:var(--mnc-purple); }
.mnc-card-icon { font-size:36px; margin-bottom:14px; display:block; }
.mnc-card-title { font-size:20px; font-weight:800; margin:0 0 8px; letter-spacing:-0.01em; }
.mnc-card-sub { font-size:13px; color:var(--mnc-muted); margin:0 0 20px; line-height:1.5; }

/* Buttons */
.mnc-btn { display:block; width:100%; padding:11px 20px; border-radius:100px; font-size:13px; font-weight:700; font-family:var(--mnc-font); cursor:pointer; transition:all 0.2s; border:none; margin-top:10px; letter-spacing:0.02em; }
.mnc-btn-primary { background:var(--mnc-green); color:#000; }
.mnc-btn-primary:hover { background:#90e060; transform:translateY(-1px); box-shadow:0 6px 20px rgba(126,217,87,0.3); }
.mnc-btn-ghost { background:transparent; color:var(--mnc-muted); border:1px solid var(--mnc-border); }
.mnc-btn-ghost:hover { border-color:rgba(255,255,255,0.2); color:var(--mnc-text); }
.mnc-btn-ghost-outline { background:transparent; color:var(--mnc-purple); border:1.5px solid var(--mnc-purple); }
.mnc-btn-ghost-outline:hover { background:var(--mnc-purple); color:#fff; }

/* Scan UI */
.mnc-scan-ui { margin-top:16px; }
.mnc-scan-wrap { position:relative; width:100%; max-width:240px; margin:0 auto 14px; border-radius:10px; overflow:hidden; border:1.5px solid var(--mnc-green); }
.mnc-scan-img { width:100%; display:block; max-height:280px; object-fit:cover; }
.mnc-scan-anim { position:absolute; inset:0; pointer-events:none; }
.mnc-scan-line { position:absolute; left:0; right:0; height:2px; background:linear-gradient(90deg,transparent,var(--mnc-green),transparent); box-shadow:0 0 10px rgba(126,217,87,0.8); animation:mncScanLine 1.8s ease-in-out infinite; }
@keyframes mncScanLine { 0%{top:0;opacity:1} 90%{top:100%;opacity:1} 100%{top:100%;opacity:0} }
.mnc-scan-corner { position:absolute; width:14px; height:14px; border-color:var(--mnc-green); border-style:solid; border-width:0; }
.mnc-sc-tl { top:4px;left:4px;border-top-width:2px;border-left-width:2px; }
.mnc-sc-tr { top:4px;right:4px;border-top-width:2px;border-right-width:2px; }
.mnc-sc-bl { bottom:4px;left:4px;border-bottom-width:2px;border-left-width:2px; }
.mnc-sc-br { bottom:4px;right:4px;border-bottom-width:2px;border-right-width:2px; }
.mnc-scan-status { font-size:12px; color:var(--mnc-green); font-weight:700; text-align:center; margin-bottom:10px; }
.mnc-detected { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; margin-bottom:10px; }
.mnc-detected-chip { padding:4px 12px; border-radius:100px; background:var(--mnc-green-dim); border:1px solid var(--mnc-green); color:var(--mnc-green); font-size:11px; font-weight:700; animation:mncPop 0.3s ease; }

/* Ghost Form - new design */
.mnc-ghost-form { margin-top:18px; text-align:left; }
.mnc-field { margin-bottom:16px; }
.mnc-lbl { display:block; font-size:10px; font-weight:800; color:var(--mnc-muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:0.1em; }
.mnc-lbl-hint { font-weight:400; text-transform:none; letter-spacing:0; font-size:9px; color:rgba(244,244,244,0.3); }

/* Category pills */
.mnc-cat-pills { display:flex; flex-wrap:wrap; gap:6px; }
.mnc-cat-pill { padding:7px 14px; border-radius:100px; border:1px solid var(--mnc-border); background:var(--mnc-surface2); font-size:12px; font-weight:700; font-family:var(--mnc-font); color:var(--mnc-muted); cursor:pointer; transition:all 0.15s; }
.mnc-cat-pill:hover { border-color:rgba(255,255,255,0.2); color:var(--mnc-text); }
.mnc-cat-pill.sel { background:var(--mnc-green-dim); border-color:var(--mnc-green); color:var(--mnc-green); }

/* Item tiles - multi-select */
.mnc-item-tiles { display:flex; flex-wrap:wrap; gap:6px; }
.mnc-item-tile { padding:6px 12px; border-radius:100px; border:1px solid var(--mnc-border); background:var(--mnc-surface2); font-size:11px; font-weight:600; font-family:var(--mnc-font); color:var(--mnc-muted); cursor:pointer; transition:all 0.15s; white-space:nowrap; }
.mnc-item-tile:hover { border-color:rgba(255,255,255,0.2); color:var(--mnc-text); }
.mnc-item-tile.sel { background:var(--mnc-green-dim); border-color:var(--mnc-green); color:var(--mnc-green); }

/* Selected pills with brand extension */
.mnc-selected-pills { display:flex; flex-wrap:wrap; gap:8px; }
.mnc-sel-pill-wrap { position:relative; display:inline-block; }
.mnc-sel-pill { display:inline-flex; align-items:center; gap:0; border-radius:100px; border:1px solid var(--mnc-green); background:var(--mnc-green-dim); overflow:hidden; }
.mnc-sel-pill-name { padding:6px 10px 6px 12px; font-size:12px; font-weight:700; color:var(--mnc-green); font-family:var(--mnc-font); white-space:nowrap; }
.mnc-sel-pill-brand-btn { display:flex; align-items:center; gap:3px; padding:6px 10px; font-size:10px; font-weight:800; color:var(--mnc-green); cursor:pointer; border-left:1px solid rgba(126,217,87,0.3); background:transparent; border-top:none; border-right:none; border-bottom:none; font-family:var(--mnc-font); transition:background 0.15s; }
.mnc-sel-pill-brand-btn:hover { background:rgba(126,217,87,0.1); }
.mnc-sel-pill-remove { display:flex; align-items:center; padding:6px 10px 6px 4px; font-size:14px; color:rgba(126,217,87,0.6); cursor:pointer; background:transparent; border:none; font-family:var(--mnc-font); line-height:1; }
.mnc-sel-pill-remove:hover { color:var(--mnc-green); }

/* Inline brand dropdown */
.mnc-brand-menu { position:absolute; top:calc(100% + 8px); left:0; z-index:20; background:#1a1a1a; border:1px solid rgba(126,217,87,0.3); border-radius:12px; padding:8px 0; min-width:190px; box-shadow:0 16px 40px rgba(0,0,0,0.6); }
.mnc-brand-menu-hdr { padding:6px 12px; font-size:10px; font-weight:800; color:#7ed957; text-transform:uppercase; letter-spacing:0.1em; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:4px; }
.mnc-brand-item { padding:7px 16px; font-size:12px; font-weight:600; color:var(--mnc-muted); cursor:pointer; font-family:var(--mnc-font); transition:all 0.1s; display:block; width:100%; text-align:left; background:transparent; border:none; }
.mnc-brand-item:hover { background:var(--mnc-green-dim); color:var(--mnc-green); }
.mnc-brand-custom-wrap { padding:6px 8px; border-top:1px solid rgba(255,255,255,0.06); margin-top:4px; }
.mnc-brand-custom { width:100%; padding:6px 10px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; color:#f4f4f4; font-size:12px; outline:none; box-sizing:border-box; font-family:inherit; }

/* Input */
.mnc-input { width:100%; padding:10px 14px; border:1px solid var(--mnc-border); border-radius:8px; background:var(--mnc-surface2); color:var(--mnc-text); font-size:13px; font-family:var(--mnc-font); outline:none; transition:border-color 0.2s; box-sizing:border-box; }
.mnc-input::placeholder { color:var(--mnc-muted); }
.mnc-input:focus { border-color:var(--mnc-green); }
</style>

<script>
(function() {
  'use strict';
  var $ = function(id){ return document.getElementById(id); };
  var PH = 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=300&h=400&fit=crop';
  var CAT = {tops:'Tops',bottoms:'Bottoms',outerwear:'Outerwear',footwear:'Footwear',accessories:'Accessories',watches:'Watches',ethnic:'Ethnic',dresses:'Dresses',activewear:'Activewear',other:'Other'};
  var CLOTH_API = 'https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/cloth_detection';

  // Popular items per category (format: "Color Name")
  var ITEMS = {
    tops:        ['White Oversized Tee','Black T-Shirt','Grey Striped Shirt','Navy Blue Polo','White Linen Shirt','Black Crop Top','Sky Blue Oxford Shirt','Graphic Print Tee','Olive Henley','Maroon Turtleneck','Pink Boxy Shirt','Beige Knit Top'],

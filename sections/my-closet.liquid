  function render() {
    var grid=$('mnc-grid'),empty=$('mnc-empty');
    if(!grid)return;
    var filtered=filter==='all'?closetItems:closetItems.filter(function(it){return(it.category||classify(it.label))===filter;});
    var cats={};
    closetItems.forEach(function(it){cats[it.category||classify(it.label)]=1;});
    if($('mnc-total-count'))$('mnc-total-count').textContent=closetItems.length;
    if($('mnc-cat-count'))$('mnc-cat-count').textContent=Object.keys(cats).length;
    Array.from(grid.querySelectorAll('.mnc-item-card')).forEach(function(el){el.remove();});
    if(!filtered.length){if(empty)empty.style.display='block';return;}
    if(empty)empty.style.display='none';
    filtered.forEach(function(item){
      var cat=item.category||classify(item.label);
      var card=document.createElement('div');
      card.className='mnc-item-card';
      var realIdx=closetItems.indexOf(item);
      var artSrc = renderVectorArt(item, cat);
      card.innerHTML='<img class="mnc-item-img" src="'+artSrc+'" alt="'+item.label+'">'+
        '<div class="mnc-item-body"><span class="mnc-item-cat">'+(CAT[cat]||cat)+'</span>'+
        '<p class="mnc-item-label">'+item.label+'</p>'+
        (item.brand?'<p class="mnc-item-meta">'+item.brand+'</p>':'')+
        '</div><button class="mnc-item-del" data-idx="'+realIdx+'">&#215;</button>';
      grid.appendChild(card);
    });
    grid.querySelectorAll('.mnc-item-del').forEach(function(btn){
      btn.addEventListener('click',function(e){
        e.stopPropagation();
        closetItems.splice(parseInt(btn.dataset.idx),1);
        save();render();
      });
    });
  }

  // ── Filters ───────────────────────────────────────────────
  function initFilters() {
    document.querySelectorAll('.mnc-filter').forEach(function(btn){
      btn.addEventListener('click',function(e){
        e.preventDefault();
        document.querySelectorAll('.mnc-filter').forEach(function(b){b.classList.remove('active');});
        btn.classList.add('active');filter=btn.dataset.cat;render();
      });
    });
  }

  // ── Photo Upload + Real API ───────────────────────────────
  function initPhoto() {
    var snapBtn=$('mnc-snap-btn'),inp=$('mnc-photo-input'),scanUI=$('mnc-scan-ui');
    var prev=$('mnc-preview-img'),status=$('mnc-scan-status'),detEl=$('mnc-detected-items');
    var saveBtn=$('mnc-save-detected'),retake=$('mnc-retake-btn');
    if(!snapBtn)return;
    snapBtn.addEventListener('click',function(){inp&&inp.click();});
    if(retake)retake.addEventListener('click',function(){
      scanUI.style.display='none';snapBtn.style.display='';detected=[];if(inp)inp.value='';
    });
    if(inp)inp.addEventListener('change',function(e){
      var f=e.target.files[0];if(!f)return;
      var r=new FileReader();
      r.onload=function(ev){
        prev.src=ev.target.result;snapBtn.style.display='none';scanUI.style.display='block';
        detected=[];if(detEl)detEl.innerHTML='';if(saveBtn)saveBtn.style.display='none';
        if(status)status.textContent='\ud83d\udd0d Analysing with AI\u2026';
        runScan(ev.target.result,status,detEl,saveBtn);
      };
      r.readAsDataURL(f);
    });
    if(saveBtn)saveBtn.addEventListener('click',function(){
      detected.forEach(function(it){if(!closetItems.find(function(c){return c.label===it.label;}))closetItems.push(it);});
      save();render();
      scanUI.style.display='none';snapBtn.style.display='';if(inp)inp.value='';detected=[];
    });
  }

  function runScan(src,statusEl,detEl,saveBtn) {
    fetch(CLOTH_API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({image:src})})
    .then(function(r){return r.json();})
    .then(function(data){
      var apiItems=data.detected_items||[];
      if(!apiItems.length)throw new Error('No items');
      var catMap={'Topwear':'tops','Bottomwear':'bottoms','Outerwear':'outerwear','Footwear':'footwear','Accessory':'accessories','Dress':'dresses'};
      apiItems.forEach(function(item,idx){
        setTimeout(function(){
          var it={label:item.name||'Clothing Item',category:catMap[item.category]||'tops',color:item.color||'',fit:item.fit||'',img:src,source:'photo_upload_ai',added_at:new Date().toISOString()};
          detected.push(it);
          if(detEl){var c=document.createElement('div');c.className='mnc-detected-chip';c.textContent='\ud83d\udc55 '+it.label+(it.color?' \u00b7 '+it.color:'');detEl.appendChild(c);}
          if(statusEl)statusEl.textContent='\ud83d\udd0d Found: '+it.label+'\u2026';
          if(idx===apiItems.length-1){if(statusEl)statusEl.textContent='\u2705 '+detected.length+' detected!';if(saveBtn)saveBtn.style.display='block';}
        },idx*700);
      });
      if(data.person_analysis){try{var id=JSON.parse(localStorage.getItem('mn_identity')||'{}');var pa=data.person_analysis;if(pa.skin_tone)id.skin_mst=pa.skin_tone;if(pa.body_build)id.body_type=pa.body_build;localStorage.setItem('mn_identity',JSON.stringify(id));window.MN_IDENTITY=id;}catch(e){}}
    })
    .catch(function(){
      var MOCK=[{label:'Top / T-Shirt',category:'tops'},{label:'Denim Jeans',category:'bottoms'},{label:'Sneakers',category:'footwear'}];
      var i=0;var iv=setInterval(function(){
        if(i>=2){clearInterval(iv);if(statusEl)statusEl.textContent='\u2705 '+detected.length+' detected!';if(saveBtn)saveBtn.style.display='block';return;}
        var it=Object.assign({},MOCK[i],{img:src,source:'photo_upload',added_at:new Date().toISOString()});
        detected.push(it);
        if(detEl){var c=document.createElement('div');c.className='mnc-detected-chip';c.textContent='\ud83d\udc55 '+it.label;detEl.appendChild(c);}
        if(statusEl)statusEl.textContent='\ud83d\udd0d Found: '+it.label+'\u2026';
        i++;
      },1000);
    });
  }

  // ── Ghost Mode ────────────────────────────────────────────
  function initGhost() {
    var btn=$('mnc-ghost-btn'),form=$('mnc-ghost-form'),saveBtn=$('mnc-ghost-save');
    if(!btn)return;
    btn.addEventListener('click',function(){
      form.style.display=form.style.display==='none'?'block':'none';
      btn.textContent=form.style.display==='none'?'Enter Ghost Mode':'\u2715 Cancel';
      if(form.style.display==='none'){resetGhost();}
    });

    // Category pill selection
    document.querySelectorAll('.mnc-cat-pill').forEach(function(p){
      p.addEventListener('click',function(){
        document.querySelectorAll('.mnc-cat-pill').forEach(function(x){x.classList.remove('sel');});
        p.classList.add('sel');
        ghost.cat=p.dataset.cat;
        ghost.selectedItems=[];
        renderItemTiles(ghost.cat);
        renderSelectedPills();
        var f=$('mnc-items-field');if(f)f.style.display='block';
        if(saveBtn)saveBtn.style.display='none';
      });
    });

    // Custom input
    var customInp=$('mnc-ghost-custom');
    if(customInp)customInp.addEventListener('keydown',function(e){
      if(e.key==='Enter'&&this.value.trim()){
        addSelectedItem(this.value.trim());
        this.value='';
      }
    });

    // Save
    if(saveBtn)saveBtn.addEventListener('click',function(){
      if(!ghost.selectedItems.length){alert('Please select at least one item.');return;}
      ghost.selectedItems.forEach(function(it){
        var newItem={label:it.brand?it.label+' \u00b7 '+it.brand:it.label,category:ghost.cat,brand:it.brand||'',source:'ghost_mode',added_at:new Date().toISOString(),img:''};
        if(!closetItems.find(function(c){return c.label===newItem.label;}))closetItems.push(newItem);
      });
      save();render();
      form.style.display='none';btn.textContent='Enter Ghost Mode';
      resetGhost();
    });

    // Close inline brand menu on outside click
    document.addEventListener('click',function(){
      if(activeBrandPill!==null){
        activeBrandPill=null;
        renderSelectedPills();
      }
    });
  }

  function renderItemTiles(cat) {
    var container=$('mnc-item-tiles');
    if(!container)return;
    container.innerHTML='';
    var list=ITEMS[cat]||[];
    list.forEach(function(name){
      var tile=document.createElement('button');
      tile.type='button';
      tile.className='mnc-item-tile';
      tile.textContent=name;
      var isSelected=ghost.selectedItems.find(function(it){return it.label===name;});
      if(isSelected)tile.classList.add('sel');
      tile.addEventListener('click',function(e){
        e.preventDefault();
        var idx=ghost.selectedItems.findIndex(function(it){return it.label===name;});
        if(idx>-1){ghost.selectedItems.splice(idx,1);tile.classList.remove('sel');}
        else{ghost.selectedItems.push({label:name,brand:''});tile.classList.add('sel');}
        renderSelectedPills();
        if($('mnc-ghost-save'))$('mnc-ghost-save').style.display=ghost.selectedItems.length?'block':'none';
      });
      container.appendChild(tile);
    });
  }

  function addSelectedItem(name) {
    if(!ghost.selectedItems.find(function(it){return it.label===name;})){
      ghost.selectedItems.push({label:name,brand:''});
      renderSelectedPills();
      renderItemTiles(ghost.cat);
      if($('mnc-ghost-save'))$('mnc-ghost-save').style.display='block';
    }
  }

  function renderSelectedPills() {
    var container=$('mnc-selected-pills');
    var field=$('mnc-selected-field');
    if(!container)return;
    container.innerHTML='';
    if(!ghost.selectedItems.length){if(field)field.style.display='none';return;}
    if(field)field.style.display='block';
    ghost.selectedItems.forEach(function(it,idx){
      var wrap=document.createElement('div');
      wrap.className='mnc-sel-pill-wrap';
      wrap.addEventListener('click', function(e){ e.stopPropagation(); });

      var pill=document.createElement('div');
      pill.className='mnc-sel-pill';
      var nameSpan=document.createElement('span');
      nameSpan.className='mnc-sel-pill-name';
      nameSpan.textContent=it.label;

      var brandBtn=document.createElement('button');
      brandBtn.type='button';
      brandBtn.className='mnc-sel-pill-brand-btn';
      brandBtn.innerHTML=(it.brand?it.brand:'BRAND')+' &#9660;';
      brandBtn.addEventListener('click',function(e){
        e.preventDefault();
        e.stopPropagation();
        activeBrandPill = (activeBrandPill===idx ? null : idx);
        renderSelectedPills();
      });

      var removeBtn=document.createElement('button');
      removeBtn.type='button';
      removeBtn.className='mnc-sel-pill-remove';
      removeBtn.innerHTML='&#215;';
      removeBtn.addEventListener('click',function(e){
        e.preventDefault();
        e.stopPropagation();
        if(activeBrandPill===idx) activeBrandPill=null;
        ghost.selectedItems.splice(idx,1);
        renderSelectedPills();
        renderItemTiles(ghost.cat);
        if($('mnc-ghost-save'))$('mnc-ghost-save').style.display=ghost.selectedItems.length?'block':'none';
      });

      pill.appendChild(nameSpan);
      pill.appendChild(brandBtn);
      pill.appendChild(removeBtn);
      wrap.appendChild(pill);

      if(activeBrandPill===idx){
        wrap.style.zIndex='25';
        var menu=document.createElement('div');
        menu.className='mnc-brand-menu';

        var hdr=document.createElement('div');
        hdr.className='mnc-brand-menu-hdr';
        hdr.textContent='Select Brand';
        menu.appendChild(hdr);

        var selectedBrand = it.brand || '';
        TOP_BRANDS.forEach(function(brand){
          var btn=document.createElement('button');
          btn.type='button';
          btn.className='mnc-brand-item';
          btn.innerHTML=(selectedBrand===brand?'&#10003; ':'') + brand;
          btn.addEventListener('click',function(e){
            e.preventDefault();
            e.stopPropagation();
            ghost.selectedItems[idx].brand=brand;
            activeBrandPill=null;
            renderSelectedPills();
          });
          menu.appendChild(btn);
        });

        var customWrap=document.createElement('div');
        customWrap.className='mnc-brand-custom-wrap';
        var customInp=document.createElement('input');
        customInp.className='mnc-brand-custom';
        customInp.type='text';
        customInp.placeholder='Type brand name…';
        customInp.value=selectedBrand;
        customInp.addEventListener('click', function(e){ e.stopPropagation(); });
        customInp.addEventListener('input', function(){ ghost.selectedItems[idx].brand=this.value; });
        customInp.addEventListener('keydown', function(e){
          if(e.key==='Enter'){
            e.preventDefault();
            activeBrandPill=null;
            renderSelectedPills();
          }
        });
        customInp.addEventListener('blur', function(){
          setTimeout(function(){
            if(activeBrandPill===idx){
              activeBrandPill=null;
              renderSelectedPills();
            }
          }, 120);
        });
        customWrap.appendChild(customInp);
        menu.appendChild(customWrap);
        wrap.appendChild(menu);
      }

      container.appendChild(wrap);
    });
  }

  function resetGhost() {
    ghost={cat:'',selectedItems:[]};
    document.querySelectorAll('.mnc-cat-pill').forEach(function(p){p.classList.remove('sel');});
    var f=$('mnc-items-field');if(f)f.style.display='none';
    var sf=$('mnc-selected-field');if(sf)sf.style.display='none';
    var sb=$('mnc-ghost-save');if(sb)sb.style.display='none';
    var tiles=$('mnc-item-tiles');if(tiles)tiles.innerHTML='';
    var pills=$('mnc-selected-pills');if(pills)pills.innerHTML='';
    var ci=$('mnc-ghost-custom');if(ci)ci.value='';
  }

  // Auto ghost mode via hash
  if(window.location.hash==='#ghost-mode'){
    window.addEventListener('DOMContentLoaded',function(){
      var f=$('mnc-ghost-form'),b=$('mnc-ghost-btn');
      if(f&&b){f.style.display='block';b.textContent='\u2715 Cancel';}
      setTimeout(function(){var el=$('mnc-card-ghost');if(el)el.scrollIntoView({behavior:'smooth',block:'center'});},300);
    });
  }

  window.addEventListener('mn-identity-updated',load);
  window.addEventListener('storage',function(e){if(e.key==='mn_identity')load();});
  document.addEventListener('DOMContentLoaded',function(){load();initFilters();initPhoto();initGhost();});
})();
</script>


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  /* ─── WRAPPER ─── */
  .narrative-section { width: 100%; overflow: hidden; background: #000; padding: 0; margin: 0; }
  .narrative-wrapper {
    width: 100%; min-height: 100vh; position: relative; background: #000;
    font-family: 'Montserrat', sans-serif !important;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .narrative-wrapper * { margin:0; padding:0; box-sizing:border-box; }

  /* ─── BACKGROUND ─── */
  .cosmic-background {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(ellipse at 20% 50%, rgba(0, 255, 150, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 50%, rgba(0, 255, 150, 0.04) 0%, transparent 50%), #000;
    z-index: 0; pointer-events: none;
  }
  canvas#stars { position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; transition: filter 0.5s ease; }

  /* ─── CONTAINER ─── */
  .cta-container {
    position: relative; z-index: 10; max-width: 1300px; width: 90%; padding: 60px;
    background: rgba(10, 10, 10, 0.6); border-radius: 32px;
    border: 1px solid rgba(57, 165, 150, 0.3);
    box-shadow: 0 0 80px rgba(57, 165, 150, 0.15), inset 0 0 60px rgba(57, 165, 150, 0.05);
    backdrop-filter: blur(12px);
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
    align-items: center; overflow: hidden;
  }

  /* ─── ANIMATION STAGE ─── */
  .left-content {
    position: relative; height: 450px; display: flex;
    flex-direction: column; justify-content: center; align-items: center;
    border-radius: 24px; background: rgba(0,0,0,0.2); overflow: hidden;
  }
  .anim-layer { position: absolute; top:0; left:0; width:100%; height:100%; }
  canvas#debris { z-index:2; pointer-events:none; }
  svg#threads { z-index:1; pointer-events:none; width: 100%; height: 100%; }
  
  #focus-mask {
    background: radial-gradient(circle at 50% 50%, #000 0%, rgba(0,0,0,0.95) 30%, rgba(0,0,0,0.5) 60%, transparent 80%);
    opacity: 0; pointer-events: none; z-index: 4; transition: opacity 0.5s ease;
  }
  #flash-overlay {
    background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 60%);
    opacity: 0; pointer-events: none; z-index: 7; mix-blend-mode: screen;
  }
  svg#threads line { stroke: rgba(255,255,255,0.5); stroke-width: 1; stroke-linecap: round; opacity: 0; transition: filter 0.5s ease; }

  /* ─── ELEMENTS ─── */
  .node {
    position:absolute; width:28px; height:28px; border-radius:50%;
    background: radial-gradient(circle at 40% 35%, #fff 0%, #ccc 60%, #aaa 100%);
    box-shadow: 0 0 15px rgba(255,255,255,0.4);
    transform: translate(-50%, -50%); opacity:0; z-index:3;
    transition: filter 0.5s ease;
  }
  .node-label {
    position:absolute; color: rgba(255,255,255,0.8);
    font-family: 'Montserrat', sans-serif !important;
    font-size:11px !important; font-weight:500 !important; letter-spacing:0.5px;
    opacity:0; z-index:3; pointer-events: none;
    width: 80px; white-space: normal; text-align: center; line-height: 1.3;
    transition: filter 0.5s ease;
  }
  .hero-dot {
    position:absolute; width:72px; height:72px; border-radius:50%;
    background: radial-gradient(circle at 50% 50%, #fff 0%, #39A596 40%, #2d857a 100%);
    box-shadow: inset 0 0 20px #fff, 0 0 30px #39A596, 0 0 60px rgba(57,165,150,0.6);
    transform: translate(-50%, -50%); z-index:5;
  }
  .hero-dot.alive { animation: heartbeat 4s ease-in-out infinite; }
  @keyframes heartbeat {
    0%, 100% { transform: translate(-50%, -50%) scale(1.12); box-shadow: inset 0 0 20px #fff, 0 0 30px #39A596, 0 0 60px rgba(57,165,150,0.6); }
    50% { transform: translate(-50%, -50%) scale(1.18); box-shadow: inset 0 0 30px #fff, 0 0 50px #39A596, 0 0 90px rgba(57,165,150,0.8); }
  }
  .particle {
    position:absolute; width:3px; height:3px; border-radius:50%;
    background: #fff; box-shadow: 0 0 4px rgba(57,165,150,0.8);
    transform: translate(-50%,-50%); opacity:0; z-index:4; pointer-events: none;
  }

  /* ─── TEXT STYLES ─── */
  .text-mid {
    position: absolute;
    color: #39A596 !important; 
    font-family: 'Montserrat', sans-serif !important;
    font-size: 20px !important; font-weight: 800 !important; 
    text-transform: uppercase !important; letter-spacing: 1.5px !important;
    text-align: center !important; white-space: nowrap !important; line-height: 1.4 !important;
    text-shadow: 0 0 10px rgba(57, 165, 150, 0.8), 0 0 20px rgba(57, 165, 150, 0.6), 0 0 40px rgba(57, 165, 150, 0.4) !important;
    transform-origin: center bottom; transform: translate(-50%, -100%);
    opacity: 0; z-index: 99; pointer-events: none; will-change: transform, opacity, filter;
  }
  .text-final {
    position:absolute; bottom:15%; left:50%;
    transform:translateX(-50%); text-align:center; z-index:6;
    display: flex; flex-direction: column; gap: 12px;
    pointer-events: none; width: 100%;
  }
  .text-final .line1 { 
    font-family: 'Montserrat', sans-serif !important;
    font-size: 22px !important; font-weight: 700 !important; 
    text-transform: uppercase !important; color: #fff !important; 
    background: linear-gradient(to bottom, #ffffff 30%, #a8dcd5 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin: 0; opacity: 0; text-shadow: 0 0 30px rgba(57,165,150,0.5);
    will-change: letter-spacing, opacity, filter, transform;
  }
  .text-final .line2 { 
    font-family: 'Montserrat', sans-serif !important;
    font-size: 14px !important; font-weight: 400 !important; 
    letter-spacing: 1px !important; line-height: 1.5 !important; 
    color: rgba(255,255,255,0.7) !important; opacity: 0; filter: blur(10px);
  }

  /* ─── STATIC CONTENT ─── */
  .right-content { display: flex; flex-direction: column; gap: 30px; justify-content: center; }
  .right-content h2 {
    font-family: 'Montserrat', sans-serif !important;
    font-size: 3.5rem !important; font-weight: 600 !important; 
    color: #fff; line-height: 1.1; letter-spacing: -1px;
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.8) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .right-content p {
    font-family: 'Montserrat', sans-serif !important;
    font-size: 1.2rem !important; font-weight: 300 !important;
    color: rgba(255, 255, 255, 0.7); line-height: 1.6; margin-bottom: 10px; 
  }
  .cta-button {
    display: inline-flex; align-items: center; gap: 15px; padding: 22px 50px;
    background: rgba(57, 165, 150, 0.1); border: 1px solid rgba(57, 165, 150, 0.6);
    border-radius: 50px; color: #fff; text-decoration: none; cursor: pointer; transition: all 0.3s ease;
    box-shadow: 0 0 30px rgba(57, 165, 150, 0.2); position: relative; overflow: hidden; width: fit-content;
    font-family: 'Montserrat', sans-serif !important; font-size: 1.2rem !important; font-weight: 600 !important;
  }
  .cta-button::before {
    content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0;
    background: rgba(57, 165, 150, 0.9); border-radius: 50%;
    transform: translate(-50%, -50%); transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1), height 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 0;
  }
  .cta-button:hover::before { width: 450px; height: 450px; }
  .cta-button span { position: relative; z-index: 1; }
  .cta-button:hover { transform: translateY(-3px); box-shadow: 0 10px 40px rgba(57, 165, 150, 0.4); border-color: rgba(57, 165, 150, 1); }
  .arrow { font-size: 1.4rem; transition: transform 0.3s ease; }
  .cta-button:hover .arrow { transform: translateX(6px); }
  .time-note { 
    font-family: 'Montserrat', sans-serif !important;
    font-size: 0.9rem !important; font-weight: 400 !important;
    color: rgba(255, 255, 255, 0.4); margin-top: 10px; 
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .cta-container { grid-template-columns: 1fr; gap: 50px; padding: 40px; }
    .left-content { height: 400px; }
    .right-content { align-items: center; text-align: center; }
    .right-content h2 { font-size: 2.8rem !important; }
  }
  
  /* ─── MOBILE OPTIMIZATIONS ─── */
  @media (max-width: 768px) {
    .cta-container { 
        padding: 20px 10px; width: 95%; gap: 30px; 
    }
    .left-content { 
        height: 260px; 
        width: 100%; max-width: 100%;
        overflow: visible; 
    }
    .right-content h2 { font-size: 2.2rem !important; }
    .text-mid { font-size: 16px !important; }
    .text-final .line1 { font-size: 18px !important; }
    .text-final .line2 { font-size: 13px !important; }
    .cta-button { padding: 18px 40px; font-size: 1.1rem !important; }
    
    .hero-dot { width: 48px; height: 48px; }
    .node { width: 16px; height: 16px; } 
    .node-label { font-size: 10px !important; width: 70px; line-height: 1.2; }
  }
</style>

<div class="narrative-section">
  <div class="narrative-wrapper">
    <div class="cosmic-background"></div>
    <canvas id="stars"></canvas>

    <div class="cta-container">
      <div class="left-content" id="animationStage">
        <div id="flash-overlay" class="anim-layer"></div>
        <div id="focus-mask" class="anim-layer"></div>
        
        <canvas id="debris" class="anim-layer"></canvas>
        <svg id="threads" class="anim-layer"></svg>
        <div class="hero-dot"></div>
        
        <div class="text-mid" id="textMid">
          You tried everything<br>
          but still losing yourself
        </div>
        <div class="text-final" id="textFinal">
          <div class="line1">It's time to choose your individuality</div>
          <div class="line2">And walk your own path<br>with an independent mindset</div>
        </div>
      </div>

      <div class="right-content">
        <h2>Design Your<br>Own Narrative</h2>
        <p>Not everything fits into categories.<br>Create something that feels like you.</p>
        <a href="/pages/create-your-design" class="cta-button">
          <span>{{ section.settings.btn_text }}</span>
          <span class="arrow">→</span>
        </a>
        <div class="time-note">Takes less than a minute</div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const LABELS = ['Family Expectations', 'Job Security', 'The Rat Race', "Society's Timeline", 'Fear of Judgment', 'Grades', 'CTC'];
  const NODE_POSITIONS = [
    { x:0.25, y:0.25 }, { x:0.75, y:0.30 }, { x:0.18, y:0.55 },
    { x:0.82, y:0.52 }, { x:0.35, y:0.80 }, { x:0.70, y:0.75 }, { x:0.50, y:0.15 }
  ];

  // 0.8x SPEED (20s)
  const DURATION = 20000; 
  
  const ACT1_START = 500;  
  const ACT1_END = 5000;
  
  const BREAK_TIME = 8750; // Threads Break
  
  const TEXT_START = 6250; 
  const TEXT_END   = 9750; // Text Fades Out
  
  const ACT4_REFORM= 12750;
  const ACT4_END = 15250;
  const ACT5_TEXT1 = 15750;
  const ACT5_TEXT2 = 16500;
  const LOOP_HOLD  = 19250;

  const stage = document.getElementById('animationStage');
  const debrisCanvas = document.getElementById('debris');
  const dCtx = debrisCanvas.getContext('2d');
  const starCanvas = document.getElementById('stars');
  const sCtx = starCanvas.getContext('2d');
  const flashEl = document.getElementById('flash-overlay');
  const maskEl = document.getElementById('focus-mask'); 
  const heroDot = document.querySelector('.hero-dot');
  const svgEl = document.getElementById('threads');

  let starList = [], debrisList = [], nodes = [], labels = [], lines = [];

  function initStars() {
    starCanvas.width = window.innerWidth; starCanvas.height = window.innerHeight; starList = [];
    const count = Math.floor((starCanvas.width * starCanvas.height) / 4000);
    for(let i=0; i<count; i++) starList.push({x: Math.random()*starCanvas.width, y: Math.random()*starCanvas.height, r: Math.random()*1.5, a: Math.random()*0.5 + 0.1});
  }
  function drawStars() {
    sCtx.clearRect(0,0,starCanvas.width,starCanvas.height);
    starList.forEach(s => { sCtx.beginPath(); sCtx.arc(s.x,s.y,s.r,0,Math.PI*2); sCtx.fillStyle = `rgba(255,255,255,${s.a})`; sCtx.fill(); });
  }
  function initStage() {
    const rect = stage.getBoundingClientRect(); debrisCanvas.width = rect.width; debrisCanvas.height = rect.height;
  }
  window.addEventListener('resize', () => { initStars(); drawStars(); initStage(); positionElements(); });
  initStars(); drawStars(); initStage();

  LABELS.forEach((txt) => {
    const nd = document.createElement('div'); nd.className = 'node'; stage.appendChild(nd); nodes.push(nd);
    const lb = document.createElement('div'); lb.className = 'node-label'; lb.textContent = txt; stage.appendChild(lb); labels.push(lb);
    const ln = document.createElementNS('http://www.w3.org/2000/svg','line'); svgEl.appendChild(ln); lines.push(ln);
  });

  const PARTICLE_COUNT = 150;
  const particles = [], particleData = [];
  for(let i=0; i<PARTICLE_COUNT; i++){
    const p = document.createElement('div'); p.className = 'particle'; stage.appendChild(p); particles.push(p);
    const angle = Math.random()*Math.PI*2; const speed = 0.5 + Math.random();
    particleData.push({ vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed, reformAngle: Math.random()*Math.PI*2, reformDist: 400 + Math.random()*300, spiralSpeed: 2 + Math.random()*2 });
  }

  function getStageDimensions() { return { w: stage.clientWidth, h: stage.clientHeight, cx: stage.clientWidth/2, cy: stage.clientHeight/2 }; }

  function positionElements() {
    const { w, h, cx, cy } = getStageDimensions();
    const isMobile = window.innerWidth < 768; 
    
    heroDot.style.left = cx+'px'; heroDot.style.top = cy+'px';

    NODE_POSITIONS.forEach((pos, i) => {
      let relX = pos.x; 
      let relY = pos.y;
      
      if(isMobile) {
          relX = 0.5 + (pos.x - 0.5) * 0.7; // Compact Mobile
      } else {
          relX = 0.5 + (pos.x - 0.5) * 1.15; // WIDER DESKTOP SPREAD (15% more)
      }

      const px = relX * w; 
      const py = relY * h;
      
      nodes[i].style.left = px+'px'; nodes[i].style.top = py+'px';
      lines[i].setAttribute('x1', px); lines[i].setAttribute('y1', py); lines[i].setAttribute('x2', cx); lines[i].setAttribute('y2', cy);

      const dx = px - cx; const dy = py - cy; const dist = Math.sqrt(dx*dx + dy*dy) || 1;
      
      const push = isMobile ? 34 : 60; 
      
      const lx = px + (dx/dist)*push; const ly = py + (dy/dist)*push;
      const labelW = labels[i].offsetWidth; const labelH = labels[i].offsetHeight;

      labels[i].style.left = (lx - labelW/2) + 'px';
      labels[i].style.top = (ly - labelH/2) + 'px';
    });
  }
  setTimeout(positionElements, 200); 

  let debrisTriggered = false;
  function spawnDebris() {
    debrisList = []; const { w, h, cx, cy } = getStageDimensions();
    const isMobile = window.innerWidth < 768;

    NODE_POSITIONS.forEach(pos => {
      let relX = pos.x; let relY = pos.y;
      if(isMobile) { relX = 0.5 + (pos.x - 0.5) * 0.7; }
      else { relX = 0.5 + (pos.x - 0.5) * 1.15; } 

      const startX = relX * w; const startY = relY * h; const dx = cx - startX; const dy = cy - startY; const dist = Math.sqrt(dx*dx+dy*dy); 
      
      const segments = 12; 
      for(let j=0; j<segments; j++){
        const t = j/segments;
        debrisList.push({ 
            x: startX + dx*t, 
            y: startY + dy*t, 
            vx: (Math.random()-0.5)*1.5, 
            vy: (Math.random()-0.5)*1.5, 
            len: dist/segments, 
            angle: Math.atan2(dy,dx), 
            rotSpeed: (Math.random()-0.5)*0.2, 
            alpha: 1.0 
        });
      }
    });
  }
  function updateDebris() {
    const { w, h } = getStageDimensions(); dCtx.clearRect(0,0,w,h); if(debrisList.length === 0) return;
    dCtx.strokeStyle = "rgba(255,255,255,0.8)"; dCtx.lineWidth = 2; 
    for(let i=0; i<debrisList.length; i++){
      const p = debrisList[i]; 
      p.x += p.vx; 
      p.y += p.vy; 
      // SLOW GRAVITY
      p.vy += 0.08; 
      p.angle += p.rotSpeed; 
      p.alpha -= 0.008; 
      
      if(p.alpha > 0 && p.y < h + 100) {
        dCtx.beginPath(); dCtx.globalAlpha = p.alpha; const hl = p.len/2;
        const x1 = p.x + Math.cos(p.angle)*-hl; const y1 = p.y + Math.sin(p.angle)*-hl; const x2 = p.x + Math.cos(p.angle)*hl;  const y2 = p.y + Math.sin(p.angle)*hl;
        dCtx.moveTo(x1,y1); dCtx.lineTo(x2,y2); dCtx.stroke();
      }
    }
  }

  const textMid = document.getElementById('textMid');
  const textFinal = document.getElementById('textFinal');
  const line1 = textFinal.querySelector('.line1');
  const line2 = textFinal.querySelector('.line2');
  const BURST_DIST = 150;

  function clamp(v,min,max){ return Math.max(min,Math.min(max,v)); }
  function lerp(a,b,t){ return a + (b-a)*t; }
  function easeOut(t){ return 1 - Math.pow(1-t,3); }
  function easeIn(t){ return t*t*t; }
  function easeInOut(t){ return t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2; }

  const G0 = {i:36,ia:0.55, m:72,ma:0.28, o:110,oa:0.13};
  const GMAX = {i:64,ia:0.95, m:120,ma:0.62, o:180,oa:0.36};
  const GR = {i:44,ia:0.70, m:88,ma:0.40, o:130,oa:0.20};

  function getGlow(g) { return `inset 0 0 20px rgba(255,255,255,0.8), 0 0 ${g.i}px rgba(57,165,150,${g.ia}), 0 0 ${g.m}px rgba(57,165,150,${g.ma}), 0 0 ${g.o}px rgba(57,165,150,${g.oa})`; }
  function interpGlow(a,b,t) { return { i:lerp(a.i,b.i,t), ia:lerp(a.ia,b.ia,t), m:lerp(a.m,b.m,t), ma:lerp(a.ma,b.ma,t), o:lerp(a.o,b.o,t), oa:lerp(a.oa,b.oa,t) }; }

  let startTime = null;
  function tick(now) {
    if(!startTime) startTime = now;
    const elapsed = (now - startTime) % DURATION;
    const { cx, cy } = getStageDimensions();
    const isMobile = window.innerWidth < 768;

    let hScale = 1, hOp = 1, hShadow = '', hDx = 0, hDy = 0, flashOp = 0;
    let maskOp = 0;
    let bgFilter = ''; 

    // 1. CONNECT & BUILD
    if(elapsed < ACT1_END) {
      heroDot.classList.remove('alive');
      const p = clamp((elapsed-ACT1_START)/(ACT1_END-ACT1_START),0,1);
      hShadow = getGlow(interpGlow(G0, GMAX, easeOut(p)));
      hScale = lerp(1.0, 0.50, easeIn(p*1.3));
      debrisTriggered = false;
    }
    // 2. BREAK (THREADS SHATTER)
    else if(elapsed < TEXT_START) {
      if(!debrisTriggered) { spawnDebris(); debrisTriggered = true; }
      
      const t = clamp((elapsed-ACT1_END)/(TEXT_START-ACT1_END),0,1);
      const pulse = Math.sin(elapsed * 0.02 * Math.PI * 2) * 0.05;
      hScale = lerp(0.50, 0.35, easeOut(t)) + pulse;
      hShadow = getGlow(GMAX);
      
      maskOp = 0;
    }
    // 3. TEXT & BALL COEXIST
    else if(elapsed < TEXT_END) {
      const t = clamp((elapsed-TEXT_START)/(TEXT_END-TEXT_START),0,1);
      
      // FIX: BALL REMAINS VISIBLE
      hScale = 0.35; 
      hOp = 1; 
      hShadow = getGlow(GMAX);
      
      // Mask & Filter On
      maskOp = easeOut(t * 2); 
      const grayVal = easeOut(t) * 100;
      const brightVal = lerp(100, 90, easeOut(t));
      bgFilter = `grayscale(${grayVal}%) brightness(${brightVal}%)`;
    }
    // 4. BURST & REFORM
    else if(elapsed < ACT4_REFORM) { 
        // BALL BURSTS (Scales up rapidly then vanishes)
        const burstT = clamp((elapsed - TEXT_END)/400, 0, 1);
        hScale = lerp(0.35, 1.8, easeOut(burstT)); // Explode size
        hOp = lerp(1, 0, easeOut(burstT)); // Fade out
        hShadow = getGlow(GMAX);
        
        maskOp = 1; bgFilter = `grayscale(100%) brightness(90%)`;
    }
    else if(elapsed < ACT4_END) {
      const t = clamp((elapsed-ACT4_REFORM)/(ACT4_END-ACT4_REFORM),0,1);
      const ballT = clamp((t-0.5)*2, 0, 1);
      hShadow = getGlow(interpGlow(G0, GR, easeOut(ballT)));
      hScale = lerp(0, 1.12, easeOut(ballT)); hOp = lerp(0, 1, easeOut(ballT));
      if(t > 0.6 && t < 0.9) flashOp = t < 0.7 ? (t-0.6)*10 : (1-(t-0.7)*5);
      
      // Fade out filter/mask
      maskOp = lerp(1, 0, easeIn(t));
      bgFilter = `grayscale(${lerp(100, 0, easeIn(t))}%) brightness(${lerp(90, 100, easeIn(t))}%)`;
    }
    else {
      if(!heroDot.classList.contains('alive')) heroDot.classList.add('alive');
      hScale = 1.12; hOp = 1;
      const driftT = clamp((elapsed - ACT4_END)/(LOOP_HOLD - ACT4_END), 0, 1);
      hDy = lerp(0, -80, easeOut(driftT)); 
    }

    heroDot.style.left = (cx+hDx)+'px'; heroDot.style.top = (cy+hDy)+'px';
    heroDot.style.opacity = hOp;
    if(elapsed < ACT4_END) { heroDot.style.transform = `translate(-50%,-50%) scale(${hScale})`; heroDot.style.boxShadow = hShadow; } 
    else { heroDot.style.transform = `translate(-50%,-50%) scale(${hScale})`; heroDot.style.boxShadow = ''; }
    flashEl.style.opacity = flashOp;
    maskEl.style.opacity = maskOp;
    
    starCanvas.style.filter = bgFilter;

    const perNode = (ACT1_END - ACT1_START) / LABELS.length;
    LABELS.forEach((_, i) => {
      const start = ACT1_START + perNode * i;
      const end = start + perNode * 0.65;
      let nOp = 0;
      if(elapsed < start) nOp=0; 
      else if(elapsed < end) nOp=easeOut(clamp((elapsed-start)/(end-start),0,1)); 
      
      // KEEP VISIBLE THROUGHOUT (Dimmed by filter)
      else if(elapsed < ACT4_REFORM) nOp=1;
      
      else nOp=0;
      
      nodes[i].style.opacity = labels[i].style.opacity = nOp; 
      
      // THREADS: Cut exactly when debris triggers
      lines[i].style.opacity = (elapsed < ACT1_END) ? (nOp * 0.65) : 0;
      
      nodes[i].style.filter = bgFilter;
      labels[i].style.filter = bgFilter;
      lines[i].style.filter = bgFilter;
    });

    updateDebris();

    particles.forEach((p, i) => {
      let pOp = 0, px = cx, py = cy; const d = particleData[i];
      // PARTICLES NOW TRIGGER WITH TEXT FADE OUT (9750ms)
      if(elapsed >= TEXT_END && elapsed < ACT4_REFORM) {
        const t = clamp((elapsed-TEXT_END)/(ACT4_REFORM-TEXT_END),0,1);
        pOp = t<0.2 ? easeOut(t/0.2) : (t<0.6 ? 1 : lerp(1,0,(t-0.6)/0.4));
        const dist = BURST_DIST * easeOut(t); px = cx + d.vx * dist; py = cy + d.vy * dist;
      } else if(elapsed >= ACT4_REFORM && elapsed < ACT4_END) {
        const t = clamp((elapsed-ACT4_REFORM)/(ACT4_END-ACT4_REFORM),0,1);
        const curDist = lerp(d.reformDist, 0, easeInOut(t));
        const ang = d.reformAngle + (1-t)*d.spiralSpeed;
        px = cx + Math.cos(ang)*curDist; py = cy + Math.sin(ang)*curDist;
        if(t<0.1) pOp = t*10; else if(t>0.7) pOp = lerp(1,0,(t-0.7)*3.3); else pOp = 1;
      }
      p.style.opacity = pOp; p.style.left = px+'px'; p.style.top = py+'px';
    });

    const currentBallSize = isMobile ? 48 : 72;
    const radius = currentBallSize / 2;
    
    // TEXT POSITION: 20px gap
    const textGap = isMobile ? 15 : 20;
    const baseTxtY = cy - (radius * hScale) - textGap; 

    if(elapsed >= TEXT_START && elapsed < TEXT_END) {
      const t = clamp((elapsed-TEXT_START)/600,0,1); 
      const fv = easeOut(t); 
      const stress = clamp((elapsed-TEXT_START)/(TEXT_END-TEXT_START),0,1);
      const jx = (Math.random()-0.5)*stress*3; 
      const jy = (Math.random()-0.5)*stress*3;
      
      textMid.style.opacity = fv; 
      textMid.style.left = (cx+jx)+'px'; 
      textMid.style.top = (baseTxtY + lerp(20,0,fv) + jy)+'px';
      textMid.style.filter = `blur(${stress*2}px)`; 
      textMid.style.transform = `translate(-50%,-100%) scale(1)`;
    } else if(elapsed >= TEXT_END && elapsed < TEXT_END+600) {
      const ot = clamp((elapsed-TEXT_END)/400,0,1); const eb = easeOut(ot);
      textMid.style.opacity = lerp(1,0,eb); 
      textMid.style.transform = `translate(-50%,-100%) scale(${1+eb*0.8})`;
      textMid.style.filter = `blur(${eb*12}px)`; 
      textMid.style.top = baseTxtY+'px'; textMid.style.left = cx+'px';
    } else { textMid.style.opacity = 0; }

    const t1 = (elapsed >= ACT5_TEXT1 && elapsed < LOOP_HOLD) ? clamp((elapsed-ACT5_TEXT1)/1200,0,1) : 0;
    line1.style.opacity = easeOut(t1);
    line1.style.letterSpacing = `${lerp(1, 4, easeOut(t1))}px`;
    line1.style.transform = `translateY(${lerp(15, 0, easeOut(t1))}px) scale(${lerp(0.95, 1, easeOut(t1))})`;
    line1.style.filter = `blur(${lerp(5, 0, easeOut(t1))}px)`;

    const t2 = (elapsed >= ACT5_TEXT2 && elapsed < LOOP_HOLD) ? clamp((elapsed-ACT5_TEXT2)/1200,0,1) : 0;
    line2.style.opacity = easeOut(t2);
    line2.style.filter = `blur(${lerp(10,0,easeOut(t2))}px)`;
    line2.style.transform = `translateY(${lerp(10,0,easeOut(t2))}px)`;

    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>


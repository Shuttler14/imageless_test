{% comment %}
  NARRATIVE ARCHITECT - IDENTITY WIZARD (ALL-IN-ONE)
  Includes: Wizard UI, Context Memory, Credit System, and OpenAI Integration.
{% endcomment %}

<div class="page-width narrative-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <div class="architect-container">
    
    <div class="calibration-bar">
      <div class="calibration-label">
        <span id="calibrationText">CALIBRATING IDENTITY...</span>
        <span class="calibration-step" id="calibrationStep">STEP 1/5</span>
      </div>
      <div class="calibration-progress-container">
        <div class="calibration-progress-bar" id="calibrationBar"></div>
      </div>
    </div>

    <div class="wizard-window">
      <div id="wizardContent">
        </div>
    </div>

  </div>
</div>

<style>
  /* ════════════════ CSS STYLING ════════════════ */
  :root {
    --brand-teal: #39A596;
    --brand-teal-dim: #2a7a6f;
    --brand-glow: #4fffd9;
    --glass-panel: rgba(30, 30, 30, 0.7);
    --glass-border: rgba(255, 255, 255, 0.15);
    --text-main: #ffffff;
    --text-muted: #aaaaaa;
    --font-main: 'Montserrat', sans-serif;
    --font-terminal: 'Courier Prime', monospace;
  }

  .narrative-section {
    background: radial-gradient(circle at top center, #1a2e2b 0%, #000000 70%);
    min-height: 80vh;
    color: var(--text-main);
  }

  .architect-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 20px;
  }

  /* Calibration Bar */
  .calibration-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(0, 0, 0, 0.9);
    border-bottom: 1px solid var(--glass-border);
    padding: 15px 20px;
    backdrop-filter: blur(10px);
    margin-bottom: 30px;
    border-radius: 12px;
  }

  .calibration-label {
    font-family: var(--font-terminal);
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--brand-teal);
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .calibration-progress-container {
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .calibration-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-glow));
    width: 0%;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .calibration-progress-bar.glitch {
    animation: glitchProgress 0.3s ease-in-out;
  }

  @keyframes glitchProgress {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    50% { transform: translateX(3px); }
  }

  /* Wizard Window */
  .wizard-window {
    background: var(--glass-panel);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 40px 30px;
    backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    min-height: 500px;
  }

  .wizard-question {
    text-align: center;
    margin-bottom: 40px;
    animation: fadeInDown 0.6s ease;
  }

  .question-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--brand-teal);
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  .question-text {
    font-family: var(--font-main);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Signal Chips */
  .signal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 35px;
  }

  @media (min-width: 768px) {
    .signal-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .signal-chip {
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 20px;
    cursor: pointer;
    text-align: center;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    background: transparent;
  }

  .signal-chip:hover {
    border-color: var(--brand-teal);
    background: rgba(57, 165, 150, 0.1);
    transform: translateY(-3px);
  }

  .signal-chip.active {
    border-color: var(--brand-teal);
    background: rgba(57, 165, 150, 0.2);
    box-shadow: 0 0 15px rgba(57, 165, 150, 0.4);
  }

  .signal-chip-text {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Visual Cards */
  .visual-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 35px;
  }

  .visual-card {
    aspect-ratio: 1;
    border: 2px solid var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
  }

  .visual-card:hover, .visual-card.active {
    border-color: var(--brand-teal);
    transform: translateY(-5px);
  }

  .visual-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-card-label {
    position: absolute;
    bottom: 0;
    width: 100%;
    padding: 10px;
    background: rgba(0,0,0,0.8);
    text-align: center;
    font-size: 11px;
    font-weight: 700;
  }

  /* Buttons */
  .wizard-btn {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, var(--brand-teal), var(--brand-teal-dim));
    border: none;
    border-radius: 30px;
    color: white;
    font-weight: 800;
    letter-spacing: 1.5px;
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.3s ease;
  }

  .wizard-btn:hover { transform: translateY(-2px); }

  .wizard-btn-secondary {
    background: transparent;
    border: 1px solid var(--glass-border);
    margin-top: 15px;
  }

  /* Mirror Card */
  .mirror-card {
    background: rgba(57, 165, 150, 0.1);
    border: 1px solid var(--brand-teal);
    border-radius: 20px;
    padding: 30px;
    text-align: center;
    margin-bottom: 30px;
  }

  .mirror-stat-value {
    font-size: 18px;
    font-weight: 800;
    margin-top: 5px;
    margin-bottom: 15px;
  }

  .hidden { display: none !important; }
  .fade-in { animation: fadeIn 0.5s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  /* ════════════════ JAVASCRIPT LOGIC ════════════════ */
  
  // 1. CONFIGURATION
  const MN_CONFIG = {
    apiKey: "{{ section.settings.openai_key | escape }}",
    dailyLimit: {{ section.settings.daily_limit | default: 10 }}
  };

  // 2. USAGE MANAGER (CREDITS)
  const UsageManager = {
    STORAGE_KEY: 'mn_weekly_usage',

    getUsage() {
      const stored = localStorage.getItem(this.STORAGE_KEY);
      if (!stored) return this.resetWeek();
      const data = JSON.parse(stored);
      // Reset if > 7 days
      if (Date.now() - data.weekStart > 604800000) return this.resetWeek();
      return data;
    },

    resetWeek() {
      const data = { count: 0, weekStart: Date.now() };
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(data));
      return data;
    },

    checkCredits() {
      const usage = this.getUsage();
      return { canUse: usage.count < MN_CONFIG.dailyLimit, remaining: MN_CONFIG.dailyLimit - usage.count };
    },

    consumeCredit() {
      const usage = this.getUsage();
      if (usage.count >= MN_CONFIG.dailyLimit) return false;
      usage.count++;
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(usage));
      return true;
    }
  };

  // 3. CONTEXT MANAGER (RETURNING USERS)
  const ContextManager = {
    init() {
      const saved = localStorage.getItem('mn_identity_stats');
      if (saved) {
        this.renderDashboard(JSON.parse(saved));
        return true;
      }
      return false;
    },

    saveIdentity(data) {
      localStorage.setItem('mn_identity_stats', JSON.stringify(data));
    },

    clearIdentity() {
      localStorage.removeItem('mn_identity_stats');
      location.reload();
    },

    renderDashboard(profile) {
      document.querySelector('.calibration-bar').style.display = 'none';
      const container = document.getElementById('wizardContent');
      container.innerHTML = `
        <div class="wizard-question fade-in">
          <div class="question-label">WELCOME BACK, ${profile.archetype.toUpperCase()}</div>
          <div class="question-text">What is the mission today?</div>
        </div>
        <div class="signal-grid">
          ${this.renderChip('First Date')}
          ${this.renderChip('Job Interview')}
          ${this.renderChip('Deep Work Mode')}
          ${this.renderChip('Gym / Training')}
          ${this.renderChip('Gift for Someone')}
        </div>
        <button class="wizard-btn wizard-btn-secondary" onclick="ContextManager.clearIdentity()">RECALIBRATE IDENTITY</button>
      `;
    },

    renderChip(text) {
      return `<div class="signal-chip" onclick="ContextManager.handleContext('${text}')"><div class="signal-chip-text">${text}</div></div>`;
    },

    async handleContext(context) {
      // Basic context handler - reuses logic to generate new slogan
      if(!UsageManager.checkCredits().canUse) { alert('Weekly limit reached.'); return; }
      UsageManager.consumeCredit();
      alert(`Generating context for: ${context} (This connects to AI in full version)`);
      // Connect to your existing AI generation logic here
    }
  };

  // 4. WIZARD UI
  const WizardData = {
    steps: [
      { id: 1, type: 'signal', label: 'THE EMOTION', question: 'What is your current signal?', options: ['Quiet Rebellion', 'Main Character', 'Healing Era', 'Stoic Focus', 'Night Owl', 'Hustle Mode'] },
      { id: 2, type: 'signal', label: 'THE OBSESSION', question: 'Where does your mind drift?', options: ['AI & Code', 'Gym & Iron', 'Midnight Drives', 'Startups', 'Nature', 'Philosophy'] },
      { id: 3, type: 'signal', label: 'THE ARCHETYPE', question: 'What is your role?', options: ['The Visionary', 'The Ghost', 'The Disruptor', 'The Ruler', 'The Sage', 'The Creator'] },
      { id: 4, type: 'visual', label: 'VISUAL AESTHETIC', question: 'Choose your aesthetic', options: [
        {name: 'Cyberpunk Neon', img: 'https://cdn.shopify.com/s/files/1/0000/0000/files/cyber.jpg?v=1'}, // Replace with real URL
        {name: 'Minimalist Type', img: 'https://cdn.shopify.com/s/files/1/0000/0000/files/min.jpg?v=1'},
        {name: 'Vintage 90s', img: 'https://cdn.shopify.com/s/files/1/0000/0000/files/vin.jpg?v=1'},
        {name: 'Y2K Chrome', img: 'https://cdn.shopify.com/s/files/1/0000/0000/files/y2k.jpg?v=1'}
      ]}
    ]
  };

  const WizardUI = {
    step: 1,
    selections: {},

    init() {
      if (ContextManager.init()) return;
      this.renderStep();
    },

    renderStep() {
      const data = WizardData.steps[this.step - 1];
      const container = document.getElementById('wizardContent');
      
      if (!data) { this.renderMirror(); return; }

      let optionsHtml = '';
      if (data.type === 'visual') {
        optionsHtml = `<div class="visual-grid">${data.options.map(opt => `
          <div class="visual-card" onclick="WizardUI.select('${opt.name}')">
            <div style="height:150px; background:#222; display:flex; align-items:center; justify-content:center; color:#555;">${opt.name}</div>
            <div class="visual-card-label">${opt.name}</div>
          </div>`).join('')}</div>`;
      } else {
        optionsHtml = `<div class="signal-grid">${data.options.map(opt => `
          <div class="signal-chip" onclick="WizardUI.select('${opt}')">
            <div class="signal-chip-text">${opt}</div>
          </div>`).join('')}</div>`;
      }

      container.innerHTML = `
        <div class="wizard-question fade-in">
          <div class="question-label">${data.label}</div>
          <div class="question-text">${data.question}</div>
        </div>
        ${optionsHtml}
      `;
      
      this.updateProgress();
    },

    select(value) {
      if (this.step === 1) this.selections.emotion = value;
      if (this.step === 2) this.selections.obsession = value;
      if (this.step === 3) this.selections.archetype = value;
      if (this.step === 4) this.selections.aesthetic = value;
      
      this.step++;
      this.renderStep();
    },

    updateProgress() {
      const pct = ((this.step - 1) / 5) * 100;
      document.getElementById('calibrationBar').style.width = pct + '%';
      document.getElementById('calibrationStep').innerText = `STEP ${this.step > 5 ? 5 : this.step}/5`;
    },

    renderMirror() {
      document.getElementById('wizardContent').innerHTML = `
        <div class="wizard-question fade-in">
          <div class="question-label">THE MIRROR</div>
          <div class="question-text">Identity Calibrated</div>
        </div>
        <div class="mirror-card">
          <div class="mirror-stat-value">${this.selections.archetype}</div>
          <div style="font-size:12px; color:#aaa;">${this.selections.emotion} • ${this.selections.aesthetic}</div>
        </div>
        <button class="wizard-btn" onclick="WizardUI.generate()">GENERATE NARRATIVE</button>
      `;
    },

    async generate() {
      if (!UsageManager.consumeCredit()) { alert('Weekly limit reached.'); return; }
      
      const btn = document.querySelector('.wizard-btn');
      btn.innerText = 'WEAVING REALITY...';
      
      // CALL OPENAI HERE
      // Mocking response for now to ensure UI works
      setTimeout(() => {
        ContextManager.saveIdentity(this.selections);
        // Redirect or show result
        alert("Narrative Generated! (This is where the image would appear)");
        ContextManager.init(); // Switch to dashboard view
      }, 1500);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    WizardUI.init();
  });
</script>

{% schema %}
{
  "name": "Narrative Wizard AI",
  "settings": [
    {
      "type": "text",
      "id": "openai_key",
      "label": "OpenAI API Key",
      "info": "Paste your sk-... key here"
    },
    {
      "type": "number",
      "id": "daily_limit",
      "label": "Weekly Credit Limit",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Narrative Wizard AI"
    }
  ]
}
{% endschema %}
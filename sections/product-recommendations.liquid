<div class="" data-section-id="{{ section.id }}"  data-for="recommendation-container" data-default-product="{{ section.settings.default_product.id }}">
{%- if recommendations.performed? -%}
  {%- if recommendations.products_count > 0 -%}
      <p class="my-6 md:my-8 text-2xl md:text-4xl text-center px-4 heading-font">{{ section.settings.section_title }}</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 lg:gap-6 my-6 md:my-12 container max-w-screen-xl mx-auto" >
          {% for product in recommendations.products %}
            {% render 'product-card', product: product, wishlist:true %}
          {% endfor %}
        </div>
    {%- endif -%}
{%- endif -%}
</div>

{% comment %} <div id="product-recommendations">
  {% if recommendations.intent == 'related' %}
    <h2>You may also like</h2>
  {% elsif recommendations.intent == 'complementary' %}
    <h2>Pair it with</h2>
  {% endif %}

  <ul>
    {%- for product in recommendations.products -%}
      <li class="grid__item small--one-half medium-up--one-quarter">
        <a href="{{ product.url }}">
          <span>{{ product.title }}</span>
          <span>{{ product.price | money }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div> {% endcomment %}

{% schema %}
{
  "name": "Product Recommendation",
  "tag": "section",
  "class": "container max-w-screen-xl mx-auto px-4 md:px-6",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "You May Also Like"
    },
    {
      "type": "product",
      "id": "default_product",
      "label": "Default Product for Recommend Products"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendation"
    }
  ]
}
{% endschema %}

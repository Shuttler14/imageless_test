<div class="max-w-[500px] bg-white my-8 text-black mx-4 md:mx-6 p-8  w-full" data-for="forget-password-form">
  <h2 class="text-2xl md:text-4xl text-center mb-6 md:mb-9 lg:mb-14 heading-font">Create Account</h2>
  {% form 'create_customer' %}
    <div class="mb-2 text-red-500 normal-font">
      {{ form.errors | default_errors }}
    </div>
    <div class="flex flex-col gap-4 md:gap-6 normal-font">
      <input
        type="text"
        value=""
        name="customer[name]"
        autofocus
        placeholder="Enter Your Name"
        class="border p-1 md:p-2 focus:outline-none w-full "
      >
      
      <input
        type="email"
        value=""
        name="customer[email]"
        placeholder="Enter Your Email"
        class="border p-1 md:p-2 focus:outline-none w-full "
      >
      <input
        type="password"
        value=""
        name="customer[password]"
        placeholder="Set Your Password"
        class="border p-1 md:p-2 focus:outline-none w-full "
      >
      <button
        type="submit"
        class="border p-1 md:p-2 uppercase text-sm md:text-xl bg-black text-white hover:bg-white hover:text-black transition-all shadow-inner "
      >
        Create
      </button>
      {% comment %}
        ─── Smart Auth Switch (in-card) ────────────────────────────────
        Lives INSIDE the white card so it stacks below the submit button
        on mobile instead of floating as a flex sibling next to the card
        (the parent section is `flex justify-center`, so a sibling block
        would get crushed into the narrow leftover column on phones).
        The <script> further down reads ?return_url=... on DOMContentLoaded
        and staples it to both this link AND a hidden `return_to` input on
        the Shopify create_customer form.
      {% endcomment %}
      <p class="text-center text-sm normal-font" style="color:#4b5563; margin-top:4px;">
        Already have an account?
        <a
          href="{{ routes.account_login_url }}"
          id="mn-switch-to-login"
          style="color:#39A596; font-weight:700; text-decoration:none; border-bottom:1px solid #39A596; padding-bottom:2px; margin-left:4px;"
        >Log in here</a>
      </p>
    </div>
  {% endform %}
</div>

<script>
  // Smart Auth Switch — preserve ?return_url= across Register ↔ Login
  // so the Auth-First flow from /pages/ai-studio never loses the
  // eventual /checkout destination. Also stamps a hidden `return_to`
  // input onto the Shopify create_customer form so the server-side
  // post-auth redirect goes back to the studio / checkout.
  document.addEventListener('DOMContentLoaded', function() {
    var urlParams = new URLSearchParams(window.location.search);
    var returnUrl = urlParams.get('return_url');

    if (returnUrl) {
      var loginLink = document.getElementById('mn-switch-to-login');
      if (loginLink) {
        loginLink.href = '{{ routes.account_login_url }}?return_url=' + encodeURIComponent(returnUrl);
      }
      var form = document.querySelector('form[action$="/account"]');
      if (form && !form.querySelector('input[name="return_to"]')) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'return_to';
        input.value = returnUrl;
        form.appendChild(input);
      }
    }
  });
</script>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "container max-w-screen-xl mx-auto flex justify-center",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Register"
    }
  ]
}
{% endschema %}

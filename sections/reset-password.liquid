
<div class="max-w-[500px] bg-white my-8 text-black mx-4 md:mx-6 p-8  w-full" data-for="reset-password-form">
    <h2 class="text-2xl md:text-4xl text-center mb-6 md:mb-9 lg:mb-14 heading-font">Reset Password</h2>
    {% form 'reset_customer_password' %}
      <div class="mb-2 text-red-500 normal-font">
        {{ form.errors | default_errors }}
      </div>
    <div class="flex flex-col gap-4 md:gap-6 normal-font">
        <input type="password" name="customer[password]" autofocus placeholder="Create New Password"  class="border p-1 md:p-2 focus:outline-none w-full ">
        <input type="password" name="customer[password_confirmation]" autofocus placeholder="Confirm Password"  class="border p-1 md:p-2 focus:outline-none w-full ">
        
        <button type="submit" class="border p-1 md:p-2 uppercase text-sm md:text-xl bg-black text-white hover:bg-white hover:text-black transition-all shadow-inner ">Reset</button>
    </div>
    {% endform %}
</div>


{% schema %}
    {
      "name": "Reset Password",
      "tag": "section",
      "class": "container max-w-screen-xl mx-auto flex justify-center",
      "limit": 1,
      "settings": [
       
      ],
      "presets": [
        {
          "name": "Reset Password"
        }
      ]
    }
    {% endschema %}
{% comment %}
=================================================================================
MY NARRATIVE - TRENDING CREATOR DESIGNS CAROUSEL (HOMEPAGE)
=================================================================================
Displays featured creator designs in a carousel below the hero section
Version: 1.0.0

USAGE:
Add to index.json or homepage template:
{% section 'trending-creator-designs' %}

=================================================================================
{% endcomment %}

<style>
  .mn-trending-creators {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #0a0a0a 0%, #111 50%, #0a0a0a 100%);
    padding: 40px 20px;
    margin-top: 20px;
  }

  .mn-trending-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto 24px;
    padding: 0 20px;
  }

  .mn-trending-title {
    font-size: 28px;
    font-weight: 800;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .mn-trending-link {
    color: #fbbf24;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
  }

  .mn-trending-link:hover {
    gap: 10px;
  }

  .mn-creator-carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 10px 20px;
    max-width: 1400px;
    margin: 0 auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .mn-creator-carousel::-webkit-scrollbar {
    display: none;
  }

  .mn-carousel-item {
    flex: 0 0 280px;
    min-width: 280px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(251, 191, 36, 0.15);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .mn-carousel-item:hover {
    transform: translateY(-8px);
    border-color: rgba(251, 191, 36, 0.4);
    box-shadow: 0 20px 40px rgba(251, 191, 36, 0.1);
  }

  .mn-item-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: rgba(251, 191, 36, 0.05);
  }

  .mn-item-content {
    padding: 16px;
  }

  .mn-item-creator {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .mn-creator-avatar-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #fbbf24;
    object-fit: cover;
  }

  .mn-creator-name {
    font-size: 13px;
    font-weight: 600;
    color: #fbbf24;
  }

  .mn-item-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mn-item-price {
    font-size: 16px;
    font-weight: 700;
    color: #39A596;
  }

  .mn-item-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.7);
    color: #fbbf24;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .mn-carousel-nav {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 20px;
  }

  .mn-nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .mn-nav-btn:hover {
    background: rgba(251, 191, 36, 0.2);
    border-color: #fbbf24;
  }

  .mn-loading-trending {
    text-align: center;
    padding: 40px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .mn-carousel-item {
      flex: 0 0 240px;
      min-width: 240px;
    }

    .mn-item-image {
      height: 160px;
    }
  }
</style>

<div class="mn-trending-creators">
  <div class="mn-trending-header">
    <h2 class="mn-trending-title">Trending Creator Designs</h2>
    <a href="/pages/featured-creators" class="mn-trending-link">
      View All →
    </a>
  </div>

  <div id="mnTrendingLoading" class="mn-loading-trending">
    <p>Loading trending designs...</p>
  </div>

  <div id="mnTrendingCarousel" class="mn-creator-carousel" style="display: none;"></div>

  <div class="mn-carousel-nav">
    <button class="mn-nav-btn" onclick="scrollCarousel(-1)">&#8592;</button>
    <button class="mn-nav-btn" onclick="scrollCarousel(1)">&#8594;</button>
  </div>
</div>

<script>
  const API_BASE_URL = '{{ section.settings.creator_api_base_url | default: "https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app" }}';

  async function loadTrendingCreators() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/creator_economy?path=/api/creators/featured`);
      const data = await response.json();

      const carousel = document.getElementById('mnTrendingCarousel');
      const loading = document.getElementById('mnTrendingLoading');

      loading.style.display = 'none';

      if (!data.success || !data.data || data.data.length === 0) {
        carousel.parentElement.style.display = 'none';
        return;
      }

      carousel.innerHTML = data.data.map(creator => {
        const avatarUrl = creator.avatar_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=${creator.username}`;

        return `
          <a href="/pages/featured-creators?creator=${creator.username}" class="mn-carousel-item">
            <span class="mn-item-badge">Featured</span>
            <img
              class="mn-item-image"
              src="${creator.featured_image_url || 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=300&fit=crop'}"
              alt="${creator.username}'s design"
              onerror="this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=300&fit=crop'"
            />
            <div class="mn-item-content">
              <div class="mn-item-creator">
                <img class="mn-creator-avatar-small" src="${avatarUrl}" alt="${creator.username}" />
                <span class="mn-creator-name">@${creator.username}</span>
              </div>
              <h3 class="mn-item-title">${creator.featured_design_title || 'Exclusive Design Collection'}</h3>
              <p class="mn-item-price">From ₹${creator.featured_price || 899}</p>
            </div>
          </a>
        `;
      }).join('');

      carousel.style.display = 'flex';

    } catch (error) {
      console.error('Error loading trending creators:', error);
      document.getElementById('mnTrendingLoading').style.display = 'none';
      document.getElementById('mnTrendingCarousel').parentElement.style.display = 'none';
    }
  }

  function scrollCarousel(direction) {
    const carousel = document.getElementById('mnTrendingCarousel');
    const scrollAmount = 300;
    carousel.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadTrendingCreators);
  } else {
    loadTrendingCreators();
  }
</script>

{% schema %}
{
  "name": "Trending Creator Designs",
  "settings": [
    {
      "type": "text",
      "id": "creator_api_base_url",
      "label": "Creator Economy API Base URL",
      "default": "https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app"
    }
  ],
  "presets": [
    {
      "name": "Trending Creator Designs"
    }
  ]
}
{% endschema %}
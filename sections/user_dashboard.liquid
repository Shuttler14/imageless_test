{% assign customer_name = customer.first_name | default: "Stylist" %}
{% assign customer_id = customer.id | default: "guest" %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --mn-accent: #39A596;
  --mn-accent-dark: #2d8578;
  --mn-accent-dim: rgba(57,165,150,0.12);
  --mn-accent-glow: rgba(57,165,150,0.4);
  --mn-bg: #080808;
  --mn-card: rgba(255,255,255,0.035);
  --mn-card-hover: rgba(255,255,255,0.06);
  --mn-border: rgba(255,255,255,0.08);
  --mn-border-accent: rgba(57,165,150,0.3);
  --mn-text: #ffffff;
  --mn-muted: rgba(255,255,255,0.42);
  --mn-radius: 18px;
  --mn-radius-sm: 12px;
  --mn-font: 'Montserrat', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

.mn-dashboard {
  background: var(--mn-bg);
  font-family: var(--mn-font);
  color: var(--mn-text);
  padding-bottom: 100px;
  position: relative;
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   HERO â€” circular SVG ring + linear bar
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
.mn-hero {
  background: linear-gradient(180deg, rgba(57,165,150,0.07) 0%, transparent 100%);
  border-bottom: 1px solid var(--mn-border);
  padding: 32px 20px 28px;
}
.mn-hero-inner {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 28px;
  flex-wrap: wrap;
}
/* Circular avatar + SVG ring */
.mn-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 114px;
  height: 114px;
  cursor: pointer;
}
.mn-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  background: rgba(57,165,150,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38px;
  border: 2.5px solid rgba(57,165,150,0.25);
  overflow: hidden;
  position: relative;
}
.mn-ring-svg {
  position: absolute;
  top: -7px; left: -7px;
  width: 128px; height: 128px;
  transform: rotate(-90deg);
  pointer-events: none;
}
.mn-ring-bg  { fill:none; stroke:rgba(255,255,255,0.06); stroke-width:4.5; }
.mn-ring-fill{
  fill:none; stroke:var(--mn-accent); stroke-width:4.5; stroke-linecap:round;
  stroke-dasharray: 352; stroke-dashoffset: 352;
  transition: stroke-dashoffset 1s cubic-bezier(0.4,0,0.2,1);
  filter: drop-shadow(0 0 8px rgba(57,165,150,0.7));
}
.mn-avatar-overlay {
  position: absolute; inset: 0; border-radius: 50%;
  background: rgba(0,0,0,0.5); display:flex; align-items:center;
  justify-content:center; opacity:0; transition:opacity 0.2s; font-size:22px;
  pointer-events:none;
}
.mn-avatar-wrap:hover .mn-avatar-overlay { opacity:1; }
/* Completion % badge on ring */
.mn-ring-pct {
  position:absolute; bottom:-4px; left:50%; transform:translateX(-50%);
  background:var(--mn-accent); color:#000; font-size:10px; font-weight:900;
  padding:2px 8px; border-radius:99px; white-space:nowrap;
  box-shadow:0 2px 8px rgba(57,165,150,0.5);
}

.mn-hero-info { flex:1; min-width:220px; }
.mn-hero-name { font-size:24px; font-weight:900; letter-spacing:-0.02em; margin-bottom:3px; }
.mn-hero-sub  { font-size:11px; color:var(--mn-muted); margin-bottom:14px; line-height:1.5; }

/* Linear progress bar */
.mn-linear-bar-wrap { margin-bottom:14px; }
.mn-linear-label { display:flex; justify-content:space-between; font-size:10px; color:var(--mn-muted); font-weight:700; margin-bottom:6px; letter-spacing:0.06em; text-transform:uppercase; }
.mn-linear-track { height:7px; background:rgba(255,255,255,0.07); border-radius:99px; overflow:hidden; }
.mn-linear-fill {
  height:100%;
  background: linear-gradient(90deg, var(--mn-accent), #2dd4bf, #7dd3fc);
  border-radius:99px; width:0%;
  transition: width 1s cubic-bezier(0.4,0,0.2,1);
  box-shadow: 0 0 12px rgba(57,165,150,0.5);
}

/* Hero badges */
.mn-hero-badges { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }
.mn-hero-badge {
  font-size:9px; font-weight:800; padding:4px 10px; border-radius:99px;
  border:1px solid var(--mn-border); color:var(--mn-muted);
  text-transform:uppercase; letter-spacing:0.08em; transition:all 0.3s;
}
.mn-hero-badge.active { border-color:var(--mn-accent); color:var(--mn-accent); background:var(--mn-accent-dim); }

/* AI auto-fill button */
.mn-ai-fill-btn {
  display:inline-flex; align-items:center; gap:8px;
  background: linear-gradient(135deg, var(--mn-accent), var(--mn-accent-dark));
  color:#000; font-size:12px; font-weight:900;
  padding:10px 20px; border-radius:12px; border:none; cursor:pointer;
  letter-spacing:0.04em; transition:all 0.25s;
  box-shadow: 0 4px 16px rgba(57,165,150,0.35);
}
.mn-ai-fill-btn:hover { transform:translateY(-2px); box-shadow:0 6px 24px rgba(57,165,150,0.5); }

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   MAGIC UPLOAD DROPZONE
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
.mn-magic-dropzone {
  max-width:760px; margin:20px auto 0; padding:0 20px;
}
.mn-dropzone-inner {
  border:2px dashed rgba(57,165,150,0.35);
  border-radius:var(--mn-radius);
  padding:32px 24px;
  text-align:center;
  background: linear-gradient(135deg, rgba(57,165,150,0.04), rgba(57,165,150,0.01));
  cursor:pointer;
  transition:all 0.3s;
  position:relative;
  overflow:hidden;
}
.mn-dropzone-inner:hover, .mn-dropzone-inner.dragover {
  border-color:var(--mn-accent);
  background:rgba(57,165,150,0.08);
  box-shadow:0 0 30px rgba(57,165,150,0.15);
}
.mn-dropzone-icon { font-size:40px; margin-bottom:10px; }
.mn-dropzone-title { font-size:15px; font-weight:800; margin-bottom:6px; letter-spacing:-0.01em; }
.mn-dropzone-sub { font-size:11px; color:var(--mn-muted); line-height:1.5; }
.mn-dropzone-tag {
  display:inline-block; margin-top:12px;
  background:var(--mn-accent-dim); border:1px solid var(--mn-border-accent);
  color:var(--mn-accent); font-size:10px; font-weight:800;
  padding:4px 12px; border-radius:99px; letter-spacing:0.06em; text-transform:uppercase;
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   SECTIONS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
.mn-sections {
  max-width:760px; margin:0 auto;
  padding:24px 20px; display:flex; flex-direction:column; gap:16px;
}
.mn-section {
  background:var(--mn-card);
  border:1px solid var(--mn-border);
  border-radius:var(--mn-radius);
  padding:22px;
  border-left:3px solid var(--mn-accent);
  transition:all 0.25s;
  position:relative;
}
.mn-section:hover { background:var(--mn-card-hover); box-shadow:0 8px 40px rgba(57,165,150,0.07); }
.mn-section-title {
  font-size:13px; font-weight:900; text-transform:uppercase;
  letter-spacing:0.1em; color:var(--mn-accent); margin-bottom:18px;
  display:flex; align-items:center; gap:8px;
}
.mn-filled-check {
  width:18px; height:18px; border-radius:50%; background:var(--mn-accent);
  display:inline-flex; align-items:center; justify-content:center;
  font-size:10px; color:#000; font-weight:900; margin-left:auto;
  opacity:0; transition:opacity 0.3s; flex-shrink:0;
}
.mn-filled-check.show { opacity:1; }

/* Chips */
.mn-chips { display:flex; flex-wrap:wrap; gap:8px; }
.mn-chip {
  font-size:12px; font-weight:600; padding:8px 16px; border-radius:99px;
  border:1.5px solid var(--mn-border); background:transparent; color:#fff;
  cursor:pointer; transition:all 0.2s; user-select:none;
}
.mn-chip:hover { border-color:rgba(57,165,150,0.5); background:rgba(57,165,150,0.07); }
.mn-chip.selected { border-color:var(--mn-accent); background:var(--mn-accent-dim); color:var(--mn-accent); }

/* Height */
.mn-height-display { text-align:center; margin-bottom:20px; }
.mn-height-cm { font-size:52px; font-weight:900; line-height:1; letter-spacing:-0.04em; }
.mn-height-ft { font-size:16px; color:var(--mn-muted); font-weight:600; margin-top:4px; }
.mn-height-wrap { display:flex; align-items:flex-end; gap:24px; }
.mn-body-svg-wrap { flex-shrink:0; display:flex; align-items:flex-end; }
.mn-slider-wrap { flex:1; }
.mn-range {
  -webkit-appearance:none; width:100%; height:6px;
  border-radius:99px; background:rgba(255,255,255,0.1); outline:none; cursor:pointer;
}
.mn-range::-webkit-slider-thumb {
  -webkit-appearance:none; width:24px; height:24px; border-radius:50%;
  background:var(--mn-accent); cursor:pointer; box-shadow:0 0 14px rgba(57,165,150,0.6);
  border:2px solid rgba(255,255,255,0.2);
}
.mn-range::-moz-range-thumb { width:24px; height:24px; border-radius:50%; background:var(--mn-accent); cursor:pointer; border:none; }
.mn-range-labels { display:flex; justify-content:space-between; font-size:10px; color:var(--mn-muted); margin-top:8px; }

/* Skin tone swatches */
.mn-mst-row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
.mn-mst-swatch {
  width:38px; height:38px; border-radius:50%; cursor:pointer;
  border:3px solid transparent; transition:all 0.2s; flex-shrink:0; position:relative;
}
.mn-mst-swatch:hover { transform:scale(1.18); }
.mn-mst-swatch.selected {
  border-color:#fff; box-shadow:0 0 0 3px var(--mn-accent), 0 0 16px rgba(57,165,150,0.5);
  transform:scale(1.22);
}
.mn-mst-label { font-size:11px; color:var(--mn-muted); margin-top:10px; font-weight:600; min-height:16px; }

/* Price dual range */
.mn-price-display { font-size:22px; font-weight:900; margin-bottom:14px; color:var(--mn-accent); }
.mn-dual-range { position:relative; height:6px; background:rgba(255,255,255,0.1); border-radius:99px; margin:24px 0 8px; }
.mn-dual-range-fill { position:absolute; height:100%; background:linear-gradient(90deg,var(--mn-accent),#2dd4bf); border-radius:99px; }
.mn-dual-range input[type=range] { position:absolute; width:100%; -webkit-appearance:none; background:transparent; height:6px; pointer-events:none; top:0; margin:0; }
.mn-dual-range input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:var(--mn-accent); cursor:pointer; pointer-events:all; box-shadow:0 0 10px rgba(57,165,150,0.5); }
.mn-price-presets { display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; }
.mn-preset-btn {
  font-size:11px; font-weight:700; padding:6px 14px; border-radius:99px;
  border:1.5px solid var(--mn-border); background:transparent; color:var(--mn-muted); cursor:pointer; transition:all 0.2s;
}
.mn-preset-btn:hover,.mn-preset-btn.active { border-color:var(--mn-accent); color:var(--mn-accent); background:var(--mn-accent-dim); }

/* Weather */
.mn-weather-display {
  display:flex; align-items:center; gap:16px; padding:16px 20px;
  background:rgba(255,255,255,0.04); border-radius:14px; margin-bottom:14px;
  border:1px solid var(--mn-border);
}
.mn-weather-emoji { font-size:38px; }
.mn-weather-info { flex:1; }
.mn-weather-city { font-size:14px; font-weight:800; }
.mn-weather-temp { font-size:30px; font-weight:900; color:var(--mn-accent); }
.mn-weather-cond { font-size:11px; color:var(--mn-muted); margin-top:2px; }
.mn-weather-row { display:flex; gap:8px; flex-wrap:wrap; }
.mn-city-input {
  flex:1; min-width:140px; background:rgba(255,255,255,0.06);
  border:1.5px solid var(--mn-border); border-radius:12px;
  padding:10px 14px; color:#fff; font-size:13px; font-family:var(--mn-font); outline:none; transition:border-color 0.2s;
}
.mn-city-input:focus { border-color:var(--mn-accent); }
.mn-btn-teal {
  background:var(--mn-accent); color:#000; font-size:12px; font-weight:800;
  padding:10px 16px; border-radius:12px; border:none; cursor:pointer; white-space:nowrap;
  transition:all 0.2s; font-family:var(--mn-font);
}
.mn-btn-teal:hover { background:var(--mn-accent-dark); transform:translateY(-1px); }
.mn-locate-btn {
  background:rgba(255,255,255,0.07); color:#fff; font-size:12px; font-weight:700;
  padding:10px 14px; border-radius:12px; border:1px solid var(--mn-border); cursor:pointer; transition:all 0.2s;
}
.mn-locate-btn:hover { background:rgba(255,255,255,0.12); }

/* Vibe grid */
.mn-vibe-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.mn-vibe-card {
  border:1.5px solid var(--mn-border); border-radius:14px; padding:14px 12px;
  cursor:pointer; transition:all 0.2s; background:transparent; text-align:left; width:100%;
}
.mn-vibe-card:hover { border-color:rgba(57,165,150,0.45); background:rgba(57,165,150,0.05); }
.mn-vibe-card.selected { border-color:var(--mn-accent); background:var(--mn-accent-dim); box-shadow:0 0 20px rgba(57,165,150,0.15); }
.mn-vibe-emoji { font-size:24px; margin-bottom:6px; }
.mn-vibe-name  { font-size:12px; font-weight:800; color:#fff; margin-bottom:3px; }
.mn-vibe-desc  { font-size:10px; color:var(--mn-muted); line-height:1.45; }

/* Bank cards */
.mn-bank-row { display:flex; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
.mn-select {
  flex:1; min-width:120px; background:rgba(255,255,255,0.06);
  border:1.5px solid var(--mn-border); border-radius:12px;
  padding:10px 14px; color:#fff; font-size:13px; font-family:var(--mn-font);
  outline:none; transition:border-color 0.2s; cursor:pointer; -webkit-appearance:none;
}
.mn-select:focus { border-color:var(--mn-accent); }
.mn-select option { background:#111; color:#fff; }
.mn-add-btn {
  background:var(--mn-accent); color:#000; font-size:20px; font-weight:900;
  width:44px; height:44px; border-radius:12px; border:none; cursor:pointer;
  display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all 0.2s;
}
.mn-add-btn:hover { background:var(--mn-accent-dark); }
.mn-card-tags { display:flex; flex-wrap:wrap; gap:8px; }
.mn-card-tag {
  display:flex; align-items:center; gap:6px; padding:6px 12px;
  background:rgba(57,165,150,0.1); border:1px solid rgba(57,165,150,0.3);
  border-radius:99px; font-size:11px; font-weight:700; color:var(--mn-accent);
}
.mn-card-tag-remove { cursor:pointer; color:var(--mn-muted); font-size:16px; line-height:1; }
.mn-card-tag-remove:hover { color:#ef4444; }

/* Interests */
.mn-interest-row { display:flex; gap:8px; margin-top:14px; }
.mn-interest-input {
  flex:1; background:rgba(255,255,255,0.06); border:1.5px solid var(--mn-border);
  border-radius:12px; padding:10px 14px; color:#fff; font-size:13px; font-family:var(--mn-font); outline:none;
  transition:border-color 0.2s;
}
.mn-interest-input:focus { border-color:var(--mn-accent); }

/* Digital Closet */
.mn-closet-actions { display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap; }
.mn-closet-btn {
  flex:1; min-width:130px; padding:14px; border-radius:14px; font-size:13px; font-weight:800;
  border:1.5px solid var(--mn-border); background:rgba(255,255,255,0.04);
  color:#fff; cursor:pointer; transition:all 0.2s; text-align:center; font-family:var(--mn-font);
}
.mn-closet-btn.primary { background:var(--mn-accent); color:#000; border-color:var(--mn-accent); }
.mn-closet-btn:hover { opacity:0.85; transform:translateY(-2px); box-shadow:0 6px 20px rgba(57,165,150,0.2); }
.mn-closet-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.mn-closet-thumb {
  border-radius:12px; overflow:hidden; aspect-ratio:3/4;
  background:rgba(255,255,255,0.04); border:1px solid var(--mn-border);
  position:relative; transition:all 0.25s;
}
.mn-closet-thumb:hover { border-color:var(--mn-border-accent); transform:scale(1.02); }
.mn-closet-thumb img { width:100%; height:100%; object-fit:cover; }
.mn-closet-thumb-label {
  position:absolute; bottom:0; left:0; right:0;
  padding:8px 6px 6px;
  background:linear-gradient(0deg,rgba(0,0,0,0.85),transparent);
  font-size:9px; font-weight:700; color:#fff; line-height:1.3;
}
.mn-closet-empty { text-align:center; padding:40px 20px; color:var(--mn-muted); }
.mn-closet-empty-icon { font-size:52px; margin-bottom:14px; }

/* Switzerland Fintech */
.mn-bank-discount-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
.mn-discount-chip {
  padding:8px 14px; border-radius:99px; font-size:11px; font-weight:700;
  background:rgba(255,215,0,0.08); border:1px solid rgba(255,215,0,0.25);
  color:#ffd700; display:flex; align-items:center; gap:5px;
}

/* Chatbot sync indicator */
.mn-chatbot-sync-bar {
  display:flex; align-items:center; gap:10px; padding:12px 16px;
  background:rgba(57,165,150,0.06); border:1px solid rgba(57,165,150,0.2);
  border-radius:12px; margin-bottom:14px; font-size:12px; color:var(--mn-muted);
}
.mn-chatbot-sync-dot {
  width:8px; height:8px; border-radius:50%; background:var(--mn-accent);
  box-shadow:0 0 8px var(--mn-accent); flex-shrink:0;
  animation:mn-pulse 2s ease-in-out infinite;
}
@keyframes mn-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.85)} }
.mn-chatbot-last-sync { font-size:10px; color:rgba(57,165,150,0.7); margin-left:auto; font-weight:700; }

/* AI Loading Overlay */
.mn-ai-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,0.88); backdrop-filter:blur(10px);
  display:none; align-items:center; justify-content:center; z-index:9999; flex-direction:column; gap:20px;
}
.mn-ai-overlay.active { display:flex; }
.mn-ai-spinner { width:60px; height:60px; border:5px solid rgba(57,165,150,0.15); border-top-color:var(--mn-accent); border-radius:50%; animation:mn-spin 0.9s linear infinite; }
.mn-ai-msg { font-size:16px; font-weight:800; color:#fff; text-align:center; max-width:280px; line-height:1.5; }
.mn-ai-sub { font-size:12px; color:var(--mn-muted); }

/* Ghost Mode Modal */
.mn-modal-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,0.88); backdrop-filter:blur(8px);
  display:none; align-items:center; justify-content:center; z-index:9998; padding:20px;
}
.mn-modal-overlay.active { display:flex; }
.mn-modal-box {
  background:linear-gradient(135deg,#0a0a0a,#111);
  border:1px solid rgba(57,165,150,0.4); border-radius:20px;
  padding:28px; max-width:440px; width:100%;
  box-shadow:0 0 60px rgba(57,165,150,0.25), 0 20px 60px rgba(0,0,0,0.8);
  animation:mn-pop-in 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
.mn-modal-title { font-size:16px; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:6px; }

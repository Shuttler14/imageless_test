// ── Restore UI from saved profile ────────────────────────
function mnRestoreUI() {
  // Gender
  if (mnProfile.gender) {
    document.querySelectorAll('.mn-chip-single[data-field="gender"]').forEach(c => c.classList.toggle('selected', c.dataset.val === mnProfile.gender));
    mnFilterVibesByGender(mnProfile.gender);
    mnSetCheck('gender', true);
  }
  // Height
  if (mnProfile.height_cm) {
    const sl = document.getElementById('mn-height-slider');
    if (sl) { sl.value = mnProfile.height_cm; mnHeightChange(mnProfile.height_cm); }
  }
  // Skin
  if (mnProfile.skin_mst) mnSelectMST(mnProfile.skin_mst, mnProfile.skin_label || MST_LABELS[mnProfile.skin_mst], '#a07850');
  // Fit
  if (mnProfile.preferred_fit) {
    document.querySelectorAll('.mn-chip-single[data-field="fit"]').forEach(c => c.classList.toggle('selected', c.dataset.val === mnProfile.preferred_fit));
    mnSetCheck('fit', true);
  }
  // Occasions
  if (mnProfile.occasions && mnProfile.occasions.length) {
    document.querySelectorAll('.mn-chip[data-field="occasions"]').forEach(c => {
      if (mnProfile.occasions.includes(c.dataset.val)) c.classList.add('selected');
    });
    mnSetCheck('occasions', true);
  }
  // Hair
  if (mnProfile.hair_style) {
    document.querySelectorAll('.mn-chip-single[data-field="hair"]').forEach(c => c.classList.toggle('selected', c.dataset.val === mnProfile.hair_style));
    mnSetCheck('hair', true);
  }
  // Price
  if (mnProfile.price_min || mnProfile.price_max) {
    const mn = document.getElementById('mn-price-min'), mx = document.getElementById('mn-price-max');
    if (mn) mn.value = mnProfile.price_min || 2000;
    if (mx) mx.value = mnProfile.price_max || 8000;
    mnPriceChange();
  }
  // Weather
  if (mnProfile.weather && mnProfile.weather.city) {
    mnShowWeather(mnProfile.weather.city, mnProfile.weather.temp || 0, mnProfile.weather.condition || 'Clear', mnProfile.weather.humidity);
  }
  // Vibes
  if (mnProfile.style_vibes && mnProfile.style_vibes.length) {
    document.querySelectorAll('.mn-vibe-card').forEach(c => {
      if (mnProfile.style_vibes.includes(c.dataset.vibe)) c.classList.add('selected');
    });
    mnSetCheck('vibes', true);
  }
  // Bank cards
  if (mnProfile.bank_cards && mnProfile.bank_cards.length) { mnRenderCardTags(); mnSetCheck('bank', true); }
  // Interests
  if (mnProfile.interests && mnProfile.interests.length) {
    document.querySelectorAll('#mn-interest-chips .mn-chip').forEach(c => {
      const txt = c.textContent.replace(/^[^\w]+/, '').trim();
      if (mnProfile.interests.some(i => c.textContent.includes(i))) c.classList.add('selected');
    });
    mnSetCheck('interests', true);
  }
  // Profile photo
  if (mnProfile.profile_photo_b64) {
    const ph = document.getElementById('mn-avatar-photo');
    const em = document.getElementById('mn-avatar-emoji');
    if (ph) { ph.src = mnProfile.profile_photo_b64; ph.style.display = 'block'; }
    if (em) em.style.display = 'none';
    mnSetCheck('photo', true);
  }
  // Closet
  mnRenderCloset();
  mnUpdateProgress();
}

// ── Profile photo upload handler ─────────────────────────
function mnInitPhotoUpload() {
  const wrap = document.getElementById('mn-avatar-wrap');
  const inp = document.getElementById('mn-profile-photo-input');
  const aiBtn = document.getElementById('mn-ai-photo-btn');
  if (wrap && inp) {
    wrap.addEventListener('click', () => inp.click());
    inp.addEventListener('change', function() {
      if (!this.files[0]) return;
      const reader = new FileReader();
      reader.onload = e => {
        const dataUrl = e.target.result;
        const rawB64 = dataUrl.replace(/^data:image\/\w+;base64,/, '');
        // Show avatar
        const ph = document.getElementById('mn-avatar-photo');
        const em = document.getElementById('mn-avatar-emoji');
        if (ph) { ph.src = dataUrl; ph.style.display = 'block'; }
        if (em) em.style.display = 'none';
        mnProfile.profile_photo_b64 = rawB64;
        mnSetCheck('photo', true); mnUpdateProgress();
        // Trigger AI auto-fill
        mnAutoFillFromPhoto(rawB64);
      };
      reader.readAsDataURL(this.files[0]);
    });
  }
  if (aiBtn && inp) {
    aiBtn.addEventListener('click', e => { e.stopPropagation(); inp.click(); });
  }
}

// ── Init ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  mnLoadProfile();
  mnInitPhotoUpload();
  mnPriceChange(); // Init price fill bar
  mnUpdateProgress();
});
</script>


function mnRenderCardTags() {
  const container = document.getElementById('mn-card-tags');
  if (!container) return;
  container.innerHTML = '';
  (mnProfile.bank_cards || []).forEach((c, i) => {
    const tag = document.createElement('div');
    tag.className = 'mn-card-tag mn-pop-in';
    tag.innerHTML = '<span>💳 ' + c.bank + ' ' + c.variant + '</span><span class="mn-card-tag-remove" onclick="mnRemoveCard(' + i + ')">×</span>';
    container.appendChild(tag);
  });
}

function mnRemoveCard(i) {

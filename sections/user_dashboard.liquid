<script>
// ═══════════════════════════════════════════════════════════
// MY NARRATIVE — User Style Dashboard JS
// ═══════════════════════════════════════════════════════════

const MN_API = 'https://mynarrative-ai.vercel.app/api/stylist_pipeline';
const MN_WEATHER_KEY = '{{ section.settings.weather_api_key | escape }}';
const MN_CUSTOMER_ID = '{{ customer.id | default: "guest" }}';

// ── Bank card variants lookup ────────────────────────────
const BANK_CARDS = {
  'HDFC':       ['Regalia','Millennia','Diners Club','Infinia','MoneyBack+','Tata Neu Infinity','Swiggy','Business Regalia','Diners Black','Freedom'],
  'SBI':        ['SimplyCLICK','SimplyMOVE','Prime','Elite','Pulse','Cashback','Club Vistara','IRCTC Platinum','Unnati','Aurum'],
  'ICICI':      ['Amazon Pay','Coral','Sapphiro','Rubyx','Platinum','Emeralde','HPCL Super Saver','MMT Signature','MakeMyTrip Platinum','Business Advantage'],
  'Axis':       ['Flipkart','Magnus','Neo','MY Zone','Privilege','Vistara Infinite','Atlas','Reserve','Olympus','ACE'],
  'Kotak':      ['811','Royale','Zen','White Reserve','League','Essentia','Corporate Platinum','Delight','6E Rewards','PVR'],
  'PNB':        ['RuPay Platinum','RuPay Select','PNB-Pride','Millennia','Global Classic','Power','Heritage','International Platinum','RuPay NCMC','Rupay Select'],
  'IndusInd':   ['Legend','Pinnacle','Celesta','Tiger','Platinum Aura','Club Vistara','Nexxt','EazyDiner','Duo Signature','Avios'],
  'Yes Bank':   ['Yes First Preferred','Marquee','POP','Prosperity Rewards Plus','Business Prime','Travel','Wellness','ACE','RuPay Select','Yes Premia'],
  'IDFC First': ['Wealth','Select','Classic','Millennia','HPCL Power+','WoW','Mayura','Ashva','LTF Millennia','Club Vistara'],
  'Canara':     ['RuPay Platinum','Visa Gold','Classic','Mastercard Platinum','Global','RuPay Select','Canara Credit','Titanium','Sapphire','Corporate'],
};

// ── MST labels ───────────────────────────────────────────
const MST_LABELS = {1:'Very Light',2:'Light',3:'Light Medium',4:'Medium Light',5:'Medium',6:'Medium Dark',7:'Dark',8:'Very Dark',9:'Deep',10:'Deepest'};

// ── Profile state ────────────────────────────────────────
let mnProfile = {
  gender: null, height_cm: 172, skin_mst: null, skin_label: null,
  preferred_fit: null, occasions: [], hair_style: null,
  price_min: 2000, price_max: 8000,
  weather: null, style_vibes: [], bank_cards: [],
  interests: [], profile_photo_b64: null, closet: [],
  hidden_biometrics: {}, completion_pct: 0,
};

// ── Weight map for completion % ──────────────────────────
const WEIGHTS = {
  gender:8, height:8, skin:8, fit:8, occasions:8,
  hair:8, price:6, weather:6, vibes:10, bank:8,
  interests:8, photo:10, closet:10,
};

// Load from localStorage on init
function mnLoadProfile() {
  try {
    const saved = localStorage.getItem('mn_identity');
    if (saved) {
      const p = JSON.parse(saved);
      Object.assign(mnProfile, p);
      mnRestoreUI();
    }
  } catch(e) { console.warn('MN: load error', e); }
}

// Save to localStorage + fire event
function mnSaveToStorage() {
  mnProfile.completion_pct = mnCalcCompletion();
  localStorage.setItem('mn_identity', JSON.stringify(mnProfile));
  window.dispatchEvent(new CustomEvent('mn-identity-updated', { detail: mnProfile }));
}

// ── Completion calculation ───────────────────────────────
function mnCalcCompletion() {
  let pct = 0;
  if (mnProfile.gender) pct += WEIGHTS.gender;
  if (mnProfile.height_cm && mnProfile.height_cm !== 172) pct += WEIGHTS.height;
  if (mnProfile.skin_mst) pct += WEIGHTS.skin;
  if (mnProfile.preferred_fit) pct += WEIGHTS.fit;
  if (mnProfile.occasions && mnProfile.occasions.length) pct += WEIGHTS.occasions;
  if (mnProfile.hair_style) pct += WEIGHTS.hair;
  if (mnProfile.price_min !== 2000 || mnProfile.price_max !== 8000) pct += WEIGHTS.price;
  if (mnProfile.weather && mnProfile.weather.city) pct += WEIGHTS.weather;
  if (mnProfile.style_vibes && mnProfile.style_vibes.length) pct += WEIGHTS.vibes;
  if (mnProfile.bank_cards && mnProfile.bank_cards.length) pct += WEIGHTS.bank;
  if (mnProfile.interests && mnProfile.interests.length) pct += WEIGHTS.interests;
  if (mnProfile.profile_photo_b64) pct += WEIGHTS.photo;
  if (mnProfile.closet && mnProfile.closet.length) pct += WEIGHTS.closet;
  return Math.min(100, pct);
}

// ── Update progress rings + bar ──────────────────────────
function mnUpdateProgress() {
  const pct = mnCalcCompletion();
  // Circular ring: circumference = 2 * pi * 54.9 = 344.97
  const circ = 344.97;
  const offset = circ - (pct / 100) * circ;
  const ring = document.getElementById('mn-ring-fill');
  if (ring) ring.style.strokeDashoffset = offset;
  // Linear bar
  const fill = document.getElementById('mn-linear-fill');
  if (fill) fill.style.width = pct + '%';
  const label = document.getElementById('mn-pct-label');
  if (label) label.textContent = pct + '%';
  // Hero badges
  function setBadge(id, active) {
    const b = document.getElementById(id);
    if (b) b.classList.toggle('active', active);
  }
  setBadge('badge-gender', !!mnProfile.gender);
  setBadge('badge-height', mnProfile.height_cm !== 172);
  setBadge('badge-skin', !!mnProfile.skin_mst);
  setBadge('badge-style', !!(mnProfile.style_vibes && mnProfile.style_vibes.length));
  setBadge('badge-closet', !!(mnProfile.closet && mnProfile.closet.length));
}

// ── Section filled checkmarks ────────────────────────────
function mnSetCheck(id, val) {
  const el = document.getElementById('chk-' + id);
  if (el) el.classList.toggle('show', !!val);
}

// ── Height ───────────────────────────────────────────────
function mnHeightChange(val) {
  val = parseInt(val);
  mnProfile.height_cm = val;
  const totalIn = Math.round(val / 2.54);
  const ft = Math.floor(totalIn / 12);
  const inch = totalIn % 12;
  document.getElementById('mn-height-cm').textContent = val + ' cm';
  document.getElementById('mn-height-ft').textContent = ft + " ft " + inch + " in";
  // Scale SVG body: map 140cm->100px, 220cm->220px
  const svgH = Math.round(100 + ((val - 140) / 80) * 120);
  const svg = document.getElementById('mn-body-svg');
  if (svg) svg.setAttribute('height', svgH);
  mnSetCheck('height', val !== 172);
  mnUpdateProgress(); mnSaveToStorage();
}

// ── Skin tone ────────────────────────────────────────────
function mnSelectMST(mst, label, hex) {
  document.querySelectorAll('.mn-mst-swatch').forEach(s => s.classList.remove('selected'));
  const sw = document.querySelector('.mn-mst-swatch[data-mst="' + mst + '"]');
  if (sw) sw.classList.add('selected');
  document.getElementById('mn-mst-label').textContent = 'MST ' + mst + ' — ' + label;
  mnProfile.skin_mst = mst; mnProfile.skin_label = label;
  mnSetCheck('skin', true); mnUpdateProgress(); mnSaveToStorage();
}

// ── Single-select chips ───────────────────────────────────
function mnSelectSingle(btn, field) {
  document.querySelectorAll('.mn-chip-single[data-field="' + field + '"]').forEach(c => c.classList.remove('selected'));
  btn.classList.add('selected');
  const val = btn.dataset.val;
  if (field === 'gender') {
    mnProfile.gender = val;
    mnFilterVibesByGender(val);
    mnSetCheck('gender', true);
  } else if (field === 'fit') {
    mnProfile.preferred_fit = val;
    mnSetCheck('fit', true);
  } else if (field === 'hair') {
    mnProfile.hair_style = val;
    mnSetCheck('hair', true);
  }
  mnUpdateProgress(); mnSaveToStorage();
}

// ── Multi-select chips (occasions) ───────────────────────
function mnToggleMulti(btn, field) {
  btn.classList.toggle('selected');
  const val = btn.dataset.val;
  if (!mnProfile[field]) mnProfile[field] = [];
  if (btn.classList.contains('selected')) {
    if (!mnProfile[field].includes(val)) mnProfile[field].push(val);
  } else {
    mnProfile[field] = mnProfile[field].filter(v => v !== val);
  }
  mnSetCheck(field, mnProfile[field].length > 0);
  mnUpdateProgress(); mnSaveToStorage();
}

// ── Style vibe cards ─────────────────────────────────────
function mnToggleVibe(card) {
  card.classList.toggle('selected');
  const vibe = card.dataset.vibe;
  if (!mnProfile.style_vibes) mnProfile.style_vibes = [];
  if (card.classList.contains('selected')) {
    if (!mnProfile.style_vibes.includes(vibe)) mnProfile.style_vibes.push(vibe);
  } else {
    mnProfile.style_vibes = mnProfile.style_vibes.filter(v => v !== vibe);
  }
  mnSetCheck('vibes', mnProfile.style_vibes.length > 0);
  mnUpdateProgress(); mnSaveToStorage();
}

// Filter vibe cards by gender
function mnFilterVibesByGender(gender) {
  document.querySelectorAll('.mn-vibe-card').forEach(card => {
    const tag = card.dataset.genderTag;
    if (!gender || gender === 'non-binary' || gender === 'prefer-not') {
      card.style.display = '';
    } else {
      card.style.display = (tag === gender) ? '' : 'none';
    }
  });
}

// ── Price range ───────────────────────────────────────────
function mnPriceChange() {
  let minV = parseInt(document.getElementById('mn-price-min').value);
  let maxV = parseInt(document.getElementById('mn-price-max').value);
  if (minV > maxV) { const t = minV; minV = maxV; maxV = t; }
  mnProfile.price_min = minV; mnProfile.price_max = maxV;
  document.getElementById('mn-price-display').textContent = '\u20b9' + minV.toLocaleString('en-IN') + ' \u2013 \u20b9' + maxV.toLocaleString('en-IN');
  // Update fill bar
  const total = 50000 - 500;
  const leftPct = ((minV - 500) / total) * 100;
  const rightPct = ((maxV - 500) / total) * 100;
  const fill = document.getElementById('mn-price-fill');
  if (fill) { fill.style.left = leftPct + '%'; fill.style.width = (rightPct - leftPct) + '%'; }
  mnSetCheck('price', true); mnUpdateProgress(); mnSaveToStorage();
}

function mnSetPreset(min, max, btn) {
  document.querySelectorAll('.mn-preset-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('mn-price-min').value = min;
  document.getElementById('mn-price-max').value = max;
  mnPriceChange();
}

// ── Weather ───────────────────────────────────────────────
const WEATHER_EMOJIS = { Clear:'☀️', Clouds:'☁️', Rain:'🌧️', Drizzle:'🌦️', Thunderstorm:'⛈️', Snow:'❄️', Mist:'🌫️', Haze:'🌫️', Fog:'🌫️', Smoke:'🌫️' };
function mnShowWeather(city, temp, cond, humidity) {
  document.getElementById('mn-weather-display').style.display = 'flex';
  document.getElementById('mn-weather-city').textContent = city;
  document.getElementById('mn-weather-temp').textContent = Math.round(temp) + '\u00b0C';
  document.getElementById('mn-weather-cond').textContent = cond + (humidity ? ' \u00b7 ' + humidity + '% humidity' : '');
  document.getElementById('mn-weather-emoji').textContent = WEATHER_EMOJIS[cond] || '🌤️';
  mnProfile.weather = { city, temp, condition: cond, humidity };
  mnSetCheck('weather', true); mnUpdateProgress(); mnSaveToStorage();
}

function mnFetchWeatherByCity() {
  const city = document.getElementById('mn-city-input').value.trim();
  if (!city) return;
  const key = MN_WEATHER_KEY && MN_WEATHER_KEY.length > 5 ? MN_WEATHER_KEY : null;
  if (!key) {
    // No API key — store city manually without weather data
    mnProfile.weather = { city, temp: null, condition: 'Manual', humidity: null };
    document.getElementById('mn-weather-display').style.display = 'flex';
    document.getElementById('mn-weather-city').textContent = city;
    document.getElementById('mn-weather-temp').textContent = 'Set in Shopify';
    document.getElementById('mn-weather-cond').textContent = 'Add OpenWeather key in theme settings';
    document.getElementById('mn-weather-emoji').textContent = '🌍';
    mnSetCheck('weather', true); mnUpdateProgress(); mnSaveToStorage();
    return;
  }
  fetch('https://api.openweathermap.org/data/2.5/weather?q=' + encodeURIComponent(city) + '&appid=' + key + '&units=metric')
    .then(r => r.json())
    .then(d => {
      if (d.cod !== 200) throw new Error(d.message);
      mnShowWeather(d.name, d.main.temp, d.weather[0].main, d.main.humidity);
    })
    .catch(e => alert('Weather lookup failed: ' + e.message));
}

function mnAutoLocate() {
  if (!navigator.geolocation) return alert('Geolocation not supported.');
  navigator.geolocation.getCurrentPosition(pos => {
    const key = MN_WEATHER_KEY && MN_WEATHER_KEY.length > 5 ? MN_WEATHER_KEY : null;
    if (!key) { alert('Add your OpenWeather API key in Shopify Theme Settings to use auto-locate.'); return; }
    fetch('https://api.openweathermap.org/data/2.5/weather?lat=' + pos.coords.latitude + '&lon=' + pos.coords.longitude + '&appid=' + key + '&units=metric')
      .then(r => r.json())
      .then(d => mnShowWeather(d.name, d.main.temp, d.weather[0].main, d.main.humidity))
      .catch(e => alert('Location weather failed: ' + e.message));
  }, () => alert('Location access denied.'));
}

// ── Bank cards ────────────────────────────────────────────
function mnPopulateCardVariants() {
  const bank = document.getElementById('mn-bank-select').value;
  const sel = document.getElementById('mn-card-variant-select');
  sel.innerHTML = '<option value="">Select Card</option>';
  if (bank && BANK_CARDS[bank]) {
    BANK_CARDS[bank].forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; sel.appendChild(o); });
  }

{% assign customer_name = customer.first_name | default: "Stylist" %}
{% assign customer_id = customer.id | default: "guest" %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');

:root {
  --mn-accent: #39A596;
  --mn-accent-dim: rgba(57,165,150,0.15);
  --mn-bg: #0a0a0a;
  --mn-card: rgba(255,255,255,0.04);
  --mn-border: rgba(255,255,255,0.09);
  --mn-text: #ffffff;
  --mn-muted: rgba(255,255,255,0.45);
  --mn-radius: 20px;
}

.mn-dashboard {
  background: var(--mn-bg);
  min-height: 100vh;
  font-family: 'Montserrat', sans-serif;
  color: var(--mn-text);
  padding: 0 0 120px 0;
}

/* ── PROFILE HERO ── */
.mn-hero {
  background: linear-gradient(180deg, rgba(57,165,150,0.08) 0%, transparent 100%);
  border-bottom: 1px solid var(--mn-border);
  padding: 32px 20px 28px;
}
.mn-hero-inner {
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 24px;
}
.mn-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 110px;
  height: 110px;
  cursor: pointer;
}
.mn-avatar-wrap input[type=file] { display:none; }
.mn-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  background: rgba(57,165,150,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  border: 2px solid rgba(57,165,150,0.3);
}
.mn-ring-svg {
  position: absolute;
  top: -5px; left: -5px;
  width: 120px; height: 120px;
  transform: rotate(-90deg);
  pointer-events: none;
}
.mn-ring-bg { fill:none; stroke:rgba(255,255,255,0.07); stroke-width:4; }
.mn-ring-fill { fill:none; stroke:var(--mn-accent); stroke-width:4; stroke-linecap:round;
  stroke-dasharray: 345; stroke-dashoffset: 345;
  transition: stroke-dashoffset 0.8s cubic-bezier(0.4,0,0.2,1);
  filter: drop-shadow(0 0 6px rgba(57,165,150,0.6));
}
.mn-avatar-overlay {
  position: absolute; inset: 0; border-radius: 50%;
  background: rgba(0,0,0,0.45); display:flex; align-items:center; justify-content:center;
  opacity:0; transition:opacity 0.2s; font-size:20px;
}
.mn-avatar-wrap:hover .mn-avatar-overlay { opacity:1; }
.mn-hero-info { flex:1; min-width:0; }
.mn-hero-name { font-size: 22px; font-weight: 900; letter-spacing:-0.02em; margin-bottom:4px; }
.mn-hero-sub { font-size: 12px; color: var(--mn-muted); margin-bottom: 14px; }
.mn-linear-bar-wrap { margin-bottom: 12px; }
.mn-linear-label { display:flex; justify-content:space-between; font-size:11px; color:var(--mn-muted); font-weight:600; margin-bottom:6px; }
.mn-linear-track { height: 6px; background: rgba(255,255,255,0.08); border-radius:99px; overflow:hidden; }
.mn-linear-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--mn-accent), #2dd4bf);
  border-radius: 99px;
  width: 0%;
  transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
  box-shadow: 0 0 10px rgba(57,165,150,0.4);
}
.mn-hero-badges { display:flex; gap:8px; flex-wrap:wrap; }
.mn-hero-badge {
  font-size:10px; font-weight:700; padding:4px 10px; border-radius:99px;
  border: 1px solid var(--mn-border); color: var(--mn-muted);
  text-transform: uppercase; letter-spacing:0.08em;
}
.mn-hero-badge.active { border-color:var(--mn-accent); color:var(--mn-accent); background:var(--mn-accent-dim); }
.mn-ai-fill-btn {
  margin-top: 14px; display:inline-flex; align-items:center; gap:8px;
  background: var(--mn-accent); color:#000; font-size:12px; font-weight:800;
  padding: 10px 18px; border-radius:12px; border:none; cursor:pointer;
  letter-spacing:0.04em; transition:all 0.2s;
}
.mn-ai-fill-btn:hover { background:#2d8a7d; transform:translateY(-1px); }
.mn-ai-fill-input { display:none; }

/* ── SECTIONS ── */
.mn-sections { max-width: 700px; margin: 0 auto; padding: 24px 20px; display:flex; flex-direction:column; gap:20px; }
.mn-section {
  background: var(--mn-card);
  border: 1px solid var(--mn-border);
  border-radius: var(--mn-radius);
  padding: 24px;
  border-left: 3px solid var(--mn-accent);
  transition: all 0.25s;
  position: relative;
}
.mn-section:hover { background:rgba(255,255,255,0.06); box-shadow:0 8px 32px rgba(57,165,150,0.08); }
.mn-section-title {
  font-size: 14px; font-weight: 800; text-transform:uppercase;
  letter-spacing: 0.1em; color: var(--mn-accent); margin-bottom: 20px;
  display:flex; align-items:center; gap:8px;
}
.mn-filled-check {
  width:18px; height:18px; border-radius:50%; background:var(--mn-accent);
  display:inline-flex; align-items:center; justify-content:center;
  font-size:10px; color:#000; font-weight:900; margin-left:auto;
  opacity:0; transition:opacity 0.3s;
}
.mn-filled-check.show { opacity:1; }

/* ── HEIGHT SLIDER ── */
.mn-height-display {
  text-align: center; margin-bottom: 20px;
}
.mn-height-cm { font-size: 48px; font-weight: 900; line-height:1; letter-spacing:-0.03em; }
.mn-height-ft { font-size: 18px; color: var(--mn-muted); font-weight: 600; margin-top: 4px; }
.mn-height-wrap { display:flex; align-items:flex-end; gap: 24px; }
.mn-body-svg-wrap { flex-shrink:0; }
.mn-slider-wrap { flex:1; }
.mn-range { -webkit-appearance:none; width:100%; height:6px; border-radius:99px; background:rgba(255,255,255,0.1); outline:none; }
.mn-range::-webkit-slider-thumb { -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:var(--mn-accent); cursor:pointer; box-shadow:0 0 12px rgba(57,165,150,0.5); }
.mn-range::-moz-range-thumb { width:22px; height:22px; border-radius:50%; background:var(--mn-accent); cursor:pointer; border:none; }
.mn-range-labels { display:flex; justify-content:space-between; font-size:10px; color:var(--mn-muted); margin-top:8px; }

/* ── SKIN TONE ── */
.mn-mst-row { display:flex; gap:8px; flex-wrap:wrap; }
.mn-mst-swatch {
  width:36px; height:36px; border-radius:50%; cursor:pointer;
  border:3px solid transparent; transition:all 0.2s; flex-shrink:0;
  position:relative;
}
.mn-mst-swatch:hover { transform:scale(1.15); }
.mn-mst-swatch.selected { border-color:#fff; box-shadow: 0 0 0 3px var(--mn-accent); transform:scale(1.2); }
.mn-mst-label { font-size:11px; color:var(--mn-muted); margin-top:10px; font-weight:600; min-height:16px; }

/* ── CHIPS ── */
.mn-chips { display:flex; flex-wrap:wrap; gap:8px; }
.mn-chip {
  font-size:12px; font-weight:600; padding:8px 16px; border-radius:99px;
  border:1.5px solid var(--mn-border); background:transparent; color:#fff;
  cursor:pointer; transition:all 0.2s; user-select:none;
}
.mn-chip:hover { border-color:rgba(57,165,150,0.5); background:rgba(57,165,150,0.07); }
.mn-chip.selected { border-color:var(--mn-accent); background:var(--mn-accent-dim); color:var(--mn-accent); }
.mn-chip-single { border-radius:12px; }

/* ── PRICE RANGE ── */
.mn-price-display { font-size:20px; font-weight:800; margin-bottom:16px; color:var(--mn-accent); }
.mn-dual-range { position:relative; height:6px; background:rgba(255,255,255,0.1); border-radius:99px; margin:20px 0 8px; }
.mn-dual-range-fill { position:absolute; height:100%; background:var(--mn-accent); border-radius:99px; }
.mn-dual-range input[type=range] { position:absolute; width:100%; -webkit-appearance:none; background:transparent; height:6px; pointer-events:none; top:0; }
.mn-dual-range input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:20px; height:20px; border-radius:50%; background:var(--mn-accent); cursor:pointer; pointer-events:all; box-shadow:0 0 10px rgba(57,165,150,0.4); }
.mn-price-presets { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }
.mn-preset-btn {
  font-size:11px; font-weight:700; padding:6px 14px; border-radius:99px;
  border:1.5px solid var(--mn-border); background:transparent; color:var(--mn-muted);
  cursor:pointer; transition:all 0.2s;
}
.mn-preset-btn:hover, .mn-preset-btn.active { border-color:var(--mn-accent); color:var(--mn-accent); background:var(--mn-accent-dim); }

/* ── WEATHER ── */
.mn-weather-display {
  display:flex; align-items:center; gap:16px; padding:16px 20px;
  background:rgba(255,255,255,0.04); border-radius:14px; margin-bottom:16px;
  border:1px solid var(--mn-border);
}
.mn-weather-emoji { font-size:36px; }
.mn-weather-info { flex:1; }
.mn-weather-city { font-size:14px; font-weight:800; }
.mn-weather-temp { font-size:28px; font-weight:900; color:var(--mn-accent); }
.mn-weather-cond { font-size:11px; color:var(--mn-muted); margin-top:2px; }
.mn-weather-row { display:flex; gap:10px; align-items:center; }
.mn-city-input {
  flex:1; background:rgba(255,255,255,0.06); border:1.5px solid var(--mn-border);
  border-radius:12px; padding:10px 14px; color:#fff; font-size:13px;
  font-family:'Montserrat',sans-serif; outline:none; transition:border-color 0.2s;
}
.mn-city-input:focus { border-color:var(--mn-accent); }
.mn-weather-btn {
  background:var(--mn-accent); color:#000; font-size:12px; font-weight:800;
  padding:10px 16px; border-radius:12px; border:none; cursor:pointer;
  white-space:nowrap; transition:all 0.2s;
}
.mn-weather-btn:hover { background:#2d8a7d; }
.mn-locate-btn {
  background:rgba(255,255,255,0.08); color:#fff; font-size:11px; font-weight:700;
  padding:10px 14px; border-radius:12px; border:1px solid var(--mn-border); cursor:pointer;
  white-space:nowrap; transition:all 0.2s;
}

/* ── STYLE VIBE CARDS ── */
.mn-vibe-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.mn-vibe-card {
  border:1.5px solid var(--mn-border); border-radius:14px; padding:14px;
  cursor:pointer; transition:all 0.2s; background:transparent; text-align:left;
}
.mn-vibe-card:hover { border-color:rgba(57,165,150,0.4); background:rgba(57,165,150,0.05); }
.mn-vibe-card.selected { border-color:var(--mn-accent); background:var(--mn-accent-dim); }
.mn-vibe-emoji { font-size:22px; margin-bottom:6px; }
.mn-vibe-name { font-size:12px; font-weight:800; color:#fff; margin-bottom:2px; }
.mn-vibe-desc { font-size:10px; color:var(--mn-muted); line-height:1.4; }

/* ── BANK CARDS ── */
.mn-bank-row { display:flex; gap:10px; margin-bottom:12px; }
.mn-select {
  flex:1; background:rgba(255,255,255,0.06); border:1.5px solid var(--mn-border);
  border-radius:12px; padding:10px 14px; color:#fff; font-size:13px;
  font-family:'Montserrat',sans-serif; outline:none; transition:border-color 0.2s;
  cursor:pointer;
}
.mn-select:focus { border-color:var(--mn-accent); }
.mn-select option { background:#1a1a1a; color:#fff; }
.mn-add-btn {
  background:var(--mn-accent); color:#000; font-size:18px; font-weight:900;
  width:42px; height:42px; border-radius:10px; border:none; cursor:pointer;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
  transition:all 0.2s;
}
.mn-add-btn:hover { background:#2d8a7d; }
.mn-card-tags { display:flex; flex-wrap:wrap; gap:8px; }
.mn-card-tag {
  display:flex; align-items:center; gap:6px; padding:6px 12px;
  background:rgba(57,165,150,0.1); border:1px solid rgba(57,165,150,0.3);
  border-radius:99px; font-size:11px; font-weight:700; color:var(--mn-accent);
}
.mn-card-tag-remove { cursor:pointer; color:var(--mn-muted); font-size:14px; font-weight:900; line-height:1; }
.mn-card-tag-remove:hover { color:#ef4444; }

/* ── INTERESTS ── */
.mn-interest-input-row { display:flex; gap:10px; margin-top:14px; }
.mn-interest-input {
  flex:1; background:rgba(255,255,255,0.06); border:1.5px solid var(--mn-border);
  border-radius:12px; padding:10px 14px; color:#fff; font-size:13px;
  font-family:'Montserrat',sans-serif; outline:none;
}
.mn-interest-input:focus { border-color:var(--mn-accent); }

/* ── DIGITAL CLOSET ── */
.mn-closet-actions { display:flex; gap:12px; margin-bottom:20px; }
.mn-closet-btn {
  flex:1; padding:14px; border-radius:14px; font-size:13px; font-weight:800;
  border:1.5px solid var(--mn-border); background:rgba(255,255,255,0.04);
  color:#fff; cursor:pointer; transition:all 0.2s; text-align:center;
}
.mn-closet-btn.primary { background:var(--mn-accent); color:#000; border-color:var(--mn-accent); }
.mn-closet-btn:hover { opacity:0.85; transform:translateY(-1px); }
.mn-closet-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.mn-closet-thumb { border-radius:10px; overflow:hidden; aspect-ratio:3/4; background:rgba(255,255,255,0.04); border:1px solid var(--mn-border); position:relative; }
.mn-closet-thumb img { width:100%; height:100%; object-fit:cover; }
.mn-closet-empty { text-align:center; padding:40px 20px; color:var(--mn-muted); }
.mn-closet-empty-icon { font-size:48px; margin-bottom:12px; }

/* ── AI LOADING OVERLAY ── */
.mn-ai-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,0.85); backdrop-filter:blur(8px);
  display:none; align-items:center; justify-content:center; z-index:9999;
  flex-direction:column; gap:20px;
}
.mn-ai-overlay.active { display:flex; }
.mn-ai-spinner { width:56px; height:56px; border:4px solid rgba(57,165,150,0.2); border-top-color:var(--mn-accent); border-radius:50%; animation:mn-spin 0.9s linear infinite; }
.mn-ai-msg { font-size:15px; font-weight:700; color:#fff; text-align:center; max-width:260px; line-height:1.5; }
.mn-ai-sub { font-size:12px; color:var(--mn-muted); }

/* ── SAVE BUTTON ── */
.mn-save-bar {
  position:fixed; bottom:0; left:0; right:0; z-index:1000;
  padding:16px 20px; background:rgba(10,10,10,0.95); backdrop-filter:blur(12px);
  border-top:1px solid var(--mn-border); display:flex; justify-content:center;
}
.mn-save-btn {
  background:var(--mn-accent); color:#000; font-size:14px; font-weight:900;
  padding:14px 40px; border-radius:14px; border:none; cursor:pointer;
  letter-spacing:0.05em; transition:all 0.2s; display:flex; align-items:center; gap:8px;
  max-width:400px; width:100%; justify-content:center;
}
.mn-save-btn:hover { background:#2d8a7d; transform:translateY(-1px); }
.mn-save-btn.saved { background:#16a34a; }

/* ── AI FLASH ANIMATION ── */
@keyframes mn-flash { 0%,100%{background:var(--mn-card)} 50%{background:rgba(57,165,150,0.15)} }
.mn-ai-flash { animation: mn-flash 0.6s ease 2; }
@keyframes mn-spin { to { transform:rotate(360deg); } }
@keyframes mn-pop-in { from{opacity:0;transform:scale(0.85)} to{opacity:1;transform:scale(1)} }
.mn-pop-in { animation: mn-pop-in 0.3s ease forwards; }

@media (max-width:600px) {
  .mn-hero-inner { flex-direction:column; text-align:center; }
  .mn-vibe-grid { grid-template-columns:1fr 1fr; }
  .mn-height-wrap { flex-direction:column; align-items:center; }
  .mn-closet-grid { grid-template-columns:repeat(2,1fr); }
}
</style>

<!-- AI loading overlay -->
<div class="mn-ai-overlay" id="mn-ai-overlay">
  <div class="mn-ai-spinner"></div>
  <div class="mn-ai-msg" id="mn-ai-msg">AI is reading your style DNA...</div>
  <div class="mn-ai-sub">Scanning skin tone, hair, body type & more</div>
</div>

<div class="mn-dashboard">

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- HERO: Profile pic + ring + progress bar            -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="mn-hero">
    <div class="mn-hero-inner">
      <div class="mn-avatar-wrap" id="mn-avatar-wrap" title="Upload photo for AI auto-fill">
        <div class="mn-avatar-img" id="mn-avatar-img">
          <span id="mn-avatar-emoji">👤</span>
          <img id="mn-avatar-photo" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:50%;position:absolute;inset:0;"/>
        </div>
        <svg class="mn-ring-svg" viewBox="0 0 120 120">
          <circle class="mn-ring-bg" cx="60" cy="60" r="54.9"/>
          <circle class="mn-ring-fill" id="mn-ring-fill" cx="60" cy="60" r="54.9"/>
        </svg>
        <div class="mn-avatar-overlay">📷</div>
        <input type="file" id="mn-profile-photo-input" accept="image/*" class="mn-ai-fill-input"/>
      </div>
      <div class="mn-hero-info">
        <div class="mn-hero-name">{{ customer_name }}'s Style Profile</div>
        <div class="mn-hero-sub">The more you fill, the smarter your stylist gets.</div>
        <div class="mn-linear-bar-wrap">
          <div class="mn-linear-label">
            <span>Profile Completion</span>
            <span id="mn-pct-label">0%</span>
          </div>
          <div class="mn-linear-track">
            <div class="mn-linear-fill" id="mn-linear-fill"></div>
          </div>
        </div>
        <div class="mn-hero-badges">
          <span class="mn-hero-badge" id="badge-gender">Gender</span>
          <span class="mn-hero-badge" id="badge-height">Height</span>
          <span class="mn-hero-badge" id="badge-skin">Skin</span>
          <span class="mn-hero-badge" id="badge-style">Styles</span>
          <span class="mn-hero-badge" id="badge-closet">Closet</span>
        </div>
        <button class="mn-ai-fill-btn" id="mn-ai-photo-btn">
          ✨ Auto-Fill from Photo
        </button>
      </div>
    </div>
  </div>

  <div class="mn-sections">
    <!-- ═══ SECTION 1: GENDER ═══ -->
    <div class="mn-section" id="mn-sec-gender">
      <div class="mn-section-title">👤 Gender <span class="mn-filled-check" id="chk-gender">✓</span></div>
      <div class="mn-chips">
        <button class="mn-chip mn-chip-single" data-field="gender" data-val="men" onclick="mnSelectSingle(this,'gender')">👔 Men</button>
        <button class="mn-chip mn-chip-single" data-field="gender" data-val="women" onclick="mnSelectSingle(this,'gender')">👗 Women</button>
        <button class="mn-chip mn-chip-single" data-field="gender" data-val="non-binary" onclick="mnSelectSingle(this,'gender')">🌈 Non-Binary</button>
        <button class="mn-chip mn-chip-single" data-field="gender" data-val="prefer-not" onclick="mnSelectSingle(this,'gender')">🤍 Prefer Not to Say</button>
      </div>
    </div>

    <!-- ═══ SECTION 2: HEIGHT ═══ -->
    <div class="mn-section" id="mn-sec-height">
      <div class="mn-section-title">📏 Height <span class="mn-filled-check" id="chk-height">✓</span></div>
      <div class="mn-height-display">
        <div class="mn-height-cm" id="mn-height-cm">172 cm</div>
        <div class="mn-height-ft" id="mn-height-ft">5 ft 7.7 in</div>
      </div>
      <div class="mn-height-wrap">
        <!-- SVG body silhouette — scales with height -->
        <div class="mn-body-svg-wrap">
          <svg id="mn-body-svg" width="60" viewBox="0 0 60 200" fill="none" xmlns="http://www.w3.org/2000/svg" style="transition:height 0.3s ease">
            <!-- Head -->
            <circle cx="30" cy="18" r="14" stroke="#39A596" stroke-width="2.5" fill="rgba(57,165,150,0.1)"/>
            <!-- Neck -->
            <rect x="26" y="32" width="8" height="10" rx="3" fill="rgba(57,165,150,0.15)" stroke="#39A596" stroke-width="2"/>
            <!-- Shoulders + Torso -->
            <path id="mn-torso" d="M8 44 Q30 40 52 44 L48 100 Q30 104 12 100 Z" stroke="#39A596" stroke-width="2.5" fill="rgba(57,165,150,0.08)"/>
            <!-- Left arm -->
            <path id="mn-larm" d="M8 46 L2 90 Q1 95 5 96 L10 96 L14 52" stroke="#39A596" stroke-width="2" fill="rgba(57,165,150,0.05)" stroke-linejoin="round"/>
            <!-- Right arm -->
            <path id="mn-rarm" d="M52 46 L58 90 Q59 95 55 96 L50 96 L46 52" stroke="#39A596" stroke-width="2" fill="rgba(57,165,150,0.05)" stroke-linejoin="round"/>
            <!-- Left leg -->
            <path id="mn-lleg" d="M12 100 L8 170 Q8 178 14 178 L22 178 L24 100" stroke="#39A596" stroke-width="2.5" fill="rgba(57,165,150,0.08)" stroke-linejoin="round"/>
            <!-- Right leg -->
            <path id="mn-rleg" d="M48 100 L52 170 Q52 178 46 178 L38 178 L36 100" stroke="#39A596" stroke-width="2.5" fill="rgba(57,165,150,0.08)" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="mn-slider-wrap">
          <input type="range" class="mn-range" id="mn-height-slider" min="140" max="220" value="172" oninput="mnHeightChange(this.value)"/>
          <div class="mn-range-labels"><span>140 cm (4'7")</span><span>220 cm (7'2")</span></div>
        </div>
      </div>
    </div>

    <!-- ═══ SECTION 3: SKIN TONE ═══ -->
    <div class="mn-section" id="mn-sec-skin">

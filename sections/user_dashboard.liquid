// POST image to creator-economy-e5xehp13q-aryans-projects-af8c9a95.vercel.app/v1/analyze-user
// Response auto-populates visible fields AND all 30 hidden fields
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
async function mnHandleMagicUpload(file) {
  if (!file || !file.type.startsWith('image/')) return;
  const overlay = document.getElementById('mn-ai-overlay');
  const msg     = document.getElementById('mn-ai-msg');
  overlay.classList.add('active');
  msg.textContent = 'AI is reading your style DNA...';

  try {
    const dataUrl = await mnToBase64(file);
    const raw_b64 = dataUrl.replace(/^data:image\/\w+;base64,/, '');

    // Show avatar immediately
    const ph = document.getElementById('mn-avatar-photo');
    const em = document.getElementById('mn-avatar-emoji');
    if (ph) { ph.src = dataUrl; ph.style.display = 'block'; }
    if (em) em.style.display = 'none';
    mnProfile.profile_photo_b64 = raw_b64;
    mnSetCheck('photo', true);

    msg.textContent = 'Analyzing body metrics & style signals...';

    // POST to API
    const res = await fetch(MN_AI_API, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        user_id:   MN_CUSTOMER,
        image_b64: raw_b64,
        context:   'style_profile'
      })
    });

    if (!res.ok) throw new Error('API returned ' + res.status);
    const data = await res.json();

    msg.textContent = 'Auto-filling your profile...';

    // â”€â”€ Map visible fields from API response â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Gender
    if (data.gender) {
      const gBtn = document.querySelector('.mn-chip[data-field="gender"][data-val="' + data.gender + '"]');
      if (gBtn) mnSelectSingle(gBtn, 'gender');
    }
    // Height
    if (data.height_cm) {
      const hSlider = document.getElementById('mn-height-slider');
      if (hSlider) { hSlider.value = data.height_cm; mnHeightChange(data.height_cm); }
    }
    // Skin tone (MST 1-10)
    if (data.skin_mst) {
      mnSelectMST(data.skin_mst, data.skin_label || ('MST '+data.skin_mst), data.skin_hex || '#d7bd96');
    }
    // Preferred fit
    if (data.preferred_fit) {
      const fBtn = document.querySelector('.mn-chip[data-field="fit"][data-val="' + data.preferred_fit + '"]');
      if (fBtn) mnSelectSingle(fBtn, 'fit');
    }
    // Hair style
    if (data.hair_style) {
      const hBtn = document.querySelector('.mn-chip[data-field="hair"][data-val="' + data.hair_style + '"]');
      if (hBtn) mnSelectSingle(hBtn, 'hair');
    }
    // Occasions (array)
    if (Array.isArray(data.occasions)) {
      data.occasions.forEach(occ => {
        const btn = document.querySelector('.mn-chip[data-field="occasions"][data-val="' + occ + '"]');
        if (btn && !btn.classList.contains('selected')) mnToggleMulti(btn, 'occasions');
      });
    }
    // Style vibes (array)
    if (Array.isArray(data.style_vibes)) {
      data.style_vibes.forEach(vibe => {
        const card = document.querySelector('.mn-vibe-card[data-vibe="' + vibe + '"]');
        if (card && !card.classList.contains('selected')) mnToggleVibe(card);
      });
    }
    // Price range
    if (data.price_min || data.price_max) {
      if (data.price_min) document.getElementById('mn-price-min').value = data.price_min;
      if (data.price_max) document.getElementById('mn-price-max').value = data.price_max;
      mnPriceChange();
    }

    // â”€â”€ Map ALL 30 hidden AI biometric fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    const AI_FIELD_MAP = {
      ai_facial_symmetry:          data.ai_facial_symmetry,
      ai_undertone_temp:           data.ai_undertone_temp,
      ai_shoulder_width_ratio:     data.ai_shoulder_width_ratio,
      ai_torso_leg_ratio:          data.ai_torso_leg_ratio,
      ai_color_contrast_level:     data.ai_color_contrast_level,
      ai_neck_length:              data.ai_neck_length,
      ai_jawline_angularity:       data.ai_jawline_angularity,
      ai_posture_type:             data.ai_posture_type,
      ai_fabric_drape_preference:  data.ai_fabric_drape_preference,
      ai_pattern_density_tolerance:data.ai_pattern_density_tolerance,
      ai_saturation_preference:    data.ai_saturation_preference,
      ai_wardrobe_base_color:      data.ai_wardrobe_base_color,
      ai_footwear_style_index:     data.ai_footwear_style_index,
      ai_accessory_density:        data.ai_accessory_density,
      ai_silhouette_volume:        data.ai_silhouette_volume,
      ai_visual_weight_distribution:data.ai_visual_weight_distribution,
      ai_texture_complexity:       data.ai_texture_complexity,
      ai_trend_adoption_rate:      data.ai_trend_adoption_rate,
      ai_modesty_index:            data.ai_modesty_index,
      ai_climate_adaptability:     data.ai_climate_adaptability,
      ai_formality_baseline:       data.ai_formality_baseline,
      ai_brand_affinity_score:     data.ai_brand_affinity_score,
      ai_vintage_affinity:         data.ai_vintage_affinity,
      ai_athletic_build_index:     data.ai_athletic_build_index,
      ai_curvilinear_index:        data.ai_curvilinear_index,
      ai_gait_mobility_needs:      data.ai_gait_mobility_needs,
      ai_layering_propensity:      data.ai_layering_propensity,
      ai_color_blocking_tendency:  data.ai_color_blocking_tendency,
      ai_metallic_hardware_pref:   data.ai_metallic_hardware_pref,
      ai_print_scale_pref:         data.ai_print_scale_pref
    };

    // Write to hidden input fields + store in profile
    mnProfile.ai_metrics = {};
    Object.entries(AI_FIELD_MAP).forEach(([id, val]) => {
      const el = document.getElementById(id);
      if (el && val !== undefined && val !== null) el.value = val;
      if (val !== undefined && val !== null) mnProfile.ai_metrics[id] = val;
    });

    // Flash sections to show AI fill
    ['mn-sec-gender','mn-sec-height','mn-sec-skin','mn-sec-fit','mn-sec-hair','mn-sec-vibes'].forEach(id => {
      const sec = document.getElementById(id);
      if (sec) { sec.classList.add('mn-ai-flash'); setTimeout(() => sec.classList.remove('mn-ai-flash'), 1200); }
    });

    mnUpdateProgress();
    mnSaveToStorage();

  } catch (err) {
    console.error('Magic Upload error:', err);
    // On API failure still save the photo locally
    mnSaveToStorage();
  } finally {
    overlay.classList.remove('active');
  }
}

// Helper: file to base64 data URL
function mnToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload  = () => resolve(reader.result);
    reader.onerror = e  => reject(e);
  });
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// CHATBOT â†” DASHBOARD BIDIRECTIONAL SYNC
//
// DIRECTION 1: Dashboard â†’ Chatbot
//   When profile updates, fire 'mn-identity-updated' event.
//   The chatbot (MN-fashion-consultant) listens and injects
//   profile as system context automatically.
//
// DIRECTION 2: Chatbot â†’ Dashboard
//   The chatbot fires 'mn-chatbot-save' CustomEvent with
//   extracted key-value pairs from conversation. Dashboard
//   listens and merges them into mnProfile instantly.
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

// Listen for chatbot pushing data INTO the dashboard
window.addEventListener('mn-chatbot-save', function(e) {
  if (!e.detail || typeof e.detail !== 'object') return;
  const updates = e.detail;

  // Merge every key from the chatbot into mnProfile
  Object.entries(updates).forEach(([key, value]) => {
    if (key === 'occasions' || key === 'style_vibes' || key === 'interests' || key === 'bank_cards') {
      // Arrays â€” merge without duplicates
      if (!Array.isArray(mnProfile[key])) mnProfile[key] = [];
      const arr = Array.isArray(value) ? value : [value];
      arr.forEach(v => { if (!mnProfile[key].includes(v)) mnProfile[key].push(v); });
    } else if (key.startsWith('ai_')) {
      // AI metric fields â€” write to hidden inputs too
      if (!mnProfile.ai_metrics) mnProfile.ai_metrics = {};
      mnProfile.ai_metrics[key] = value;
      const el = document.getElementById(key);
      if (el) el.value = value;
    } else {
      mnProfile[key] = value;
    }
  });

  mnProfile.chatbot_synced_at = new Date().toISOString();
  mnUpdateProgress();
  mnSaveToStorage();
  mnRestoreUI();

  // Update sync indicator
  const syncEl = document.getElementById('mn-chatbot-last-sync');
  if (syncEl) syncEl.textContent = 'Synced ' + new Date().toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
});

// Also listen for raw localStorage changes (cross-tab sync)
window.addEventListener('storage', function(e) {
  if (e.key === MN_STORE_KEY && e.newValue) {
    try {
      const updated = JSON.parse(e.newValue);
      Object.assign(mnProfile, updated);
      mnRestoreUI();
      mnUpdateProgress();
      const syncEl = document.getElementById('mn-chatbot-last-sync');
      if (syncEl && updated.chatbot_synced_at) {
        syncEl.textContent = 'Synced ' + new Date(updated.chatbot_synced_at).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
      }
    } catch(err) {}
  }
});

// â”€â”€ Save button (explicit user save) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function mnSaveProfile() {
  const btn   = document.getElementById('mn-save-btn');
  const label = document.getElementById('mn-save-label');
  if (btn) btn.classList.add('saved');
  if (label) label.textContent = 'âœ“ Profile Saved!';
  mnSaveToStorage();

  // Optional: POST to your backend for server-side persistence
  try {
    await fetch('https://creator-economy-98sr4ud94-aryans-projects-af8c9a95.vercel.app/api/profile_manager', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'save_profile', user_id: MN_CUSTOMER, profile: mnProfile })
    });
  } catch(e) { /* Non-critical â€” data already in localStorage */ }

  setTimeout(() => {
    if (btn) btn.classList.remove('saved');
    if (label) label.textContent = 'ðŸ’¾ Save Style Profile';
  }, 2500);
}

// â”€â”€ Profile photo upload â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnInitPhotoUpload() {
  const wrap  = document.getElementById('mn-avatar-wrap');
  const inp   = document.getElementById('mn-profile-photo-input');
  const aiBtn = document.getElementById('mn-ai-photo-btn');

  if (wrap && inp) {
    wrap.addEventListener('click', () => inp.click());
    inp.addEventListener('change', function() {
      if (!this.files[0]) return;
      mnHandleMagicUpload(this.files[0]);
    });
  }
  if (aiBtn && inp) {
    aiBtn.addEventListener('click', e => { e.stopPropagation(); inp.click(); });
  }
  // Magic dropzone input
  const magicInp = document.getElementById('mn-magic-upload-input');
  if (magicInp) {
    magicInp.addEventListener('change', function() {
      if (this.files[0]) mnHandleMagicUpload(this.files[0]);
    });
  }
}

// â”€â”€ Restore UI from saved profile â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnRestoreUI() {
  const p = mnProfile;

  // Gender
  if (p.gender) {
    document.querySelectorAll('.mn-chip[data-field="gender"]').forEach(c => c.classList.toggle('selected', c.dataset.val === p.gender));
    mnSetCheck('gender', true);
  }
  // Height
  if (p.height_cm) {
    const sl = document.getElementById('mn-height-slider');
    if (sl) sl.value = p.height_cm;
    mnHeightChange(p.height_cm);
  }
  // Skin tone
  if (p.skin_mst) mnSelectMST(p.skin_mst, p.skin_label || 'Custom', p.skin_hex || '#d7bd96');
  // Fit
  if (p.preferred_fit) {
    document.querySelectorAll('.mn-chip[data-field="fit"]').forEach(c => c.classList.toggle('selected', c.dataset.val === p.preferred_fit));
    mnSetCheck('fit', true);
  }
  // Occasions
  if (Array.isArray(p.occasions) && p.occasions.length) {
    document.querySelectorAll('.mn-chip[data-field="occasions"]').forEach(c => c.classList.toggle('selected', p.occasions.includes(c.dataset.val)));
    mnSetCheck('occasions', true);
  }
  // Hair
  if (p.hair_style) {
    document.querySelectorAll('.mn-chip[data-field="hair"]').forEach(c => c.classList.toggle('selected', c.dataset.val === p.hair_style));
    mnSetCheck('hair', true);
  }
  // Price
  if (p.price_min || p.price_max) {
    const pmn = document.getElementById('mn-price-min'), pmx = document.getElementById('mn-price-max');
    if (pmn) pmn.value = p.price_min || 2000;
    if (pmx) pmx.value = p.price_max || 8000;
    mnPriceChange();
  }
  // Weather
  if (p.weather && p.weather.city) mnShowWeather(p.weather.city, p.weather.temp, p.weather.condition, p.weather.humidity);
  // Vibes
  if (Array.isArray(p.style_vibes) && p.style_vibes.length) {
    document.querySelectorAll('.mn-vibe-card').forEach(c => c.classList.toggle('selected', p.style_vibes.includes(c.dataset.vibe)));
    mnSetCheck('vibes', true);
  }
  // Bank cards
  if (Array.isArray(p.bank_cards) && p.bank_cards.length) { mnRenderCardTags(); mnSetCheck('bank', true); }
  // Interests
  if (Array.isArray(p.interests) && p.interests.length) {
    document.querySelectorAll('#mn-interest-chips .mn-chip').forEach(c => {
      const label = c.textContent.replace(/^[^\w\u20ac\u00a3\u00a5]+/, '').trim();
      c.classList.toggle('selected', p.interests.some(i => c.textContent.includes(i)));
    });
    mnSetCheck('interests', true);
  }
  // Photo
  if (p.profile_photo_b64) {
    const ph = document.getElementById('mn-avatar-photo'), em = document.getElementById('mn-avatar-emoji');
    if (ph) { ph.src = 'data:image/jpeg;base64,' + p.profile_photo_b64; ph.style.display = 'block'; }
    if (em) em.style.display = 'none';
    mnSetCheck('photo', true);
  }
  // AI hidden metrics
  if (p.ai_metrics) {
    Object.entries(p.ai_metrics).forEach(([id, val]) => {
      const el = document.getElementById(id);
      if (el && val !== undefined) el.value = val;
    });
  }
  // Closet
  mnRenderCloset();
  // Sync indicator
  if (p.chatbot_synced_at) {
    const syncEl = document.getElementById('mn-chatbot-last-sync');
    if (syncEl) syncEl.textContent = 'Synced ' + new Date(p.chatbot_synced_at).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
  }
}

// â”€â”€ Init â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
document.addEventListener('DOMContentLoaded', function() {
  mnLoadProfile();
  mnInitPhotoUpload();
  mnPriceChange();   // initialise price fill bar
  mnUpdateProgress();

  // â”€â”€ Handle arrival from widget profile ring click â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Detect ?mn_focus=profile in URL or #style-profile hash
  const urlParams  = new URLSearchParams(window.location.search);
  const hashTarget = window.location.hash === '#style-profile';
  const fromWidget = urlParams.get('mn_focus') === 'profile' || hashTarget;

  if (fromWidget) {
    // Check if profile photo is missing
    const hasPhoto = !!(mnProfile.profile_photo_b64 || mnProfile.profile_photo_url);
    const pct      = mnCalcCompletion();

    // Scroll to top of dashboard smoothly
    setTimeout(() => {
      const hero = document.getElementById('style-profile');
      if (hero) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);

    // If no photo â€” show the welcome banner + pulse the dropzone
    if (!hasPhoto || pct < 30) {
      const banner = document.getElementById('mn-welcome-banner');
      if (banner) banner.style.display = 'block';

      // Highlight the Magic Upload dropzone after scroll settles
      setTimeout(() => {
        const dropzone = document.getElementById('mn-magic-dropzone');
        if (dropzone) {
          dropzone.classList.add('mn-dropzone-focused');
          dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
          // Remove focus class after animation finishes (3 cycles Ã— 1.5s)
          setTimeout(() => dropzone.classList.remove('mn-dropzone-focused'), 5000);
        }
        // Also pulse the avatar ring
        const avatarWrap = document.getElementById('mn-avatar-wrap');
        if (avatarWrap) {
          avatarWrap.classList.add('mn-ring-focused');
          setTimeout(() => avatarWrap.classList.remove('mn-ring-focused'), 4500);
        }
      }, 600);

    } else {
      // Profile partially/fully filled â€” just scroll to hero, no banner
      // Highlight the first empty section instead
      const sectionIds = [
        { id: 'mn-sec-gender',    filled: !!mnProfile.gender },
        { id: 'mn-sec-skin',      filled: !!mnProfile.skin_mst },
        { id: 'mn-sec-fit',       filled: !!mnProfile.preferred_fit },
        { id: 'mn-sec-occasions', filled: !!(mnProfile.occasions && mnProfile.occasions.length) },
        { id: 'mn-sec-vibes',     filled: !!(mnProfile.style_vibes && mnProfile.style_vibes.length) },
        { id: 'mn-sec-bank',      filled: !!(mnProfile.bank_cards && mnProfile.bank_cards.length) },
      ];
      const firstEmpty = sectionIds.find(s => !s.filled);
      if (firstEmpty) {
        setTimeout(() => {
          const sec = document.getElementById(firstEmpty.id);
          if (sec) {
            sec.scrollIntoView({ behavior: 'smooth', block: 'center' });
            sec.classList.add('mn-ai-flash');
            setTimeout(() => sec.classList.remove('mn-ai-flash'), 1200);
          }
        }, 600);
      }
    }

    // Clean up URL param without page reload
    if (urlParams.get('mn_focus')) {
      const cleanUrl = window.location.pathname + window.location.hash;
      window.history.replaceState({}, '', cleanUrl);
    }
  }
});

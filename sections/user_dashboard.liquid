function mnAddBankCard() {
  const bank = document.getElementById('mn-bank-select').value;
  const variant = document.getElementById('mn-card-variant-select').value;
  if (!bank || !variant) return;
  if (!mnProfile.bank_cards) mnProfile.bank_cards = [];
  const exists = mnProfile.bank_cards.some(c => c.bank === bank && c.variant === variant);
  if (exists) return;
  mnProfile.bank_cards.push({ bank, variant });
  mnRenderCardTags();
  mnSetCheck('bank', true); mnUpdateProgress(); mnSaveToStorage();
  document.getElementById('mn-bank-select').value = '';
  document.getElementById('mn-card-variant-select').innerHTML = '<option value="">Select Card</option>';

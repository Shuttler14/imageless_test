// ── AI Auto-fill from photo ───────────────────────────────
function mnAutoFillFromPhoto(b64raw) {
  const overlay = document.getElementById('mn-ai-overlay');
  const msg = document.getElementById('mn-ai-msg');
  if (overlay) overlay.classList.add('active');
  const msgs = ['AI is reading your style DNA...','Detecting skin tone...','Analysing body proportions...','Checking hair style...','Building your hidden biometrics...','Almost done — populating fields...'];
  let mi = 0;
  const interval = setInterval(() => { if (msg && msgs[++mi]) msg.textContent = msgs[mi]; }, 3000);

  const userId = MN_CUSTOMER_ID || 'guest_' + Math.random().toString(36).slice(2,9);

  fetch(MN_API, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: 'extract_profile', user_id: userId, user_image: b64raw }),
  })
  .then(r => r.json())
  .then(data => {
    clearInterval(interval);
    if (overlay) overlay.classList.remove('active');

    // The extract_profile action returns biometrics + profile fields
    // Support both direct extract_profile response and full_pipeline response shapes
    const bio = data.biometrics || data.profile || {};
    const hidden = data.hidden_biometrics || {};

    // Map API response fields to profile
    if (bio.monk_skin_tone || bio.skin_mst) {
      const mst = bio.monk_skin_tone || bio.skin_mst;
      const label = MST_LABELS[mst] || bio.mst_label || 'Medium';
      mnProfile.skin_mst = mst;
      mnProfile.skin_label = label;
      mnFlash('mn-sec-skin');
      mnSelectMST(mst, label, '#a07850');
    }
    if (bio.hair_style || bio.hair_length) {
      const hair = bio.hair_style || bio.hair_length || 'Short & Neat';
      mnProfile.hair_style = hair;
      mnFlash('mn-sec-hair');
      document.querySelectorAll('.mn-chip-single[data-field="hair"]').forEach(c => {
        c.classList.toggle('selected', c.dataset.val === hair);
      });
      mnSetCheck('hair', true);
    }
    if (bio.body_type) {
      const fitMap = { slim:'slim', athletic:'athletic', regular:'regular', relaxed:'relaxed', oversized:'oversized', average:'regular', lean:'slim', muscular:'athletic' };
      const fit = fitMap[bio.body_type.toLowerCase()] || 'regular';
      mnProfile.preferred_fit = fit;
      mnFlash('mn-sec-fit');
      document.querySelectorAll('.mn-chip-single[data-field="fit"]').forEach(c => {
        c.classList.toggle('selected', c.dataset.val === fit);
      });
      mnSetCheck('fit', true);
    }
    if (bio.height_cm || bio.estimated_height_cm) {
      const h = parseInt(bio.height_cm || bio.estimated_height_cm);
      if (h >= 140 && h <= 220) {
        mnProfile.height_cm = h;
        const slider = document.getElementById('mn-height-slider');
        if (slider) { slider.value = h; mnHeightChange(h); }
        mnFlash('mn-sec-height');
      }
    }
    if (bio.gender_presentation) {
      const g = bio.gender_presentation.toLowerCase().includes('female') ? 'women' : 'men';
      mnProfile.gender = g;
      mnFlash('mn-sec-gender');
      document.querySelectorAll('.mn-chip-single[data-field="gender"]').forEach(c => {
        c.classList.toggle('selected', c.dataset.val === g);
      });
      mnFilterVibesByGender(g);
      mnSetCheck('gender', true);
    }

    // Store all hidden biometrics (30 fields for ML enrichment)
    mnProfile.hidden_biometrics = Object.assign(mnProfile.hidden_biometrics || {}, hidden, {
      face_shape: bio.face_shape || hidden.face_shape || null,
      undertone_warm_cool: bio.undertone || hidden.undertone_warm_cool || null,
      eye_color: bio.eye_color || null,
      brow_thickness: hidden.brow_thickness || null,
      jaw_width_ratio: hidden.jaw_width_ratio || null,
      cheekbone_prominence: hidden.cheekbone_prominence || null,
      shoulder_to_waist_ratio: bio.shoulder_to_waist_ratio || hidden.shoulder_to_waist_ratio || null,
      waist_to_hip_ratio: bio.waist_to_hip_ratio || hidden.waist_to_hip_ratio || null,
      leg_to_torso_ratio: hidden.leg_to_torso_ratio || null,
      arm_length_category: hidden.arm_length_category || null,
      neck_length: hidden.neck_length || null,
      posture_type: bio.posture || hidden.posture_type || null,
      hair_density: hidden.hair_density || null,
      hair_texture: bio.hair_texture || hidden.hair_texture || null,
      skin_clarity_score: hidden.skin_clarity_score || null,
      wrinkle_presence: hidden.wrinkle_presence || null,
      beard_style: bio.beard_style || hidden.beard_style || null,
      muscle_definition: hidden.muscle_definition || null,
      weight_category: bio.weight_category || hidden.weight_category || null,
      style_confidence_score: hidden.style_confidence_score || null,
      color_contrast_level: bio.color_contrast || hidden.color_contrast_level || null,
      pattern_tolerance: hidden.pattern_tolerance || null,
      layering_preference: hidden.layering_preference || null,
      accessory_affinity: hidden.accessory_affinity || null,
      footwear_preference: hidden.footwear_preference || null,
      cultural_fusion_index: hidden.cultural_fusion_index || null,
      formality_default: hidden.formality_default || null,
      occasion_versatility_score: hidden.occasion_versatility_score || null,
      trend_adoption_rate: hidden.trend_adoption_rate || null,
      price_sensitivity_index: hidden.price_sensitivity_index || null,
      _source: 'photo_ai', _ts: Date.now(),
    });

    mnProfile.profile_photo_b64 = b64raw;
    mnSetCheck('skin', !!mnProfile.skin_mst);
    mnUpdateProgress();
    mnSaveToStorage();

    // Success toast
    const toast = document.createElement('div');
    toast.style.cssText = 'position:fixed;top:20px;right:20px;z-index:10000;background:#16a34a;color:#fff;padding:14px 20px;border-radius:12px;font-size:13px;font-weight:700;font-family:Montserrat,sans-serif;animation:mn-pop-in 0.3s ease;max-width:280px;';
    toast.textContent = 'Profile auto-filled from your photo! Review and adjust below.';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  })
  .catch(err => {
    clearInterval(interval);
    if (overlay) overlay.classList.remove('active');
    // Graceful fallback — don't block the user
    console.warn('[MN] extract_profile failed, using full_pipeline fallback:', err);
    // Try full_pipeline as fallback to still get biometrics
    fetch(MN_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'full_pipeline', user_id: userId, occasion: 'date_night', vibe_id: 'caffeine_survivor', user_image: b64raw }),
    })
    .then(r => r.json())
    .then(data => { if (data.success && data.biometrics) mnAutoFillBiometrics(data.biometrics); })
    .catch(() => {});
  });
}

// Fallback: apply biometrics from full_pipeline response
function mnAutoFillBiometrics(bio) {
  if (bio.monk_skin_tone) mnSelectMST(bio.monk_skin_tone, MST_LABELS[bio.monk_skin_tone] || 'Medium', '#a07850');
  if (bio.body_type) {
    const fitMap = { slim:'slim', athletic:'athletic', regular:'regular', average:'regular', lean:'slim', muscular:'athletic' };
    const fit = fitMap[bio.body_type.toLowerCase()] || 'regular';
    document.querySelectorAll('.mn-chip-single[data-field="fit"]').forEach(c => c.classList.toggle('selected', c.dataset.val === fit));
    mnProfile.preferred_fit = fit;
  }
  mnUpdateProgress(); mnSaveToStorage();
}


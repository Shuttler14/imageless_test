// ── Digital Closet ────────────────────────────────────────
function mnHandleClosetUpload(input) {
  const files = Array.from(input.files);
  if (!files.length) return;
  if (!mnProfile.closet) mnProfile.closet = [];
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      const b64 = e.target.result;
      mnProfile.closet.push({ b64, name: file.name, ts: Date.now() });
      mnRenderCloset();
      mnSetCheck('closet', true); mnUpdateProgress(); mnSaveToStorage();
    };
    reader.readAsDataURL(file);
  });
}

function mnRenderCloset() {
  const grid = document.getElementById('mn-closet-grid');
  const empty = document.getElementById('mn-closet-empty');
  if (!grid) return;
  grid.innerHTML = '';
  if (!mnProfile.closet || !mnProfile.closet.length) {
    if (empty) empty.style.display = 'block';
    return;
  }
  if (empty) empty.style.display = 'none';
  mnProfile.closet.forEach((item, i) => {
    const div = document.createElement('div');
    div.className = 'mn-closet-thumb mn-pop-in';
    div.innerHTML = '<img src="' + item.b64 + '" alt="Closet item ' + (i+1) + '" loading="lazy"/>';
    grid.appendChild(div);
  });
}


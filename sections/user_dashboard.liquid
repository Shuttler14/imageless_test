function mnAddCustomInterest() {
  const inp = document.getElementById('mn-interest-custom');
  const val = inp.value.trim();
  if (!val) return;
  if (!mnProfile.interests) mnProfile.interests = [];
  if (mnProfile.interests.includes(val)) { inp.value = ''; return; }

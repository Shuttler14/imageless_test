// â”€â”€ Digital Closet â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnRenderCloset() {
  const closet  = mnGet(MN_CLOSET_KEY) || mnProfile.closet || [];
  const grid    = document.getElementById('mn-closet-grid');
  const empty   = document.getElementById('mn-closet-empty');
  if (!grid) return;
  if (!closet.length) { grid.innerHTML = ''; if(empty) empty.style.display='block'; return; }
  if (empty) empty.style.display = 'none';
  grid.innerHTML = closet.map((item, i) => {
    const thumb = item.thumbnail_url || item.image_url || '';
    const name  = item.original_name || item.name || 'Item';
    const color = item.color || '';
    return '<div class="mn-closet-thumb">' +
      (thumb ? '<img src="' + thumb + '" alt="' + name + '" loading="lazy"/>' : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:36px">' + (item.emoji || 'ðŸ‘”') + '</div>') +
      '<div class="mn-closet-thumb-label">' + name + (color ? '<br><span style="opacity:0.6">' + color + '</span>' : '') + '</div>' +
    '</div>';
  }).join('');
  mnSetCheck('closet', true);
}

async function mnHandleClosetUpload(input) {
  if (!input.files || !input.files.length) return;
  const overlay = document.getElementById('mn-ai-overlay');
  const msg     = document.getElementById('mn-ai-msg');
  overlay.classList.add('active');
  for (const file of Array.from(input.files)) {
    msg.textContent = 'Segmenting "' + file.name + '"...';
    try {
      const b64 = await mnToBase64(file);
      const raw = b64.replace(/^data:image\/\w+;base64,/, '');
      // Show preview
      const prev = document.getElementById('mn-closet-preview');
      const pimg = document.getElementById('mn-closet-preview-img');
      if (prev && pimg) { pimg.src = b64; prev.style.display = 'block'; }
      let item = { name: file.name.split('.')[0], emoji: 'ðŸ‘”', image_url: b64, original_name: file.name.split('.')[0], added_at: new Date().toISOString() };
      try {
        const res = await fetch(MN_CLOSET_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: MN_CUSTOMER, image_b64: raw, filename: file.name })
        });
        if (res.ok) {
          const data = await res.json();
          item = Object.assign(item, data.item || data);
        }
      } catch(e) { console.warn('Closet API unavailable, storing locally', e); }
      if (!Array.isArray(mnProfile.closet)) mnProfile.closet = [];
      mnProfile.closet.push(item);
      // Mirror to shared closet key
      const shared = mnGet(MN_CLOSET_KEY) || [];
      shared.push(item);
      mnSet(MN_CLOSET_KEY, shared);
      mnSaveToStorage();
    } catch(e) { console.error(e); }
  }
  overlay.classList.remove('active');
  document.getElementById('mn-closet-modal').classList.remove('active');
  mnRenderCloset(); mnUpdateProgress();
  input.value = '';
}

function mnHandleMagicDrop(event) {
  const file = event.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) mnHandleMagicUpload(file);
}

// â”€â”€ Ghost Mode â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function mnSubmitGhost() {
  const desc = (document.getElementById('mn-ghost-input').value || '').trim();
  const cat  = document.getElementById('mn-ghost-category').value;
  if (!desc) return;
  const overlay = document.getElementById('mn-ai-overlay');
  const msg     = document.getElementById('mn-ai-msg');
  overlay.classList.add('active');
  msg.textContent = 'Generating AI embedding for "' + desc + '"...';
  let item = { name: desc, original_name: desc, category: cat || 'Other', emoji: 'ðŸ‘»', ghost: true, added_at: new Date().toISOString() };
  try {
    const res = await fetch(MN_GHOST_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: MN_CUSTOMER, description: desc, category: cat })
    });
    if (res.ok) {
      const data = await res.json();
      item = Object.assign(item, data.item || data);
    }
  } catch(e) { console.warn('Ghost API unavailable, storing locally', e); }
  if (!Array.isArray(mnProfile.closet)) mnProfile.closet = [];
  mnProfile.closet.push(item);
  const shared = mnGet(MN_CLOSET_KEY) || [];
  shared.push(item);
  mnSet(MN_CLOSET_KEY, shared);
  mnSaveToStorage();
  overlay.classList.remove('active');
  document.getElementById('mn-ghost-modal').classList.remove('active');
  document.getElementById('mn-ghost-input').value = '';
  mnRenderCloset(); mnUpdateProgress();
}
</script>

// â”€â”€ Completion calculation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnCalcCompletion() {
  let p = 0;
  if (mnProfile.gender)                                   p += WEIGHTS.gender;
  if (mnProfile.height_cm && mnProfile.height_cm !== 172) p += WEIGHTS.height;
  if (mnProfile.skin_mst)                                 p += WEIGHTS.skin;
  if (mnProfile.preferred_fit)                            p += WEIGHTS.fit;
  if (mnProfile.occasions && mnProfile.occasions.length)  p += WEIGHTS.occasions;
  if (mnProfile.hair_style)                               p += WEIGHTS.hair;
  if (mnProfile.price_min !== 2000 || mnProfile.price_max !== 8000) p += WEIGHTS.price;
  if (mnProfile.weather && mnProfile.weather.city)        p += WEIGHTS.weather;
  if (mnProfile.style_vibes && mnProfile.style_vibes.length) p += WEIGHTS.vibes;
  if (mnProfile.bank_cards && mnProfile.bank_cards.length)   p += WEIGHTS.bank;
  if (mnProfile.interests && mnProfile.interests.length)     p += WEIGHTS.interests;
  if (mnProfile.profile_photo_b64)                        p += WEIGHTS.photo;
  if (mnProfile.closet && mnProfile.closet.length)        p += WEIGHTS.closet;
  return Math.min(100, p);
}

// â”€â”€ Update SVG ring + linear bar + badges â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnUpdateProgress() {
  const pct = mnCalcCompletion();
  // Circular ring â€” circumference for r=56: 2*PI*56 = 351.86
  const circ = 351.86;
  const ring = document.getElementById('mn-ring-fill');
  if (ring) ring.style.strokeDashoffset = circ - (pct / 100) * circ;
  // Badge ring pct
  const rp = document.getElementById('mn-ring-pct');
  if (rp) rp.textContent = pct + '%';
  // Linear fill
  const fill = document.getElementById('mn-linear-fill');
  if (fill) fill.style.width = pct + '%';
  const lbl = document.getElementById('mn-pct-label');
  if (lbl) lbl.textContent = pct + '%';
  // Sub text
  const sub = document.getElementById('mn-hero-sub-text');
  if (sub) {
    if (pct < 30)       sub.textContent = 'Profile ' + pct + '% Complete â€” Feed the AI to unlock hyper-personalized styles.';
    else if (pct < 70)  sub.textContent = 'Profile ' + pct + '% Complete â€” Great start! Add more data for precision styling.';
    else if (pct < 100) sub.textContent = 'Profile ' + pct + '% Complete â€” Almost there! Your AI stylist is getting smarter.';
    else                sub.textContent = 'Profile 100% Complete â€” Your AI stylist has everything it needs. ðŸŽ‰';
  }
  // Badges
  const bd = (id, active) => { const b = document.getElementById(id); if (b) b.classList.toggle('active', active); };
  bd('badge-gender',  !!mnProfile.gender);
  bd('badge-height',  mnProfile.height_cm !== 172);
  bd('badge-skin',    !!mnProfile.skin_mst);
  bd('badge-style',   !!(mnProfile.style_vibes && mnProfile.style_vibes.length));
  bd('badge-closet',  !!(mnProfile.closet && mnProfile.closet.length));
  bd('badge-bank',    !!(mnProfile.bank_cards && mnProfile.bank_cards.length));
}

function mnSetCheck(id, val) {
  const el = document.getElementById('chk-' + id);
  if (el) el.classList.toggle('show', !!val);
}

// â”€â”€ Height â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnHeightChange(val) {
  val = parseInt(val);
  mnProfile.height_cm = val;
  const totalIn = Math.round(val / 2.54);
  document.getElementById('mn-height-cm').textContent = val + ' cm';
  document.getElementById('mn-height-ft').textContent = Math.floor(totalIn/12) + ' ft ' + (totalIn%12) + ' in';
  // Scale SVG: 140cmâ†’100px, 220cmâ†’220px
  const svgH = Math.round(100 + ((val - 140) / 80) * 120);
  const svg = document.getElementById('mn-body-svg');
  if (svg) svg.setAttribute('height', svgH);
  mnSetCheck('height', val !== 172);
  mnUpdateProgress(); mnSaveToStorage();
}

// â”€â”€ Skin tone â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnSelectMST(mst, label, hex) {
  document.querySelectorAll('.mn-mst-swatch').forEach(s => s.classList.remove('selected'));
  const sw = document.querySelector('.mn-mst-swatch[data-mst="' + mst + '"]');
  if (sw) sw.classList.add('selected');
  document.getElementById('mn-mst-label').textContent = 'MST ' + mst + ' â€” ' + label;
  mnProfile.skin_mst = mst; mnProfile.skin_label = label; mnProfile.skin_hex = hex;
  mnSetCheck('skin', true); mnUpdateProgress(); mnSaveToStorage();
}

// â”€â”€ Single-select chips (gender, fit, hair) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnSelectSingle(btn, field) {
  document.querySelectorAll('.mn-chip[data-field="' + field + '"]').forEach(c => c.classList.remove('selected'));
  btn.classList.add('selected');
  const val = btn.dataset.val;
  if      (field === 'gender') { mnProfile.gender = val;         mnSetCheck('gender', true); }
  else if (field === 'fit')    { mnProfile.preferred_fit = val;  mnSetCheck('fit', true); }
  else if (field === 'hair')   { mnProfile.hair_style = val;     mnSetCheck('hair', true); }
  mnUpdateProgress(); mnSaveToStorage();
}

// â”€â”€ Multi-select chips (occasions) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnToggleMulti(btn, field) {
  btn.classList.toggle('selected');
  const val = btn.dataset.val;
  if (!Array.isArray(mnProfile[field])) mnProfile[field] = [];
  if (btn.classList.contains('selected')) {
    if (!mnProfile[field].includes(val)) mnProfile[field].push(val);
  } else {
    mnProfile[field] = mnProfile[field].filter(v => v !== val);
  }
  mnSetCheck(field, mnProfile[field].length > 0);
  mnUpdateProgress(); mnSaveToStorage();
}


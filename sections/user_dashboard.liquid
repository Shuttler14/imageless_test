<!-- 
═══════════════════════════════════════════════════════════
MY NARRATIVE - USER DASHBOARD
Displays user's style profile, preferences, and saved data
═══════════════════════════════════════════════════════════
-->

<style>
  .mn-user-dashboard {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    max-width: 1400px;
    margin: 60px auto;
    padding: 0 24px;
  }

  /* Profile Hero Section */
  .mn-profile-hero {
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.08), rgba(79, 255, 217, 0.08));
    border: 1px solid rgba(57, 165, 150, 0.2);
    border-radius: 24px;
    padding: 48px;
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 48px;
    animation: fadeInUp 0.6s ease-out;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }

  .mn-profile-avatar-section {
    text-align: center;
    flex-shrink: 0;
  }

  .mn-profile-avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 4px solid rgba(57, 165, 150, 0.3);
    box-shadow: 0 12px 32px rgba(57, 165, 150, 0.2);
    object-fit: cover;
    margin-bottom: 20px;
    transition: all 0.4s ease;
    background: linear-gradient(135deg, #39A596, #4fffd9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72px;
    color: white;
  }

  .mn-profile-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 16px 48px rgba(57, 165, 150, 0.3);
  }

  .mn-profile-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .mn-closet-btn {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #39A596, #4fffd9);
    color: white;
    border: none;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(57, 165, 150, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .mn-closet-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(57, 165, 150, 0.4);
  }

  .mn-profile-info {
    flex: 1;
  }

  .mn-profile-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 42px;
    font-weight: 700;
    background: linear-gradient(135deg, #39A596, #4fffd9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .mn-profile-personality {
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    color: rgba(0, 0, 0, 0.6);
    font-style: italic;
    margin-bottom: 24px;
  }

  .mn-quick-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .mn-stat-box {
    background: white;
    border: 1px solid rgba(57, 165, 150, 0.15);
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .mn-stat-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(57, 165, 150, 0.15);
  }

  .mn-stat-icon {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .mn-stat-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .mn-stat-value {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1a1a1a;
  }

  /* Dashboard Grid */
  .mn-dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    margin-bottom: 48px;
  }

  .mn-dashboard-card {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(57, 165, 150, 0.2);
    border-radius: 20px;
    padding: 32px;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    animation: fadeInUp 0.6s ease-out;
    animation-fill-mode: both;
  }

  .mn-dashboard-card:nth-child(1) { animation-delay: 0.2s; }
  .mn-dashboard-card:nth-child(2) { animation-delay: 0.3s; }
  .mn-dashboard-card:nth-child(3) { animation-delay: 0.4s; }

  .mn-dashboard-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 48px rgba(57, 165, 150, 0.15);
    border-color: rgba(57, 165, 150, 0.4);
  }

  .mn-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid rgba(57, 165, 150, 0.1);
  }

  .mn-card-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #39A596, #4fffd9);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 4px 12px rgba(57, 165, 150, 0.3);
  }

  .mn-card-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .mn-card-content {
    font-family: 'Montserrat', sans-serif;
    color: rgba(0, 0, 0, 0.7);
    line-height: 1.6;
  }

  .mn-profile-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mn-profile-item:last-child {
    border-bottom: none;
  }

  .mn-profile-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mn-profile-value {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    background: rgba(57, 165, 150, 0.1);
    padding: 8px 14px;
    border-radius: 8px;
  }

  .mn-archetype-display {
    text-align: center;
    padding: 32px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.05), rgba(79, 255, 217, 0.05));
    border-radius: 16px;
    margin-bottom: 24px;
  }

  .mn-archetype-icon {
    font-size: 64px;
    margin-bottom: 16px;
  }

  .mn-archetype-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .mn-archetype-tagline {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-style: italic;
    color: rgba(0, 0, 0, 0.6);
  }

  .mn-empty-state {
    text-align: center;
    padding: 48px 24px;
    color: rgba(0, 0, 0, 0.4);
  }

  .mn-empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .mn-empty-text {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    margin-bottom: 24px;
  }

  .mn-btn-primary {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #39A596, #4fffd9);
    color: white;
    border: none;
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(57, 165, 150, 0.3);
  }

  .mn-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(57, 165, 150, 0.4);
  }

  .mn-palette-display {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 16px;
  }

  .mn-palette-swatch {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .mn-personality-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.1), rgba(79, 255, 217, 0.1));
    border: 1px solid rgba(57, 165, 150, 0.3);
    padding: 10px 20px;
    border-radius: 20px;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #39A596;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 968px) {
    .mn-profile-hero {
      flex-direction: column;
      text-align: center;
      padding: 32px;
    }

    .mn-profile-name {
      font-size: 32px;
    }

    .mn-quick-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .mn-dashboard-grid {
      grid-template-columns: 1fr;
    }

    .mn-quick-stats {
      grid-template-columns: 1fr;
    }

    .mn-profile-avatar {
      width: 140px;
      height: 140px;
      font-size: 56px;
    }
  }
</style>

<div class="mn-user-dashboard">
  <!-- Profile Hero Section -->
  <div class="mn-profile-hero">
    <div class="mn-profile-avatar-section">
      <div class="mn-profile-avatar" id="profile-avatar">
        👤
      </div>
      <a href="/pages/my-closet" class="mn-closet-btn">
        <span>👗</span>
        <span>Digital Closet</span>
      </a>
    </div>

    <div class="mn-profile-info">
      <h1 class="mn-profile-name" id="profile-name">Welcome Back</h1>
      <p class="mn-profile-personality" id="profile-personality">
        <span class="mn-personality-badge">
          <span>✨</span>
          <span id="personality-tone">Complete your profile to discover your style personality</span>
        </span>
      </p>

      <div class="mn-quick-stats" id="quick-stats">
        <div class="mn-stat-box">
          <div class="mn-stat-icon">📏</div>
          <div class="mn-stat-label">Height</div>
          <div class="mn-stat-value" id="stat-height">-</div>
        </div>
        <div class="mn-stat-box">
          <div class="mn-stat-icon">💪</div>
          <div class="mn-stat-label">Body Type</div>
          <div class="mn-stat-value" id="stat-body">-</div>
        </div>
        <div class="mn-stat-box">
          <div class="mn-stat-icon">🎨</div>
          <div class="mn-stat-label">Skin Tone</div>
          <div class="mn-stat-value" id="stat-skin">-</div>
        </div>
        <div class="mn-stat-box">
          <div class="mn-stat-icon">🌡️</div>
          <div class="mn-stat-label">Temperature</div>
          <div class="mn-stat-value" id="stat-temp">-</div>
        </div>
        <div class="mn-stat-box">
          <div class="mn-stat-icon">💰</div>
          <div class="mn-stat-label">Budget Range</div>
          <div class="mn-stat-value" id="stat-budget">-</div>
        </div>
      </div>
    </div>
  </div>

  <div class="mn-dashboard-grid">
    <!-- Style Identity Card -->
    <div class="mn-dashboard-card">
      <div class="mn-card-header">
        <div class="mn-card-icon">✨</div>
        <h2 class="mn-card-title">Style Archetype</h2>
      </div>
      <div class="mn-card-content" id="identity-content">
        <div class="mn-empty-state">
          <div class="mn-empty-icon">🎨</div>
          <p class="mn-empty-text">Start your style journey to discover your unique fashion archetype</p>
          <button class="mn-btn-primary" onclick="document.getElementById('mn-widget-minimized').click()">
            Begin Journey
          </button>
        </div>
      </div>
    </div>

    <!-- Personal Details Card -->
    <div class="mn-dashboard-card">
      <div class="mn-card-header">
        <div class="mn-card-icon">👤</div>
        <h2 class="mn-card-title">Personal Details</h2>
      </div>
      <div class="mn-card-content" id="details-content">
        <div class="mn-empty-state">
          <div class="mn-empty-icon">📋</div>
          <p class="mn-empty-text">Complete your profile to get personalized recommendations</p>
        </div>
      </div>
    </div>

    <!-- Preferences Card -->
    <div class="mn-dashboard-card">
      <div class="mn-card-header">
        <div class="mn-card-icon">🌍</div>
        <h2 class="mn-card-title">Lifestyle & Preferences</h2>
      </div>
      <div class="mn-card-content" id="preferences-content">
        <div class="mn-empty-state">
          <div class="mn-empty-icon">⚙️</div>
          <p class="mn-empty-text">Your style preferences will appear here</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Load user data from localStorage and populate dashboard
  (function() {
    const STORAGE_KEY = 'mn_core_identity';
    
    function loadDashboardData() {
      try {
        const storedData = localStorage.getItem(STORAGE_KEY);
        if (!storedData) return;
        
        const identity = JSON.parse(storedData);
        
        // Populate Profile Avatar
        const avatarEl = document.getElementById('profile-avatar');
        if (identity.profileImage) {
          avatarEl.innerHTML = `<img src="${identity.profileImage}" alt="Profile Picture">`;
        } else if (identity.archetype && identity.archetype.icon) {
          avatarEl.innerHTML = identity.archetype.icon;
        }
        
        // Populate Profile Name
        const nameEl = document.getElementById('profile-name');
        if (identity.name) {
          nameEl.textContent = identity.name;
        } else if (identity.archetype) {
          nameEl.textContent = `The ${identity.archetype.name}`;
        }
        
        // Populate Personality Tone
        const personalityEl = document.getElementById('personality-tone');
        if (identity.personalityTone) {
          personalityEl.textContent = identity.personalityTone;
        } else if (identity.coreExpression && identity.presence && identity.signal) {
          personalityEl.textContent = `${identity.coreExpression} · ${identity.presence} · ${identity.signal}`;
        }
        
        // Populate Quick Stats
        if (identity.height) {
          document.getElementById('stat-height').textContent = `${identity.height} cm`;
        }
        
        if (identity.build || identity.bodyType) {
          document.getElementById('stat-body').textContent = identity.build || identity.bodyType;
        }
        
        if (identity.skinTone) {
          document.getElementById('stat-skin').textContent = identity.skinTone;
        }
        
        // Temperature (check for climate or temperature data)
        if (identity.temperature) {
          document.getElementById('stat-temp').textContent = identity.temperature;
        } else if (identity.climate) {
          document.getElementById('stat-temp').textContent = identity.climate;
        } else if (identity.region) {
          // Try to fetch temperature for region (placeholder for now)
          document.getElementById('stat-temp').textContent = identity.region;
        }
        
        if (identity.budget || identity.priceRange) {
          document.getElementById('stat-budget').textContent = identity.budget || identity.priceRange;
        }
        
        // Populate Style Identity
        if (identity.archetype) {
          const identityHTML = `
            <div class="mn-archetype-display">
              <div class="mn-archetype-icon">${identity.archetype.icon}</div>
              <h3 class="mn-archetype-name">${identity.archetype.name}</h3>
              <p class="mn-archetype-tagline">"${identity.archetype.tagline}"</p>
              <div class="mn-palette-display">
                ${identity.archetype.palette.map(color => 
                  `<div class="mn-palette-swatch" style="background-color: ${color};"></div>`
                ).join('')}
              </div>
            </div>
            <div class="mn-profile-item">
              <span class="mn-profile-label"><span>💫</span> Core Expression</span>
              <span class="mn-profile-value">${identity.coreExpression || 'Not set'}</span>
            </div>
            <div class="mn-profile-item">
              <span class="mn-profile-label"><span>👁️</span> Presence</span>
              <span class="mn-profile-value">${identity.presence || 'Not set'}</span>
            </div>
            <div class="mn-profile-item">
              <span class="mn-profile-label"><span>📢</span> Signal</span>
              <span class="mn-profile-value">${identity.signal || 'Not set'}</span>
            </div>
          `;
          document.getElementById('identity-content').innerHTML = identityHTML;
        }
        
        // Populate Personal Details
        if (identity.height || identity.build || identity.skinTone || identity.bodyType) {
          const detailsHTML = `
            ${identity.gender ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>⚧️</span> Gender</span>
                <span class="mn-profile-value">${identity.gender}</span>
              </div>
            ` : ''}
            ${identity.height ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>📏</span> Height</span>
                <span class="mn-profile-value">${identity.height} cm</span>
              </div>
            ` : ''}
            ${identity.build || identity.bodyType ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>💪</span> Body Type</span>
                <span class="mn-profile-value">${identity.build || identity.bodyType}</span>
              </div>
            ` : ''}
            ${identity.skinTone ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>🎨</span> Skin Tone</span>
                <span class="mn-profile-value">${identity.skinTone}</span>
              </div>
            ` : ''}
            ${identity.undertone ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>🌈</span> Undertone</span>
                <span class="mn-profile-value">${identity.undertone}</span>
              </div>
            ` : ''}
            ${identity.age ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>🎂</span> Age</span>
                <span class="mn-profile-value">${identity.age}</span>
              </div>
            ` : ''}
          `;
          document.getElementById('details-content').innerHTML = detailsHTML;
        }
        
        // Populate Preferences
        if (identity.region || identity.climate || identity.budget || identity.temperature || identity.priceRange) {
          const preferencesHTML = `
            ${identity.region ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>📍</span> Region</span>
                <span class="mn-profile-value">${identity.region}</span>
              </div>
            ` : ''}
            ${identity.climate ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>☀️</span> Climate</span>
                <span class="mn-profile-value">${identity.climate}</span>
              </div>
            ` : ''}
            ${identity.temperature ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>🌡️</span> Temperature</span>
                <span class="mn-profile-value">${identity.temperature}</span>
              </div>
            ` : ''}
            ${identity.budget || identity.priceRange ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>💰</span> Budget Range</span>
                <span class="mn-profile-value">${identity.budget || identity.priceRange}</span>
              </div>
            ` : ''}
            ${identity.closet && identity.closet.length > 0 ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>👗</span> Closet Items</span>
                <span class="mn-profile-value">${identity.closet.length} items</span>
              </div>
            ` : ''}
            ${identity.favoriteColors && identity.favoriteColors.length > 0 ? `
              <div class="mn-profile-item">
                <span class="mn-profile-label"><span>🎨</span> Favorite Colors</span>
                <span class="mn-profile-value">${identity.favoriteColors.join(', ')}</span>
              </div>
            ` : ''}
          `;
          document.getElementById('preferences-content').innerHTML = preferencesHTML;
        }
        
      } catch (error) {
        console.error('Error loading dashboard data:', error);
      }
    }
    
    // Load data on page load
    loadDashboardData();
    
    // Listen for storage changes
    window.addEventListener('storage', function(e) {
      if (e.key === STORAGE_KEY) {
        loadDashboardData();
      }
    });
    
    // Listen for custom event from AI widget
    window.addEventListener('mn-identity-updated', loadDashboardData);
  })();
</script>

{% schema %}
{
  "name": "User Dashboard",
  "settings": [],
  "presets": [
    {
      "name": "User Dashboard"
    }
  ]
}
{% endschema %}

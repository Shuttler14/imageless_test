// â”€â”€ Price range â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnPriceChange() {
  let minV = parseInt(document.getElementById('mn-price-min').value);
  let maxV = parseInt(document.getElementById('mn-price-max').value);
  if (minV > maxV) { [minV, maxV] = [maxV, minV]; }
  mnProfile.price_min = minV; mnProfile.price_max = maxV;
  document.getElementById('mn-price-display').textContent = 'â‚¹' + minV.toLocaleString('en-IN') + ' â€“ â‚¹' + maxV.toLocaleString('en-IN');
  const total = 50000 - 500;
  const lp = ((minV-500)/total)*100, rp = ((maxV-500)/total)*100;
  const fill = document.getElementById('mn-price-fill');
  if (fill) { fill.style.left = lp + '%'; fill.style.width = (rp-lp) + '%'; }
  mnSetCheck('price', true); mnUpdateProgress(); mnSaveToStorage();
}
function mnSetPreset(min, max, btn) {
  document.querySelectorAll('.mn-preset-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('mn-price-min').value = min;
  document.getElementById('mn-price-max').value = max;
  mnPriceChange();
}
</script>
<script>
// â”€â”€ Weather â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnShowWeather(city, temp, cond, humidity) {
  document.getElementById('mn-weather-display').style.display = 'flex';
  document.getElementById('mn-weather-city').textContent = city;
  document.getElementById('mn-weather-temp').textContent = (temp !== null ? Math.round(temp) : '--') + '\u00b0C';
  document.getElementById('mn-weather-cond').textContent = cond + (humidity ? ' \u00b7 ' + humidity + '% humidity' : '');
  document.getElementById('mn-weather-emoji').textContent = W_EMOJI[cond] || 'ðŸŒ¡ï¸';
  mnProfile.weather = { city, temp, condition: cond, humidity };
  mnSetCheck('weather', true); mnUpdateProgress(); mnSaveToStorage();
}

function mnFetchWeatherByCity() {
  const city = (document.getElementById('mn-city-input').value || '').trim();
  if (!city) return;
  const key = WEATHER_KEY && WEATHER_KEY.length > 5 ? WEATHER_KEY : null;
  if (!key) {
    // No key â€” store city only
    mnProfile.weather = { city, temp: null, condition: 'Manual', humidity: null };
    document.getElementById('mn-weather-display').style.display = 'flex';
    document.getElementById('mn-weather-city').textContent = city;
    document.getElementById('mn-weather-temp').textContent = 'City saved';
    document.getElementById('mn-weather-cond').textContent = 'Add OpenWeather key in Shopify Theme Settings for live data';
    document.getElementById('mn-weather-emoji').textContent = 'ðŸ™ï¸';
    mnSetCheck('weather', true); mnUpdateProgress(); mnSaveToStorage();
    return;
  }
  fetch('https://api.openweathermap.org/data/2.5/weather?q=' + encodeURIComponent(city) + '&appid=' + key + '&units=metric')
    .then(r => r.json())
    .then(d => {
      if (d.cod !== 200) throw new Error(d.message || 'City not found');
      mnShowWeather(d.name, d.main.temp, d.weather[0].main, d.main.humidity);
    })
    .catch(e => alert('Weather lookup failed: ' + e.message));
}

function mnAutoLocate() {
  if (!navigator.geolocation) { alert('Geolocation not supported in this browser.'); return; }
  navigator.geolocation.getCurrentPosition(
    pos => {
      const key = WEATHER_KEY && WEATHER_KEY.length > 5 ? WEATHER_KEY : null;
      if (!key) { alert('Add your OpenWeather API key in Shopify Theme Settings to use auto-locate.'); return; }
      fetch('https://api.openweathermap.org/data/2.5/weather?lat=' + pos.coords.latitude + '&lon=' + pos.coords.longitude + '&appid=' + key + '&units=metric')
        .then(r => r.json())
        .then(d => mnShowWeather(d.name, d.main.temp, d.weather[0].main, d.main.humidity))
        .catch(e => alert('Location weather failed: ' + e.message));
    },
    () => alert('Location access denied. Please enter your city manually.')
  );
}

// â”€â”€ Bank cards â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnPopulateCardVariants() {
  const bank = document.getElementById('mn-bank-select').value;
  const sel  = document.getElementById('mn-card-variant-select');
  sel.innerHTML = '<option value="">Select Card Variant</option>';
  if (bank && BANK_CARDS[bank]) {
    BANK_CARDS[bank].forEach(c => {
      const o = document.createElement('option'); o.value = c; o.textContent = c; sel.appendChild(o);
    });
  }
}

function mnAddBankCard() {
  const bank    = document.getElementById('mn-bank-select').value;
  const variant = document.getElementById('mn-card-variant-select').value;
  if (!bank || !variant) return;
  if (!Array.isArray(mnProfile.bank_cards)) mnProfile.bank_cards = [];
  if (mnProfile.bank_cards.some(c => c.bank === bank && c.variant === variant)) return;
  mnProfile.bank_cards.push({ bank, variant });
  mnRenderCardTags();
  mnSetCheck('bank', true); mnUpdateProgress(); mnSaveToStorage();
  document.getElementById('mn-bank-select').value = '';
  document.getElementById('mn-card-variant-select').innerHTML = '<option value="">Select Card Variant</option>';
}

function mnRenderCardTags() {
  const container = document.getElementById('mn-card-tags');
  if (!container) return;
  container.innerHTML = '';
  (mnProfile.bank_cards || []).forEach((c, i) => {
    const tag = document.createElement('div');
    tag.className = 'mn-card-tag mn-pop-in';
    tag.innerHTML = '<span>ðŸ’³ ' + c.bank + ' ' + c.variant + '</span><span class="mn-card-tag-remove" onclick="mnRemoveCard(' + i + ')">&times;</span>';
    container.appendChild(tag);
  });
  // Show discount chips for all saved banks
  const dc = document.getElementById('mn-discount-chips');
  if (dc) {
    dc.innerHTML = '';
    const seen = new Set();
    (mnProfile.bank_cards || []).forEach(c => {
      if (!seen.has(c.bank) && BANK_OFFERS[c.bank]) {
        seen.add(c.bank);
        BANK_OFFERS[c.bank].forEach(offer => {
          const chip = document.createElement('div');
          chip.className = 'mn-discount-chip';
          chip.innerHTML = 'ðŸŽ ' + offer + ' <span style="font-size:9px;opacity:0.6">(' + c.bank + ')</span>';
          dc.appendChild(chip);
        });
      }
    });
  }
}

function mnRemoveCard(i) {
  mnProfile.bank_cards.splice(i, 1);
  mnRenderCardTags();
  mnSetCheck('bank', (mnProfile.bank_cards||[]).length > 0);
  mnUpdateProgress(); mnSaveToStorage();
}

// â”€â”€ Interests â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function mnToggleInterest(btn, label) {
  btn.classList.toggle('selected');
  if (!Array.isArray(mnProfile.interests)) mnProfile.interests = [];
  if (btn.classList.contains('selected')) {
    if (!mnProfile.interests.includes(label)) mnProfile.interests.push(label);
  } else {
    mnProfile.interests = mnProfile.interests.filter(i => i !== label);
  }
  mnSetCheck('interests', mnProfile.interests.length > 0);
  mnUpdateProgress(); mnSaveToStorage();
}

function mnAddCustomInterest() {
  const input = document.getElementById('mn-interest-custom');
  const val = (input.value || '').trim();
  if (!val) return;
  if (!Array.isArray(mnProfile.interests)) mnProfile.interests = [];
  if (!mnProfile.interests.includes(val)) {
    mnProfile.interests.push(val);
    const chip = document.createElement('button');
    chip.className = 'mn-chip selected mn-pop-in';
    chip.textContent = val;
    chip.onclick = function() { this.classList.toggle('selected'); mnProfile.interests = mnProfile.interests.filter(i => i !== val); mnUpdateProgress(); mnSaveToStorage(); };
    document.getElementById('mn-custom-interests').appendChild(chip);
  }
  input.value = '';
  mnSetCheck('interests', true); mnUpdateProgress(); mnSaveToStorage();

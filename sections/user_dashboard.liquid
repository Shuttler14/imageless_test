function mnSaveToStorage() {
  mnProfile.completion_pct = mnCalcCompletion();
  mnSet(MN_STORE_KEY, mnProfile);
  // Fire event so chatbot + any listeners know profile changed
  window.dispatchEvent(new CustomEvent('mn-identity-updated', { detail: { ...mnProfile } }));

{% comment %}
  1. LOGIN GATE: Redirect users to login if they are not signed in.
{% endcomment %}
{% unless customer %}
  <script>
    window.location.href = "/account/login";
  </script>
{% else %}

<style>
  /* =========================================
     EXACT STYLES EXTRACTED FROM NAVBAR SEARCH
     ========================================= */
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* Mobile: 2 columns */
    gap: 20px 16px;
  }
  
  @media (min-width: 768px) {
    .wishlist-grid {
      grid-template-columns: repeat(4, 1fr); /* Desktop: 4 columns */
      gap: 30px 24px;
    }
  }

  .search-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    position: relative;
    text-align: left;
    animation: fadeIn 0.4s ease forwards;
  }

  .search-card-img {
    width: 100%;
    aspect-ratio: 0.8; /* Exact match */
    border-radius: 0;
    overflow: hidden;
    background: #1a1a1a;
    margin-bottom: 10px;
    position: relative;
  }

  .search-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Hover Effect */
  .search-card:hover .search-card-img img {
    transform: scale(1.05);
  }

  .search-card-vendor {
    font-size: 10px;
    color: #39A596; /* Brand Green */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
    display: block;
  }

  .search-card-title {
    font-size: 13px;
    color: #fff;
    font-weight: 400;
    line-height: 1.4;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }

  .search-card-price {
    font-size: 13px;
    color: #fff;
    font-weight: 600;
  }

  /* Specific styles for the Remove Button on Wishlist */
  .wishlist-remove-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    z-index: 20;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .wishlist-remove-btn:hover {
    background: rgba(220, 38, 38, 0.8); /* Red on hover */
    border-color: rgba(220, 38, 38, 1);
  }
</style>

<div class="px-4 md:px-6 container max-w-screen-xl mx-auto my-8 md:my-12">
  
  <div class="text-center mb-10">
    <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-2 uppercase heading-font">My Wishlist</h1>
    <div class="h-0.5 w-16 bg-[#39A596] mx-auto"></div>
  </div>

  <div 
    class="wishlist-grid normal-font"
    data-for="wishlist-container"
  >
    </div>
  
  <div id="wishlist-empty-msg" class="hidden text-center py-20 col-span-full">
    <p class="text-gray-400 text-lg uppercase tracking-widest mb-6">Your wishlist is empty</p>
    <a href="/collections/all" class="inline-block border border-white px-8 py-3 text-sm uppercase tracking-widest text-white hover:bg-white hover:text-black transition-colors duration-300">
      Start Shopping
    </a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const container = document.querySelector('[data-for="wishlist-container"]');
  const emptyMsg = document.getElementById('wishlist-empty-msg');
  
  // 1. Get Handles from Local Storage
  const wishlistHandles = JSON.parse(localStorage.getItem('wishlist_items')) || [];

  if (wishlistHandles.length === 0) {
    emptyMsg.classList.remove('hidden');
    return;
  }

  // 2. Fetch Data
  const productPromises = wishlistHandles.map(handle => 
    fetch(`/products/${handle}.js`)
      .then(res => {
        if (!res.ok) throw new Error('Product not found');
        return res.json();
      })
      .catch(err => console.error(err))
  );

  const products = await Promise.all(productPromises);

  // 3. Render Cards
  products.forEach(product => {
    if (product) {
      container.innerHTML += buildProductCard(product);
    }
  });

  if (container.children.length === 0) {
     emptyMsg.classList.remove('hidden');
  }
});

function buildProductCard(product) {
  // --- Exact Logic from Search Bar ---
  const price = '₹' + Math.floor(product.price / 100).toLocaleString('en-IN');
  const subtitle = product.type || 'Unisex'; // Using Type as the "Green Subtitle"

  return `
    <div class="search-card group">
      <div class="search-card-img">
        <a href="${product.url}" class="block w-full h-full">
            <img src="${product.featured_image}" alt="${product.title}" />
        </a>
        
        <button 
          onclick="removeFromWishlist('${product.handle}', this)"
          class="wishlist-remove-btn"
          title="Remove from Wishlist"
        >
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <span class="search-card-vendor">${subtitle}</span>
      <a href="${product.url}" class="search-card-title">${product.title}</a>
      <span class="search-card-price">${price}</span>
    </div>
  `;
}

function removeFromWishlist(handle, btnElement) {
  let wishlist = JSON.parse(localStorage.getItem('wishlist_items')) || [];
  wishlist = wishlist.filter(item => item !== handle);
  localStorage.setItem('wishlist_items', JSON.stringify(wishlist));
  
  // Animate removal
  const card = btnElement.closest('.search-card');
  if(card) {
    card.style.opacity = '0';
    setTimeout(() => card.remove(), 300);
  }
  
  // Check empty state
  if(wishlist.length === 0) {
     setTimeout(() => {
        document.getElementById('wishlist-empty-msg').classList.remove('hidden');
     }, 300);
  }
}
</script>
{% endunless %}

{% schema %}
{
  "name": "Wishlist",
  "settings": []
}
{% endschema %}
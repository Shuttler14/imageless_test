{% comment %}
  MY NARRATIVE - VIRTUAL TRY ON WIDGET
  Uses Glassmorphism UI to match brand identity.
{% endcomment %}

<style>
  /* Floating Trigger Button */
  .mn-vton-trigger {
    width: 100%;
    margin-top: 15px;
    padding: 16px;
    background: linear-gradient(135deg, rgba(57, 165, 150, 0.2), rgba(0, 0, 0, 0.4));
    border: 1px solid #39A596;
    border-radius: 8px;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(57, 165, 150, 0.15);
  }
  
  .mn-vton-trigger:hover {
    background: #39A596;
    color: #000;
    box-shadow: 0 0 25px rgba(57, 165, 150, 0.6);
  }

  /* Modal Overlay */
  .mn-vton-modal {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.92);
    backdrop-filter: blur(10px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .mn-vton-modal.active {
    display: flex;
    opacity: 1;
  }

  /* Modal Content */
  .mn-vton-card {
    background: rgba(20, 20, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 30px;
    width: 90%;
    max-width: 450px;
    position: relative;
    box-shadow: 0 0 50px rgba(57, 165, 150, 0.1);
    text-align: center;
  }

  .mn-vton-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
  }

  /* Steps UI */
  .mn-upload-area {
    border: 2px dashed #39A596;
    border-radius: 12px;
    padding: 40px 20px;
    margin: 20px 0;
    cursor: pointer;
    background: rgba(57, 165, 150, 0.05);
    transition: 0.3s;
  }
  
  .mn-upload-area:hover {
    background: rgba(57, 165, 150, 0.15);
  }

  .mn-vton-image-preview {
    width: 100%;
    border-radius: 12px;
    display: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  /* Loading Animation */
  .mn-loader-bar {
    width: 100%;
    height: 4px;
    background: #333;
    border-radius: 2px;
    overflow: hidden;
    margin-top: 15px;
    display: none;
  }
  .mn-loader-fill {
    height: 100%;
    background: #39A596;
    width: 0%;
    transition: width 0.3s;
    animation: loading 15s linear forwards; /* Approximate generation time */
  }
  @keyframes loading { to { width: 95%; } }

</style>

<button class="mn-vton-trigger" onclick="MNTryOn.open()">
  <span style="font-size: 18px;">✨</span> TRY ON THIS LOOK
</button>

<div id="mn-vton-modal" class="mn-vton-modal">
  <div class="mn-vton-card">
    <button class="mn-vton-close" onclick="MNTryOn.close()">×</button>
    
    <h3 style="font-family:'Montserrat'; color:#fff; margin-bottom:5px;">Virtual Fitting Room</h3>
    <p style="font-size:12px; color:#aaa; margin-bottom:20px;">
      See exactly how the <span style="color:#39A596;">{{ product.title }}</span> looks on you.
    </p>

    <div id="mn-vton-step-upload">
      <div class="mn-upload-area" onclick="document.getElementById('mn-user-upload').click()">
        <div style="font-size:32px; margin-bottom:10px;">📸</div>
        <div style="font-weight:700; color:#fff; font-size:14px;">Upload Your Photo</div>
        <div style="font-size:11px; color:#888; margin-top:5px;">Best results: Good lighting, standing pose</div>
      </div>
      <input type="file" id="mn-user-upload" accept="image/*" style="display:none" onchange="MNTryOn.process(this)">
    </div>

    <div id="mn-vton-step-loading" style="display:none; padding:40px 0;">
      <div style="font-size:14px; color:#fff; font-weight:700; letter-spacing:1px;">WEAVING REALITY...</div>
      <div class="mn-loader-bar"><div class="mn-loader-fill"></div></div>
      <p style="font-size:11px; color:#666; margin-top:10px;">Powered by My Narrative AI Engine</p>
    </div>

    <div id="mn-vton-step-result" style="display:none;">
      <img id="mn-vton-final-image" class="mn-vton-image-preview">
      <button class="mn-vton-trigger" onclick="MNTryOn.reset()" style="margin-top:20px;">🔄 Try Another Photo</button>
    </div>

  </div>
</div>

<script>
  window.MNTryOn = {
    // Determine category based on product type or tags
    category: "{% if product.type contains 'Pant' or product.type contains 'Trouser' %}lower_body{% else %}upper_body{% endif %}",
    productImage: "{{ product.featured_image | image_url: width: 800 }}",
    api: "https://mynarrative-ai.vercel.app/api/virtual_try_on",

    open: () => document.getElementById('mn-vton-modal').classList.add('active'),
    close: () => document.getElementById('mn-vton-modal').classList.remove('active'),
    
    reset: () => {
      document.getElementById('mn-vton-step-upload').style.display = 'block';
      document.getElementById('mn-vton-step-result').style.display = 'none';
      document.getElementById('mn-vton-step-loading').style.display = 'none';
    },

    process: async (input) => {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];

      // UI Switch
      document.getElementById('mn-vton-step-upload').style.display = 'none';
      document.getElementById('mn-vton-step-loading').style.display = 'block';

      // Read File
      const reader = new FileReader();
      reader.onload = async (e) => {
        const base64Img = e.target.result;
        
        try {
          // CALL API
          const response = await fetch(MNTryOn.api, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              mode: 'vton',
              user_image: base64Img,
              garment_image: MNTryOn.productImage,
              category: MNTryOn.category,
              description: "{{ product.title }}"
            })
          });

          const data = await response.json();

          if (data.success) {
            document.getElementById('mn-vton-final-image').src = data.image;
            document.getElementById('mn-vton-final-image').style.display = 'block';
            document.getElementById('mn-vton-step-loading').style.display = 'none';
            document.getElementById('mn-vton-step-result').style.display = 'block';
          } else {
            alert("AI Error: " + (data.error || "Unknown error"));
            MNTryOn.reset();
          }
        } catch (err) {
          console.error(err);
          alert("Connection Failed. Check your internet.");
          MNTryOn.reset();
        }
      };
      reader.readAsDataURL(file);
    }
  };
</script>

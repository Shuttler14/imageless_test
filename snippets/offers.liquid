<div class="mt-1 md:mt-2 text-sm md:text-base ">
  <!-- Top Section (Green ticket style) -->
   <input type="checkbox" id="offer-toggle" class="hidden peer" />
  <label for="offer-toggle" class="relative block cursor-pointer bg-teal-500 rounded-xl p-4 peer-checked:[&_i]:rotate-180 transition-transform duration-300">
    <p class="font-medium text-black">Start your story strong!</p>
    <p class="text-black">Get <span class="font-bold text-black">₹100 off</span> on orders above ₹1000</p>
     <i class="bi bi-chevron-down text-black absolute top-1/2 transform -translate-y-1/2 right-5 transition-transform duration-300"></i>

    <div class="absolute top-1/2 -left-2 w-4 h-4 bg-black rounded-full transform -translate-y-1/2"></div>
    <div class="absolute top-1/2 -right-2 w-4 h-4 bg-black rounded-full transform -translate-y-1/2"></div>
  </label>

  <!-- Offer Cards -->
  <div class="pt-2 max-h-0 peer-checked:max-h-[1000px] transition-height duration-300 overflow-hidden ">
    {% comment %} <div class="bg-gray-100 p-4 rounded-t-xl">
      <p class="font-medium text-black">Elevate your edit!</p>
      <p class="text-black">Get <span class="font-bold text-black">₹400 off</span> on orders above ₹1500</p>
    </div> {% endcomment %}

    <div class="bg-gray-100 p-4 rounded-t-xl">
      <p class="font-medium text-black">Your story must have a voice</p>
      <p class="text-black"><span class="font-bold text-black">₹200 off

      {% comment %} </span> + <span
          class="font-bold text-black">₹200</span> voucher  {% endcomment %}
          on orders above ₹2000</p>
    </div>

    <div class="bg-gray-100 p-4 border-t border-b border-black rounded-b-xl">
      <p class="font-medium text-black">Let your personality speak!</p>
      <p class="text-black"><span class="font-bold text-black">₹300 off

      {% comment %} </span> + <span
          class="font-bold text-black">₹300</span> voucher {% endcomment %}
           on orders above ₹3000</p>
    </div>
  </div>
</div>

<div class="max-w-[500px] bg-white mt-8 text-black mx-4 md:mx-6 p-8 w-full" data-for="forget-password-form">
    <h2 class="text-2xl md:text-4xl text-center mb-6 md:mb-9 lg:mb-14">Activate Account</h2>
    {% form 'create_customer' %}
        <div class="mb-2 text-red-500">
            {{ form.errors | default_errors }}
            </div>
            <div class="flex flex-col gap-4 md:gap-6">
        <input type="password" value="" name="customer[password]" placeholder="Enter Your Password" class="border p-1 md:p-2 focus:outline-none w-full " />
        <input type="password" value="" name="customer[password_confirmation]" placeholder="Confirm Password" class="border p-1 md:p-2 focus:outline-none w-full " />
        <button type="submit" class="border p-1 md:p-2 uppercase text-xl md:text-2xl bg-black text-white hover:bg-white hover:text-black transition-all shadow-inner ">Activate Account</button>
        <button type="submit" name="decline" class="border p-1 md:p-2 uppercase text-sm md:text-xl bg-red-600 text-white hover:bg-white hover:text-black transition-all shadow-inner ">Decline Invitation</button>
    </div>
    {% endform %}
</div>

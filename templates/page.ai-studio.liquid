<script>
document.addEventListener('DOMContentLoaded', function() {
  // Check if user is logged in
  const isLoggedIn = {{ is_logged_in }};
  
  // Function to show the buy-to-publish modal
  window.showBuyToPublishModal = function() {
    document.getElementById('mnBuyToPublishModal').classList.add('active');
    
    if (isLoggedIn) {
      document.getElementById('mnAuthSection').style.display = 'none';
      document.getElementById('mnCheckoutSection').style.display = 'block';
    } else {
      document.getElementById('mnAuthSection').style.display = 'block';
      document.getElementById('mnCheckoutSection').style.display = 'none';
    }
  };
  
  // Function to hide the modal
  window.hideBuyToPublishModal = function() {
    document.getElementById('mnBuyToPublishModal').classList.remove('active');
  };
  
  // Cancel button
  document.getElementById('mnCancelBuyToPublish')?.addEventListener('click', hideBuyToPublishModal);
  
  // Proceed to checkout
  document.getElementById('mnProceedToCheckout')?.addEventListener('click', async function() {
    // Pull design data from runtime state first, then local storage fallback.
    const stateDesign = (typeof window !== 'undefined' && window.state) ? window.state : {};
    const storedDesign = JSON.parse(localStorage.getItem('mn_current_design') || '{}');
    const designData = {
      uuid: stateDesign.design_uuid || stateDesign.designUuid || storedDesign.uuid || storedDesign.design_uuid || '',
      imageUrl: stateDesign.imageUrl || stateDesign.image_url || storedDesign.imageUrl || storedDesign.image_url || ''
    };

    if (!designData.uuid || !designData.imageUrl) {
      alert('Please generate a design first');
      return;
    }
    
    this.disabled = true;
    this.textContent = 'Adding Sample Kit...';
    
    try {
      // TODO: Replace placeholder variant ID with the real Shopify Variant ID
      // for the "Creator Sample Kit" base product in this store.
      const SAMPLE_KIT_VARIANT_ID = 48593020184756;

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: SAMPLE_KIT_VARIANT_ID,
            quantity: 1,
            properties: {
              '_design_uuid': designData.uuid,
              '_is_sample_kit': 'true',
              'Design Image': designData.imageUrl
            }
          }]
        })
      });

      if (!response.ok) {
        // TASK 6b: Specific alert for cart errors to guide debugging
        alert("Cart Error: Please ensure the correct Variant ID is set in page.ai-studio.liquid.");
        const errorText = await response.text();
        throw new Error(errorText || 'Failed to add sample kit to cart');
      }

      window.location.href = '/checkout';
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
      this.disabled = false;
      this.textContent = 'Proceed to Checkout';
    }
  });
  
  // Close modal on overlay click
  document.getElementById('mnBuyToPublishModal').addEventListener('click', function(e) {
    if (e.target === this) {
      hideBuyToPublishModal();
    }
  });
});
</script>


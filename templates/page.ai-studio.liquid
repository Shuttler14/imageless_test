<!-- AI Design Studio Page — header/footer isolation fix -->
<style>
  /* Prevent the design studio content from breaking the theme header/footer */
  .mn-ai-studio-wrapper {
    position: relative;
    width: 100%;
    overflow-x: hidden;
    /* Reset any inherited fixed/absolute positioning from page content */
    isolation: isolate;
  }
  /* Ensure the header stays on top of any z-index from studio content */
  #shopify-section-header,
  .site-header,
  header[role="banner"],
  .header-wrapper,
  #shopify-section-group-header-group {
    position: sticky !important;
    top: 0 !important;
    z-index: 9999 !important;
  }
  /* Ensure footer renders normally below studio content */
  #shopify-section-footer,
  footer[role="contentinfo"],
  .site-footer {
    position: relative !important;
    z-index: 1 !important;
  }
  /* Fix any full-bleed containers inside page content */
  .mn-ai-studio-wrapper > * {
    max-width: 100vw;
    box-sizing: border-box;
  }
  /* Prevent any rogue body margin/padding from page content injecting styles */
  .mn-ai-studio-wrapper [style*="position: fixed"],
  .mn-ai-studio-wrapper [style*="position:fixed"] {
    position: absolute !important;
  }
</style>

<div class="mn-ai-studio-wrapper">
{% assign is_logged_in = false %}
{% if customer.id != blank %}
  {% assign is_logged_in = true %}
{% endif %}
{{ page.content }}
</div>

{% comment %} Buy-to-Publish Modal {% endcomment %}
<div class="mn-modal-overlay" id="mnBuyToPublishModal">
  <div class="mn-modal" style="max-width: 500px; text-align: center;">
    <div style="width: 80px; height: 80px; margin: 0 auto 20px; background: linear-gradient(135deg, #39A596, #2dd4bf); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
        <path d="M2 17l10 5 10-5"/>
        <path d="M2 12l10 5 10-5"/>
      </svg>
    </div>
    <h3 class="mn-modal-title" style="font-size: 22px; margin-bottom: 12px;">Own & Drop This Design</h3>
    <p style="color: rgba(255,255,255,0.7); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
      To list this design on the My Narrative marketplace and earn up to <strong style="color: #39A596;">45% commission</strong>, you must own the first piece. Let's get it to your door.
    </p>
    
    <div id="mnAuthSection">
      <p style="color: rgba(255,255,255,0.5); font-size: 13px; margin-bottom: 16px;">
        Sign in or create an account to continue
      </p>
      <a href="{{ routes.account_login_url }}?return_url=/pages/ai-studio" class="mn-onboarding-btn" style="display: block; text-decoration: none; box-sizing: border-box;">
        Sign In / Create Account
      </a>
    </div>

    <div id="mnCheckoutSection" style="display: none;">
      <p style="color: rgba(255,255,255,0.5); font-size: 13px; margin-bottom: 16px;">
        Ready to own this design? You'll receive the physical piece and your design will be published automatically.
      </p>
      <button class="mn-onboarding-btn" id="mnProceedToCheckout" style="width: 100%; box-sizing: border-box;">
        Proceed to Checkout
      </button>
    </div>
    
    <p style="color: rgba(255,255,255,0.4); font-size: 12px; margin-top: 16px; cursor: pointer;" id="mnCancelBuyToPublish">
      Maybe later
    </p>
  </div>
</div>

<style>
  .mn-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 10000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(8px);
  }
  
  .mn-modal-overlay.active {
    display: flex;
  }
  
  .mn-modal {
    background: #111;
    border: 1px solid rgba(57, 165, 150, 0.3);
    border-radius: 20px;
    padding: 32px;
    max-width: 400px;
    width: 100%;
    position: relative;
    z-index: 10001;
    animation: modalSlideIn 0.3s ease;
  }
  
  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .mn-onboarding-btn {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, #39A596, #2dd4bf);
    border: none;
    border-radius: 12px;
    color: #000;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .mn-onboarding-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(57, 165, 150, 0.4);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Check if user is logged in
  const isLoggedIn = {{ is_logged_in }};
  
  // Function to show the buy-to-publish modal
  window.showBuyToPublishModal = function() {
    document.getElementById('mnBuyToPublishModal').classList.add('active');
    
    if (isLoggedIn) {
      document.getElementById('mnAuthSection').style.display = 'none';
      document.getElementById('mnCheckoutSection').style.display = 'block';
    } else {
      document.getElementById('mnAuthSection').style.display = 'block';
      document.getElementById('mnCheckoutSection').style.display = 'none';
    }
  };
  
  // Function to hide the modal
  window.hideBuyToPublishModal = function() {
    document.getElementById('mnBuyToPublishModal').classList.remove('active');
  };
  
  // Cancel button
  document.getElementById('mnCancelBuyToPublish')?.addEventListener('click', hideBuyToPublishModal);
  
  // Proceed to checkout
  document.getElementById('mnProceedToCheckout')?.addEventListener('click', async function() {
    // Get the current design data from localStorage or state
    const designData = JSON.parse(localStorage.getItem('mn_current_design') || '{}');
    
    if (!designData.imageUrl) {
      alert('Please generate a design first');
      return;
    }
    
    this.disabled = true;
    this.textContent = 'Creating Product...';
    
    try {
      const response = await fetch('https://mynarrative-ai.vercel.app/api/shopify_product', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: '/api/shopify/create_draft_product',
          creator_id: '{{ customer.id }}',
          title: designData.title || 'My Custom Design',
          description: designData.description || 'AI-generated design',
          image_url: designData.imageUrl,
          price: 1299,
          customer_id: '{{ customer.id }}'
        })
      });
      
      const result = await response.json();
      
      if (result.success && result.data.checkout_url) {
        window.location.href = result.data.checkout_url;
      } else if (result.success && result.data.variant_id) {
        // Redirect to cart with the variant
        window.location.href = `https://mynarrative.in/cart/${result.data.variant_id}:1`;
      } else {
        alert('Failed to create product. Please try again.');
        this.disabled = false;
        this.textContent = 'Proceed to Checkout';
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
      this.disabled = false;
      this.textContent = 'Proceed to Checkout';
    }
  });
  
  // Close modal on overlay click
  document.getElementById('mnBuyToPublishModal').addEventListener('click', function(e) {
    if (e.target === this) {
      hideBuyToPublishModal();
    }
  });
});
</script>

<!-- 🎁 GIFT MODE RECEIVER SCRIPT (Enhanced with Psychological UX) -->

          }, 200);

          // 4. Auto-Skip to Step 3 - Wait for function to be ready
          const jumpToStep3 = () => {
            if (typeof goToStep === 'function') {
              console.log("🚀 Jumping to Step 3...");
              goToStep(3);
            } else {
              console.log("⏳ Waiting for goToStep function...");
              setTimeout(jumpToStep3, 200);
            }
          };
          setTimeout(jumpToStep3, 300);
        } else {
          console.warn("⚠️ State object not found");
        }
      }
      
      // Clear only gift-mode payloads; keep creator pending designs intact.
      if (data && data.slogan) {
        localStorage.removeItem('mn_pending_design');

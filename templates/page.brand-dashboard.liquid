<div class="page-width">
  <div class="brand-dashboard" style="padding:40px 0;">
    <!-- Dashboard Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;">
      <div>
        <h1 style="margin-bottom:4px;">Brand Dashboard</h1>
        <p style="color:#666;font-size:0.9rem;">Manage your AI Stylist, catalog, and syndicate partnerships.</p>
      </div>
      <div style="display:flex;gap:12px;">
        <button id="btn-snippet" style="padding:10px 20px;border-radius:8px;border:1px solid #ddd;background:white;cursor:pointer;font-size:0.9rem;">Get Snippet</button>
        <button id="btn-settings" style="padding:10px 20px;border-radius:8px;border:1px solid #ddd;background:white;cursor:pointer;font-size:0.9rem;">Settings</button>
      </div>
    </div>

    <!-- Stats Cards -->
    <div id="stats-cards" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:40px;">
      <div style="background:white;border:1px solid #eee;border-radius:12px;padding:20px;">
        <div style="color:#888;font-size:0.85rem;margin-bottom:8px;">Recommendations</div>
        <div style="font-size:1.8rem;font-weight:700;" id="stat-recs">0</div>
        <div style="color:#39A596;font-size:0.8rem;">+12% this week</div>
      </div>
      <div style="background:white;border:1px solid #eee;border-radius:12px;padding:20px;">
        <div style="color:#888;font-size:0.85rem;margin-bottom:8px;">Conversions</div>
        <div style="font-size:1.8rem;font-weight:700;" id="stat-conversions">0</div>
        <div style="color:#39A596;font-size:0.8rem;">3.2% rate</div>
      </div>
      <div style="background:white;border:1px solid #eee;border-radius:12px;padding:20px;">
        <div style="color:#888;font-size:0.85rem;margin-bottom:8px;">Revenue Driven</div>
        <div style="font-size:1.8rem;font-weight:700;" id="stat-revenue">$0</div>
        <div style="color:#39A596;font-size:0.8rem;">$1,240 this month</div>
      </div>
      <div style="background:white;border:1px solid #eee;border-radius:12px;padding:20px;">
        <div style="color:#888;font-size:0.85rem;margin-bottom:8px;">Affiliate Earnings</div>
        <div style="font-size:1.8rem;font-weight:700;color:#39A596;" id="stat-earnings">$0</div>
        <div style="color:#888;font-size:0.8rem;">Pending payout</div>
      </div>
    </div>

    <!-- Tabs -->
    <div style="display:flex;gap:0;border-bottom:2px solid #eee;margin-bottom:24px;">
      <button class="tab-btn active" data-tab="syndicate" style="padding:12px 24px;border:none;background:transparent;font-size:0.95rem;cursor:pointer;border-bottom:2px solid #39A596;margin-bottom:-2px;">Syndicate Partners</button>
      <button class="tab-btn" data-tab="catalog" style="padding:12px 24px;border:none;background:transparent;font-size:0.95rem;cursor:pointer;color:#888;">Catalog</button>
      <button class="tab-btn" data-tab="analytics" style="padding:12px 24px;border:none;background:transparent;font-size:0.95rem;cursor:pointer;color:#888;">Analytics</button>
      <button class="tab-btn" data-tab="settings" style="padding:12px 24px;border:none;background:transparent;font-size:0.95rem;cursor:pointer;color:#888;">Settings</button>
    </div>

    <!-- Syndicate Tab -->
    <div id="tab-syndicate" class="tab-content">
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;">
        <!-- Partner List -->
        <div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 style="margin:0;">Your Partners</h3>
            <button id="btn-find-partners" style="padding:8px 16px;border-radius:6px;border:none;background:#39A596;color:white;cursor:pointer;font-size:0.85rem;">+ Find Partners</button>
          </div>
          
          <div id="partners-list" style="display:flex;flex-direction:column;gap:12px;">
            <!-- Partners loaded dynamically -->
            <div style="background:#f8f9fa;border-radius:8px;padding:24px;text-align:center;color:#888;">
              No partners yet. Click "Find Partners" to get started.
            </div>
          </div>
        </div>

        <!-- Syndicate Settings -->
        <div>
          <h3 style="margin-bottom:16px;">Syndicate Rules</h3>
          
          <div style="background:white;border:1px solid #eee;border-radius:12px;padding:20px;">
            <div style="margin-bottom:16px;">
              <label style="display:block;margin-bottom:8px;font-weight:500;font-size:0.9rem;">Allow Other Brands to Show:</label>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <label style="display:flex;align-items:center;gap:4px;font-size:0.85rem;">
                  <input type="checkbox" class="syndicate-cat" value="bottom" checked> Bottoms
                </label>
                <label style="display:flex;align-items:center;gap:4px;font-size:0.85rem;">
                  <input type="checkbox" class="syndicate-cat" value="footwear" checked> Footwear
                </label>
                <label style="display:flex;align-items:center;gap:4px;font-size:0.85rem;">
                  <input type="checkbox" class="syndicate-cat" value="accessory" checked> Accessories
                </label>
                <label style="display:flex;align-items:center;gap:4px;font-size:0.85rem;">
                  <input type="checkbox" class="syndicate-cat" value="outerwear"> Outerwear
                </label>
              </div>
            </div>

            <div style="margin-bottom:16px;">
              <label style="display:block;margin-bottom:8px;font-weight:500;font-size:0.9rem;">Commission Rate (Host):</label>
              <div style="display:flex;align-items:center;gap:8px;">
                <input type="range" id="commission-rate" min="3" max="15" value="7" style="flex:1;">
                <span id="commission-display" style="font-weight:600;min-width:40px;">7%</span>
              </div>
              <div style="font-size:0.8rem;color:#888;margin-top:4px;">You earn this on partner sales from your site</div>
            </div>

            <div style="margin-bottom:16px;">
              <label style="display:block;margin-bottom:8px;font-weight:500;font-size:0.9rem;">Price Tier Matching:</label>
              <select id="price-tier" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-size:0.9rem;">
                <option value="any">Any Price Point</option>
                <option value="value">Budget (Under ₹1,500)</option>
                <option value="mid">Mid-Range (₹1,500–3,500)</option>
                <option value="premium">Premium (₹3,500+)</option>
              </select>
            </div>

            <button id="btn-save-rules" style="width:100%;padding:10px;border-radius:6px;border:none;background:#39A596;color:white;cursor:pointer;font-size:0.9rem;">Save Rules</button>
          </div>

          <!-- Earnings Summary -->
          <div style="background:linear-gradient(135deg,#39A596,#2d8a7d);border-radius:12px;padding:20px;margin-top:16px;color:white;">
            <h4 style="margin:0 0 12px;font-size:0.95rem;">Syndicate Earnings</h4>
            <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
              <span style="opacity:0.8;font-size:0.85rem;">This Month</span>
              <span style="font-weight:600;">$342.50</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
              <span style="opacity:0.8;font-size:0.85rem;">All Time</span>
              <span style="font-weight:600;">$2,847.20</span>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,0.2);padding-top:8px;margin-top:8px;">
              <button style="width:100%;padding:8px;border-radius:6px;border:1px solid white;background:transparent;color:white;cursor:pointer;font-size:0.85rem;">View Payout History</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Find Partners Modal -->
    <div id="find-partners-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;display:none;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:16px;width:600px;max-height:80vh;overflow:hidden;">
        <div style="padding:20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
          <h3 style="margin:0;">Find Partner Brands</h3>
          <button id="close-modal" style="border:none;background:none;font-size:1.2rem;cursor:pointer;">&times;</button>
        </div>
        <div style="padding:20px;overflow-y:auto;max-height:60vh;">
          <input type="text" id="partner-search" placeholder="Search brands..." style="width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;margin-bottom:16px;">
          
          <div id="partner-results" style="display:flex;flex-direction:column;gap:12px;">
            <!-- Results loaded dynamically -->
          </div>
        </div>
      </div>
    </div>

    <!-- Other Tabs (Placeholder) -->
    <div id="tab-catalog" class="tab-content" style="display:none;">
      <h3>Product Catalog</h3>
      <p style="color:#666;">Your catalog is automatically synced from your store.</p>
      <button style="padding:10px 20px;border-radius:8px;border:1px solid #39A596;background:white;color:#39A596;cursor:pointer;">Sync Now</button>
    </div>

    <div id="tab-analytics" class="tab-content" style="display:none;">
      <h3>Analytics</h3>
      <p style="color:#666;">Detailed analytics coming soon.</p>
    </div>

    <div id="tab-settings" class="tab-content" style="display:none;">
      <h3>Widget Settings</h3>
      <p style="color:#666;">Customize your widget appearance.</p>
    </div>
  </div>
</div>

<script>
// Tab switching
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.onclick = function() {
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); b.style.color = '#888'; b.style.borderBottom = 'none'; });
    btn.classList.add('active');
    btn.style.color = '#39A596';
    btn.style.borderBottom = '2px solid #39A596';
    
    document.querySelectorAll('.tab-content').forEach(function(c) { c.style.display = 'none'; });
    document.getElementById('tab-' + btn.getAttribute('data-tab')).style.display = 'block';
  };
});

// Commission rate slider
document.getElementById('commission-rate').oninput = function() {
  document.getElementById('commission-display').textContent = this.value + '%';
};

// Find partners modal
document.getElementById('btn-find-partners').onclick = function() {
  document.getElementById('find-partners-modal').style.display = 'flex';
};

document.getElementById('close-modal').onclick = function() {
  document.getElementById('find-partners-modal').style.display = 'none';
};

// Save rules
document.getElementById('btn-save-rules').onclick = function() {
  var categories = Array.from(document.querySelectorAll('.syndicate-cat:checked')).map(function(c) { return c.value; });
  var commission = parseInt(document.getElementById('commission-rate').value) / 100;
  
  fetch('/api/syndicate/rules', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      allowed_categories: categories,
      affiliate_commission_rate: commission
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    alert('Rules saved!');
  })
  .catch(function(err) {
    alert('Error: ' + err.message);
  });
};

// Load partners on page load
fetch('/api/syndicate/partners')
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var list = document.getElementById('partners-list');
    if (data.as_host && data.as_host.length > 0) {
      list.innerHTML = data.as_host.map(function(p) {
        return '<div style="background:white;border:1px solid #eee;border-radius:8px;padding:16px;display:flex;justify-content:space-between;align-items:center;">'
          + '<div><div style="font-weight:600;">' + (p.guest_brand ? p.guest_brand.name : 'Partner') + '</div>'
          + '<div style="font-size:0.85rem;color:#888;">' + p.total_conversions + ' conversions</div></div>'
          + '<div style="text-align:right;"><div style="font-weight:600;color:#39A596;">$' + (p.total_commissions_earned || 0).toFixed(2) + '</div>'
          + '<div style="font-size:0.8rem;color:#888;">earned</div></div></div>';
      }).join('');
    }
  });
</script>


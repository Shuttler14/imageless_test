{% layout none %}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Brand Dashboard — Narrative Ads</title>
  <link rel="stylesheet" href="https://mynarrative.store/cdn/shop/t/3/assets/brand-dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://mynarrative.store/cdn/shop/t/3/assets/brand-dashboard.js?v=2" defer></script>
  <meta name="brand-id" content="7fcf3029-86e6-43ab-a256-9518d32458f8">
  <meta name="brand-name" content="Zara">
</head>
<body>
<div class="dashboard-layout">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="sidebar-logo-icon">N</div>
      <div class="sidebar-logo-text">NARRATIVE <span>ADS</span></div>
    </div>

    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Main</div>
      <a class="sidebar-nav-item active" data-nav="overview">
        <span class="sidebar-nav-icon">&#9680;</span>
        <span class="sidebar-nav-label">Overview</span>
      </a>
      <a class="sidebar-nav-item" data-nav="campaigns">
        <span class="sidebar-nav-icon">&#9672;</span>
        <span class="sidebar-nav-label">Campaigns</span>
      </a>
      <a class="sidebar-nav-item" data-nav="products">
        <span class="sidebar-nav-icon">&#9673;</span>
        <span class="sidebar-nav-label">Products</span>
      </a>
      <a class="sidebar-nav-item" data-nav="partners">
        <span class="sidebar-nav-icon">&#9674;</span>
        <span class="sidebar-nav-label">Partner Brands</span>
      </a>
      <div class="sidebar-section-label">Network</div>
      <a class="sidebar-nav-item" data-nav="settings">
        <span class="sidebar-nav-icon">&#9678;</span>
        <span class="sidebar-nav-label">Network Settings</span>
      </a>
      <a class="sidebar-nav-item" data-nav="analytics">
        <span class="sidebar-nav-icon">&#9681;</span>
        <span class="sidebar-nav-label">Analytics</span>
      </a>
      <div class="sidebar-section-label">Account</div>
      <a class="sidebar-nav-item" data-nav="wallet">
        <span class="sidebar-nav-icon">&#9682;</span>
        <span class="sidebar-nav-label">Billing & Wallet</span>
      </a>
    </nav>

    <div class="sidebar-bottom">
      <div class="sidebar-brand-info">
        <div class="sidebar-brand-avatar" id="header-avatar">Z</div>
        <div class="sidebar-brand-details">
          <div class="sidebar-brand-name" id="brand-display-name">Zara</div>
          <div class="sidebar-brand-plan">Growth Plan</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="dashboard-main">
    <header class="top-header">
      <div class="header-left">
        <button class="mobile-menu-btn" id="mobile-menu-btn">&#9776;</button>
        <h1 class="header-title" id="header-title">Overview</h1>
        <div class="header-breadcrumb">
          <span>/</span>
          <span id="breadcrumb-view">Overview</span>
        </div>
      </div>
      <div class="header-right">
        <div class="header-search">
          <span class="header-search-icon">&#128269;</span>
          <input type="text" placeholder="Search...">
        </div>
        <button class="header-action-btn" title="Notifications">
          &#128276;
          <span class="header-notification-dot"></span>
        </button>
        <div class="header-avatar" id="header-avatar-circle">Z</div>
      </div>
    </header>

    <div class="dashboard-content" id="dashboard-content">
      <div class="stats-grid">
        <div class="stat-card skeleton skeleton-card"></div>
        <div class="stat-card skeleton skeleton-card"></div>
        <div class="stat-card skeleton skeleton-card"></div>
        <div class="stat-card skeleton skeleton-card"></div>
      </div>
    </div>
  </main>
</div>

<div class="mobile-overlay" id="mobile-overlay"></div>
</body>
</html>

<script>
// Plan selection
document.querySelectorAll('.plan-select-btn').forEach(function(btn) {
  btn.onclick = function() {
    var plan = btn.getAttribute('data-plan');
    document.getElementById('selected-plan').value = plan;
    document.querySelector('.brand-plans').style.display = 'none';
    document.getElementById('brand-registration').style.display = 'block';
    window.scrollTo({ top: document.getElementById('brand-registration').offsetTop - 100, behavior: 'smooth' });
  };
});

// Form submission
document.getElementById('brand-form').onsubmit = function(e) {
  e.preventDefault();
  
  var submitBtn = this.querySelector('button[type="submit"]');
  var originalText = submitBtn.textContent;
  submitBtn.textContent = 'Creating...';
  submitBtn.disabled = true;
  
  fetch('/api/brand/register', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      name: document.getElementById('brand-name').value,
      domain: document.getElementById('brand-domain').value.replace(/https?:\/\//, ''),
      contact_email: document.getElementById('brand-email').value,
      contact_name: document.getElementById('brand-contact').value,
      plan_tier: document.getElementById('selected-plan').value
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      alert('Error: ' + data.error);
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
      return;
    }
    
    document.getElementById('brand-registration').style.display = 'none';
    document.getElementById('brand-snippet').style.display = 'block';
    
    var apiKey = data.api_key || '';
    var snippet = '<!-- MyNarrative AI Stylist - Conversion Engine -->\n'
      + '<script src="https://widget.mynarrative.store/mn-embed.js"\n'
      + '        data-api-key="' + apiKey + '"\n'
      + '        data-position="bottom-right"\n'
      + '        data-theme="dark"\n'
      + '        async defer><\/script>\n'
      + '<!-- End MyNarrative Widget -->';
    
    document.getElementById('snippet-code').textContent = snippet;
  })
  .catch(function(err) {
    alert('Error: ' + err.message);
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  });
};

// Copy snippet
document.getElementById('copy-snippet').onclick = function() {
  navigator.clipboard.writeText(document.getElementById('snippet-code').textContent).then(function() {
    document.getElementById('copy-snippet').textContent = 'Copied!';
    setTimeout(function() { document.getElementById('copy-snippet').textContent = 'Copy Code'; }, 2000);
  });
};

// Go to dashboard
document.getElementById('go-dashboard').onclick = function() {
  window.location.href = '/account/login';
};

// ROI Calculator
function updateROI() {
  var visitors = parseInt(document.getElementById('roi-visitors').value) || 100000;
  var conversion = parseFloat(document.getElementById('roi-conversion').value) || 1.5;
  var aov = parseFloat(document.getElementById('roi-aov').value) || 80;
  
  var currentRevenue = visitors * (conversion / 100) * aov;
  var newRevenue = visitors * (conversion * 2 / 100) * aov;
  var gain = newRevenue - currentRevenue;
  var cost = 199 + (newRevenue * 0.015);
  var roi = gain / cost;
  
  document.getElementById('roi-current').textContent = '$' + currentRevenue.toLocaleString();
  document.getElementById('roi-new').textContent = '$' + newRevenue.toLocaleString();
  document.getElementById('roi-gain').textContent = '+$' + gain.toLocaleString() + '/mo';
  document.getElementById('roi-cost').textContent = '$' + Math.round(cost).toLocaleString();
  document.getElementById('roi-gain').nextElementSibling.innerHTML = 
    'You pay $199/mo + 1.5% = <span id="roi-cost" style="font-weight:600;">$' + Math.round(cost).toLocaleString() + '</span>. <strong style="color:#39A596;">ROI: ' + Math.round(roi) + 'x</strong>';
}

['roi-visitors', 'roi-conversion', 'roi-aov'].forEach(function(id) {
  document.getElementById(id).oninput = updateROI;
});
updateROI();
</script>


{% comment %}
=================================================================================
CREATOR DASHBOARD PAGE TEMPLATE
=================================================================================
Displays the creator dashboard for logged-in users
Access: /pages/creator-dashboard
=================================================================================
{% endcomment %}

<div class="creator-dashboard-page">
  {% section 'creator-dashboard' %}
</div>

{% schema %}
{
  "name": "Creator Dashboard",
  "templates": ["page"],
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API Base URL",
      "default": "https://api.mynarrative.store"
    }
  ]
}
{% endschema %}
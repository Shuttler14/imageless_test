{{ 'MN-stylist-wizard-v4.css' | asset_url | stylesheet_tag }}

<style>
.mn-auth-shell{min-height:100vh;display:flex;align-items:center;justify-content:center;background:#080808;padding:20px}
.mn-auth-card{width:100%;max-width:400px;position:relative;background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.06);border-radius:20px;padding:40px 32px;backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);box-shadow:0 8px 32px rgba(0,0,0,0.4)}
.mn-auth-orb{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none}
.mn-auth-orb--teal{width:200px;height:200px;background:#00bcbcc2;top:-60px;right:-40px;opacity:.18}
.mn-auth-orb--purple{width:160px;height:160px;background:#7c3aedc7;bottom:-40px;left:-30px;opacity:.12}
.mn-auth-logo{text-align:center;margin-bottom:28px}
.mn-auth-logo a{font-family:'DM Sans',sans-serif;font-size:22px;font-weight:800;letter-spacing:-0.02em;color:#fff;text-decoration:none}
.mn-auth-logo a b{color:#00bcbc}
.mn-auth-title{font-size:20px;font-weight:700;color:#fff;margin-bottom:6px;text-align:center}
.mn-auth-sub{font-size:13px;color:rgba(255,255,255,0.5);text-align:center;margin-bottom:24px;line-height:1.5}
.mn-auth-field{margin-bottom:16px}
.mn-auth-label{font-size:11px;color:rgba(255,255,255,0.4);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:6px;display:block}
.mn-auth-input{width:100%;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:15px;font-family:'DM Sans',sans-serif;outline:none;transition:border-color 0.2s;box-sizing:border-box}
.mn-auth-input:focus{border-color:rgba(0,188,188,0.4)}
.mn-auth-input::placeholder{color:rgba(255,255,255,0.25)}
.mn-auth-btn{width:100%;padding:13px;border-radius:12px;border:none;background:linear-gradient(135deg,#00bcbc,#00a3a3);color:#fff;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'DM Sans',sans-serif}
.mn-auth-btn:hover{filter:brightness(1.1);transform:translateY(-1px)}
.mn-auth-btn:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.mn-auth-btn--ghost{background:transparent;border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.6);margin-top:10px}
.mn-auth-btn--ghost:hover{border-color:rgba(255,255,255,0.2);color:#fff}
.mn-auth-divider{display:flex;align-items:center;gap:12px;margin:20px 0}
.mn-auth-divider::before,.mn-auth-divider::after{content:'';flex:1;height:1px;background:rgba(255,255,255,0.06)}
.mn-auth-divider span{font-size:11px;color:rgba(255,255,255,0.3);text-transform:uppercase;letter-spacing:0.08em}
.mn-auth-social{display:flex;gap:10px}
.mn-auth-social-btn{flex:1;padding:11px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:rgba(255,255,255,0.7);font-size:13px;cursor:pointer;text-align:center;transition:all 0.2s;font-family:'DM Sans',sans-serif}
.mn-auth-social-btn:hover{border-color:rgba(255,255,255,0.15);background:rgba(255,255,255,0.06)}
.mn-auth-footer{text-align:center;margin-top:20px;font-size:12px;color:rgba(255,255,255,0.3)}
.mn-auth-footer a{color:rgba(0,188,188,0.8);text-decoration:none}
.mn-auth-error{background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:rgba(255,255,255,0.7);text-align:center}
.mn-auth-success{background:rgba(0,188,188,0.08);border:1px solid rgba(0,188,188,0.2);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:rgba(255,255,255,0.7);text-align:center}
.mn-auth-otp-row{display:flex;gap:8px}
.mn-auth-otp-row .mn-auth-input{flex:1;text-align:center;font-size:20px;letter-spacing:0.3em;font-family:monospace}
</style>

<div class="mn-auth-shell">
  <div class="mn-auth-card">
    <div class="mn-auth-orb mn-auth-orb--teal"></div>
    <div class="mn-auth-orb mn-auth-orb--purple"></div>
    
    <div class="mn-auth-logo">
      <a href="/">my<b>narrative</b></a>
    </div>

    <div id="mn-auth-form">
      <!-- Step 1: Email -->
      <div id="mn-auth-step-email">
        <h1 class="mn-auth-title">Welcome back</h1>
        <p class="mn-auth-sub">Sign in to access your style profile, saved outfits, and personalized recommendations.</p>
        
        <div class="mn-auth-field">
          <label class="mn-auth-label" for="mn-auth-email">Email</label>
          <input class="mn-auth-input" type="email" id="mn-auth-email" placeholder="you@email.com" autocomplete="email">
        </div>
        
        <button class="mn-auth-btn" id="mn-auth-send-btn" onclick="mnAuthSendOtp()">Continue with email</button>
        
        <div class="mn-auth-divider"><span>or</span></div>
        
        <div class="mn-auth-social">
          <button class="mn-auth-social-btn" onclick="mnAuthGoogle()">Google</button>
          <button class="mn-auth-social-btn" onclick="mnAuthPhone()">Phone</button>
        </div>
        
        <p class="mn-auth-footer">By continuing, you agree to our <a href="/pages/terms">Terms</a> and <a href="/pages/privacy">Privacy Policy</a></p>
      </div>

      <!-- Step 2: OTP Verification -->
      <div id="mn-auth-step-otp" style="display:none">
        <h1 class="mn-auth-title">Check your inbox</h1>
        <p class="mn-auth-sub">We sent a 6-digit code to <strong id="mn-auth-email-display"></strong></p>
        
        <div class="mn-auth-field">
          <label class="mn-auth-label" for="mn-auth-otp">Verification code</label>
          <div class="mn-auth-otp-row">
            <input class="mn-auth-input" type="text" inputmode="numeric" id="mn-auth-otp" placeholder="000000" maxlength="6" autocomplete="one-time-code">
          </div>
        </div>
        
        <button class="mn-auth-btn" id="mn-auth-verify-btn" onclick="mnAuthVerifyOtp()">Verify & sign in</button>
        
        <button class="mn-auth-btn mn-auth-btn--ghost" onclick="mnAuthResend()">Resend code</button>
        
        <p class="mn-auth-footer"><a href="#" onclick="mnAuthBackToEmail();return false">← Use a different email</a></p>
      </div>

      <!-- Step 3: Profile Setup (first-time users) -->
      <div id="mn-auth-step-profile" style="display:none">
        <h1 class="mn-auth-title">Set up your profile</h1>
        <p class="mn-auth-sub">Help us personalize your experience.</p>
        
        <div class="mn-auth-field">
          <label class="mn-auth-label" for="mn-auth-name">Display name</label>
          <input class="mn-auth-input" type="text" id="mn-auth-name" placeholder="Your name" autocomplete="name">
        </div>
        
        <div class="mn-auth-field">
          <label class="mn-auth-label">I am</label>
          <div style="display:flex;gap:8px;margin-top:4px">
            <button class="mn-auth-gender-btn" data-gender="male" onclick="mnAuthGender(this)">Male</button>
            <button class="mn-auth-gender-btn" data-gender="female" onclick="mnAuthGender(this)">Female</button>
            <button class="mn-auth-gender-btn" data-gender="non-binary" onclick="mnAuthGender(this)">Non-binary</button>
          </div>
        </div>
        
        <button class="mn-auth-btn" onclick="mnAuthCompleteProfile()">Continue →</button>
        
        <p class="mn-auth-footer"><a href="#" onclick="mnAuthSkipProfile();return false">Skip for now</a></p>
      </div>

      <!-- Error/Success -->
      <div id="mn-auth-message"></div>
    </div>
  </div>
</div>

<style>
.mn-auth-gender-btn{flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:rgba(255,255,255,0.6);font-size:13px;cursor:pointer;text-align:center;transition:all 0.2s;font-family:'DM Sans',sans-serif}
.mn-auth-gender-btn:hover{border-color:rgba(255,255,255,0.15);color:#fff}
.mn-auth-gender-btn.active{border-color:rgba(0,188,188,0.5);color:#00bcbc;background:rgba(0,188,188,0.08)}
</style>

<script>
(function(){
  var API='https://drishti-api.fly.dev';
  var SUPABASE_URL='https://fmganuxtqbquubtvvqdo.supabase.co';
  var SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZ2FudXh0cWJxdXVidHZ2cWRvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MTQ0Njk5OSwiZXhwIjoyMDg3MDIyOTk5fQ.CEdZM4fbkonyxsCmjccgHhwxpLcNvQT_GdiXOB5D6cU';
  var authState={email:'',otp:'',gender:null,stage:'email',busy:false};
  
  window.mnAuthSendOtp=function(){
    var email=document.getElementById('mn-auth-email').value.trim();
    if(!email||!email.includes('@')){mnAuthMsg('Please enter a valid email','error');return;}
    authState.email=email;authState.busy=true;
    mnAuthMsg('Sending code...','info');
    
    fetch(API+'/api/auth/send-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})})
    .then(function(r){return r.json();})
    .then(function(d){
      authState.busy=false;
      if(d.error){mnAuthMsg(d.error,'error');return;}
      authState.stage='otp';
      document.getElementById('mn-auth-step-email').style.display='none';
      document.getElementById('mn-auth-step-otp').style.display='block';
      document.getElementById('mn-auth-email-display').textContent=email;
      mnAuthMsg('','info');
    })
    .catch(function(e){authState.busy=false;mnAuthMsg('Network error. Try again.','error');});
  };
  
  window.mnAuthVerifyOtp=function(){
    var otp=document.getElementById('mn-auth-otp').value.trim();
    if(!otp||otp.length!==6){mnAuthMsg('Enter the 6-digit code','error');return;}
    authState.otp=otp;authState.busy=true;
    mnAuthMsg('Verifying...','info');
    
    fetch(API+'/api/auth/verify-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:authState.email,otp:otp})})
    .then(function(r){return r.json();})
    .then(function(d){
      authState.busy=false;
      if(d.error){mnAuthMsg(d.error,'error');return;}
      if(d.is_new_user){
        authState.stage='profile';
        document.getElementById('mn-auth-step-otp').style.display='none';
        document.getElementById('mn-auth-step-profile').style.display='block';
      }else{
        mnAuthComplete(d);
      }
    })
    .catch(function(e){authState.busy=false;mnAuthMsg('Network error. Try again.','error');});
  };
  
  window.mnAuthResend=function(){
    fetch(API+'/api/auth/send-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:authState.email})})
    .then(function(r){return r.json();})
    .then(function(d){mnAuthMsg(d.error?'Failed to resend':'Code resent!','error');})
    .catch(function(){mnAuthMsg('Network error','error');});
  };
  
  window.mnAuthBackToEmail=function(){
    document.getElementById('mn-auth-step-otp').style.display='none';
    document.getElementById('mn-auth-step-email').style.display='block';
    mnAuthMsg('','info');
  };
  
  window.mnAuthGender=function(btn){
    document.querySelectorAll('.mn-auth-gender-btn').forEach(function(b){b.classList.remove('active');});
    btn.classList.add('active');
    authState.gender=btn.getAttribute('data-gender');
  };
  
  window.mnAuthCompleteProfile=function(){
    var name=document.getElementById('mn-auth-name').value.trim()||authState.email.split('@')[0];
    fetch(API+'/api/auth/complete-profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:authState.email,name:name,gender:authState.gender})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){mnAuthMsg(d.error,'error');return;}
      mnAuthComplete(d);
    })
    .catch(function(){mnAuthMsg('Network error','error');});
  };
  
  window.mnAuthSkipProfile=function(){
    mnAuthComplete({user_id:authState.email,email:authState.email});
  };
  
  window.mnAuthGoogle=function(){mnAuthMsg('Google sign-in coming soon','info');};
  window.mnAuthPhone=function(){mnAuthMsg('Phone sign-in coming soon','info');};
  
  function mnAuthComplete(d){
    try{
      localStorage.setItem('mn_user',JSON.stringify({
        user_id:d.user_id,email:d.email||authState.email,name:d.display_name||d.name,gender:d.gender||authState.gender,token:d.token
      }));
    }catch(e){}
    var redirect= new URLSearchParams(window.location.search).get('redirect')||'/';
    window.location.href=redirect;
  }
  
  function mnAuthMsg(msg,type){
    var el=document.getElementById('mn-auth-message');
    if(!msg){el.innerHTML='';return;}
    el.innerHTML='<div class="mn-auth-'+type+'">'+msg+'</div>';
  }
})();
</script>

{% schema %}
{
  "name": "Login / Signup",
  "class": "mn-login-page",
  "settings": []
}
{% endschema %}

{% comment %} Redirect to Shopify's native customer login {% endcomment %}
<script>
  var params = new URLSearchParams(window.location.search);
  var returnTo = params.get('return_to') || '/pages/stylist';
  window.location.replace('/account/login?return_to=' + encodeURIComponent(returnTo));
</script>
<noscript>
  <meta http-equiv="refresh" content="0;url=/account/login?return_to=/pages/stylist">
</noscript>

{% comment %}
=================================================================================
PLACEMENT EDITOR  (mirror of AI STUDIO — upload mode only)
=================================================================================
This file is a byte-for-byte clone of templates/page.ai-studio.liquid so that
the user-visible chrome (token gate, badge, header/footer isolation, wiring
scripts) is identical on both pages.

Two differences from the source:
  1. The Liquid fork at the bottom forces `is_upload_mode = true`, so this
     page always renders the `creator-upload-studio` section.
  2. The tiny <script> below normalises the URL to carry
     `?intent=creator_upload` before any other JS runs, so the token bypass,
     badge label and `mnOnDesignReady` routing all treat this page as the
     creator-upload flow even when the user lands on `/pages/placement-editor`
     without a query string.
=================================================================================
{% endcomment %}

{%- assign creator_id = customer.id | default: '' -%}

<script>
  window.ENV = Object.assign({}, window.ENV || {}, {
    SUPABASE_URL: "{{ settings.supabase_url | default: '' | escape }}",
    SUPABASE_ANON_KEY: "{{ settings.supabase_anon_key | default: '' | escape }}"
  });

  // Force `intent=creator_upload` before any downstream script reads the URL.
  // All 1500+ lines inherited from page.ai-studio.liquid read the intent via
  // URLSearchParams(window.location.search), so we rewrite the URL synchronously
  // here and everything downstream sees the correct value.
  (function mnForceUploadIntent() {
    try {
      var p = new URLSearchParams(window.location.search);
      if (p.get('intent') !== 'creator_upload') {
        p.set('intent', 'creator_upload');
        var newUrl = window.location.pathname + '?' + p.toString() + window.location.hash;
        window.history.replaceState(window.history.state || {}, '', newUrl);
      }
      sessionStorage.setItem('mn_creator_intent', 'creator_upload');
      sessionStorage.setItem('mn_creator_intent_ts', Date.now().toString());
      window.MN_CREATOR_INTENT = true;
    } catch (e) {
      console.warn('[MN placement-editor] intent normalise failed:', e);
    }
  })();
</script>

<!-- Token Gate Overlay (hidden by default, shown if 0 tokens) -->

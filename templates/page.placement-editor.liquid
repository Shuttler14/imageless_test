{% comment %}
=================================================================================
AI STUDIO WIRING — OpenAI slogans + gpt-image-1 designs
=================================================================================
The page content (narrative-architect-complete.html) ships with hardcoded
slogans and four stock preview images, plus a `transitionToStudio()` that only
fires an alert. This block monkey-patches those three functions AFTER the page
content has executed, so we don't have to modify the user-maintained HTML.

Flow:
  1) captureEmotion  →  POST /api/ai/slogans     (8 AI-generated slogans)
  2) displayVisualPreviews → 4× parallel POST /api/ai/design-image
                              (gpt-image-1 + Supabase upload → stable URL)
  3) transitionToStudio   →  POST /api/designs/submit (draft) → mnOnDesignReady
                              (which then routes to consumer cart or creator onboarding)

All three steps gracefully fall back to the hardcoded profile if the backend
is unreachable, so the studio never becomes a dead-end.
================================================================================= {% endcomment %}
<script>
(function mnWireAIStudio() {
  'use strict';

  // Only run on the AI studio (not on the creator_upload fork)
  var upParams = new URLSearchParams(window.location.search);
  if ((upParams.get('intent') || '') === 'creator_upload') return;

  var CREATOR_API = (window.MN_CREATOR_API
    || 'https://drishti-api-blond.vercel.app');
  var CUSTOMER_ID = '{{ customer.id | default: "" }}';

  // Style variants we ask gpt-image-1 to render for step 3.
  var STYLE_VARIANTS = [
    { name: 'Minimalist Type',    descriptor: 'minimalist typography, bold geometric sans-serif, centered lockup, clean flat vector, two-color limit' },
    { name: 'Streetwear Graphic', descriptor: 'streetwear graphic print, bold illustrative emblem with the slogan as a banner, high contrast flat ink' },
    { name: 'Vintage 90s',        descriptor: '1990s vintage band-tee aesthetic, warped serif type, muted earth palette, lightly distressed silkscreen texture' },
    { name: 'Y2K Chrome',         descriptor: 'Y2K chrome bubble lettering, metallic reflections stylised flat, silver / cyan / magenta accent, futurist layout' }
  ];

  // ---------- helpers -----------------------------------------------------

  function waitFor(test, onReady, opts) {
    opts = opts || {};
    var maxMs = opts.maxMs || 8000;
    var interval = opts.interval || 120;
    var start = Date.now();
    (function tick() {
      if (test()) return onReady();
      if (Date.now() - start > maxMs) {
        if (opts.onTimeout) opts.onTimeout();
        return;
      }
      setTimeout(tick, interval);
    })();
  }

  function getOriginalDetect() {
    try {
      return (typeof NarrativeArchitect !== 'undefined'
              && typeof NarrativeArchitect.detectNarrative === 'function')
        ? NarrativeArchitect.detectNarrative.bind(NarrativeArchitect)
        : null;
    } catch (e) { return null; }
  }

  function setLoadingButton(btnId, textId, text) {
    var btn = document.getElementById(btnId);
    var txt = textId ? document.getElementById(textId) : null;
    if (btn) btn.disabled = text === 'loading';
    if (txt && typeof text === 'string' && text !== 'loading') txt.textContent = text;
  }

  // ---------- 1. AI slogan generator --------------------------------------

  async function mnFetchSlogans(input, tone) {
    try {
      var resp = await fetch(CREATOR_API + '/api/ai/slogans', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ topic: input, tone: tone || 'personal, honest' })
      });
      if (!resp.ok) throw new Error('http_' + resp.status);
      var data = await resp.json();
      if (data && data.success && Array.isArray(data.quotes) && data.quotes.length) {
        return data.quotes.slice(0, 8);
      }
      throw new Error('empty_response');
    } catch (e) {
      console.warn('[MN AI Studio] Slogan backend failed, falling back:', e);
      return null;
    }
  }

  function patchCaptureEmotion() {
    if (typeof window.captureEmotion !== 'function') return false;
    if (window.__mnCaptureEmotionPatched) return true;
    window.__mnCaptureEmotionPatched = true;

    var origDetect = getOriginalDetect();

    window.captureEmotion = async function mnCaptureEmotion() {
      var inputEl = document.getElementById('userInput');
      var input = inputEl ? (inputEl.value || '').trim() : '';
      if (!input) { alert('Your narrative is waiting. Speak your truth.'); return; }

      var btn = document.getElementById('submitBtn');
      var btnText = document.getElementById('btnText');
      if (btnText) btnText.textContent = 'ANALYZING...';
      if (btn) btn.disabled = true;

      // Still use the hardcoded profile for style/color defaults — these feed
      // into image generation — but replace the slogan array with AI output.
      var narrative = origDetect ? origDetect(input) : {
        key: 'universal',
        profile: {
          slogans: [],
          voiceResponse: 'Your signal is clear. Let\u2019s calibrate it.',
          style: 'minimalist typography',
          tone: 'personal, honest',
          colors: ['black', 'white']
        }
      };

      var aiSlogans = await mnFetchSlogans(input, narrative.profile.tone);
      var slogans = aiSlogans && aiSlogans.length
        ? aiSlogans
        : (narrative.profile.slogans || []);

      window.currentRecommendation = {
        slogans: slogans,
        voiceResponse: narrative.profile.voiceResponse,
        recommendedStyle: narrative.profile.style,
        recommendedTone: narrative.profile.tone,
        recommendedColors: narrative.profile.colors,
        detectedNarrative: narrative.key,
        primaryColor: (narrative.profile.colors && narrative.profile.colors[0]) || 'black'
      };
      window.userProfile = {
        rawInput: input,
        detectedNarrative: narrative.key,
        timestamp: new Date().toISOString()
      };

      if (typeof displaySlogans === 'function') displaySlogans(window.currentRecommendation);

      if (btnText) btnText.textContent = 'DECODE MY SIGNAL';
      if (btn) btn.disabled = false;

      var sloganWindow = document.getElementById('sloganWindow');
      if (sloganWindow) {
        sloganWindow.classList.remove('hidden');
        sloganWindow.scrollIntoView({ behavior: 'smooth' });
      }
    };
    console.log('[MN AI Studio] captureEmotion → OpenAI wired');
    return true;
  }

  // ---------- 2. AI image generator ---------------------------------------

  async function mnFetchDesignImage(slogan, styleDescriptor, color, sourceInput) {
    var resp = await fetch(CREATOR_API + '/api/ai/design-image', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        slogan: slogan,
        style: styleDescriptor,
        color: color || 'black',
        source_input: sourceInput || ''
      })
    });
    var data = {};
    try { data = await resp.json(); } catch (e) {}
    if (!resp.ok || !data || !data.success || !data.image_url) {
      throw new Error((data && data.error) || ('http_' + resp.status));
    }
    return data.image_url;
  }

  function renderPreviewPlaceholder(gridEl, styleName) {
    var card = document.createElement('div');
    card.className = 'preview-card mn-preview-card';
    card.innerHTML =
      '<div class="mn-preview-skeleton" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;'
    + 'background:linear-gradient(110deg,#1a1a1a 8%,#262626 18%,#1a1a1a 33%);background-size:200% 100%;'
    + 'animation:mnPreviewShimmer 1.4s linear infinite;color:rgba(255,255,255,0.35);font-size:0.75rem;letter-spacing:0.08em;">'
    + 'GENERATING...</div>'
    + '<div class="preview-label">' + styleName + '</div>';
    gridEl.appendChild(card);
    return card;
  }

  function ensureShimmerKeyframes() {
    if (document.getElementById('mnPreviewShimmerKF')) return;
    var s = document.createElement('style');
    s.id = 'mnPreviewShimmerKF';
    s.textContent = '@keyframes mnPreviewShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}'
                  + '.mn-preview-card.selected{outline:2px solid #39A596;outline-offset:2px;}';
    document.head.appendChild(s);
  }

  function patchDisplayVisualPreviews() {
    if (typeof window.displayVisualPreviews !== 'function') return false;
    if (window.__mnDisplayVisualPatched) return true;
    window.__mnDisplayVisualPatched = true;

    ensureShimmerKeyframes();

    window.displayVisualPreviews = async function mnDisplayVisualPreviews() {
      var grid = document.getElementById('visualGrid');
      if (!grid) return;
      grid.innerHTML = '';

      var slogan = window.selectedSlogan || '';
      if (!slogan) {
        grid.innerHTML = '<div style="padding:2rem;color:rgba(239,68,68,0.75);text-align:center;">Pick a slogan first.</div>';
        return;
      }

      var rec = window.currentRecommendation || {};
      var sourceInput = (window.userProfile && window.userProfile.rawInput) || '';
      var color = rec.primaryColor || 'black';

      // Reset the "selected design" state for this round.
      window.mnSelectedDesignImage = null;
      window.mnSelectedDesignStyle = null;

      // Fire the 4 requests in parallel; each card fills in independently.
      var tasks = STYLE_VARIANTS.map(function(variant) {
        var card = renderPreviewPlaceholder(grid, variant.name);
        return mnFetchDesignImage(slogan, variant.descriptor, color, sourceInput)
          .then(function(imageUrl) {
            card.innerHTML =
              '<img src="' + imageUrl + '" alt="' + variant.name + '" style="width:100%;aspect-ratio:1;object-fit:cover;background:#0d0d0d;">'
            + '<div class="preview-label">' + variant.name + '</div>';
            card.dataset.imageUrl = imageUrl;
            card.dataset.styleName = variant.name;
            card.onclick = function() {
              document.querySelectorAll('.mn-preview-card, .preview-card').forEach(function(c) {
                c.classList.remove('selected');
              });
              card.classList.add('selected');
              window.mnSelectedDesignImage = imageUrl;
              window.mnSelectedDesignStyle = variant.name;
            };
            // Auto-select the first successful variant so "Continue" is always armed.
            if (!window.mnSelectedDesignImage) {
              card.click();
            }
          })
          .catch(function(err) {
            console.warn('[MN AI Studio] Image failed for', variant.name, err);
            card.innerHTML =
              '<div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;'
            + 'background:rgba(239,68,68,0.08);border:1px dashed rgba(239,68,68,0.4);'
            + 'color:rgba(239,68,68,0.8);font-size:0.75rem;padding:1rem;text-align:center;">'
            + 'Generation failed.<br><span style="opacity:0.65">Try a different slogan.</span></div>'
            + '<div class="preview-label">' + variant.name + '</div>';
          });
      });

      await Promise.all(tasks);
    };
    console.log('[MN AI Studio] displayVisualPreviews → gpt-image-1 wired');
    return true;
  }

  // ---------- 3. Finalise → draft + mnOnDesignReady -----------------------

  async function mnSubmitDraft(imageUrl, slogan, styleName, color) {
    if (!CUSTOMER_ID) return ''; // anonymous — skip backend, let mnOnDesignReady gate auth
    try {
      var resp = await fetch(CREATOR_API + '/api/designs/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          user_id: CUSTOMER_ID,
          title: (slogan || 'My Design').slice(0, 80),
          slogan: slogan,
          design_file_url: imageUrl,
          flat_image_url:  imageUrl,
          image_url:       imageUrl,
          source: 'creator_ai',
          style:  styleName || 'Minimalist Type',
          color:  color || 'black',
          status: 'draft'
        })
      });
      var json = {};
      try { json = await resp.json(); } catch (e) {}
      return (json && (json.design_id || json.id)) || '';
    } catch (e) {
      console.warn('[MN AI Studio] Draft save failed:', e);
      return '';
    }
  }

  function patchTransitionToStudio() {
    if (typeof window.transitionToStudio !== 'function') return false;
    if (window.__mnTransitionPatched) return true;
    window.__mnTransitionPatched = true;

    window.transitionToStudio = async function mnTransitionToStudio() {
      var imageUrl = window.mnSelectedDesignImage;
      var slogan   = window.selectedSlogan || '';
      var styleName = window.mnSelectedDesignStyle
        || (window.currentRecommendation && window.currentRecommendation.recommendedStyle)
        || 'Minimalist Type';
      var color    = (window.currentRecommendation && window.currentRecommendation.primaryColor) || 'black';

      if (!imageUrl) {
        alert('Pick one of the generated designs first.');
        return;
      }

      var btn = document.getElementById('generateBtn');
      var originalText = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Saving your design...'; }

      var designId = await mnSubmitDraft(imageUrl, slogan, styleName, color);

      if (typeof window.mnOnDesignReady === 'function') {
        // mnOnDesignReady handles both flows:
        //   - Creator intent → register (if needed) → /pages/creator-onboarding
        //   - Consumer intent → /cart/add.js → login gate → /cart
        window.mnOnDesignReady(designId, imageUrl, slogan || 'My Design');
      } else {
        // Ultra-safe fallback: go to cart for consumers.
        window.location.href = CUSTOMER_ID ? '/cart' : '/account/login?return_url=/cart';
      }

      if (btn) { btn.disabled = false; btn.textContent = originalText; }
    };
    console.log('[MN AI Studio] transitionToStudio → mnOnDesignReady wired');
    return true;
  }

  // ---------- Defensive architect-button bind -----------------------------
  // Ensures architect studio buttons (#submitBtn "REVEAL/DECODE", #continueBtn
  // "VISUALIZE", #generateBtn "RENDER") always fire their handler, even if
  // the inline onclick is broken, the window.* function isn't defined yet,
  // or the button got stuck in a disabled state from a prior failed run.
  var ARCHITECT_BUTTON_MAP = [
    { id: 'submitBtn',   fn: 'captureEmotion',         label: 'Reveal slogans' },
    { id: 'continueBtn', fn: 'proceedToVisualization', label: 'Visualize narrative' },
    { id: 'generateBtn', fn: 'transitionToStudio',     label: 'Render identity' }
  ];

  function bindArchitectButton(entry) {
    var btn = document.getElementById(entry.id);
    if (!btn || btn.__mnBound) return false;
    btn.__mnBound = true;

    if (btn.disabled && !btn.dataset.mnIntentionallyDisabled) {
      btn.disabled = false;
    }
    btn.style.pointerEvents = 'auto';

    btn.addEventListener('click', function(e) {
      if (e.__mnArchitectFired) return;

      var fn = window[entry.fn];
      if (typeof fn !== 'function') {
        console.warn('[MN architect] ' + entry.label + ' clicked but window.' + entry.fn + ' is not defined yet — retrying in 250ms');
        setTimeout(function() {
          var retry = window[entry.fn];
          if (typeof retry === 'function') {
            console.info('[MN architect] retry → firing ' + entry.fn + '()');
            try { retry(); } catch (err) { console.error('[MN architect] ' + entry.fn + ' threw', err); }
          } else {
            console.error('[MN architect] ' + entry.fn + ' still not available after retry — studio wiring is broken');
            if (btn.disabled) btn.disabled = false;
          }
        }, 250);
        e.__mnArchitectFired = true;
        return;
      }

      if (btn.getAttribute('onclick')) {
        btn.removeAttribute('onclick');
        console.info('[MN architect] took over inline onclick for #' + entry.id);
      }

      e.__mnArchitectFired = true;
      console.info('[MN architect] firing ' + entry.fn + '() via defensive bind');
      try {
        var res = fn();
        if (res && typeof res.catch === 'function') {
          res.catch(function(err) {
            console.error('[MN architect] ' + entry.fn + ' rejected', err);
            if (btn.disabled) btn.disabled = false;
          });
        }
      } catch (err) {
        console.error('[MN architect] ' + entry.fn + ' threw synchronously', err);
        if (btn.disabled) btn.disabled = false;
      }
    }, false);

    console.info('[MN architect] ✅ defensive bind attached to #' + entry.id + ' (' + entry.label + ')');
    return true;
  }

  function bindAllArchitectButtons() {
    var pending = 0;
    ARCHITECT_BUTTON_MAP.forEach(function(entry) {
      if (!bindArchitectButton(entry)) pending++;
    });
    return pending;
  }

  function startArchitectBindPoll() {
    if (bindAllArchitectButtons() === 0) return;
    var start = Date.now();
    var iv = setInterval(function() {
      var remaining = bindAllArchitectButtons();
      if (remaining === 0 || Date.now() - start > 15000) {
        clearInterval(iv);
        if (remaining > 0) {
          console.warn('[MN architect] ' + remaining + ' architect button(s) never appeared after 15s');
        }
      }
    }, 200);
  }

  // ---------- Wait for the page content, then patch -----------------------

  function patchAll() {
    var a = patchCaptureEmotion();
    var b = patchDisplayVisualPreviews();
    var c = patchTransitionToStudio();
    return a && b && c;
  }

  function boot() {
    startArchitectBindPoll();

    if (patchAll()) return;
    waitFor(
      function() {
        return typeof window.captureEmotion === 'function'
            && typeof window.displayVisualPreviews === 'function'
            && typeof window.transitionToStudio === 'function';
      },
      patchAll,
      {
        maxMs: 10000,
        interval: 150,
        onTimeout: function() {
          patchAll();
          console.warn('[MN AI Studio] Some studio functions were not found within 10s; patched whatever was available.');
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
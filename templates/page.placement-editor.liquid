<!-- Token Status Badge — fixed bottom-right, clear of content -->
<div id="mnTokenBadge" style="
  display: none;
  position: fixed;
  bottom: 1.25rem;
  right: 1.25rem;
  top: auto;
  background: rgba(10,10,10,0.88);
  border: 1px solid rgba(57,165,150,0.4);
  border-radius: 2rem;
  padding: 0.4rem 0.9rem 0.4rem 0.65rem;
  font-size: 0.78rem;

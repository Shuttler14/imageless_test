  <span style="color:rgba(255,255,255,0.5);font-size:0.7rem">tokens</span>
</div>

<style>
  @keyframes mnTokenGateIn {
    from { opacity:0; transform:translateY(16px); }
    to   { opacity:1; transform:translateY(0); }
  }
</style>

<script>
(function() {
  'use strict';
  var pageParams = new URLSearchParams(window.location.search);
  var pageIntent = pageParams.get('intent') || '';
  var BYPASS_TOKENS_FOR_UPLOAD = pageIntent === 'creator_upload';
  var CREATOR_API = 'https://drishti-api-blond.vercel.app';
  var CREATOR_ID  = '{{ creator_id }}';
  var overlay     = document.getElementById('mnTokenGateOverlay');
  var badge       = document.getElementById('mnTokenBadge');
  var badgeCount  = document.getElementById('mnTokenBadgeCount');

  function applyTokenState(credits) {
    if (credits === null || credits === undefined) {
      // Pre-migration or API unavailable — allow access, show no badge
      if (overlay) overlay.style.display = 'none';
      return;
    }

    if (badgeCount) badgeCount.textContent = credits;

    if (credits <= 0) {
      // BLOCK studio access
      if (overlay) overlay.style.display = 'flex';
      if (badge)   badge.style.display = 'none';
      // Also prevent any design generation button from firing
      document.querySelectorAll(
        '#ai-generate-btn, .generate-btn, [data-action="generate"], #generateBtn'
      ).forEach(function(btn) {
        btn.disabled = true;
        btn.title    = 'Earn Narrative Tokens to generate designs';
      });
    } else {
      // ALLOW — show token badge
      if (overlay) overlay.style.display = 'none';
      if (badge) {
        badge.style.display = 'flex';
        // Color by token level
        if (badgeCount) {
          badgeCount.style.color = credits <= 1 ? '#f59e0b' : '#39A596';
        }
        // Click badge → token top-up page
        badge.onclick = function() { window.location.href = '/pages/narrative-tokens'; };
      }
    }
  }

  async function checkTokens() {
    if (BYPASS_TOKENS_FOR_UPLOAD) {
      applyTokenState(null);
      return;
    }
    if (!CREATOR_ID) {
      // Not logged in — redirect to login
      applyTokenState(null);
      return;
    }
    try {
      var resp = await fetch(
        CREATOR_API + '/api/creator/earnings/summary?creator_id=' + CREATOR_ID,
        { headers: { 'Accept': 'application/json' } }
      );
      if (!resp.ok) throw new Error('HTTP ' + resp.status);
      var data    = await resp.json();
      var summary = data.summary || data || {};
      var credits = (summary.ai_credits != null) ? summary.ai_credits : null;
      applyTokenState(credits);
    } catch (e) {
      console.warn('[MN AI Studio] Token check failed — allowing access:', e.message);
      applyTokenState(null); // fail open
    }
  }

  // Run on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkTokens);
  } else {
    checkTokens();
  }

  // Expose so studio JS can call after generation to update count
  window.mnUpdateTokenDisplay = applyTokenState;
})();
</script>

<!-- AI Design Studio Page — header/footer isolation fix -->

<!-- ═══════════════════════════════════════════════════════════════
     TASK 1: Upload Button Fix + TASK 4: Back-Button State Machine
     Injected via JS since {{ page.content }} renders the studio UI
     ═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  'use strict';
  var SUPABASE_URL = (window.ENV && window.ENV.SUPABASE_URL) || '';
  var SUPABASE_ANON_KEY = (window.ENV && window.ENV.SUPABASE_ANON_KEY) || '';

  function savePendingDesign(designData) {
    if (!designData) return;
    var payload = Object.assign({}, designData, { saved_at: Date.now() });
    try {
      localStorage.setItem('mn_pending_design', JSON.stringify(payload));
    } catch (err) {
      console.warn('[MN] localStorage write failed for pending design', err);
    }
  }

  function reinjectPlacementPreview(uploadedUrl) {
    if (!uploadedUrl) return;
    var selectors = [
      '.placement-mockup-img', '#final-design-preview',
      'img[data-role*="mockup"]', 'img[data-role*="preview"]',
      '#step-3 img', '.mockup-preview img', '.design-preview img'
    ];
    selectors.forEach(function(sel) {
      document.querySelectorAll(sel).forEach(function(node) {
        if (node && node.tagName === 'IMG') {
          node.src = uploadedUrl;
          node.srcset = '';
          node.setAttribute('data-upload-routed', '1');
        }
      });
    });
  }

  /** Phantom-click "I HAVE MY OWN PREFERENCES" so upload flow skips AI-vs-manual gate inside Step 3. */
  function startManualEditorBypass(uploadedUrl) {
    var attempts = 0;
    var maxAttempts = 25;
    var tickMs = 100;
    var bypassId = setInterval(function() {
      attempts++;
      var manualBtn = null;
      var pool = document.querySelectorAll(
        'button, a[href], [role="button"], .btn, .manual-mode-btn, .own-preferences-btn, [data-mode="manual"], [data-editor="manual"], [data-choice="manual"]'
      );
      for (var i = 0; i < pool.length; i++) {
        var el = pool[i];
        var raw = (el.textContent || el.innerText || el.getAttribute('aria-label') || '').toUpperCase().replace(/\s+/g, ' ').trim();
        if (
          raw.indexOf('OWN PREFERENCES') !== -1 ||
          raw.indexOf('I HAVE MY OWN') !== -1 ||
          (raw.indexOf('MY OWN') !== -1 && raw.indexOf('PREFERENCE') !== -1) ||
          (raw.indexOf('MANUAL') !== -1 && (raw.indexOf('PLACEMENT') !== -1 || raw.indexOf('FABRIC') !== -1 || raw.indexOf('EDIT') !== -1))
        ) {
          manualBtn = el;
          break;
        }
      }
      if (manualBtn) {
        try { manualBtn.click(); } catch (e) {}
        clearInterval(bypassId);
        setTimeout(function() { reinjectPlacementPreview(uploadedUrl); }, 50);
        setTimeout(function() { reinjectPlacementPreview(uploadedUrl); }, 350);
        return;
      }
      if (attempts >= maxAttempts) clearInterval(bypassId);
    }, tickMs);
  }

  function routeUploadToStudioFlow(file, publicUrl) {
    var uploadedUrl = publicUrl || '';
    var title = file && file.name ? file.name.replace(/\.[^.]+$/, '') : 'Uploaded Design';
    var uploadPayload = {
      file_name: file && file.name ? file.name : '',
      file_type: file && file.type ? file.type : '',
      file_size: file && file.size ? file.size : 0,
      image_url: uploadedUrl,
      asset_url: uploadedUrl,
      title: title,
      source: 'creator_upload',
      uploaded_at: new Date().toISOString()
    };

    // Let any studio implementation consume this without forcing a full finish redirect.
    window.mnUploadedDesign = uploadPayload;
    window.dispatchEvent(new CustomEvent('mn:upload-design-ready', { detail: uploadPayload }));

    // Generic /pages/ai-studio visits: align URL + session so creator checkout & mnOnDesignReady work.
    try {
      var locUrl = new URL(window.location.href);
      var curIntent = locUrl.searchParams.get('intent') || '';
      if (curIntent.indexOf('creator') === -1) {
        locUrl.searchParams.set('intent', 'creator_upload');
        history.replaceState(history.state || {}, '', locUrl.toString());
      }
      sessionStorage.setItem('mn_creator_intent', 'creator_upload');
      sessionStorage.setItem('mn_creator_intent_ts', Date.now().toString());
      window.MN_CREATOR_INTENT = true;
    } catch (eIntent) {}

    if (window.state && typeof window.state === 'object') {
      window.state.isUploadedDesign = true;
      window.state.designSource = 'upload';
      window.state.uploadedDesignUrl = uploadedUrl;
      window.state.generatedImage = uploadedUrl;
      window.state.uploadedDesignMeta = uploadPayload;
    }

    if (typeof window.goToStep === 'function') {
      // Step 3 in this studio is Fabric Color + Placement in current flow.
      window.goToStep(3);
    } else if (typeof window.renderStep3 === 'function') {
      window.renderStep3();
    } else if (typeof window.MNAIStylist !== 'undefined' && typeof window.MNAIStylist.expandWidget === 'function') {
      window.MNAIStylist.expandWidget();
    }
  }

  function showUploadError() {
    var message = 'Upload failed. Please ensure your file is a valid image under 15MB and try again.';
    var errEl = document.getElementById('mn-upload-error');
    if (!errEl) {
      errEl = document.createElement('div');
      errEl.id = 'mn-upload-error';
      errEl.style.cssText = 'margin:10px 0 0;padding:10px 12px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.35);border-radius:10px;color:#fecaca;font-size:12px;line-height:1.45;text-align:center;';
      var wrapper = document.querySelector('.mn-ai-studio-wrapper') || document.body;
      if (wrapper) wrapper.prepend(errEl);
    }
    errEl.textContent = message;
    errEl.style.display = 'block';
  }

  function clearUploadError() {
    var errEl = document.getElementById('mn-upload-error');
    if (errEl) errEl.style.display = 'none';
  }

  function buildUploadFileName(file) {
    var typeParts = (file && file.type ? file.type : 'image/png').split('/');
    var ext = (typeParts[1] || 'png').toLowerCase().replace(/[^a-z0-9]/g, '') || 'png';
    var id = (window.crypto && window.crypto.randomUUID)
      ? window.crypto.randomUUID()
      : (Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8));
    return 'custom_upload_' + id + '.' + ext;
  }

  async function uploadDesignAsset(file) {
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) throw new Error('missing_supabase_env');
    if (!file || !file.type || file.type.indexOf('image/') !== 0 || file.size > (15 * 1024 * 1024)) {
      throw new Error('invalid_file');
    }
    var fileName = buildUploadFileName(file);
    var uploadUrl = SUPABASE_URL + '/storage/v1/object/creator_assets/' + encodeURIComponent(fileName);
    var resp = await fetch(uploadUrl, {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
        apikey: SUPABASE_ANON_KEY,
        'Content-Type': file.type
      },
      body: file
    });
    if (!resp.ok) {
      let errorBody = {};
      try { errorBody = await resp.json(); } catch(e) {}
      console.error('[Supabase Upload Blocked]', resp.status, resp.statusText, errorBody);
      throw new Error('supabase_upload_failed');
    }
    return SUPABASE_URL + '/storage/v1/object/public/creator_assets/' + fileName;
  }

  function consumePendingUploadFromIntent() {
    var params = new URLSearchParams(window.location.search);
    if ((params.get('intent') || '') !== 'creator_upload') return;
    // In creator_upload mode we render sections/creator-upload-studio, which reads
    // `mn_pending_upload` itself and handles the full placement-editor → draft flow.
    // Do NOT consume it here; that would strand the user on the AI studio React flow.
    return;
  }

  // ── TASK 1: Wire upload button to native file picker ────────────
  // Finds any button with text "GET STARTED" in the studio and:
  //   1. Changes text to "CHOOSE DESIGN"
  //   2. Styles with #39A596 brand color
  //   3. Wires to a hidden <input type="file"> for native OS gallery
  function patchUploadButton() {
    // Find all buttons/links that say "GET STARTED" (case-insensitive)
    var allBtns = document.querySelectorAll('button, a, [role="button"], input[type="submit"]');
    allBtns.forEach(function(btn) {
      var text = (btn.textContent || btn.value || '').trim().toUpperCase();
      if (text === 'GET STARTED' || text === 'GET STARTED →' || text === 'UPLOAD DESIGN') {

        // Change button text
        if (btn.tagName === 'INPUT') {
          btn.value = 'CHOOSE DESIGN';
        } else {
          // Preserve any child elements (arrows, icons), just replace text node
          var hasChildren = btn.children.length > 0;
          if (hasChildren) {
            // Replace first text node only
            for (var i = 0; i < btn.childNodes.length; i++) {
              if (btn.childNodes[i].nodeType === 3 && btn.childNodes[i].textContent.trim()) {
                btn.childNodes[i].textContent = 'CHOOSE DESIGN ';
                break;
              }
            }
          } else {
            btn.textContent = 'CHOOSE DESIGN';
          }
        }

        // Apply #39A596 brand color styling
        btn.style.cssText += ';background:#39A596 !important;color:#000 !important;border-color:#39A596 !important;';

        // Add quality helper text under upload CTA once.
        if (!btn.dataset.mnUploadHintPatched) {
          btn.dataset.mnUploadHintPatched = '1';
          var hintId = 'mn-upload-quality-hint';
          if (!document.getElementById(hintId)) {
            var hint = document.createElement('p');
            hint.id = hintId;
            hint.textContent = 'For perfect print quality, upload a high-resolution image with a transparent background.';
            hint.style.cssText = 'margin:8px 0 0;font-size:12px;line-height:1.45;color:rgba(255,255,255,0.7);text-align:center;';
            if (btn.parentNode) btn.parentNode.insertBefore(hint, btn.nextSibling);
          }
        }

        // Create hidden file input if not already present
        var fileInputId = 'mn-studio-file-input';
        var existingInput = document.getElementById(fileInputId);
        if (!existingInput) {
          var fileInput = document.createElement('input');
          fileInput.type = 'file';
          fileInput.id = fileInputId;
          fileInput.accept = 'image/*';
          fileInput.style.cssText = 'position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;';
          fileInput.setAttribute('aria-hidden', 'true');
          document.body.appendChild(fileInput);

          // When file selected, dispatch to studio's existing file handler
          fileInput.addEventListener('change', function() {
            var file = this.files[0];
            if (!file) return;
            clearUploadError();
            // Try to find studio's own file input and dispatch to it
            var studioInput = document.querySelector(
              'input[type="file"]:not(#' + fileInputId + '), #mnw-selfie-input, #design-upload-input, .upload-input'
            );
            if (studioInput) {
              // Transfer file to studio input via DataTransfer
              try {
                var dt = new DataTransfer();
                dt.items.add(file);
                studioInput.files = dt.files;
                studioInput.dispatchEvent(new Event('change', { bubbles: true }));
              } catch(e) {
                // Fallback: dispatch change event directly on studio input
                var event = new Event('change', { bubbles: true });
                studioInput.dispatchEvent(event);
              }
            }
            uploadDesignAsset(file).then(function(publicUrl) {
              routeUploadToStudioFlow(file, publicUrl);
            }).catch(function() {
              showUploadError();
            });
          });
        }

        // Wire button click to open file picker
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          document.getElementById(fileInputId).click();
        });

        console.log('[MN] Upload button patched: GET STARTED → CHOOSE DESIGN');
      }
    });
  }

  // ── TASK 4: Back-Button State Machine ──────────────────────────
  // Problem: browser back button resets the entire studio canvas,
  //          losing the first design and dropping user to an empty state.
  // Solution: Push a history entry when the first design is complete.
  //           On popstate, intercept and revert to "second design" prompt
  //           instead of navigating away from the page.

  var MN_HISTORY_STATES = {
    STUDIO_INITIAL:      'mn_studio_initial',
    FIRST_DESIGN_DONE:   'mn_first_design_done',
    SECOND_DESIGN_PROMPT:'mn_second_design_prompt',
    SECOND_DESIGN_DONE:  'mn_second_design_done',
  };

  // Save the first completed design so back-nav can restore it
  var mnFirstDesign = null;

  // Push state when first design is complete
  window.mnMarkFirstDesignComplete = function(designUuid, imageUrl, title) {
    mnFirstDesign = { uuid: designUuid, imageUrl: imageUrl, title: title, ts: Date.now() };
    sessionStorage.setItem('mn_first_design', JSON.stringify(mnFirstDesign));

    // Push state so browser back button lands here instead of previous page
    history.pushState(
      { state: MN_HISTORY_STATES.FIRST_DESIGN_DONE, design: mnFirstDesign },
      '',
      window.location.href
    );
    console.log('[MN] History state pushed: first design complete');
  };

  // Push state when "second design" prompt is shown
  window.mnShowSecondDesignPrompt = function() {
    history.pushState(
      { state: MN_HISTORY_STATES.SECOND_DESIGN_PROMPT },
      '',
      window.location.href
    );
    renderSecondDesignPrompt();
  };

  // Render the "second design" prompt UI
  function renderSecondDesignPrompt() {
    var first = mnFirstDesign
      || JSON.parse(sessionStorage.getItem('mn_first_design') || 'null');

    // Find the studio content container
    var container = document.getElementById('mn-content-container')
      || document.querySelector('.mn-studio-main, .studio-content, #studio-container');

    if (!container) return;

    container.innerHTML = [
      '<div style="text-align:center;padding:2.5rem 1.5rem;max-width:480px;margin:0 auto;">',
        first && first.imageUrl ? (
          '<img src="' + first.imageUrl + '" alt="Your design" style="width:120px;height:120px;object-fit:cover;border-radius:0.75rem;border:2px solid rgba(57,165,150,0.4);margin-bottom:1.25rem;">'
        ) : '',
        '<div style="font-size:2rem;margin-bottom:0.75rem;">🎨</div>',
        '<h2 style="font-family:Montserrat,sans-serif;font-size:1.25rem;font-weight:800;color:white;margin:0 0 0.5rem;">',
          first ? 'Great design! Want to create a second one?' : 'Want to create another design?',
        '</h2>',
        '<p style="color:rgba(255,255,255,0.6);font-size:0.875rem;line-height:1.5;margin:0 0 1.5rem;">',
          'Your first design is saved. You can create another variation or go publish this one.',
        '</p>',
        '<div style="display:flex;flex-direction:column;gap:0.75rem;">',
          '<button id="mn-second-design-yes" style="',
            'padding:0.875rem 1.5rem;background:#39A596;color:#000;border:none;',
            'border-radius:0.75rem;font-family:Montserrat,sans-serif;font-weight:700;',
            'font-size:0.875rem;cursor:pointer;width:100%;transition:background 0.2s;',
          '">🎨 Yes, create another design</button>',
          '<button id="mn-second-design-no" style="',
            'padding:0.875rem 1.5rem;background:transparent;',
            'border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.7);',
            'border-radius:0.75rem;font-family:Montserrat,sans-serif;font-weight:600;',
            'font-size:0.875rem;cursor:pointer;width:100%;transition:all 0.2s;',
          '">No thanks, publish this design →</button>',
        '</div>',
      '</div>'
    ].join('');

    // Wire buttons
    var yesBtn = document.getElementById('mn-second-design-yes');
    var noBtn  = document.getElementById('mn-second-design-no');

    if (yesBtn) yesBtn.addEventListener('click', function() {
      // Start new design — go back to step 0
      if (typeof renderStep0 === 'function') renderStep0();
      else if (typeof window.MNAIStylist !== 'undefined') window.MNAIStylist.expandWidget();
    });

    if (noBtn) noBtn.addEventListener('click', function() {
      history.pushState(
        { state: MN_HISTORY_STATES.SECOND_DESIGN_DONE },
        '',
        window.location.href
      );
      // Route based on intent:
      //   - Creator intent  → login (if needed) → onboarding/dashboard via mnOnDesignReady
      //   - Consumer intent → login (if needed) → cart via mnOnConsumerDesignReady
      if (window.MN_CREATOR_INTENT) {
        if (!window.isCustomerLoggedIn) {
          window.location.href = '/account/register?return_url=' +
            encodeURIComponent(window.location.pathname + window.location.search);
          return;
        }
        if (typeof window.mnOnDesignReady === 'function' && mnFirstDesign) {
          window.mnOnDesignReady(mnFirstDesign.uuid, mnFirstDesign.imageUrl, mnFirstDesign.title);
        } else {
          window.location.href = '/pages/creator-dashboard';
        }
      } else {
        // Consumer flow — straight to cart, with login/register gate just before it.
        if (typeof window.mnOnConsumerDesignReady === 'function' && mnFirstDesign) {
          window.mnOnConsumerDesignReady(mnFirstDesign.uuid, mnFirstDesign.imageUrl, mnFirstDesign.title);
        } else if (!window.isCustomerLoggedIn) {
          window.location.href = '/account/login?return_url=/cart';
        } else {
          window.location.href = '/cart';
        }
      }
    });
  }

  // ── popstate handler: intercept browser back ──────────────────
  window.addEventListener('popstate', function(e) {
    var historyState = e.state && e.state.state;

    if (historyState === MN_HISTORY_STATES.FIRST_DESIGN_DONE ||
        historyState === MN_HISTORY_STATES.SECOND_DESIGN_PROMPT ||
        historyState === MN_HISTORY_STATES.SECOND_DESIGN_DONE) {
      // User hit back after first design was done
      // Revert to "second design" prompt — do NOT navigate away
      e.preventDefault && e.preventDefault();

      // Restore first design from session if lost in memory
      if (!mnFirstDesign) {
        mnFirstDesign = JSON.parse(sessionStorage.getItem('mn_first_design') || 'null');
      }

      renderSecondDesignPrompt();
      console.log('[MN] Back intercepted — showing second design prompt');
    }
    // For all other states, allow normal back navigation
  });

  // ── Push initial state so popstate fires correctly ────────────
  history.replaceState(
    { state: MN_HISTORY_STATES.STUDIO_INITIAL },
    '',
    window.location.href
  );

  // ── Run upload button patch after DOM is ready ────────────────
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      // Patch immediately + retry after content renders (React/Shopify sections may be async)
      patchUploadButton();
      consumePendingUploadFromIntent();
      setTimeout(patchUploadButton, 500);
      setTimeout(patchUploadButton, 1500);
    });
  } else {
    patchUploadButton();
    consumePendingUploadFromIntent();
    setTimeout(patchUploadButton, 500);
    setTimeout(patchUploadButton, 1500);
  }

  // ── MutationObserver: patch dynamically rendered upload buttons ──
  var patchObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.addedNodes.length) patchUploadButton();
    });
  });
  if (document.body) {
    patchObserver.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      patchObserver.observe(document.body, { childList: true, subtree: true });
    });
  }

  // Expose state machine functions globally
  window.MN_STUDIO_STATE = MN_HISTORY_STATES;
  window.mnRenderSecondDesignPrompt = renderSecondDesignPrompt;
})();
</script>

<!-- INTENT-BASED ROUTING -->
<script>
(function() {
  var params = new URLSearchParams(window.location.search);
  var intent = params.get('intent') || '';
  var IS_CREATOR_INTENT = intent.indexOf('creator') !== -1;

  function setPendingDesign(designData) {
    if (!designData) return;
    var payload = Object.assign({}, designData, { saved_at: Date.now() });
    try {
      localStorage.setItem('mn_pending_design', JSON.stringify(payload));
    } catch (e) {}
  }

  function isPendingDesignExpired(payload) {
    if (!payload) return true;
    var ts = Number(payload.saved_at || 0);
    if (!ts) return false;
    return (Date.now() - ts) > (2 * 60 * 60 * 1000);
  }

  // ---------------------------------------------------------------------------
  // Effective creator intent — merges URL + sessionStorage with a TTL.
  // See page.ai-studio.liquid for full rationale; this placement-editor path
  // always defaults to 'creator_upload' (URL normaliser above sets the query
  // param), but we still go through this helper for consistency with the
  // studio and to handle sessionStorage-backed returns from auth flows.
  // ---------------------------------------------------------------------------
  function getEffectiveCreatorIntent() {
    try {
      var urlIntent = new URLSearchParams(window.location.search).get('intent') || '';
      if (urlIntent && urlIntent.indexOf('creator') !== -1) return urlIntent;
      var sessIntent = sessionStorage.getItem('mn_creator_intent') || '';
      var sessTs     = parseInt(sessionStorage.getItem('mn_creator_intent_ts') || '0', 10);
      var TTL_MS     = 2 * 60 * 60 * 1000;
      if (sessIntent && sessTs && (Date.now() - sessTs) < TTL_MS) {
        if (sessIntent.indexOf('creator') !== -1) return sessIntent;
      }
    } catch (e) {}
    return '';
  }
  window.getEffectiveCreatorIntent = getEffectiveCreatorIntent;

  // Store intent in sessionStorage so the studio JS can read it
  if (IS_CREATOR_INTENT) {
    sessionStorage.setItem('mn_creator_intent', intent);
    sessionStorage.setItem('mn_creator_intent_ts', Date.now().toString());
  }

  // Show a subtle banner indicating creator mode
  if (IS_CREATOR_INTENT) {
    var banner = document.createElement('div');
    banner.id = 'mnCreatorModeBanner';
    // Elegant floating pill — not a full-width bar
    banner.style.cssText = [
      'position:fixed',
      'top:72px',
      'left:50%',
      'transform:translateX(-50%)',
      'z-index:9988',
      'background:rgba(10,10,10,0.82)',
      'border:1px solid rgba(57,165,150,0.5)',
      'border-radius:2rem',
      'padding:0.35rem 1rem 0.35rem 0.75rem',
      'display:flex',
      'align-items:center',
      'gap:0.45rem',
      'font-family:Montserrat,sans-serif',
      'font-size:0.72rem',
      'font-weight:700',
      'color:#39A596',
      'letter-spacing:0.04em',
      'white-space:nowrap',
      'backdrop-filter:blur(12px)',
      '-webkit-backdrop-filter:blur(12px)',
      'box-shadow:0 4px 20px rgba(0,0,0,0.4),0 0 0 1px rgba(57,165,150,0.15)',
      'animation:mnBannerIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both',
    ].join(';');
    banner.innerHTML = '<span style="width:7px;height:7px;background:#39A596;border-radius:50%;display:inline-block;box-shadow:0 0 6px #39A596;animation:mnDotPulse 2s ease infinite;"></span>' +
      '<span style="color:rgba(255,255,255,0.5);font-weight:600;">' + (intent === 'creator_upload' ? 'Creator Upload' : 'Creator Mode') + '</span>';

    // Add keyframes once
    if (!document.getElementById('mnBannerStyles')) {
      var s = document.createElement('style');
      s.id = 'mnBannerStyles';
      s.textContent = [
        '@keyframes mnBannerIn{from{opacity:0;transform:translateX(-50%) translateY(-8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}',
        '@keyframes mnDotPulse{0%,100%{opacity:1;box-shadow:0 0 6px #39A596}50%{opacity:0.5;box-shadow:0 0 3px #39A596}}',
      ].join('');
      document.head.appendChild(s);
    }
    var wrapper = document.querySelector('.mn-ai-studio-wrapper');
    if (wrapper) {
      banner.style.position = 'absolute';
      banner.style.left = '50%';
      banner.style.transform = 'translateX(-50%)';
      wrapper.prepend(banner);
    } else {
      document.body.prepend(banner);
    }
  }

  // Override the studio's "Add to Cart" / "Buy Now" behavior when in creator intent
  // Poll for the studio's submit/generate button and intercept it
  window.MN_CREATOR_INTENT = IS_CREATOR_INTENT;

  // This function is called by the studio when a design is ready
  // The studio should call: window.mnOnDesignReady(design_uuid, image_url, title)
  window.mnOnDesignReady = function(designUuid, imageUrl, title) {
    var effIntent = getEffectiveCreatorIntent();

    // Save design data to localStorage regardless of flow; the intercept click
    // handler and consumer helper both rely on it being present.
    var designData = {
      design_uuid:  designUuid || '',
      image_url:    imageUrl   || '',
      title:        title      || 'My Design',
      intent:       effIntent || 'consumer_design',
      created_at:   new Date().toISOString(),
    };
    setPendingDesign(designData);

    // No creator intent → this is a consumer shopper. Skip onboarding entirely
    // and route them to cart (with login gate) via the consumer helper.
    if (!effIntent) {
      if (typeof window.mnOnConsumerDesignReady === 'function') {
        window.mnOnConsumerDesignReady(designUuid, imageUrl, title);
      }
      return;
    }

    // Hardcoded Liquid check — more reliable than window.isCustomerLoggedIn
    var currentCustomerId = '{{ customer.id | default: "" }}';

    if (currentCustomerId !== '') {
      // User IS logged in — go to first-run profile setup; dashboard comes after publish.
      var q = 'from=studio&intent=' + encodeURIComponent(effIntent);
      if (designUuid) q += '&design_id=' + encodeURIComponent(designUuid);
      window.location.href = '/pages/creator-onboarding?' + q;
    } else {
      // User is NOT logged in — register first, then land on onboarding.
      // Creators MUST sign up before they can publish.
      var retQ = 'from=studio&intent=' + encodeURIComponent(effIntent);
      if (designUuid) retQ += '&design_id=' + encodeURIComponent(designUuid);
      window.location.href = '/account/register?return_url=' +
        encodeURIComponent('/pages/creator-onboarding?' + retQ);
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // CONSUMER FLOW — "just want to try it" path
  // ═══════════════════════════════════════════════════════════════════════════
  // When the user arrives on /pages/ai-studio WITHOUT a creator intent, they
  // are a regular shopper. Don't route them to onboarding or the dashboard —
  // add the design to their cart and send them to /cart. Gate login only at
  // that boundary so we don't lose them to "sign up" mid-experience.
  //
  // Theme settings can override the default t-shirt variant used for the
  // print-on-demand parent product via `settings.default_tshirt_variant_id`.
  // ═══════════════════════════════════════════════════════════════════════════
  var DEFAULT_TSHIRT_VARIANT_ID =
    parseInt('{{ settings.default_tshirt_variant_id | default: "" }}', 10) || 0;
  var DEFAULT_HOODIE_VARIANT_ID =
    parseInt('{{ settings.default_hoodie_variant_id | default: "" }}', 10) || 0;
  var IS_LOGGED_IN = '{{ customer.id | default: "" }}' !== '';

  function mnNormalizeProductType(value) {
    var raw = String(value || '').toLowerCase();
    if (raw.indexOf('hood') !== -1) return 'hoodie';
    return 'tee';
  }

  function mnDefaultVariantForProductType(productType) {
    return mnNormalizeProductType(productType) === 'hoodie'
      ? (DEFAULT_HOODIE_VARIANT_ID || DEFAULT_TSHIRT_VARIANT_ID)
      : DEFAULT_TSHIRT_VARIANT_ID;
  }

  // ---------------------------------------------------------------------------
  // Consumer auth modal — lazy-mounted so it doesn't bloat the DOM unless used.
  // When a not-logged-in shopper tries to add their design to cart, we show a
  // small popup offering: Login / Create account / Continue as guest.
  // Shopify's cart cookie persists across login, so "continue as guest" simply
  // lets them proceed to /cart and checkout without an account.
  // ---------------------------------------------------------------------------
  function ensureConsumerAuthModal() {
    var existing = document.getElementById('mnConsumerAuthModal');
    if (existing) return existing;

    var wrap = document.createElement('div');
    wrap.id = 'mnConsumerAuthModal';
    wrap.setAttribute('role', 'dialog');
    wrap.setAttribute('aria-modal', 'true');
    wrap.setAttribute('aria-labelledby', 'mnConsumerAuthTitle');
    wrap.style.cssText = [
      'display:none', 'position:fixed', 'inset:0',
      'background:rgba(0,0,0,0.82)', 'backdrop-filter:blur(10px)',
      'z-index:100000', 'align-items:center', 'justify-content:center',
      'padding:1.25rem', 'font-family:Montserrat,system-ui,sans-serif'
    ].join(';');
    wrap.innerHTML = [
      '<div style="',
        'background:#0f0f0f;color:#fff;border:1px solid rgba(57,165,150,0.35);',
        'border-radius:18px;max-width:440px;width:100%;padding:28px 24px 22px;',
        'box-shadow:0 30px 80px rgba(0,0,0,0.6);animation:mnTokenGateIn 0.28s ease;',
      '">',
        '<div style="text-align:center;margin-bottom:18px">',
          '<div style="font-size:2.5rem;line-height:1;margin-bottom:10px">👕</div>',
          '<h3 id="mnConsumerAuthTitle" style="margin:0 0 6px;font-size:1.25rem;font-weight:800;letter-spacing:-0.01em">',
            'Save your design before checkout',
          '</h3>',
          '<p style="margin:0;color:rgba(255,255,255,0.6);font-size:0.9rem;line-height:1.5">',
            'Sign in or create a free account so your custom design is saved to ',
            'your order. You can also continue as a guest if you prefer.',
          '</p>',
        '</div>',
        '<div style="display:flex;flex-direction:column;gap:10px;margin-top:8px">',
          '<button id="mnAuthLoginBtn" type="button" style="',
            'padding:13px 18px;background:linear-gradient(135deg,#39A596,#2dd4bf);',
            'color:#000;font-weight:800;font-size:0.92rem;letter-spacing:0.04em;',
            'text-transform:uppercase;border:0;border-radius:12px;cursor:pointer;',
            'transition:transform 0.15s">Login</button>',
          '<button id="mnAuthRegisterBtn" type="button" style="',
            'padding:13px 18px;background:rgba(57,165,150,0.12);',
            'color:#39A596;font-weight:700;font-size:0.9rem;letter-spacing:0.04em;',
            'text-transform:uppercase;border:1px solid rgba(57,165,150,0.45);',
            'border-radius:12px;cursor:pointer;">Create account</button>',
          '<button id="mnAuthGuestBtn" type="button" style="',
            'padding:11px 18px;background:transparent;color:rgba(255,255,255,0.6);',
            'font-weight:600;font-size:0.85rem;border:0;cursor:pointer;',
            'text-decoration:underline">Continue as guest →</button>',
        '</div>',
        '<button id="mnAuthCloseBtn" type="button" aria-label="Close" style="',
          'position:absolute;top:12px;right:14px;background:transparent;border:0;',
          'color:rgba(255,255,255,0.4);font-size:1.4rem;cursor:pointer;line-height:1;',
          'padding:4px 8px">&times;</button>',
      '</div>'
    ].join('');
    wrap.firstChild.style.position = 'relative';
    document.body.appendChild(wrap);

    wrap.addEventListener('click', function(e) { if (e.target === wrap) hideConsumerAuthModal(); });
    wrap.querySelector('#mnAuthCloseBtn').addEventListener('click', hideConsumerAuthModal);
    return wrap;
  }

  function showConsumerAuthModal(opts) {
    var modal = ensureConsumerAuthModal();
    var returnUrl = (opts && opts.returnUrl) || '/cart';
    var onGuest   = (opts && opts.onGuest)   || function(){ window.location.href = returnUrl; };

    modal.querySelector('#mnAuthLoginBtn').onclick = function() {
      window.location.href = '/account/login?return_url=' + encodeURIComponent(returnUrl);
    };
    modal.querySelector('#mnAuthRegisterBtn').onclick = function() {
      window.location.href = '/account/register?return_url=' + encodeURIComponent(returnUrl);
    };
    modal.querySelector('#mnAuthGuestBtn').onclick = onGuest;

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function hideConsumerAuthModal() {
    var modal = document.getElementById('mnConsumerAuthModal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // ═══════════════════════════════════════════════════════════════════════
  // mnOnConsumerDesignReady — strict Auth-First cart-add + checkout redirect.
  // Callers MUST be logged in — the click interceptor gates unauth'd users
  // into the register flow BEFORE invoking this helper.
  // ═══════════════════════════════════════════════════════════════════════
  window.mnOnConsumerDesignReady = function(designUuid, imageUrl, title, variantId, extraProps) {
    var productType = mnNormalizeProductType(extraProps && extraProps._product_type);
    var variant = variantId || mnDefaultVariantForProductType(productType);

    // Strict variant validation — required by the Auth-First spec.
    if (!variant || variant === 0 || variant === '0') {
      alert('Configuration Error: Default print product Variant ID is missing in Theme Settings. Please add it via the Theme Editor.');
      return;
    }

    var properties = Object.assign({}, extraProps || {}, {
      '_design_uuid':  designUuid || '',
      '_design_title': title      || 'My Design',
      '_product_type': productType,
      '_design_file_url': imageUrl || '',
      '_design_preview_url': imageUrl || '',
      'Custom Design': imageUrl   || ''
    });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: variant, quantity: 1, properties: properties }] })
    })
    .then(function(r) {
      if (r.ok) return r.json();
      return r.text().then(function(txt) {
        console.error('[MN] consumer cart/add failed:', r.status, txt);
        throw new Error('cart_add_failed:' + r.status);
      });
    })
    .then(function() {
      // Straight to checkout, NOT /cart — maximises conversion.
      window.location.href = '/checkout';
    })
    .catch(function(err) {
      console.error('[MN] Consumer add-to-cart failed:', err);
      alert(
        'We couldn\u2019t add your design to the cart. ' +
        'Please try again in a moment \u2014 your design is still saved.'
      );
    });
  };

  // CAUTION: `.action-btn` is intentionally NOT in this list — the studio
  // HTML reuses it for every primary button (REVEAL MY SLOGANS, PROCEED,
  // etc.). Matching it here would swallow those clicks. The Auth-First
  // click interceptor catches the real cart buttons via `#cart-btn` and
  // the `finalizeOrder`/`addToCart` onclick selectors below.
  var CART_SELECTOR = [
    '[data-action="add-to-cart"]', '.add-to-cart', '#addToCart',
    '[name="add"]', '.btn-cart', '.product-form__submit',
    '[data-role="add-to-cart"]', '[data-cart]',
    '.buy-now-btn', '.mn-buy-btn',
    // Studio-shipped cart / publish buttons:
    '#cart-btn', '[onclick*="finalizeOrder"]', '[onclick*="addToCart"]'
  ].join(', ');
  var CART_TEXT_RE  = /\b(add to cart|buy now|purchase|get yours|checkout now|order now)\b/i;

  // Explicit allow-list of architect-studio buttons that must NEVER be treated
  // as cart actions — they drive the AI slogan / visualize / render flow.
  var ARCHITECT_SELECTOR = [
    '.architect-btn', '.architect-btn-secondary',
    '#submitBtn', '#continueBtn', '#generateBtn',
    '.slogan-card', '.visual-preview-card',
    '[onclick*="captureEmotion"]', '[onclick*="proceedToVisualization"]',
    '[onclick*="transitionToStudio"]', '[onclick*="resetConsultation"]',
    '[onclick*="selectSlogan"]'
  ].join(', ');

  function isArchitectAction(target) {
    if (!target || target.nodeType !== 1) return false;
    var node = target, hops = 0;
    while (node && hops < 4) {
      if (typeof node.matches === 'function') {
        try { if (node.matches(ARCHITECT_SELECTOR)) return true; } catch (e) {}
      }
      node = node.parentNode;
      hops++;
    }
    return false;
  }

  function isCartAction(target) {
    if (!target || target.nodeType !== 1) return false;
    if (isArchitectAction(target)) return false;
    var node = target, hops = 0;
    while (node && hops < 4) {
      if (typeof node.matches === 'function') {
        try { if (node.matches(CART_SELECTOR)) return true; } catch (e) {}
      }
      var txt = (node.textContent || '').trim();
      if (node.tagName && /^(BUTTON|A)$/.test(node.tagName) && txt && txt.length < 40 && CART_TEXT_RE.test(txt)) {
        return true;
      }
      node = node.parentNode;
      hops++;
    }
    return false;
  }

  console.info('[MN placement-editor] Auth-First interceptor armed. MN_CREATOR_INTENT=' + !!window.MN_CREATOR_INTENT);

  // ═══════════════════════════════════════════════════════════════════════
  // AUTH-FIRST CART CLICK INTERCEPTOR — see page.ai-studio.liquid for the
  // full rationale. Short version: the studio's inline onclick="finalizeOrder()"
  // fires a /cart/add.js with a broken payload. We take TOTAL ownership:
  //   1. preventDefault() + stopPropagation() unconditionally.
  //   2. Branch on creator intent × login state and route accordingly.
  // ═══════════════════════════════════════════════════════════════════════
  document.addEventListener('click', function(e) {
    if (!isCartAction(e.target)) return;

    // Kill the studio's native cart-add + redirect UNCONDITIONALLY.
    e.preventDefault();
    e.stopPropagation();
    if (typeof e.stopImmediatePropagation === 'function') {
      e.stopImmediatePropagation();
    }

    var effIntent = getEffectiveCreatorIntent();
    console.info('[MN placement-editor] cart-button click intercepted. effIntent=' +
      (effIntent || '(none — consumer)') + ' logged_in=' + IS_LOGGED_IN);

    // ─── Creator flow ────────────────────────────────────────────────
    if (effIntent) {
      var onboardingUrl = '/pages/creator-onboarding?from=studio&intent=' + encodeURIComponent(effIntent);
      if (IS_LOGGED_IN) {
        window.location.href = onboardingUrl;
      } else {
        window.location.href = '/account/register?return_url=' + encodeURIComponent(onboardingUrl);
      }
      return;
    }

    // ─── Consumer flow ───────────────────────────────────────────────
    if (IS_LOGGED_IN) {
      var raw = null;
      try { raw = localStorage.getItem('mn_pending_design'); } catch (err) {}
      var parsed = null;
      if (raw) { try { parsed = JSON.parse(raw); } catch (err) {} }

      var uuid  = (parsed && (parsed.design_uuid || parsed.uuid))     || '';
      var img   = (parsed && (parsed.image_url   || parsed.imageUrl)) || '';
      var title = (parsed && parsed.title)                             || 'My Design';

      window.mnOnConsumerDesignReady(uuid, img, title, null, {
        '_product_type': (parsed && parsed.product_type) || 'tee'
      });
      return;
    }

    // Logged-out consumer: set resume flag, send to register with a
    // return URL back to this exact page. The auto-resume listener
    // below will re-fire the cart-add once they come back authenticated.
    try { sessionStorage.setItem('mn_resume_checkout', 'true'); } catch (err) {}
    var here = window.location.pathname + window.location.search;
    window.location.href = '/account/register?return_url=' + encodeURIComponent(here);
  }, true);

  // ═══════════════════════════════════════════════════════════════════════
  // AUTO-RESUME CHECKOUT — fires after the register/login round-trip.
  // ═══════════════════════════════════════════════════════════════════════
  function mnAutoResumeCheckout() {
    if (!IS_LOGGED_IN) return;
    var flag = null;
    try { flag = sessionStorage.getItem('mn_resume_checkout'); } catch (err) {}
    if (flag !== 'true') return;
    try { sessionStorage.removeItem('mn_resume_checkout'); } catch (err) {}

    var raw = null;
    try { raw = localStorage.getItem('mn_pending_design'); } catch (err) {}
    if (!raw) {
      console.warn('[MN placement-editor] auto-resume skipped: no mn_pending_design in localStorage');
      return;
    }
    var parsed = null;
    try { parsed = JSON.parse(raw); } catch (err) {}
    if (!parsed) return;

    console.info('[MN placement-editor] ✅ auto-resume firing mnOnConsumerDesignReady after auth round-trip');
    window.mnOnConsumerDesignReady(
      parsed.design_uuid || parsed.uuid     || '',
      parsed.image_url   || parsed.imageUrl || '',
      parsed.title                          || 'My Design',
      null,
      { '_product_type': parsed.product_type || 'tee' }
    );
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mnAutoResumeCheckout);
  } else {
    mnAutoResumeCheckout();
  }

  window.mnDiagnose = function mnDiagnose() {
    var raw = localStorage.getItem('mn_pending_design');
    var parsed = null;
    try { parsed = raw ? JSON.parse(raw) : null; } catch(e) {}
    var report = {
      page_url:           window.location.href,
      url_intent:         new URLSearchParams(window.location.search).get('intent') || '(none)',
      session_intent:     sessionStorage.getItem('mn_creator_intent') || '(none)',
      resume_checkout:    sessionStorage.getItem('mn_resume_checkout') || '(none)',
      MN_CREATOR_INTENT:  !!window.MN_CREATOR_INTENT,
      effective_intent:   (typeof getEffectiveCreatorIntent === 'function') ? getEffectiveCreatorIntent() : '(fn missing)',
      is_logged_in:       IS_LOGGED_IN,
      default_tshirt_variant_id: DEFAULT_TSHIRT_VARIANT_ID || '(NOT SET — theme settings → My Narrative → Print-on-Demand Products)',
      pending_design:     parsed || '(none in localStorage)',
      consumer_helper:    typeof window.mnOnConsumerDesignReady,
      creator_helper:     typeof window.mnOnDesignReady,
      auth_modal_mount:   typeof ensureConsumerAuthModal,
      finalizeOrder:      typeof window.finalizeOrder + ' (studio-owned, intercepted by Auth-First click gate)',
      interceptor_mode:   'auth-first (preventDefault + stopPropagation always)',
    };
    console.table(report);
    console.log('[MN diagnose] Full object:', report);
    return report;
  };
  console.info('[MN placement-editor] Paste `mnDiagnose()` in this console for a pipeline health-check.');
})();
</script>

